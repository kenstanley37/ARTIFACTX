<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NMS.WinUI3.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NMS.WinUI3"
    xmlns:views="using:NMS.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NMS Save Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource NmsBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <views:AppTitleBar x:Name="CustomTitleBar" Grid.Row="0"/>

        <NavigationView x:Name="RootNav"
                        Grid.Row="1"
                        PaneDisplayMode="LeftCompact"
                        IsSettingsVisible="False"
                        SelectionChanged="RootNav_SelectionChanged"
                        Background="Transparent">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Save Hub Landing" Icon="Home" Tag="SaveHub" />
                <NavigationViewItem Content="Inventory Control" Icon="AllApps" Tag="Inventory" />
                <NavigationViewItem Content="Data Diagnostic" Icon="ReportHacked" Tag="DataDiagnostic" />

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Structural Analysis" SelectsOnInvoked="False" IsExpanded="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="JSON Ancestry Engine" Icon="Find" Tag="AncestrySearch" />
                        <NavigationViewItem Content="HG File Decryption" Tag="HGDecryption">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE943;" FontFamily="Segoe MDL2 Assets"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated"/>
        </NavigationView>
    </Grid>
</Window>