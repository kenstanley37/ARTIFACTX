<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NMS.WinUI3.Views.SaveHubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NMS.Core.Models"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Dynamic Save Workspace Selector" Style="{ThemeResource HeaderTextBlockStyle}" FontWeight="Bold"/>
            <TextBlock Text="Select an identified game profile slot to manage its specific restore point files." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="Active Storage Directory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}"/>
                    <TextBlock x:Name="DirectoryPathTxt" Text="No folder mapped..." FontStyle="Italic" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                </StackPanel>
                <Button Grid.Column="1" Click="ChangeDirectoryBtn_Click" Style="{ThemeResource AccentButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Folder"/>
                        <TextBlock Text="Select Save Path"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <ListView x:Name="MasterSlotsListView" Grid.Row="0" SelectionMode="Single" SelectionChanged="MasterSlotsListView_SelectionChanged" Padding="0,4">
                    <ListView.Header>
                        <Grid Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CHARACTER PROFILE SLOT" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="IDENTIFIED GAMEPLAY MODE" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="Gray"/>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SaveFileCard">
                            <Grid Padding="4,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="👤" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Units}" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind GameVersion}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" Text="Available Save Branch Options for Selected Slot" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,16,0,8"/>

                <ListView x:Name="BranchFilesListView" Grid.Row="2" SelectionMode="Single" SelectionChanged="BranchFilesListView_SelectionChanged" Padding="0,4" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="6" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <ListView.Header>
                        <Grid Padding="16,6" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="FILE TARGET" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="1" Text="SAVE TYPE BRANCH" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="Gray"/>
                            <TextBlock Grid.Column="2" Text="DISK MODIFICATION TIMESTAMP" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="Bold" Foreground="Gray"/>
                        </Grid>
                    </ListView.Header>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SaveFileCard">
                            <Grid Padding="4,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind FileName}" Style="{ThemeResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource NmsAccentBrush}"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind GameVersion}" Style="{ThemeResource BodyTextBlockStyle}"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind LastModified}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="Gray"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="32" Height="32" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <Border x:Name="ValidationInspectorPane" Grid.Column="1" Visibility="Collapsed"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderThickness="1"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        CornerRadius="6"
        Padding="20">

                <ScrollViewer>
                    <StackPanel Spacing="16">

                        <!-- HEADER -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE99A;" FontFamily="Segoe MDL2 Assets" Foreground="OrangeRed"/>
                            <TextBlock Text="Workspace Validation Pane"
                           Style="{ThemeResource SubtitleTextBlockStyle}"
                           FontWeight="Bold"/>
                        </StackPanel>

                        <MenuFlyoutSeparator/>

                        <!-- FILE NAME -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Active Editor File Name Context:"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="Gray"/>
                            <TextBlock x:Name="InspectorFileName"
                           Text="save.hg"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Foreground="{ThemeResource NmsAccentBrush}"/>
                        </StackPanel>

                        <!-- BRANCH TYPE -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Verified Save Type Branch Identification:"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="Gray"/>
                            <TextBlock x:Name="InspectorPayloadName"
                           Text="Unknown"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        </StackPanel>

                        <!-- TIMESTAMP -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="Last Modified Time Target:"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="Gray"/>
                            <TextBlock x:Name="InspectorFileTime"
                           Text="Unknown"
                           Style="{ThemeResource BodyTextBlockStyle}"/>
                        </StackPanel>

                        <MenuFlyoutSeparator Margin="0,8"/>

                        <!-- CURRENCY -->
                        <TextBlock Text="Decrypted Character Balance Matrix"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"/>

                        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                  Padding="12"
                  CornerRadius="6">

                            <StackPanel Spacing="8">
                                <TextBlock x:Name="InspectorUnits"
                               Text="0 UNITS"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               FontWeight="Bold"
                               Foreground="Orange"/>

                                <TextBlock x:Name="InspectorNanites"
                               Text="0 NANITES"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               FontWeight="Bold"
                               Foreground="Cyan"/>

                                <TextBlock x:Name="InspectorQuicksilver"
                               Text="0 QUICKSILVER"
                               Style="{ThemeResource BodyTextBlockStyle}"
                               FontWeight="Bold"
                               Foreground="Magenta"/>
                            </StackPanel>

                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Grid>
</Page>