<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NMS.WinUI3.Views.SaveFolderSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NMS.WinUI3.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Folder Picker Section -->
        <StackPanel x:Name="FolderPickerSection"
                Orientation="Vertical"
                Margin="40,40,0,0"
                Spacing="12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">

            <TextBlock Text="Select Your No Man's Sky Save Folder"
                   FontSize="20"
                   FontWeight="Bold"/>

            <TextBlock Text="Choose the folder containing your .hg save files."
                   FontSize="14"
                   Foreground="Gray"/>

            <Button x:Name="PickFolderBtn"
                Content="Pick Save Folder"
                Width="180"
                Click="PickFolderBtn_Click"/>

            <TextBlock x:Name="SelectedFolderTxt"
                   Text=""
                   FontSize="12"
                   Foreground="Gray"/>
        </StackPanel>

        <!-- Save Overview Section -->
        <Grid x:Name="SaveOverviewSection"
          Grid.Row="1"
          Margin="20"
          Visibility="Collapsed">

            <!-- Placeholder for your future overview content -->
            <TextBlock Text="Save Overview will appear here..."
                   FontSize="16"
                   Foreground="Gray"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        </Grid>
        <ProgressRing x:Name="LoadingRing"
              Width="40"
              Height="40"
              IsActive="False"
              Visibility="Collapsed"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>

    </Grid>
    
</Page>
