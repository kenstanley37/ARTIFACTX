<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NMS.WinUI3.Views.SaveFolderSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NMS.WinUI3.Views"
    xmlns:models="using:NMS.WinUI3.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Select Your No Man's Sky Save Folder" FontSize="22" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}"
                       Text="We looked for Steam, GOG, and Microsoft Store installs automatically. Pick one below, or browse for your own."/>
        </StackPanel>

        <!-- Candidate folders, each with its own nested save-slot preview when selected -->
        <Grid Grid.Row="1">
            <ListView ItemsSource="{x:Bind ViewModel.Candidates}"
                      SelectedItem="{x:Bind ViewModel.SelectedCandidate, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SaveFolderCandidate">
                        <StackPanel Padding="0,4">

                            <!-- Folder header -->
                            <Grid Padding="12" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <SymbolIcon Grid.Column="0" Symbol="Folder"
                                            Foreground="{ThemeResource NmsAccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind FolderPath}" FontSize="12" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind SubText}" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Click="RemoveFolderBtn_Click" Tag="{x:Bind}"
                                        Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="Remove this folder from the list">
                                    <SymbolIcon Symbol="Delete"/>
                                </Button>
                            </Grid>

                            <!-- Nested save preview: visually attached under this folder when selected -->
                            <Border Visibility="{x:Bind IsSelected, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Margin="20,0,12,12" Padding="16,12"
                                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                    BorderBrush="{ThemeResource NmsAccentBrush}"
                                    BorderThickness="2,0,0,0">
                                <StackPanel Spacing="8">
                                    <ProgressRing IsActive="{x:Bind IsLoadingSlots, Mode=OneWay}"
                                                  Visibility="{x:Bind IsLoadingSlots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  Width="28" Height="28" HorizontalAlignment="Left"/>

                                    <TextBlock Text="No readable save files were found in this folder."
                                               Foreground="{ThemeResource NmsTextSecondary}" FontSize="13"
                                               Visibility="{x:Bind IsEmptyResult, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <ItemsControl ItemsSource="{x:Bind SlotGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SaveSlotGroup">
                                                <Border Tapped="SaveSlot_Tapped" Tag="{x:Bind}"
                    Padding="10" Margin="0,4" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToActiveBackgroundConverter}}">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{x:Bind SlotLabel}" FontWeight="Bold" FontSize="14"/>
                                                            <Border Grid.Column="1" Background="{ThemeResource NmsAccentBrush}" CornerRadius="4" Padding="8,3"
                                Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="ACTIVE" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                            </Border>
                                                        </Grid>

                                                        <ItemsControl ItemsSource="{x:Bind Files}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:SaveFileEntry">
                                                                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,4">
                                                                        <Grid ColumnSpacing="10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Grid.Column="0" Background="{ThemeResource NmsAccentBrush}"
                                                CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind SaveKindLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                                            </Border>
                                                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind SaveName}" FontWeight="SemiBold" FontSize="13"/>
                                                                                <TextBlock Text="{x:Bind FileName}" FontSize="11" Foreground="Gray"/>
                                                                            </StackPanel>
                                                                            <StackPanel Grid.Column="2" Spacing="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind LastModifiedDisplay}" FontSize="12" HorizontalAlignment="Right"/>
                                                                                <TextBlock Text="{x:Bind PlayTimeDisplay}" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Indexing your save folders — this only happens once per launch."
                           FontSize="13" Foreground="{ThemeResource NmsTextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="OrangeRed"
                       Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
            <Button Content="Browse for folder..." Click="BrowseFolderBtn_Click" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Page>