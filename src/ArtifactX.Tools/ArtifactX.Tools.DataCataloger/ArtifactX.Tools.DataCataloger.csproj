<Project Sdk="Microsoft.NET.Sdk">

  <!-- Developer tool: command-line front end to ArtifactX.GameData (the catalog
       builder the app runs on the player's PC), plus research commands
       (grep, locid, dumpfile...). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DataCataloger</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ArtifactX.GameData\ArtifactX.GameData.csproj" />
  </ItemGroup>

</Project>
