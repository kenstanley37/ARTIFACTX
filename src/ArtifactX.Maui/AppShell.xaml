<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ArtifactX.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:explore="clr-namespace:ArtifactX.Maui.Views.ExplorePages"
    xmlns:reference="clr-namespace:ArtifactX.Maui.Views.ReferencePages"
    Title="ArtifactX"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{DynamicResource ThemeChromeColor}"
    Shell.TabBarBackgroundColor="{DynamicResource ThemeChromeColor}"
    Shell.TabBarTitleColor="{DynamicResource ThemeAccentColor}"
    Shell.TabBarForegroundColor="{DynamicResource ThemeAccentColor}"
    Shell.TabBarUnselectedColor="{DynamicResource ThemeTextDimColor}">

    <TabBar>
        <ShellContent
            Title="Home"
            Route="home"
            ContentTemplate="{DataTemplate explore:HomePage}" />

        <ShellContent
            Title="Systems"
            Route="systems"
            ContentTemplate="{DataTemplate explore:PortalGlyphsPage}" />

        <ShellContent
            Title="Recipes"
            Route="recipes"
            ContentTemplate="{DataTemplate reference:RecipesPage}" />

        <ShellContent
            Title="Eggs"
            Route="eggs"
            ContentTemplate="{DataTemplate explore:EggSequencerPage}" />
    </TabBar>

</Shell>
