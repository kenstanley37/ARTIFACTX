<?xml version="1.0" encoding="utf-8" ?>
<!-- "Galaxy Map" theme (shared with ArtifactX.WinUI3) - obsidian space backdrop,
     glassy panels, warm gold/amber highlights, and softly rounded corners. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ArtifactX.Maui.Resources.Themes.GalaxyMap">

    <Color x:Key="ThemeVoidColor">#04050B</Color>
    <Color x:Key="ThemeChromeColor">#08090F</Color>
    <Color x:Key="ThemePanelColor">#14182C</Color>
    <Color x:Key="ThemePanelAltColor">#1E223A</Color>
    <Color x:Key="ThemeLineColor">#2A3150</Color>
    <Color x:Key="ThemeAccentColor">#FFC62E</Color>
    <Color x:Key="ThemeAccentAltColor">#FF9D3D</Color>
    <Color x:Key="ThemeCyanColor">#39D0FF</Color>
    <Color x:Key="ThemePurpleSystemColor">#C77DFF</Color>
    <Color x:Key="ThemeDoneColor">#7EF0C2</Color>
    <Color x:Key="ThemeTextColor">#ECEAF2</Color>
    <Color x:Key="ThemeTextDimColor">#BDB8CC</Color>
    <Color x:Key="ThemeTextFaintColor">#938DA8</Color>
    <Color x:Key="ThemeOnAccentColor">#04050B</Color>
    <Color x:Key="ThemeSelectedFillColor">#33FFC62E</Color>
    <Color x:Key="ThemeWarningColor">#FFB454</Color>

    <SolidColorBrush x:Key="ThemeVoidBrush" Color="{StaticResource ThemeVoidColor}" />
    <SolidColorBrush x:Key="ThemeChromeBrush" Color="{StaticResource ThemeChromeColor}" />
    <SolidColorBrush x:Key="ThemePanelBrush" Color="{StaticResource ThemePanelColor}" />
    <SolidColorBrush x:Key="ThemePanelAltBrush" Color="{StaticResource ThemePanelAltColor}" />
    <SolidColorBrush x:Key="ThemeLineBrush" Color="{StaticResource ThemeLineColor}" />
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="{StaticResource ThemeAccentColor}" />
    <SolidColorBrush x:Key="ThemeAccentAltBrush" Color="{StaticResource ThemeAccentAltColor}" />
    <SolidColorBrush x:Key="ThemeCyanBrush" Color="{StaticResource ThemeCyanColor}" />
    <SolidColorBrush x:Key="ThemeDoneBrush" Color="{StaticResource ThemeDoneColor}" />
    <SolidColorBrush x:Key="ThemeTextBrush" Color="{StaticResource ThemeTextColor}" />
    <SolidColorBrush x:Key="ThemeTextDimBrush" Color="{StaticResource ThemeTextDimColor}" />
    <SolidColorBrush x:Key="ThemeTextFaintBrush" Color="{StaticResource ThemeTextFaintColor}" />
    <SolidColorBrush x:Key="ThemeOnAccentBrush" Color="{StaticResource ThemeOnAccentColor}" />

    <LinearGradientBrush x:Key="ThemePageBackdropBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#1A1208" Offset="0.0" />
        <GradientStop Color="#04050B" Offset="0.45" />
        <GradientStop Color="#0C0A22" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeBandBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#24FFC62E" Offset="0.0" />
        <GradientStop Color="#0AFF9D3D" Offset="1.0" />
    </LinearGradientBrush>

    <x:Double x:Key="ThemeCardRadius">10</x:Double>
    <x:String x:Key="ThemeDisplayFont">Exo2</x:String>
    <x:String x:Key="ThemeBodyFont">TitilliumWeb</x:String>
</ResourceDictionary>
