<?xml version="1.0" encoding="utf-8" ?>
<!-- A portal address as glyph pictures (our own artwork, ArtifactXPortalGlyphs), in dialling order - what a player
     enters at a portal. Code is the 12-character address; fewer characters draw fewer glyphs (an address being typed). -->
<ContentView
    x:Class="ArtifactX.Maui.Controls.GlyphRow"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:art="clr-namespace:ArtifactX.Core.Theming;assembly=ArtifactX.Core"
    xmlns:helpers="clr-namespace:ArtifactX.Maui.Helpers.PortalGlyphs"
    xmlns:local="clr-namespace:ArtifactX.Maui.Controls"
    x:Name="Root">
    <ContentView.Resources>
        <helpers:PortalGlyphGeometryConverter x:Key="GlyphGeometryConverter" />
    </ContentView.Resources>
    <FlexLayout x:Name="Glyphs" Wrap="NoWrap" JustifyContent="SpaceBetween">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="art:PortalGlyphVector">
                <Path Data="{Binding PathData, Converter={StaticResource GlyphGeometryConverter}}"
                      Fill="{DynamicResource ThemeTextBrush}" Aspect="Uniform"
                      WidthRequest="{Binding GlyphSize, Source={x:Reference Root}, x:DataType='local:GlyphRow'}"
                      HeightRequest="{Binding GlyphSize, Source={x:Reference Root}, x:DataType='local:GlyphRow'}"
                      Margin="3,0" FlexLayout.Shrink="1" />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </FlexLayout>
</ContentView>
