<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ArtifactX.Maui.Views.ReferencePages.RecipesPage"
    Shell.NavBarIsVisible="False"
    Background="{DynamicResource ThemePageBackdropBrush}">

    <VerticalStackLayout Padding="20,24" Spacing="14">
        <Label
            Text="Recipes"
            Style="{StaticResource ThemePageTitleStyle}" />
        <Label
            Text="Find an item to make or an ingredient you have."
            Style="{StaticResource ThemeDimTextStyle}" />
    </VerticalStackLayout>
</ContentPage>
