<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArtifactX.Maui.ViewModels"
    x:Class="ArtifactX.Maui.Views.ReferencePages.RecipeDetailsPage"
    x:DataType="vm:RecipeDetailsViewModel"
    Shell.NavBarIsVisible="False"
    Background="{DynamicResource ThemePageBackdropBrush}"
    xmlns:controls="clr-namespace:ArtifactX.Maui.Controls">
    <!-- The galaxy being viewed, on every page (GalaxyBar); outside the scroll so it stays in sight. -->
    <Grid RowDefinitions="Auto,*">
        <controls:GalaxyBar />
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,28" Spacing="14" MaximumWidthRequest="720" HorizontalOptions="Fill">
                <Button Text="Back" Command="{Binding GoBackCommand}" HorizontalOptions="Start" SemanticProperties.Description="Back to the recipes"
                        TextColor="{DynamicResource ThemeTextColor}" BackgroundColor="{DynamicResource ThemePanelAltColor}" />
                <Label Text="{Binding Title}" Style="{StaticResource ThemePageTitleStyle}" />
                <Label Text="{Binding Station}" Style="{StaticResource ThemeBodyTextStyle}" />
                <Label Text="{Binding Buff}" IsVisible="{Binding HasBuff}" FontSize="16" TextColor="{DynamicResource ThemeDoneColor}" />
                <Label Text="{Binding Summary}" Style="{StaticResource ThemeDimTextStyle}" />
                <Label Text="{Binding Notice}" IsVisible="{Binding HasNotice}" FontSize="14" TextColor="{DynamicResource ThemeWarningColor}" />

                <!-- Everything to gather for one of it. -->
                <Border Style="{StaticResource ThemeCardStyle}" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="SHOPPING LIST" Style="{StaticResource ThemeEyebrowStyle}" />
                        <Label Text="The raw ingredients for one, all steps included." Style="{StaticResource ThemeDimTextStyle}" FontSize="13" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Gather}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecipeGatherItem">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" SemanticProperties.Description="{Binding AccessibleName}">
                                        <Label Text="{Binding AmountText}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource ThemeAccentColor}" />
                                        <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" TextColor="{DynamicResource ThemeTextColor}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- The steps, in the order to do them. -->
                <Label Text="STEPS" Style="{StaticResource ThemeEyebrowStyle}" Margin="0,6,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Steps}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecipeStepViewModel">
                            <Border Style="{StaticResource ThemeCardAltStyle}" Padding="12,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" TextColor="{DynamicResource ThemeTextColor}" />
                                    <Label Text="{Binding Station}" FontSize="13" TextColor="{DynamicResource ThemeTextDimColor}" />
                                    <Label Text="{Binding Formula}" FontSize="15" TextColor="{DynamicResource ThemeTextColor}" />
                                    <Label Text="{Binding Runs}" IsVisible="{Binding HasRuns}" FontSize="14" TextColor="{DynamicResource ThemeAccentColor}" />
                                    <VerticalStackLayout IsVisible="{Binding HasAlternatives}" Spacing="2" Margin="0,4,0,0">
                                        <Label Text="{Binding AlternativesTitle}" Style="{StaticResource ThemeEyebrowStyle}" />
                                        <Picker ItemsSource="{Binding Alternatives}" SelectedItem="{Binding SelectedAlternative}" Title="Make it with"
                                                ItemDisplayBinding="{Binding Label, x:DataType='vm:RecipeAlternative'}"
                                                TextColor="{DynamicResource ThemeTextColor}"
                                                SemanticProperties.Description="{Binding Title, StringFormat='Choose another recipe for {0}'}" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
