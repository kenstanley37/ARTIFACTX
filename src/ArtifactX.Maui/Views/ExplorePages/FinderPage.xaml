<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:ArtifactX.Maui.ViewModels"
    xmlns:models="clr-namespace:ArtifactX.Maui.Models"
    x:Class="ArtifactX.Maui.Views.ExplorePages.FinderPage"
    x:DataType="vm:FinderViewModel"
    Shell.NavBarIsVisible="False"
    Background="{DynamicResource ThemePageBackdropBrush}"
    xmlns:controls="clr-namespace:ArtifactX.Maui.Controls">
    <!-- The galaxy being viewed, on every page (GalaxyBar); outside the scroll so it stays in sight. -->
    <Grid RowDefinitions="Auto,Auto,*">
        <controls:GalaxyBar />
        <VerticalStackLayout Grid.Row="1" Padding="20,20,20,8" Spacing="10" MaximumWidthRequest="720" HorizontalOptions="Fill">
            <Label Text="Find multi-tools" Style="{StaticResource ThemePageTitleStyle}" />
            <Label Text="Station cabinets selling the kind and class of multi-tool you want, in the systems around one you've opened."
                   Style="{StaticResource ThemeDimTextStyle}" />
            <VerticalStackLayout IsVisible="{Binding HasStarts}" Spacing="6">
                <Picker ItemsSource="{Binding Starts}" SelectedItem="{Binding Start}" Title="Search around"
                        ItemDisplayBinding="{Binding Name, x:DataType='models:RecentSystemSummary'}"
                        TextColor="{DynamicResource ThemeTextColor}" SemanticProperties.Description="The system to search around" />
                <Picker ItemsSource="{Binding Areas}" SelectedItem="{Binding Area}" Title="How far"
                        ItemDisplayBinding="{Binding Label, x:DataType='vm:FinderChoice'}"
                        TextColor="{DynamicResource ThemeTextColor}" SemanticProperties.Description="How far to search" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Picker ItemsSource="{Binding Classes}" SelectedItem="{Binding Class}" Title="Class"
                            ItemDisplayBinding="{Binding Label, x:DataType='vm:FinderChoice'}"
                            TextColor="{DynamicResource ThemeTextColor}" SemanticProperties.Description="Lowest class to show" />
                    <Picker Grid.Column="1" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}" Title="Kind"
                            ItemDisplayBinding="{Binding Label, x:DataType='vm:FinderChoice'}"
                            TextColor="{DynamicResource ThemeTextColor}" SemanticProperties.Description="Kind of multi-tool" />
                </Grid>
                <Label Text="{Binding RollNote}" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" />
            </VerticalStackLayout>
            <HorizontalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" Color="{DynamicResource ThemeAccentColor}" HeightRequest="20" WidthRequest="20" />
                <Label Text="{Binding Status}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="14" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}" SelectionMode="None"
                        MaximumWidthRequest="720" HorizontalOptions="Fill" Margin="20,0,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:FinderRowViewModel">
                    <controls:TapCard Margin="0,0,0,8" AccessibleName="{Binding AccessibleName}" CommandParameter="{Binding .}"
                                      Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinderViewModel}}, Path=OpenCommand}">
                        <Border Style="{StaticResource ThemeCardAltStyle}" Padding="12,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="{DynamicResource ThemeTextColor}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsBest}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource ThemeDoneColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Place}" FontSize="14" TextColor="{DynamicResource ThemeAccentColor}" />
                                <Label Text="{Binding Action}" FontSize="13" TextColor="{DynamicResource ThemeTextDimColor}" />
                            </VerticalStackLayout>
                        </Border>
                    </controls:TapCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
