<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ArtifactX.Maui.Views.ExplorePages.PortalGlyphsPage"
    Shell.NavBarIsVisible="False"
    Background="{DynamicResource ThemePageBackdropBrush}">

    <VerticalStackLayout Padding="20,24" Spacing="14">
        <Label
            Text="Portal glyphs"
            Style="{StaticResource ThemePageTitleStyle}" />
        <Label
            Text="Tap the 12 glyphs in order, or scan them from a portal or a screenshot."
            Style="{StaticResource ThemeDimTextStyle}" />
    </VerticalStackLayout>
</ContentPage>
