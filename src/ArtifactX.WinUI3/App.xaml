<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ArtifactX.WinUI3.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ArtifactX.WinUI3.Converters"
    xmlns:local="using:ArtifactX.WinUI3">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Active visual theme - ThemeService swaps this one entry for the
                     user's pick at startup and on change. Must come before
                     ThemeStyles, which is built from its Theme* keys. -->
                <ResourceDictionary Source="ms-appx:///Themes/StationCore.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/ThemeStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:StringFormatConverter x:Key="StringFormatConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:BoolToActiveBackgroundConverter x:Key="BoolToActiveBackgroundConverter" />
            <converters:BoolToAccentBrushConverter x:Key="BoolToAccentBrushConverter" />
            <converters:SlotStateToBackgroundConverter x:Key="SlotStateToBackgroundConverter" />
            <converters:SlotStateToBorderConverter x:Key="SlotStateToBorderConverter" />

            <SolidColorBrush x:Key="NmsBackgroundBrush" Color="#0A0D14" />
            <SolidColorBrush x:Key="NmsPaneBackgroundBrush" Color="#10141F" />
            <SolidColorBrush x:Key="NmsAccentBrush" Color="#FF9D00" />
            <SolidColorBrush x:Key="NmsTextPrimary" Color="#F0F3F8" />
            <SolidColorBrush x:Key="NmsTextSecondary" Color="#8A96A8" />
            <SolidColorBrush x:Key="NmsDangerBrush" Color="#C42B1C" />

            <!-- NavigationView pane backgrounds come from the active theme
                 (Themes/*.xaml) - don't redefine them here, root keys would win. -->

            <!-- Every page's "Reset X Changes" button uses this - a plain
                 default-styled button blended into the background too easily,
                 and this is a destructive action (discards pending edits) that
                 deserves to stand out. Plain property Setters (not a
                 ThemeResource-key override, which needs a Style.Resources
                 block WinUI3 doesn't actually support) - the default Button
                 template binds its idle Background/Foreground/BorderBrush
                 straight from these properties, which covers the state this
                 button is in almost all the time; hover/pressed still use the
                 stock highlight treatment on top of it. -->
            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{StaticResource NmsDangerBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource NmsDangerBrush}"/>
            </Style>

            <!-- Solid accent call-to-action (e.g. Claim Station), built from the active
                 theme's keys. Lives here rather than Themes/ThemeStyles.xaml because a
                 BasedOn StaticResource to XamlControlsResources' DefaultButtonStyle is
                 only reliable from the app's root dictionary (same as DangerButtonStyle). -->
            <Style x:Key="ThemeAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ThemeAccentBrush}"/>
                <Setter Property="Foreground" Value="{ThemeResource ThemeOnAccentBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="CornerRadius" Value="{ThemeResource ThemeCardCornerRadius}"/>
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="CharacterSpacing" Value="180"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
