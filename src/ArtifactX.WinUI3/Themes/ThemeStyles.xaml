<?xml version="1.0" encoding="utf-8"?>
<!-- Shared styles built only from the Theme* keys every theme file defines,
     so a page styled with these looks right in whichever theme is active.
     ThemeResource (not StaticResource) so the lookup goes through whatever
     theme dictionary ThemeService has merged in. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A panel: themed fill, hairline border, theme corner radius. -->
    <Style x:Key="ThemeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ThemePanelBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource ThemeLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ThemeCardCornerRadius}"/>
    </Style>

    <!-- The coloured header strip across the top of a card. -->
    <Style x:Key="ThemeBandStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ThemeBandBrush}"/>
        <Setter Property="Padding" Value="18,11"/>
    </Style>

    <!-- Uppercase, widely spaced label - the game's "DIRECTORSHIP REQUIREMENTS"
         look. TextBlock has no text-transform, so callers write the text in
         capitals themselves. -->
    <Style x:Key="ThemeBandTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="CharacterSpacing" Value="220"/>
        <Setter Property="Foreground" Value="{ThemeResource ThemeBandTextBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ThemeEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CharacterSpacing" Value="260"/>
        <Setter Property="Foreground" Value="{ThemeResource ThemeAccentBrush}"/>
    </Style>

    <Style x:Key="ThemePageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="CharacterSpacing" Value="140"/>
        <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
    </Style>

    <Style x:Key="ThemeHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="CharacterSpacing" Value="30"/>
        <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ThemeBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeBodyFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ThemeDimTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ThemeBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource ThemeTextDimBrush}"/>
    </Style>

    <!-- Big number in a stat (counts, standings). -->
    <Style x:Key="ThemeNumberStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{ThemeResource ThemeTextBrush}"/>
    </Style>

    <!-- A row of portal glyphs that opens the large glyph view (Controls/GlyphStrip).
         Looks like the row itself; hover, press or keyboard focus adds an accent
         outline and a magnifier badge so people can tell it's clickable. -->
    <Style x:Key="GlyphStripButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="UseSystemFocusVisuals" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOutline.Opacity" Value="1"/>
                                        <Setter Target="Badge.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverOutline.Opacity" Value="1"/>
                                        <Setter Target="Badge.Opacity" Value="1"/>
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled"/>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="HoverOutline" Opacity="0" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{ThemeResource ThemeAccentBrush}"/>
                        <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"/>
                        <Border x:Name="Badge" Opacity="0" Width="18" Height="18" CornerRadius="9"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                Background="{ThemeResource ThemeAccentBrush}">
                            <FontIcon Glyph="&#xE71E;" FontSize="10" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
