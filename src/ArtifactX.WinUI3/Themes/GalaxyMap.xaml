<?xml version="1.0" encoding="utf-8"?>
<!-- "Galaxy Map" theme - darker and starrier, glassy panels with gold
     highlights and softly rounded corners. Same keys as StationCore.xaml. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="ThemeVoidBrush" Color="#04050B"/>
    <SolidColorBrush x:Key="ThemePanelBrush" Color="#9E14182C"/>
    <SolidColorBrush x:Key="ThemePanelAltBrush" Color="#B31E223A"/>
    <SolidColorBrush x:Key="ThemeLineBrush" Color="#47FFC62E"/>
    <SolidColorBrush x:Key="ThemeAccentBrush" Color="#FFC62E"/>
    <SolidColorBrush x:Key="ThemeAccentAltBrush" Color="#FF9D3D"/>
    <SolidColorBrush x:Key="ThemeDoneBrush" Color="#7EF0C2"/>
    <SolidColorBrush x:Key="ThemeTextBrush" Color="#ECEAF2"/>
    <SolidColorBrush x:Key="ThemeTextDimBrush" Color="#BDB8CC"/> <!-- 8.7:1 on panels; was 6.7 (2026-10-18) -->
    <SolidColorBrush x:Key="ThemeTextFaintBrush" Color="#938DA8"/> <!-- 5.3:1, passes WCAG AA; was 3.3 -->
    <SolidColorBrush x:Key="ThemeOnAccentBrush" Color="#04050B"/>
    <SolidColorBrush x:Key="ThemeBandTextBrush" Color="#FFC62E"/>
    <!-- Fill behind a selected choice button (ship picker, Class S/A/B/C...). -->
    <SolidColorBrush x:Key="ThemeSelectedFillBrush" Color="#33FFC62E"/>
    <SolidColorBrush x:Key="ThemeWarningBrush" Color="#FFB454"/>
    <SolidColorBrush x:Key="ThemeTrackBrush" Color="#1AECEAF2"/>

    <LinearGradientBrush x:Key="ThemeBandBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#24FFC62E" Offset="0"/>
        <GradientStop Color="#0AFF9D3D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeHeroOverlayBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F204050B" Offset="0.05"/>
        <GradientStop Color="#8004050B" Offset="0.55"/>
        <GradientStop Color="#D904050B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemeTileFadeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0004050B" Offset="0.35"/>
        <GradientStop Color="#EB04050B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ThemePageBackdropBrush" StartPoint="1,0" EndPoint="0,1">
        <GradientStop Color="#2A1A08" Offset="0"/>
        <GradientStop Color="#04050B" Offset="0.45"/>
        <GradientStop Color="#120D30" Offset="1"/>
    </LinearGradientBrush>

    <CornerRadius x:Key="ThemeCardCornerRadius">4</CornerRadius>
    <FontFamily x:Key="ThemeDisplayFont">/Assets/Fonts/Exo2-Variable.ttf#Exo 2</FontFamily>
    <FontFamily x:Key="ThemeBodyFont">/Assets/Fonts/TitilliumWeb-Regular.ttf#Titillium Web</FontFamily>
    <!-- Inventory slots (InventorySlotGrid), colour-coded by what the slot holds
         like the game's own inventory: technology / product / substance. -->
    <LinearGradientBrush x:Key="ThemeSlotTechBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D92A4A86" Offset="0"/>
        <GradientStop Color="#D9132446" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeSlotProductBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9805A12" Offset="0"/>
        <GradientStop Color="#D9402B08" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ThemeSlotSubstanceBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D9155C58" Offset="0"/>
        <GradientStop Color="#D90A302E" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ThemeSlotEmptyBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ThemeSlotLockedBrush" Color="#59000000"/>
    <SolidColorBrush x:Key="ThemeSlotBorderBrush" Color="#40FFC62E"/>
    <SolidColorBrush x:Key="ThemeSlotLockedBorderBrush" Color="#8C5A3C3C"/>
    <SolidColorBrush x:Key="ThemeSlotLabelBackgroundBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="ThemeSuperchargedBrush" Color="#FFB21E"/>
    <!-- Station tool card stats: damage warm, scanner cool; accent is gold here, so neither reuses it. -->
    <SolidColorBrush x:Key="ThemeDamageStatBrush" Color="#FF9E6B"/>
    <SolidColorBrush x:Key="ThemeScannerStatBrush" Color="#6FD8FF"/>
    <SolidColorBrush x:Key="ThemeDamagedBrush" Color="#FF3B3B"/>
    <CornerRadius x:Key="ThemeSlotCornerRadius">6</CornerRadius>

    <!-- App frame: title bar + nav pane share the opaque chrome colour. -->
    <SolidColorBrush x:Key="ThemeChromeBrush" Color="#08090F"/>

    <!-- WinUI built-in keys, overridden so the whole frame follows the theme.
         Plain keys in this later-merged dictionary win over XamlControlsResources'
         own theme dictionaries; App.xaml must NOT redefine them at its root,
         since root keys beat every merged dictionary. Most pages paint their
         root with ApplicationPageBackgroundThemeBrush, so this gives every page
         the theme's backdrop without touching the page. -->
    <StaticResource x:Key="ApplicationPageBackgroundThemeBrush" ResourceKey="ThemePageBackdropBrush"/>
    <StaticResource x:Key="NavigationViewDefaultPaneBackground" ResourceKey="ThemeChromeBrush"/>
    <StaticResource x:Key="NavigationViewExpandedPaneBackground" ResourceKey="ThemeChromeBrush"/>
    <StaticResource x:Key="NavigationViewTopPaneBackground" ResourceKey="ThemeChromeBrush"/>
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#FFC62E"/>
</ResourceDictionary>
