<?xml version="1.0" encoding="utf-8"?>
<!-- The Multi-Tool / Starships selector strip (EquipmentChipViewModel): one button per
     item with CORVETTE / ACTIVE / NEW pills, faded GONE leftovers and empty slots. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.EquipmentStrip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <Style x:Key="PillTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
            <Setter Property="CharacterSpacing" Value="120"/>
        </Style>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{x:Bind Items, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:EquipmentChipViewModel">
                <Button Click="Chip_Click" Loaded="Chip_Loaded" Padding="12,6,12,6"
                        Background="{x:Bind Background}" BorderBrush="{x:Bind Border}" BorderThickness="{x:Bind BorderThickness}"
                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Opacity="{x:Bind Opacity}"
                        ToolTipService.ToolTip="{x:Bind Tip}" AutomationProperties.Name="{x:Bind AutomationName}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="11" Visibility="{x:Bind IsEmptySlot}"/>
                        <TextBlock Text="{x:Bind Name}" FontWeight="{x:Bind NameWeight}" VerticalAlignment="Center" Visibility="{x:Bind IsItem}"/>
                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" Visibility="{x:Bind IsEmptySlot}"/>
                        <TextBlock Text="{x:Bind Name}" TextDecorations="Strikethrough" VerticalAlignment="Center" Visibility="{x:Bind IsGone}"/>

                        <!-- Corvettes are built, not found: their modules live in a separate build. -->
                        <Border Visibility="{x:Bind IsCorvette}" BorderBrush="{ThemeResource ThemeAccentBrush}" BorderThickness="1"
                                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="6,1,6,1" VerticalAlignment="Center">
                            <TextBlock Text="CORVETTE" Style="{StaticResource PillTextStyle}" Foreground="{ThemeResource ThemeAccentBrush}"/>
                        </Border>
                        <!-- The one the game has in hand / is flying; independent of which is selected here. -->
                        <Border Visibility="{x:Bind IsActive}" Background="{ThemeResource ThemeDoneBrush}"
                                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="6,1,6,1" VerticalAlignment="Center">
                            <TextBlock Text="ACTIVE" Style="{StaticResource PillTextStyle}" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                        </Border>
                        <Border Visibility="{x:Bind IsNew}" Background="{ThemeResource ThemeAccentBrush}"
                                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="6,1,6,1" VerticalAlignment="Center">
                            <TextBlock Text="NEW" Style="{StaticResource PillTextStyle}" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                        </Border>
                        <Border Visibility="{x:Bind IsGone}" Background="{ThemeResource ThemeLineBrush}"
                                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="6,1,6,1" VerticalAlignment="Center">
                            <TextBlock Text="GONE" Style="{StaticResource PillTextStyle}" Foreground="{ThemeResource ThemeTextBrush}"/>
                        </Border>
                    </StackPanel>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
