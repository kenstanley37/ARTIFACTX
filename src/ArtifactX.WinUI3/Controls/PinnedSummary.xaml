<?xml version="1.0" encoding="utf-8"?>
<!-- The two-line summary in a page's pinned top bar (Planet Details, Current System): what the page is
     about, shown once the page's own header card has scrolled out of view (IsShown, set by the page). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PinnedSummary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel x:Name="Root" Spacing="1" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
        <StackPanel.OpacityTransition>
            <ScalarTransition Duration="0:0:0.15"/>
        </StackPanel.OpacityTransition>
        <TextBlock x:Name="TitleLine" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1">
            <Run Text="{x:Bind Title, Mode=OneWay}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold" FontSize="16"
                 Foreground="{ThemeResource ThemeTextBrush}"/><Run Text="{x:Bind AccentSeparator, Mode=OneWay}" FontSize="14"
                 Foreground="{ThemeResource ThemeTextDimBrush}"/><Run Text="{x:Bind Accent, Mode=OneWay}" FontFamily="{ThemeResource ThemeDisplayFont}"
                 FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource ThemeAccentBrush}"/>
        </TextBlock>
        <TextBlock x:Name="DetailsLine" Text="{x:Bind Details, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1"/>
    </StackPanel>
</UserControl>
