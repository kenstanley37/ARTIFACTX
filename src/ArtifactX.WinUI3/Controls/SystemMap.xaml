<?xml version="1.0" encoding="utf-8"?>
<!-- The current system as an orrery (SystemMap.xaml.cs): star in the middle, planets on rings; drag to turn, right-drag to move, wheel to zoom. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.SystemMap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="Stage" Background="Transparent" ManipulationMode="None"
                AutomationProperties.Name="System map: the star with its planets and moons on their orbits. Drag to turn, right-drag to move, use the mouse wheel to zoom, click a planet to open it. Arrow keys turn, plus and minus zoom, Home looks straight down again."/>
        <TextBlock Text="Drag to turn · right-drag to move · wheel to zoom · click a planet to open it" Style="{StaticResource ThemeDimTextStyle}"
                   FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,110,8" IsHitTestVisible="False"/>
        <Button Content="Top-down" Click="TopDown_Click" Padding="10,2" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,6"
                AutomationProperties.Name="Look straight down on the system map again"
                ToolTipService.ToolTip="Look straight down on the system again (Home)"/>
    </Grid>
</UserControl>
