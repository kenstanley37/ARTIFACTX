<?xml version="1.0" encoding="utf-8"?>
<!-- The current system's planets and moons in 3D (SystemMap.xaml.cs): drag to turn, right-drag to move, wheel to zoom. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.SystemMap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Canvas x:Name="Stage" Background="Transparent" ManipulationMode="None"
                AutomationProperties.Name="System map. Drag to turn, right-drag to move, use the mouse wheel to zoom, click a planet to open it. Arrow keys turn, plus and minus zoom, Home returns to where you are."/>
        <TextBlock Text="Drag to turn · right-drag to move · wheel to zoom · click a planet to open it" Style="{StaticResource ThemeDimTextStyle}"
                   FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,10,8" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
