<?xml version="1.0" encoding="utf-8"?>
<!-- A creature's pet-battle panel (CreatureBattleViewModel), laid out like the analysis visor's Trait Potential panel:
     the stats players pick arena pets by, in the game's class colours. Used on creature cards and the Creature Finder. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.CreatureBattlePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels">

    <Border x:Name="Root" Padding="10,8"
            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Background="{ThemeResource ThemePanelAltBrush}"
            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
            AutomationProperties.Name="{x:Bind Battle.AutomationName, Mode=OneWay, FallbackValue=''}">
        <StackPanel Spacing="6">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="28" Height="28" CornerRadius="4" Background="{x:Bind Battle.PotentialBrush, Mode=OneWay}">
                    <TextBlock Text="{x:Bind Battle.Potential, Mode=OneWay}" FontSize="16" FontWeight="Bold"
                               FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Grid.Column="1" Text="{x:Bind Battle.Heading, Mode=OneWay}"
                           Style="{StaticResource ThemeEyebrowStyle}" FontSize="10" VerticalAlignment="Center"
                           TextWrapping="WrapWholeWords"/>
                <Border Grid.Column="2" Visibility="{x:Bind Battle.HasElement, Mode=OneWay}"
                        CornerRadius="4" Padding="6,2" BorderThickness="1" BorderBrush="{ThemeResource ThemeLineBrush}"
                        Background="{ThemeResource ThemeVoidBrush}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Battle.Element, Mode=OneWay}" FontSize="11"
                               FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                </Border>
            </Grid>
            <ItemsControl ItemsSource="{x:Bind Battle.Stats, Mode=OneWay}" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="explore:BattleStatRow">
                        <Grid Margin="0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Width="22" Height="20" CornerRadius="3" Background="{x:Bind Brush}">
                                <TextBlock Text="{x:Bind Letter}" FontSize="12" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
