<?xml version="1.0" encoding="utf-8"?>
<!-- An item's picture at the game's own size (#10, FullSizeIconService), shown in a dialog from a slot's menu.
     The catalog's small icon shows at once; the full-size one replaces it when it has been read. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.ItemPictureView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="10" HorizontalAlignment="Center">
        <Border Width="400" Height="400" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
            <Image x:Name="Picture" Stretch="Uniform" Margin="12"/>
        </Border>
        <TextBlock x:Name="StatusTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                   HorizontalAlignment="Center" MaxWidth="400"/>
    </StackPanel>
</UserControl>
