<?xml version="1.0" encoding="utf-8"?>
<!-- One kind of creature's 3D model (CreatureKindPreview): the Creature Finder shows the kind picked in its Kind filter
     here, once, instead of a model on every card. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.CreatureKindPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls">

    <Border CornerRadius="6" Background="{ThemeResource ThemePanelAltBrush}"
            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
        <controls:ShipPreview x:Name="Preview" Height="140" Width="248" PixelWidth="248" PixelHeight="140" FitToSize="True"
                              AutomationProperties.Name="{x:Bind PreviewName}"/>
    </Border>
</UserControl>
