<UserControl x:Class="ArtifactX.WinUI3.Controls.IngredientSourcePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="using:ArtifactX.WinUI3.Services">
 <!-- Where an ingredient comes from, then the closest systems that have it (only for what planets give). Hidden when nothing is known. -->
 <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.PlacesVisibility, Mode=OneWay}">
  <TextBlock Text="WHERE TO FIND IT" Style="{StaticResource ThemeEyebrowStyle}"/>
  <ItemsControl ItemsSource="{x:Bind ViewModel.Places}" IsTabStop="False">
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="x:String">
     <Border Margin="0,3" Padding="10,8" CornerRadius="6" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
      <TextBlock Text="{x:Bind}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ClosestVisibility, Mode=OneWay}">
    <!-- The ring sits beside the heading and keeps its space when idle, so a new search (the player jumped) moves nothing. -->
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
     <TextBlock Text="CLOSEST TO YOU" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
     <ProgressRing IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="14" Height="14" VerticalAlignment="Center"
      AutomationProperties.Name="Searching the star systems around you"/>
    </StackPanel>
    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
     Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
    <ItemsControl ItemsSource="{x:Bind ViewModel.Closest}" IsTabStop="False">
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="services:IngredientPlace">
       <Border Margin="0,3" Padding="10,8" CornerRadius="6" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
        AutomationProperties.Name="{x:Bind AccessibleName}">
        <Grid ColumnSpacing="10">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="2">
          <TextBlock Text="{x:Bind SystemName}" Foreground="{ThemeResource ThemeTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
          <ItemsControl ItemsSource="{x:Bind Bodies}" IsTabStop="False">
           <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="services:IngredientBody">
             <StackPanel Margin="0,4,0,0">
              <TextBlock Text="{x:Bind Planet}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="13" TextWrapping="Wrap"/>
              <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind HasDetail}" Foreground="{ThemeResource ThemeTextDimBrush}" FontSize="12" TextWrapping="Wrap"/>
             </StackPanel>
            </DataTemplate>
           </ItemsControl.ItemTemplate>
          </ItemsControl>
  </StackPanel>
       </StackPanel>
       <TextBlock Grid.Column="1" Text="{x:Bind Distance}" Foreground="{ThemeResource ThemeAccentBrush}" FontSize="12"/>
      </Grid>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </StackPanel>
</UserControl>
