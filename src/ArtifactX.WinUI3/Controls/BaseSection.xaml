<?xml version="1.0" encoding="utf-8"?>
<!-- One folding section of the Bases page (BaseSectionViewModel): a header that opens
     and closes it, Select all / Deselect where its rows can be deleted, and its cards. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.BaseSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Visibility="{x:Bind Section.IsShown, Mode=OneWay}">

    <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
            Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
        <StackPanel>
            <Button Click="Header_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Background="Transparent" BorderThickness="0" Padding="14,10"
                    AutomationProperties.Name="{x:Bind Section.Title, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Section.Glyph, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Section.Title, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Border Background="{ThemeResource ThemeVoidBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Section.CountLabel, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind Section.Summary, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                    <FontIcon Grid.Column="3" Glyph="{x:Bind Section.ChevronGlyph, Mode=OneWay}" FontSize="12"
                              Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Button>

            <StackPanel Spacing="10" Padding="14,4,14,14" Visibility="{x:Bind Section.IsExpanded, Mode=OneWay}">
                <!-- Claimed stations: what their default furniture costs, and clearing it in one go (#28). -->
                <StackPanel Visibility="{x:Bind Section.ShowFreeable, Mode=OneWay}" Spacing="6">
                    <TextBlock Text="{x:Bind Section.FreeableText, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Click="ClearFurniture_Click" HorizontalAlignment="Left" IsEnabled="{x:Bind Section.CanClear, Mode=OneWay}"
                            Foreground="{ThemeResource ThemeWarningBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}"
                            AutomationProperties.Name="{x:Bind Section.ClearAllLabel, Mode=OneWay}"
                            ToolTipService.ToolTip="Removes only the default furniture claims come with. Stations' structure and anything you built or moved stay.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                            <TextBlock Text="{x:Bind Section.ClearAllLabel, Mode=OneWay}"/>
                        </StackPanel>
                    </Button>
                    <ProgressRing IsActive="{x:Bind Section.IsClearing, Mode=OneWay}" Visibility="{x:Bind Section.IsClearing, Mode=OneWay}" Width="20" Height="20"/>
                    <TextBlock Text="Clearing..." Visibility="{x:Bind Section.IsClearing, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Section.ShowSelectionBar, Mode=OneWay}">
                    <Button Content="Select all" Click="SelectAll_Click" Padding="10,4" FontSize="11"/>
                    <Button Content="Deselect" Click="DeselectAll_Click" Padding="10,4" FontSize="11"/>
                </StackPanel>
                <ItemsControl ItemsSource="{x:Bind Section.Items, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:BaseRowViewModel">
                            <controls:BaseCard Row="{x:Bind}" OpenRequested="Card_OpenRequested"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{x:Bind Section.EmptyText, Mode=OneWay}" Visibility="{x:Bind Section.ShowEmpty, Mode=OneWay}"
                           Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
