<UserControl x:Class="ArtifactX.WinUI3.Controls.IndustrialCleanupPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:ArtifactX.WinUI3.Controls"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels">
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel Padding="28,26,28,24" Spacing="16">
   <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="30" FontWeight="Bold" Foreground="{ThemeResource ThemeTextBrush}"/>
   <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
   <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
   <local:FoldingCard Title="FINDING SCRAP AND WASTE">
    <StackPanel Padding="18" Spacing="10">
     <TextBlock Text="{x:Bind ViewModel.FindingTitle, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}"/>
     <TextBlock Text="{x:Bind ViewModel.FindingText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
    </StackPanel>
   </local:FoldingCard>
   <TextBlock Text="GETTING STARTED" Style="{StaticResource ThemeEyebrowStyle}"/>
   <ItemsRepeater ItemsSource="{x:Bind ViewModel.Instructions}">
    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="340" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout>
    <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:CleanupInstructionViewModel">
     <Border Style="{StaticResource ThemeCardStyle}" Padding="16">
      <StackPanel Spacing="12">
       <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}"/>
       <TextBlock Text="{x:Bind Text, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsRepeater.ItemTemplate>
   </ItemsRepeater>
   <local:FoldingCard Title="LIFETIME RECOVERY">
    <StackPanel Padding="18" Spacing="12">
     <TextBlock Text="{x:Bind ViewModel.ProgressMessage, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
     <ItemsRepeater ItemsSource="{x:Bind ViewModel.Counters}">
      <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="200" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout>
      <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:CleanupProgressViewModel">
       <Border Style="{StaticResource ThemeCardStyle}" Padding="12"><Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
        <TextBlock Grid.Row="1" Text="{x:Bind Progress, Mode=OneWay}" FontSize="24" Foreground="{ThemeResource ThemeAccentBrush}"/>
       </Grid></Border>
      </DataTemplate></ItemsRepeater.ItemTemplate>
     </ItemsRepeater>
    </StackPanel>
   </local:FoldingCard>
   <local:FoldingCard Title="COLOSSUS REWARD REQUIREMENTS" IsExpanded="False">
    <StackPanel Padding="18" Spacing="12">
     <TextBlock Text="Meeting a requirement does not confirm that the game granted the part. Manage unlocks on the Exocraft page." TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
     <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rewards}">
      <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="300" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill"/></ItemsRepeater.Layout>
      <ItemsRepeater.ItemTemplate><DataTemplate x:DataType="vm:CleanupProgressViewModel">
       <Border Style="{StaticResource ThemeCardStyle}" Padding="12"><Grid RowSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}"/>
        <TextBlock Grid.Row="1" Text="{x:Bind Requirement, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
        <TextBlock Grid.Row="2" Text="{x:Bind Progress, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeDoneBrush}"/>
       </Grid></Border>
      </DataTemplate></ItemsRepeater.ItemTemplate>
     </ItemsRepeater>
    </StackPanel>
   </local:FoldingCard>
  </StackPanel>
 </ScrollViewer>
</UserControl>
