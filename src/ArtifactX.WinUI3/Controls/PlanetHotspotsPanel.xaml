<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetHotspotsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <controls:FoldingCard Title="PLANETARY HOTSPOTS (SURVEY DEVICE)" SettingKey="PlanetDetailsHotspotsCollapsed"
                          Visibility="{x:Bind ViewModel.HasHotspots, Mode=OneWay}">
        <Border Style="{StaticResource ThemeCardStyle}">
            <StackPanel Padding="18,14,18,16" Spacing="14">

                <!-- Header / Subtitle Info -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="DEEP-LEVEL RESOURCE EXTRACTION SITES" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.ReferenceLocationLabel, Mode=OneWay}"
                                   Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20" VerticalAlignment="Center"/>
                </Grid>

                <!-- Mode & Toolbar Row -->
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- View Mode Selector: All Sites, Base Combos, Near Portal (base spots that also reach the portal) -->
                    <RadioButtons ItemsSource="{x:Bind ViewModel.ViewModeChoices}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedViewModeIndex, Mode=TwoWay}"
                                  MaxColumns="3" VerticalAlignment="Center"
                                  AutomationProperties.Name="Show all hotspots, multi-hotspot base combos, or base spots near the portal"/>

                    <!-- Search Box -->
                    <TextBox Grid.Column="1" PlaceholderText="Search resources (e.g. Indium, Oxygen, Power...)"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Right"
                             AutomationProperties.Name="Search hotspots by resource name"/>

                    <!-- Sort ComboBox -->
                    <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.SortChoices}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                              VerticalAlignment="Center" MinWidth="180"
                              AutomationProperties.Name="Sort hotspots"/>
                </Grid>

                <!-- Filter Row (Single Sites View Only) -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsSingleSitesView, Mode=OneWay}">
                    <RadioButtons Header="Filter" MaxColumns="5"
                                  ItemsSource="{x:Bind ViewModel.FilterChoices}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Filter hotspots by type or class"/>
                </StackPanel>

                <!-- Status / Count Label -->
                <TextBlock Text="{x:Bind ViewModel.TotalCountLabel, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsSingleSitesView, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource ThemeTextBrush}"/>

                <TextBlock Text="{x:Bind ViewModel.ClusterCountLabel, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsClustersView, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>

                <!-- 1. Single Hotspot Cards Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Hotspots, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSingleSitesView, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explore:PlanetHotspotItemViewModel">
                            <Border Width="370" MinHeight="185" Padding="14,12" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{x:Bind CardBackground, Mode=OneWay}"
                                    BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                    BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Category Icon & Badge, Coordinates, Pin -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Kind Badge -->
                                        <Border Background="{ThemeResource ThemePanelAltBrush}"
                                                BorderBrush="{ThemeResource ThemeLineBrush}"
                                                BorderThickness="1" Padding="6,2"
                                                CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                <TextBlock Text="{x:Bind Kind}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ThemeTextBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Coordinates with Copy Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Coordinates}" FontSize="12" FontWeight="Bold"
                                                       FontFamily="{ThemeResource ThemeDisplayFont}"
                                                       Foreground="{ThemeResource ThemeAccentBrush}"
                                                       VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                            <controls:CopyCodeButton Code="{x:Bind Coordinates}" Padding="6,2" Content="Copy" FontSize="11"/>
                                        </StackPanel>

                                        <!-- Pin Button -->
                                        <Button Grid.Column="2" Command="{x:Bind TogglePinCommand}" Padding="6,2" FontSize="11"
                                                Background="{x:Bind PinButtonBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind PinButtonBorderBrush, Mode=OneWay}"
                                                BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE718;" FontSize="11" Foreground="{x:Bind PinForeground, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind PinButtonText, Mode=OneWay}" FontSize="11"
                                                           Foreground="{x:Bind PinForeground, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- Middle Row: Class Badge + Resource Name -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{x:Bind ClassBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ClassBadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       FontFamily="{ThemeResource ThemeDisplayFont}"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind ResourceName}" FontSize="15" FontWeight="SemiBold"
                                                   FontFamily="{ThemeResource ThemeDisplayFont}"
                                                   Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Distance & Yield/Density -->
                                    <StackPanel Grid.Row="2" Spacing="3">
                                        <TextBlock Text="{x:Bind FullDistanceLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ThemeDoneBrush}"/>
                                        <TextBlock Text="{x:Bind YieldLabel}" FontSize="11"
                                                   Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    </StackPanel>

                                    <!-- Actions Row: Add Marker / Undo -->
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind AddMarkerText, Mode=OneWay}"
                                                Command="{x:Bind AddMarkerCommand}"
                                                IsEnabled="{x:Bind CanAddMarker, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="{x:Bind MarkerStatus, Mode=OneWay}"
                                                AutomationProperties.Name="Place Save Beacon in save"/>
                                        <Button Grid.Column="1" Content="{x:Bind RemoveButtonText, Mode=OneWay}"
                                                Command="{x:Bind UndoMarkerCommand}"
                                                Visibility="{x:Bind CanUndoMarker, Mode=OneWay}"
                                                IsEnabled="{x:Bind CanRemoveMarker, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind MarkerStatus, Mode=OneWay}"
                                                AutomationProperties.Name="Remove Save Beacon"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. Multi-Hotspot Base Clusters & Combos Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Clusters, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsClustersView, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explore:PlanetHotspotClusterItemViewModel">
                            <Border Width="460" Padding="16,14" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{x:Bind CardBackground, Mode=OneWay}"
                                    BorderBrush="{x:Bind CardBorderBrush, Mode=OneWay}"
                                    BorderThickness="{x:Bind CardBorderThickness, Mode=OneWay}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: what this spot reaches, and Pin -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{x:Bind BadgeBrush}"
                                                BorderThickness="1" Padding="8,3" HorizontalAlignment="Left"
                                                CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind ComboGlyph}" FontSize="12" Foreground="{x:Bind BadgeBrush}"/>
                                                <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="Bold" Foreground="{x:Bind BadgeBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Button Grid.Column="1" Command="{x:Bind TogglePinCommand}" Padding="8,3" FontSize="12"
                                                Background="{x:Bind PinButtonBackground, Mode=OneWay}"
                                                BorderBrush="{x:Bind PinButtonBorderBrush, Mode=OneWay}" BorderThickness="1"
                                                ToolTipService.ToolTip="{x:Bind PinTooltip, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind PinTooltip, Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE718;" FontSize="12" Foreground="{x:Bind PinForeground, Mode=OneWay}"/>
                                                <TextBlock Text="{x:Bind PinButtonText, Mode=OneWay}" FontSize="12" Foreground="{x:Bind PinForeground, Mode=OneWay}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- The hotspots as a table: name on the left; yield and distances in columns on the right.
                                         Fixed column widths keep the numbers lined up from row to row. -->
                                    <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Top">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="64"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="HOTSPOT" Style="{StaticResource ThemeEyebrowStyle}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="YIELD" Style="{StaticResource ThemeEyebrowStyle}" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="2" Text="FROM BASE" Style="{StaticResource ThemeEyebrowStyle}" FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Grid.Column="3" Text="FROM PORTAL" Style="{StaticResource ThemeEyebrowStyle}" FontSize="12" HorizontalAlignment="Right"
                                                       Visibility="{x:Bind HasPortalColumn}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{x:Bind Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="explore:ClusterHotspotRow">
                                                    <Grid Padding="0,4" ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Details}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="64"/>
                                                            <ColumnDefinition Width="72"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Background="{x:Bind Hotspot.ClassBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind Hotspot.ClassBadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                                           FontFamily="{ThemeResource ThemeDisplayFont}"/>
                                                            </Border>
                                                            <FontIcon Glyph="{x:Bind Hotspot.KindGlyph}" FontSize="13"
                                                                      Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{x:Bind Hotspot.ResourceName}" FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Yield}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{x:Bind FromBase}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{x:Bind FromPortal}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Where to build: the base computer spot (the Save Beacon goes here), and how far it is from the portal -->
                                    <Border Grid.Row="2" Background="{ThemeResource ThemePanelAltBrush}"
                                            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                            Padding="12,10" CornerRadius="4">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BASE COMPUTER" Style="{StaticResource ThemeEyebrowStyle}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind BaseCoordinates}" FontSize="14" FontWeight="Bold"
                                                           FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeAccentBrush}"
                                                           VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                                <controls:CopyCodeButton Grid.Column="2" Code="{x:Bind BaseCoordinates}" Padding="8,2" Content="Copy" FontSize="12"/>
                                                <TextBlock Grid.Column="3" Text="{x:Bind PortalDistanceLabel}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Visibility="{x:Bind HasPortalDistance, Mode=OneWay}"/>
                                            </Grid>
                                            <TextBlock Text="{x:Bind SpareText}" FontSize="13" Foreground="{x:Bind SpareBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions: Save Beacon at the base computer spot (near the portal, also a portal marker) / Undo -->
                                    <Grid Grid.Row="3" ColumnSpacing="8" VerticalAlignment="Bottom">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind AddMarkerText, Mode=OneWay}"
                                                Command="{x:Bind AddMarkerCommand}"
                                                IsEnabled="{x:Bind CanAddMarker, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="{x:Bind MarkerStatus, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind AddMarkerText, Mode=OneWay}"/>
                                        <Button Grid.Column="1" Content="{x:Bind RemoveButtonText, Mode=OneWay}"
                                                Command="{x:Bind UndoMarkerCommand}"
                                                Visibility="{x:Bind CanUndoMarker, Mode=OneWay}"
                                                IsEnabled="{x:Bind CanRemoveMarker, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind MarkerStatus, Mode=OneWay}"
                                                AutomationProperties.Name="Remove Save Beacon"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
