<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetHotspotsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <controls:FoldingCard Title="PLANETARY HOTSPOTS (SURVEY DEVICE)" SettingKey="PlanetDetailsHotspotsCollapsed"
                          Visibility="{x:Bind ViewModel.HasHotspots, Mode=OneWay}">
        <Border Style="{StaticResource ThemeCardStyle}">
            <StackPanel Padding="18,14,18,16" Spacing="14">

                <!-- Header / Subtitle Info -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="DEEP-LEVEL RESOURCE EXTRACTION SITES" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.ReferenceLocationLabel, Mode=OneWay}"
                                   Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="20" Height="20" VerticalAlignment="Center"/>
                </Grid>

                <!-- Mode & Toolbar Row -->
                <Grid ColumnSpacing="12" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- View Mode Selector: All Sites vs Base Clusters -->
                    <RadioButtons ItemsSource="{x:Bind ViewModel.ViewModeChoices}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedViewModeIndex, Mode=TwoWay}"
                                  MaxColumns="2" VerticalAlignment="Center"
                                  AutomationProperties.Name="Switch between individual sites and multi-hotspot base clusters"/>

                    <!-- Search Box -->
                    <TextBox Grid.Column="1" PlaceholderText="Search resources (e.g. Indium, Oxygen, Power...)"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" MaxWidth="320" HorizontalAlignment="Right"
                             AutomationProperties.Name="Search hotspots by resource name"/>

                    <!-- Sort ComboBox -->
                    <ComboBox Grid.Column="2" ItemsSource="{x:Bind ViewModel.SortChoices}"
                              SelectedIndex="{x:Bind ViewModel.SelectedSortIndex, Mode=TwoWay}"
                              VerticalAlignment="Center" MinWidth="180"
                              AutomationProperties.Name="Sort hotspots"/>
                </Grid>

                <!-- Filter Row (Single Sites View Only) -->
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.IsSingleSitesView, Mode=OneWay}">
                    <RadioButtons Header="Filter" MaxColumns="5"
                                  ItemsSource="{x:Bind ViewModel.FilterChoices}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedFilterIndex, Mode=TwoWay}"
                                  AutomationProperties.Name="Filter hotspots by type or class"/>
                </StackPanel>

                <!-- Status / Count Label -->
                <TextBlock Text="{x:Bind ViewModel.TotalCountLabel, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsSingleSitesView, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource ThemeTextBrush}"/>

                <TextBlock Text="{x:Bind ViewModel.ClusterCountLabel, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsClustersView, Mode=OneWay}"
                           FontSize="12" Foreground="{ThemeResource ThemeTextBrush}"/>

                <!-- 1. Single Hotspot Cards Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Hotspots, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsSingleSitesView, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explore:PlanetHotspotItemViewModel">
                            <Border Width="370" Padding="14,12" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{ThemeResource ThemeVoidBrush}"
                                    BorderBrush="{ThemeResource ThemeLineBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Category Icon & Badge, Coordinates -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Kind Badge -->
                                        <Border Background="{ThemeResource ThemePanelAltBrush}"
                                                BorderBrush="{ThemeResource ThemeLineBrush}"
                                                BorderThickness="1" Padding="6,2"
                                                CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="{x:Bind KindGlyph}" FontSize="11" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                <TextBlock Text="{x:Bind Kind}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource ThemeTextBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Coordinates with Copy Button -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Coordinates}" FontSize="12" FontWeight="Bold"
                                                       FontFamily="{ThemeResource ThemeDisplayFont}"
                                                       Foreground="{ThemeResource ThemeAccentBrush}"
                                                       VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                            <controls:CopyCodeButton Code="{x:Bind Coordinates}" Padding="6,2" Content="Copy" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Middle Row: Class Badge + Resource Name -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Border Background="{x:Bind ClassBrush}" CornerRadius="4" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind ClassBadgeText}" FontSize="11" FontWeight="Bold" Foreground="White"
                                                       FontFamily="{ThemeResource ThemeDisplayFont}"/>
                                        </Border>
                                        <TextBlock Text="{x:Bind ResourceName}" FontSize="15" FontWeight="SemiBold"
                                                   FontFamily="{ThemeResource ThemeDisplayFont}"
                                                   Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Distance & Yield/Density -->
                                    <StackPanel Grid.Row="2" Spacing="3">
                                        <TextBlock Text="{x:Bind FullDistanceLabel}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ThemeDoneBrush}"/>
                                        <TextBlock Text="{x:Bind YieldLabel}" FontSize="11"
                                                   Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    </StackPanel>

                                    <!-- Actions Row: Add Marker / Undo -->
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind AddMarkerText, Mode=OneWay}"
                                                Command="{x:Bind AddMarkerCommand}"
                                                IsEnabled="{x:Bind CanAddMarker, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="{x:Bind MarkerStatus, Mode=OneWay}"
                                                AutomationProperties.Name="Place Save Beacon in save"/>
                                        <Button Grid.Column="1" Content="Undo"
                                                Command="{x:Bind UndoMarkerCommand}"
                                                Visibility="{x:Bind CanUndoMarker, Mode=OneWay}"
                                                AutomationProperties.Name="Undo Save Beacon"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 2. Multi-Hotspot Base Clusters & Combos Grid -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Clusters, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.IsClustersView, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explore:PlanetHotspotClusterItemViewModel">
                            <Border Width="460" Padding="16,14" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{ThemeResource ThemeVoidBrush}"
                                    BorderBrush="{x:Bind CardBorderBrush}"
                                    BorderThickness="{x:Bind CardBorderThickness}">
                                <Grid RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header: Combo Badge, Glyph, and Base Coords -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Combo Title Badge -->
                                        <Border Background="{ThemeResource ThemePanelAltBrush}"
                                                BorderBrush="{x:Bind BadgeBrush}"
                                                BorderThickness="1" Padding="8,3"
                                                CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="{x:Bind ComboGlyph}" FontSize="12" Foreground="{x:Bind BadgeBrush}"/>
                                                <TextBlock Text="{x:Bind Title}" FontSize="11" FontWeight="Bold"
                                                           Foreground="{x:Bind BadgeBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Optimal Base Coordinates -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="11" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind BaseCoordinates}" FontSize="12" FontWeight="Bold"
                                                       FontFamily="{ThemeResource ThemeDisplayFont}"
                                                       Foreground="{ThemeResource ThemeAccentBrush}"
                                                       VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                            <controls:CopyCodeButton Code="{x:Bind BaseCoordinates}" Padding="6,2" Content="Copy" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Hotspot Rows in this Combo -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Hotspots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="explore:PlanetHotspotItemViewModel">
                                                <Grid Padding="0,3" ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Class Badge -->
                                                    <Border Background="{x:Bind ClassBrush}" CornerRadius="3" Padding="5,1" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind ClassBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White"
                                                                   FontFamily="{ThemeResource ThemeDisplayFont}"/>
                                                    </Border>

                                                    <!-- Kind Glyph -->
                                                    <FontIcon Grid.Column="1" Glyph="{x:Bind KindGlyph}" FontSize="12"
                                                              Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>

                                                    <!-- Resource Name -->
                                                    <TextBlock Grid.Column="2" Text="{x:Bind ResourceName}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>

                                                    <!-- Yield / Details -->
                                                    <TextBlock Grid.Column="3" Text="{x:Bind YieldLabel}" FontSize="11"
                                                               Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Optimal Base Computer Site Summary Box -->
                                    <Border Grid.Row="2" Background="{ThemeResource ThemePanelAltBrush}"
                                            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                            Padding="10,8" CornerRadius="4">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{x:Bind ReachDescription}" FontSize="11"
                                                       Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind PortalDistanceLabel}" FontSize="11"
                                                       Foreground="{ThemeResource ThemeDoneBrush}"
                                                       Visibility="{x:Bind HasPortalDistance, Mode=OneWay}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions Row: Add Base Marker / Undo -->
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{x:Bind AddMarkerText, Mode=OneWay}"
                                                Command="{x:Bind AddMarkerCommand}"
                                                IsEnabled="{x:Bind CanAddMarker, Mode=OneWay}"
                                                HorizontalAlignment="Stretch"
                                                ToolTipService.ToolTip="{x:Bind MarkerStatus, Mode=OneWay}"
                                                AutomationProperties.Name="Place Save Beacon at optimal base computer site"/>
                                        <Button Grid.Column="1" Content="Undo"
                                                Command="{x:Bind UndoMarkerCommand}"
                                                Visibility="{x:Bind CanUndoMarker, Mode=OneWay}"
                                                AutomationProperties.Name="Undo Save Beacon"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
