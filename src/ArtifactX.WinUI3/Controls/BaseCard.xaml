<?xml version="1.0" encoding="utf-8"?>
<!-- One base, settlement or placed object on the Bases page (BaseRowViewModel):
     its picture, where it is, what's recorded about the area and its portal glyphs. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.BaseCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls">

    <Border Width="420"
            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
            Background="{ThemeResource ThemePanelAltBrush}"
            CornerRadius="{ThemeResource ThemeCardCornerRadius}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Always 170 px, picture or not, so the text lines up across a row of cards (user,
                 2026-10-21); without a picture it says how to get one. -->
            <Grid Height="170" CornerRadius="7,7,0,0" Background="{ThemeResource ThemeVoidBrush}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24,0">
                    <FontIcon Glyph="&#xE722;" FontSize="28" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                    <TextBlock Text="{x:Bind Row.PicturePlaceholder, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                </StackPanel>
                <Border Visibility="{x:Bind Row.HasPicture, Mode=OneWay}">
                    <Border.Background>
                        <ImageBrush ImageSource="{x:Bind Row.Picture, Mode=OneWay}" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
            </Grid>
            <Grid Grid.Row="1" RowSpacing="8" Padding="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{x:Bind Row.IsSelected, Mode=TwoWay}" Visibility="{x:Bind Row.CanDelete, Mode=OneWay}"
                              MinWidth="0" Padding="0" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Bind Row.Name, Mode=OneWay}"
                              ToolTipService.ToolTip="Select to delete"/>
                    <Grid Grid.Column="1" Width="28" Height="28" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Ellipse Fill="{x:Bind Row.Swatch, Mode=OneWay}"/>
                        <Image Source="{x:Bind Row.Icon, Mode=OneWay}" Width="24" Height="24"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{x:Bind Row.Name, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind Row.Detail, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Row.PartsLabel, Mode=OneWay}" Foreground="{x:Bind Row.PartsBrush, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Open ›" Click="Open_Click"
                            VerticalAlignment="Top" Padding="8,4" FontSize="11"
                            ToolTipService.ToolTip="Its parts, where it is and its glyphs"/>
                </Grid>

                <TextBlock Grid.Row="1" Text="{x:Bind Row.Facts, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>

                <!-- What you've recorded about the area: you can teleport to a
                     base, so this is often more useful than its glyphs. -->
                <TextBlock Grid.Row="2" Text="{x:Bind Row.AreaLabel, Mode=OneWay}" Opacity="{x:Bind Row.AreaOpacity, Mode=OneWay}"
                           FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           ToolTipService.ToolTip="{x:Bind Row.AreaLabel, Mode=OneWay}" IsTextSelectionEnabled="True"/>

                <TextBlock Grid.Row="3" Text="{x:Bind Row.DistanceLabel, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>

                <Grid Grid.Row="4" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <controls:GlyphStrip Code="{x:Bind Row.PortalCode, Mode=OneWay}" Title="{x:Bind Row.Name, Mode=OneWay}" GlyphSize="24"
                                         VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <controls:CopyCodeButton Grid.Column="1" Code="{x:Bind Row.PortalCode, Mode=OneWay}"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
