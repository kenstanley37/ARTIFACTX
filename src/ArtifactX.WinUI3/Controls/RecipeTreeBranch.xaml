<UserControl x:Class="ArtifactX.WinUI3.Controls.RecipeTreeBranch"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels"
 xmlns:controls="using:ArtifactX.WinUI3.Controls">
 <!-- One tile and, below it, the branches it is made from, indented like a folder tree (owner, 2026-11-13: a
      left-to-right tree ran off the panel on deep recipes). The tile has a fixed height so the connector stub of
      each child lands on its tile's middle (6 px margin + 33 px). -->
 <StackPanel>
  <Button Width="280" Height="66" Padding="10,6" HorizontalContentAlignment="Left"
   Command="{x:Bind Node.Item.SelectCommand, Mode=OneWay}" AutomationProperties.Name="{x:Bind Node.Item.TileName, Mode=OneWay}"
   Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{x:Bind Node.Item.CardBorder, Mode=OneWay}"
   BorderThickness="{x:Bind Node.Item.CardBorderThickness, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Node.Item.Name, Mode=OneWay}">
   <Grid ColumnSpacing="9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="{x:Bind Node.Item.Icon, Mode=OneWay}" Width="34" Height="34" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
     <TextBlock Text="{x:Bind Node.Item.Name, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"
      TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{x:Bind Node.Item.TileStatus, Mode=OneWay}" Foreground="{x:Bind Node.Item.TileStatusBrush, Mode=OneWay}" FontSize="12"/>
    </StackPanel>
   </Grid>
  </Button>
  <!-- The trunk drops from under the parent's icon (10 px padding + half the 34 px icon = 27 px). -->
  <ItemsControl Margin="14,0,0,0" ItemsSource="{x:Bind Node.Children, Mode=OneWay}" Visibility="{x:Bind Node.ChildrenVisibility, Mode=OneWay}" IsTabStop="False">
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="vm:RecipeTreeNode">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <!-- Down to this tile's middle; on past it to the next sibling unless this is the last one. -->
      <Border Width="2" Height="40" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource ThemeLineBrush}"/>
      <Border Width="2" Margin="12,0,0,0" HorizontalAlignment="Left" Background="{ThemeResource ThemeLineBrush}" Visibility="{x:Bind LowerLineVisibility}"/>
      <Border Height="2" Margin="12,38,0,0" VerticalAlignment="Top" Background="{ThemeResource ThemeLineBrush}"/>
      <controls:RecipeTreeBranch Grid.Column="1" Margin="0,6,0,0" Node="{x:Bind}"/>
     </Grid>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </StackPanel>
</UserControl>
