<UserControl x:Class="ArtifactX.WinUI3.Controls.RecipeTreeBranch"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels"
 xmlns:controls="using:ArtifactX.WinUI3.Controls">
 <!-- One tile and, to its right, the branches it is made from, joined by lines (left to right, root first). -->
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Button VerticalAlignment="Center" Width="184" MinHeight="58" Padding="10,8" HorizontalContentAlignment="Left"
   Command="{x:Bind Node.Item.SelectCommand, Mode=OneWay}" AutomationProperties.Name="{x:Bind Node.Item.TileName, Mode=OneWay}"
   Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{x:Bind Node.Item.CardBorder, Mode=OneWay}"
   BorderThickness="{x:Bind Node.Item.CardBorderThickness, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind Node.Item.Name, Mode=OneWay}">
   <Grid ColumnSpacing="9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Image Source="{x:Bind Node.Item.Icon, Mode=OneWay}" Width="34" Height="34" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
     <TextBlock Text="{x:Bind Node.Item.Name, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="13" FontWeight="SemiBold"
      TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
     <TextBlock Text="{x:Bind Node.Item.TileStatus, Mode=OneWay}" Foreground="{x:Bind Node.Item.TileStatusBrush, Mode=OneWay}" FontSize="12"/>
    </StackPanel>
   </Grid>
  </Button>
  <Border Grid.Column="1" Width="24" Height="2" VerticalAlignment="Center" Background="{ThemeResource ThemeLineBrush}"
   Visibility="{x:Bind Node.ChildrenVisibility, Mode=OneWay}"/>
  <ItemsControl Grid.Column="2" VerticalAlignment="Center" ItemsSource="{x:Bind Node.Children, Mode=OneWay}" IsTabStop="False">
   <ItemsControl.ItemTemplate>
    <DataTemplate x:DataType="vm:RecipeTreeNode">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Row="0" Width="2" HorizontalAlignment="Left" Background="{ThemeResource ThemeLineBrush}" Visibility="{x:Bind UpperLineVisibility}"/>
      <Border Grid.Row="1" Width="2" HorizontalAlignment="Left" Background="{ThemeResource ThemeLineBrush}" Visibility="{x:Bind LowerLineVisibility}"/>
      <Border Grid.RowSpan="2" Height="2" VerticalAlignment="Center" Background="{ThemeResource ThemeLineBrush}"/>
      <controls:RecipeTreeBranch Grid.Column="1" Grid.RowSpan="2" Margin="0,5" Node="{x:Bind}"/>
     </Grid>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </Grid>
</UserControl>
