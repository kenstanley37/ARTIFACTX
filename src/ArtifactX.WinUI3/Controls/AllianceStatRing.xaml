<?xml version="1.0" encoding="utf-8"?>
<!-- One alliance stat as the game's Galactic Alliance Details screen draws it: a ringed icon
     with the stat's name and, where the game shows the class, the player's own count.
     TextOnLeft puts the words before the ring (the screen's left column). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.AllianceStatRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="14" AutomationProperties.Name="{x:Bind Stat.AccessibleName, Mode=OneWay}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="LeftText" Grid.Column="0" VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="{x:Bind Stat.Label, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource ThemeAccentBrush}" HorizontalAlignment="Right"/>
            <TextBlock Text="{x:Bind Stat.Value, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right"/>
        </StackPanel>
        <Grid Grid.Column="1" Width="78" Height="78">
            <Ellipse Fill="{ThemeResource ThemeVoidBrush}" Stroke="{ThemeResource ThemeLineBrush}" StrokeThickness="2"/>
            <Ellipse Margin="5" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="3"/>
            <FontIcon Glyph="{x:Bind Stat.Glyph, Mode=OneWay}" FontSize="28" Foreground="{ThemeResource ThemeTextBrush}"/>
        </Grid>
        <StackPanel x:Name="RightText" Grid.Column="2" VerticalAlignment="Center" Spacing="0">
            <TextBlock Text="{x:Bind Stat.Label, Mode=OneWay}" FontSize="15" Foreground="{ThemeResource ThemeAccentBrush}"/>
            <TextBlock Text="{x:Bind Stat.Value, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
        </StackPanel>
    </Grid>
</UserControl>
