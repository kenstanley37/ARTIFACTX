<?xml version="1.0" encoding="utf-8"?>
<!-- Raw save fields with no confirmed in-game effect (CompanionRawFieldViewModel):
     text, choice, flag or hex (+ Active, + Generate), by kind. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.RawFieldsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels">

    <ItemsControl ItemsSource="{x:Bind Rows, Mode=OneWay}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="10"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="viewmodels:CompanionRawFieldViewModel">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{x:Bind Label}" Width="210" VerticalAlignment="Center" Opacity="0.8" FontSize="12" TextWrapping="Wrap"/>
                    <CheckBox Content="Active" Visibility="{x:Bind HasActive}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Click="Flag_Click"/>
                    <CheckBox Visibility="{x:Bind HasFlag}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Click="Flag_Click"
                              AutomationProperties.Name="{x:Bind Label}"/>
                    <TextBox Visibility="{x:Bind HasText}" Width="{x:Bind TextWidth}"
                             Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="Text_LostFocus"
                             AutomationProperties.Name="{x:Bind Label}"/>
                    <ComboBox Visibility="{x:Bind HasChoices}" Width="220" ItemsSource="{x:Bind Choices}"
                              SelectedIndex="{x:Bind ChoiceIndex, Mode=TwoWay}" AutomationProperties.Name="{x:Bind Label}"/>
                    <Button Content="Generate" Visibility="{x:Bind CanGenerate}" Click="Generate_Click"/>
                </StackPanel>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
