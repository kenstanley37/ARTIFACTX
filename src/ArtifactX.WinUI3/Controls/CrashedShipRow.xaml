<?xml version="1.0" encoding="utf-8"?>
<!-- One predicted crashed ship (CrashedShipRowViewModel): name, coordinates, class and type, distance,
     game-style stat bars, and the optional save marker. Used on Planet Details and on Current System planet cards. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.CrashedShipRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid ColumnSpacing="10" RowSpacing="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{x:Bind Row.Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
        <TextBlock Grid.Column="1" Text="{x:Bind Row.Coordinates, Mode=OneWay}" FontSize="12" FontWeight="Bold" FontFamily="{ThemeResource ThemeDisplayFont}"
                   Foreground="{ThemeResource ThemeAccentBrush}" IsTextSelectionEnabled="True" HorizontalAlignment="Right"/>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind Row.Distance, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="4" Margin="0,2,0,2" Visibility="{x:Bind Row.HasStats, Mode=OneWay}">
            <!-- Intrinsic damage bonus -->
            <StackPanel Spacing="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Row.DamageLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeDamageStatBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Row.DamageText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeDamageStatBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Row.DamageBar, Mode=OneWay}" MinHeight="3" Height="3"
                             Foreground="{ThemeResource ThemeDamageStatBrush}" Background="{ThemeResource ThemeTrackBrush}"
                             AutomationProperties.Name="{x:Bind Row.DamageLabel, Mode=OneWay}"/>
            </StackPanel>

            <!-- Intrinsic shield bonus -->
            <StackPanel Spacing="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Row.ShieldLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeScannerStatBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Row.ShieldText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeScannerStatBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Row.ShieldBar, Mode=OneWay}" MinHeight="3" Height="3"
                             Foreground="{ThemeResource ThemeScannerStatBrush}" Background="{ThemeResource ThemeTrackBrush}"
                             AutomationProperties.Name="{x:Bind Row.ShieldLabel, Mode=OneWay}"/>
            </StackPanel>

            <!-- Intrinsic hyperdrive bonus -->
            <StackPanel Spacing="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Row.HyperdriveLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemePurpleSystemBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Row.HyperdriveText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemePurpleSystemBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Row.HyperdriveBar, Mode=OneWay}" MinHeight="3" Height="3"
                             Foreground="{ThemeResource ThemePurpleSystemBrush}" Background="{ThemeResource ThemeTrackBrush}"
                             AutomationProperties.Name="{x:Bind Row.HyperdriveLabel, Mode=OneWay}"/>
            </StackPanel>

            <!-- Maneuverability -->
            <StackPanel Spacing="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Row.ManeuverabilityLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeDoneBrush}"/>
                    <TextBlock Grid.Column="1" Text="{x:Bind Row.ManeuverabilityText, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeDoneBrush}" HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar Minimum="0" Maximum="100" Value="{x:Bind Row.ManeuverabilityBar, Mode=OneWay}" MinHeight="3" Height="3"
                             Foreground="{ThemeResource ThemeDoneBrush}" Background="{ThemeResource ThemeTrackBrush}"
                             AutomationProperties.Name="{x:Bind Row.ManeuverabilityLabel, Mode=OneWay}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{x:Bind Row.Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button Content="{x:Bind Row.AddMarkerText, Mode=OneWay}" Command="{x:Bind Row.AddMarkerCommand, Mode=OneWay}" IsEnabled="{x:Bind Row.CanAddMarker, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Row.AddMarkerName, Mode=OneWay}"
                    ToolTipService.ToolTip="Adds a marker for this crashed ship to your save. Needs No Man's Sky closed; save your changes afterwards."/>
            <Button Content="Undo" Command="{x:Bind Row.UndoMarkerCommand, Mode=OneWay}" Visibility="{x:Bind Row.CanUndoMarker, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Row.UndoMarkerName, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
