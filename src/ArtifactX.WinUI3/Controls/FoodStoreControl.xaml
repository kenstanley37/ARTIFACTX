<?xml version="1.0" encoding="utf-8"?>
<!-- One food store (Cold Storage or Ingredient Storage): the grid, and beside
     it every item it can take (ItemListPanel) - same card pattern as Corvette Cache. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.FoodStoreControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <ctcontrols:WrapPanel HorizontalSpacing="18" VerticalSpacing="18">
        <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel>
                <Border Style="{StaticResource ThemeBandStyle}">
                    <TextBlock x:Name="GridTitleTxt" Style="{StaticResource ThemeBandTextStyle}"/>
                </Border>
                <StackPanel Padding="14,12,14,14" Spacing="10">
                    <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                        <Button Content="Max All Qty" Click="MaxAllQtyBtn_Click"/>
                        <Button Content="Merge Duplicates" Click="MergeDuplicatesBtn_Click"
                                ToolTipService.ToolTip="Combines repeated items into one stack each (up to the item's max) and frees the other slots."/>
                        <Button Content="Sort" Click="SortBtn_Click"
                                ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                        <TextBlock x:Name="ResultTxt" VerticalAlignment="Center" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                    </ctcontrols:WrapPanel>
                    <controls:InventorySlotGrid x:Name="Grid"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Style="{StaticResource ThemeCardStyle}" Width="340" VerticalAlignment="Top">
            <StackPanel>
                <Border Style="{StaticResource ThemeBandStyle}">
                    <TextBlock x:Name="ListTitleTxt" Style="{StaticResource ThemeBandTextStyle}"/>
                </Border>
                <Border Padding="14,12,14,14">
                    <controls:ItemListPanel x:Name="List"/>
                </Border>
            </StackPanel>
        </Border>
    </ctcontrols:WrapPanel>
</UserControl>
