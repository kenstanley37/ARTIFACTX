<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.AppTitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtifactX.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Height="56">

    <UserControl.Resources>
        <!-- Soft highlight pulse behind the active-save label, briefly played
             whenever the active save actually SWITCHES to a different one
             (not on first load, not on every edit-triggered Refresh) - see
             AppTitleBar.xaml.cs's Refresh(). Switching saves previously gave
             no visual feedback beyond this label's text silently changing,
             which read as "nothing happened" (user feedback 2026-08-04). -->
        <Storyboard x:Name="SaveSwitchFlash">
            <DoubleAnimation Storyboard.TargetName="ActiveSaveHighlight" Storyboard.TargetProperty="Opacity"
                              From="0.35" To="0" Duration="0:0:0.9"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="TitleBarLayout" Background="{ThemeResource NmsPaneBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="12">
            <FontIcon Glyph="&#xE7E7;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource NmsAccentBrush}" FontSize="16"/>
            <TextBlock Text="ARTIFACTX"
                       Foreground="{ThemeResource NmsTextPrimary}"
                       FontWeight="SemiBold" FontSize="12" CharacterSpacing="100"/>
            <Grid VerticalAlignment="Center">
                <Border x:Name="ActiveSaveHighlight" Background="{ThemeResource NmsTextPrimary}"
                        CornerRadius="4" Opacity="0" Margin="-6,-3"/>
                <TextBlock x:Name="ActiveSaveTxt" Text="" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource NmsAccentBrush}" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <StackPanel x:Name="CurrencyDisplayRegion" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="💰" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="UnitsTxt" Text="0 UNITS" FontSize="11" FontWeight="Bold" Foreground="#FF9D00" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🧬" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="NanitesTxt" Text="0 NANITES" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🛸" VerticalAlignment="Center" FontSize="12"/>
                <TextBlock x:Name="QuicksilverTxt" Text="0 QUICKSILVER" FontSize="11" FontWeight="Bold" Foreground="#E500FF" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,12,0">
            <TextBlock x:Name="PendingChangesTxt" Text="" FontSize="11" Opacity="0.7"
                       VerticalAlignment="Center" Visibility="Collapsed"/>
            <Button x:Name="ResetBtn" Content="Reset" Click="ResetBtn_Click" Visibility="Collapsed"/>
            <Button x:Name="SaveBtn" Style="{ThemeResource AccentButtonStyle}" Click="SaveBtn_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ProgressRing x:Name="SaveSpinner" IsActive="False" Width="14" Height="14"/>
                    <TextBlock x:Name="SaveBtnText" Text="Save"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Grid.Column="3" Background="Transparent"/>
    </Grid>
</UserControl>