<?xml version="1.0" encoding="utf-8"?>
<!-- Themed. The Frigates page's "Feed Vessel" predictor for the selected organic frigate
     (FrigateFeedingViewModel). Read-only. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.FrigateFeedingPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <Border Style="{StaticResource ThemeCardStyle}" Padding="0">
        <StackPanel>
            <Border Style="{StaticResource ThemeBandStyle}">
                <TextBlock Text="FEED VESSEL" Style="{StaticResource ThemeBandTextStyle}"/>
            </Border>
            <StackPanel Spacing="14" Padding="20,16,20,20">
                <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                           Text="What each food would do to this frigate at the Fleet Command Room's Feed Vessel. Feeding replaces all its traits, the primary one included; the same food does something different to every frigate, so this list is for this one only. Traits gained later from expeditions are not included."/>
                <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                    <ComboBox Header="Best for" Width="200" ItemsSource="{x:Bind ViewModel.StatOptions}"
                              SelectedItem="{x:Bind ViewModel.SortStat, Mode=TwoWay}" AutomationProperties.Name="Sort foods by the stat they raise"/>
                    <TextBox Header="Search" Width="240" PlaceholderText="e.g. Sweetroot"
                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search foods"/>
                    <CheckBox Content="Hide foods the game refuses" IsChecked="{x:Bind ViewModel.HideRefused, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                    <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                               VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                </ctcontrols:WrapPanel>

                <ListView ItemsSource="{x:Bind ViewModel.Foods}" SelectionMode="None" MaxHeight="620">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0,0,0,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:FrigateFoodRowViewModel">
                            <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Background="{ThemeResource ThemePanelAltBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,10"
                                    AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="44" Height="44" Background="{ThemeResource ThemeVoidBrush}" VerticalAlignment="Top">
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="38" Height="38"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{x:Bind Names}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{x:Bind Changes}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="4"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:FrigateStatChangeViewModel">
                                                    <TextBlock Text="{x:Bind Text}" Foreground="{x:Bind Brush}" FontWeight="SemiBold" FontSize="13"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ItemsControl Grid.Column="2" ItemsSource="{x:Bind Traits}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
