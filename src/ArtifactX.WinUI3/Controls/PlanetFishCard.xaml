<?xml version="1.0" encoding="utf-8"?>
<!-- The fish panel on a planet's page (PlanetFishViewModel): progress on this planet
     type's fish, what's still to catch, and what you caught here. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetFishCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels">

    <StackPanel Padding="18,14,18,16" Spacing="10">
        <StackPanel Spacing="2" Visibility="{x:Bind Fish.HasProgress, Mode=OneWay}">
            <TextBlock Text="{x:Bind Fish.ProgressLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ProgressBar Maximum="{x:Bind Fish.ProgressMaximum, Mode=OneWay}" Value="{x:Bind Fish.ProgressValue, Mode=OneWay}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind Fish.ProgressCount, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}"/>
            </Grid>
        </StackPanel>
        <ItemsControl ItemsSource="{x:Bind Fish.Notes, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{x:Bind}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{x:Bind Fish.CaughtHereLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
        <ItemsControl ItemsSource="{x:Bind Fish.Groups, Mode=OneWay}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="explore:FishGroup">
                    <StackPanel Spacing="2" Margin="0,6,0,0">
                        <TextBlock Text="{x:Bind Heading}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Names}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" ToolTipService.ToolTip="{x:Bind Tooltip}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
