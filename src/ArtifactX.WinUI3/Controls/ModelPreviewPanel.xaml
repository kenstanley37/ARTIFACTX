<?xml version="1.0" encoding="utf-8"?>
<!-- A procedural model's 3D preview (freighters first - #25): its scene with the parts its seed
     picks, built from the player's own game files and shown as a hologram scan you can drag to
     turn. Colours aren't shown: a seed's colour rule isn't solved yet (see ShipsPage). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.ModelPreviewPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls">

    <StackPanel Spacing="6">
        <TextBlock Text="PREVIEW" Style="{StaticResource ThemeEyebrowStyle}"/>
        <controls:ShipPreview x:Name="Preview" Height="260"/>
        <TextBlock x:Name="NoteTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="11" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
