<UserControl x:Class="ArtifactX.WinUI3.Controls.RecipePlannerCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels">
 <Button Command="{x:Bind ViewModel.SelectCommand, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.SelectionName, Mode=OneWay}"
  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Width="250" Height="310" Padding="12"
  Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{x:Bind ViewModel.CardBorder, Mode=OneWay}">
  <Grid RowSpacing="7">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource ThemeEyebrowStyle}"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
    <Image Source="{x:Bind ViewModel.Icon, Mode=OneWay}" Width="30" Height="30"/>
    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180"/>
   </StackPanel>
   <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
    <Image Source="{x:Bind ViewModel.StationIcon, Mode=OneWay}" Width="38" Height="38"/>
    <TextBlock Text="{x:Bind ViewModel.Station, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" MaxWidth="180" FontSize="12"/>
   </StackPanel>
   <ItemsControl Grid.Row="3" ItemsSource="{x:Bind ViewModel.Ingredients, Mode=OneWay}">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerItemViewModel">
     <TextBlock Text="{x:Bind Amount}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,3"/>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Border Grid.Row="4" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
    <TextBlock Text="{x:Bind ViewModel.Amount, Mode=OneWay}" Foreground="{ThemeResource ThemeDoneBrush}" FontSize="13" TextWrapping="Wrap"/>
   </Border>
  </Grid>
 </Button>
</UserControl>
