<?xml version="1.0" encoding="utf-8"?>
<!-- A card's band with a fold button and the card's body (Body). Folded, only the band
     shows and names what the card is about ("SHIP DETAILS · THE WRAITH · FIGHTER").
     Open/closed is remembered per SettingKey across visits and app restarts. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.FoldingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Band, then the body in the remaining height: a card given a stretched height (the Ship
         Designer's My designs) lets its body fill and scroll; elsewhere it sizes to the body. -->
    <Border x:Name="Frame">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Style="{StaticResource ThemeBandStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTxt" Style="{StaticResource ThemeBandTextStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SummaryTxt" Grid.Column="1" Margin="12,0" FontSize="12"
                           Foreground="{ThemeResource ThemeBandTextBrush}" Opacity="0.8"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ContentPresenter x:Name="HeaderContentPresenter" Grid.Column="2" VerticalAlignment="Center"/>
                <!-- The negative margin keeps the band as tall as a plain card's band (the text alone). -->
                <Button x:Name="ToggleBtn" Grid.Column="3" Click="Toggle_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="10,4" Margin="0,-6" Content="Hide"/>
            </Grid>
        </Border>
        <ContentPresenter x:Name="BodyPresenter" Grid.Row="1" Content="{x:Bind Body, Mode=OneWay}"/>
    </Grid>
    </Border>
</UserControl>
