<?xml version="1.0" encoding="utf-8"?>
<!-- A card's band with a fold button and the card's body (Body). Folded, only the band
     shows and names what the card is about ("SHIP DETAILS · THE WRAITH · FIGHTER").
     Open/closed is remembered per SettingKey across visits and app restarts. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.FoldingCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <Border Style="{StaticResource ThemeBandStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="HeaderTxt" Style="{StaticResource ThemeBandTextStyle}" VerticalAlignment="Center"/>
                <TextBlock x:Name="SummaryTxt" Grid.Column="1" Margin="12,0" FontSize="12"
                           Foreground="{ThemeResource ThemeBandTextBrush}" Opacity="0.8"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ToggleBtn" Grid.Column="2" Click="Toggle_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="10,4" Content="Hide"/>
            </Grid>
        </Border>
        <ContentPresenter x:Name="BodyPresenter" Content="{x:Bind Body, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
