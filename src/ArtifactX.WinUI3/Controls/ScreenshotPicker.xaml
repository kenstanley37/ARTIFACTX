<?xml version="1.0" encoding="utf-8"?>
<!-- The player's No Man's Sky screenshots from Steam (ScreenshotPickerViewModel), newest first, to pick one. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.ScreenshotPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels">

    <Grid MinWidth="560">
        <ProgressRing IsActive="{x:Bind Picker.IsLoading, Mode=OneWay}" Visibility="{x:Bind Picker.IsLoading, Mode=OneWay}"
                      Width="32" Height="32" HorizontalAlignment="Center" Margin="0,40"/>
        <TextBlock Visibility="{x:Bind Picker.IsEmpty, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="14" TextWrapping="Wrap" Margin="0,12"
                   Text="No No Man's Sky screenshots were found in Steam. Take one in game with F12 or photo mode, or close this and choose From a picture file."/>
        <GridView x:Name="ShotsView" ItemsSource="{x:Bind Picker.Shots}" SelectionMode="Single" SelectionChanged="Shots_SelectionChanged"
                  MaxHeight="520" AutomationProperties.Name="Your No Man's Sky screenshots">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ScreenshotChoiceViewModel">
                    <StackPanel Width="240" Spacing="4" Margin="4" AutomationProperties.Name="{x:Bind AccessibleName}">
                        <Border Height="135" CornerRadius="4" Background="{ThemeResource ThemeVoidBrush}">
                            <Image Source="{x:Bind Thumbnail}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</UserControl>
