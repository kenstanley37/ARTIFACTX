<?xml version="1.0" encoding="utf-8"?>
<!-- System Starships Panel (SystemStarshipsViewModel): shows the native starship models
     for the current star system, with S-Class spawn probabilities, S-Class base stats,
     max slot capacities, class filtering, and 1-click seed copy. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.SystemStarshipsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <controls:FoldingCard Title="{x:Bind Starships.Heading, Mode=OneWay}" Summary="{x:Bind Starships.Subtitle, Mode=OneWay}"
                          SettingKey="SystemStarshipsCollapsed"
                          Visibility="{x:Bind Starships.HasShips, Mode=OneWay}">
        <Border Style="{StaticResource ThemeCardStyle}" Padding="16,12,16,14">
            <StackPanel Spacing="12">
                <!-- S-Class Spawn & Economy Summary Banner -->
                <Border Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,8">
                    <TextBlock Text="{x:Bind Starships.SpawnRulesSummary, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}"
                               FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Filter Pills -->
                <ItemsControl ItemsSource="{x:Bind Starships.FilterOptions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StarshipFilterOption">
                            <Button Click="Filter_Click" Tag="{x:Bind FilterKey}" Padding="10,3"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ThemeLineBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    AutomationProperties.Name="{x:Bind Label}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" VerticalAlignment="Center"/>
                                    <Border CornerRadius="4" Background="{ThemeResource ThemeVoidBrush}" Padding="5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Count}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Starships List -->
                <ItemsControl ItemsSource="{x:Bind Starships.FilteredShips, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:SystemStarshipItemViewModel">
                            <Border Width="375" Padding="12,10" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{x:Bind BadgeBackground}" Padding="6,1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind TypeLabel}" FontSize="10" FontWeight="Bold"
                                                           FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="120"
                                                           Foreground="{x:Bind BadgeForeground}"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind IndexLabel}"
                                                       FontSize="11" Foreground="{ThemeResource ThemeTextFaintBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind SeedHex}" FontSize="11" FontFamily="{ThemeResource ThemeDisplayFont}"
                                                       Foreground="{ThemeResource ThemeTextDimBrush}" CharacterSpacing="30"
                                                       VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DefaultName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ThemeTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SClassStatsSummary}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{x:Bind SClassSlotsSummary}" FontSize="11"
                                                   Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                        <TextBlock Text="{x:Bind SpawnChanceSummary}" FontSize="11"
                                                   Foreground="{ThemeResource ThemeTextDimBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind CopyButtonText, Mode=OneWay}" Click="Copy_Click" Tag="{x:Bind}"
                                            Padding="8,4" VerticalAlignment="Top" FontSize="12"
                                            AutomationProperties.Name="{x:Bind AutomationName}" ToolTipService.ToolTip="{x:Bind TooltipText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
