<?xml version="1.0" encoding="utf-8"?>
<!-- Glyph decoder: paste a portal code someone shared, or a signal booster's galactic
     coordinates, and see the glyphs to dial (NmsPortalCode). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.GlyphDecoder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls">

    <StackPanel Padding="20,16,20,20" Spacing="12">
        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                   Text="Paste a portal code someone shared (like 21BAE0F7D734) or galactic coordinates from a signal booster (like 0F2F:0065:077F:0013) to see the glyphs to dial."/>
        <TextBox x:Name="InputBox" MaxWidth="420" HorizontalAlignment="Left" PlaceholderText="Portal code or galactic coordinates"
                 TextChanged="Input_TextChanged"/>
        <TextBlock x:Name="ErrorTxt" Foreground="{ThemeResource ThemeWarningBrush}" FontSize="13" Visibility="Collapsed" TextWrapping="Wrap"/>
        <StackPanel x:Name="ResultPanel" Spacing="8" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:GlyphStrip x:Name="Glyphs" GlyphSize="40"/>
                <controls:CopyCodeButton x:Name="CopyBtn"/>
            </StackPanel>
            <TextBlock x:Name="DetailTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</UserControl>
