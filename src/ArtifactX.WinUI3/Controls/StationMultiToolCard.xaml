<UserControl x:Class="ArtifactX.WinUI3.Controls.StationMultiToolCard"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:ArtifactX.WinUI3.Controls"
 xmlns:viewModels="using:ArtifactX.WinUI3.ViewModels">
 <Border Style="{StaticResource ThemeCardStyle}" Padding="12">
  <StackPanel Spacing="10">
   <!-- Compact: a small preview beside the details; the full slot grid is opt-in (user, 2026-10-27). -->
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions>
     <ColumnDefinition Width="160"/>
     <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <StackPanel Spacing="2">
     <controls:ShipPreview x:Name="Preview" Height="120" FitToSize="True" AutomationProperties.Name="Multi-tool 3D preview. Drag to rotate."/>
     <TextBlock x:Name="PreviewNote" Text="Building preview..." Foreground="{ThemeResource ThemeTextBrush}" FontSize="10" TextWrapping="Wrap" Opacity="0.8"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Spacing="3">
     <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
     <TextBlock Text="{x:Bind ViewModel.Rating, Mode=OneWay}" Foreground="{ThemeResource ThemeAccentBrush}"/>
     <!-- The two numbers players compare first: stacked, coloured and larger (user, 2026-10-27). -->
     <Grid ColumnSpacing="8" Margin="0,2">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
       <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Damage potential" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center"
                 Visibility="{x:Bind ViewModel.HasDamage, Mode=OneWay}"/>
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.Damage, Mode=OneWay}" Foreground="{ThemeResource ThemeDamageStatBrush}"
                 FontSize="17" FontWeight="Bold" IsTextSelectionEnabled="True" Visibility="{x:Bind ViewModel.HasDamage, Mode=OneWay}"/>
      <TextBlock Grid.Row="1" Text="Scanner range" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Scanner, Mode=OneWay}" Foreground="{ThemeResource ThemeScannerStatBrush}"
                 FontSize="17" FontWeight="Bold" IsTextSelectionEnabled="True"/>
     </Grid>
     <TextBlock Text="{x:Bind ViewModel.SlotSummary, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="12" TextWrapping="Wrap"/>
     <TextBlock Text="{x:Bind ViewModel.Position, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel>
   </Grid>
   <ItemsControl ItemsSource="{x:Bind ViewModel.Technologies, Mode=OneWay}" AutomationProperties.Name="Installed technology">
    <ItemsControl.ItemsPanel>
     <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate x:DataType="viewModels:StationToolTechChip">
      <Grid Width="36" Height="36" CornerRadius="4" Background="{ThemeResource ThemePanelAltBrush}"
            ToolTipService.ToolTip="{x:Bind Label}" AutomationProperties.Name="{x:Bind Label}">
       <Image Source="{x:Bind Icon}" Stretch="Uniform" Margin="2"/>
       <Border Visibility="{x:Bind HasClass}" Background="{x:Bind ClassBrush}" Width="14" Height="14" CornerRadius="3"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
        <TextBlock Text="{x:Bind ClassLetter}" FontSize="9" FontWeight="Bold" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
       </Border>
      </Grid>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <ToggleButton x:Name="SlotsToggle" Content="Show all slots" Checked="SlotsToggle_Changed" Unchecked="SlotsToggle_Changed"/>
   <ScrollViewer x:Name="SlotsHost" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" AutomationProperties.Name="Multi-tool technology slots">
    <controls:InventorySlotGrid Snapshot="{x:Bind ViewModel.Inventory, Mode=OneWay}" IsReadOnly="True"/>
   </ScrollViewer>
  </StackPanel>
 </Border>
</UserControl>
