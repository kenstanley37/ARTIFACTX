<?xml version="1.0" encoding="utf-8"?>
<!-- One inventory as a card: the band (Title), the bulk actions for its kind and the
     slot grid (Slots) in an ExpandableScroll. Technology: Unlock / Supercharge / Repair /
     Arrange for Adjacency. Cargo: Unlock / Max All Qty / Sort. ExtraActions adds a
     page's own buttons (Copy Tech Stack...), AboveSlots a row above the grid. Without a
     CollapsedHeight the grid isn't capped (a Multi-Tool's fits). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.InventoryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    HorizontalAlignment="Left" VerticalAlignment="Top">

    <Border Style="{StaticResource ThemeCardStyle}">
        <StackPanel>
            <Border Style="{StaticResource ThemeBandStyle}">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource ThemeBandTextStyle}"/>
            </Border>
            <StackPanel Padding="14,12,14,14" Spacing="10">
                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button x:Name="UnlockBtn" Content="Unlock All Slots" Click="Unlock_Click"/>
                    <Button x:Name="SuperchargeBtn" Content="Supercharge All Slots" Click="Supercharge_Click"/>
                    <Button x:Name="RepairBtn" Content="Repair All Slots" Click="Repair_Click"/>
                    <Button x:Name="ArrangeBtn" Content="Arrange for Adjacency" Click="Arrange_Click"
                            ToolTipService.ToolTip="Groups same-type tech side by side so it gets the game's adjacency boost. Tech in supercharged slots stays where it is."/>
                    <Button x:Name="MaxAllBtn" Content="Max All Qty" Click="MaxAll_Click"/>
                    <Button x:Name="SortBtn" Content="Sort" Click="Sort_Click"
                            ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                    <ContentPresenter Content="{x:Bind ExtraActions, Mode=OneWay}"/>
                </ctcontrols:WrapPanel>
                <ContentPresenter x:Name="AbovePresenter" Content="{x:Bind AboveSlots, Mode=OneWay}" Visibility="Collapsed"/>
                <controls:ExpandableScroll x:Name="Scroll"/>
                <ContentPresenter x:Name="PlainSlots"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
