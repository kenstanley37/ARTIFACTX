<?xml version="1.0" encoding="utf-8"?>
<!-- The large 3D view (2026-11-15, owner: a corvette can't be inspected in the small preview): the model another
     preview shows, filling most of the window, with zoom and pan. Opened by the preview's "View larger" button. -->
<ContentDialog
    x:Class="ArtifactX.WinUI3.Controls.ModelViewerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    Title="3D view"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">4000</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">3000</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <controls:ShipPreview x:Name="Viewer" FitToSize="True" AllowExpand="False"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="ResetBtn" Content="Reset view" Click="ResetBtn_Click"
                    AutomationProperties.Name="Reset the 3D view"/>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap"
                       Text="Drag to turn, scroll to zoom toward the mouse, right-drag to move. Keys: arrows turn, + and - zoom, 0 resets."/>
        </StackPanel>
    </Grid>
</ContentDialog>
