<?xml version="1.0" encoding="utf-8"?>
<!-- The Ship Designer's "Apply the design to which ship?" choice (ApplyDesignViewModel), shown in a dialog. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.ShipApplyDesignPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ArtifactX.WinUI3.ViewModels.ShipDesignerViewModels">

    <StackPanel Spacing="10">
        <TextBlock Text="{x:Bind ViewModel.Intro}" TextWrapping="Wrap"/>
        <ListView ItemsSource="{x:Bind ViewModel.Ships}" SelectionMode="Single" MaxHeight="360"
                  SelectedItem="{x:Bind ViewModel.SelectedShip, Mode=TwoWay}"
                  AutomationProperties.Name="Your starships">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:ApplyShipChoice">
                    <TextBlock Text="{x:Bind Label}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <CheckBox Content="{x:Bind ViewModel.RenameText}" IsEnabled="{x:Bind ViewModel.RenameEnabled, Mode=OneWay}"
                  IsChecked="{x:Bind ViewModel.Rename, Mode=TwoWay}" Click="Rename_Click"/>
        <TextBlock Text="{x:Bind ViewModel.RenameNote, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
