<?xml version="1.0" encoding="utf-8"?>
<!-- Building materials (SettlementMaterialsViewModel): pick a building, see what each
     stage asks for and where to get it, with portal codes to copy. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.SettlementMaterialsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels">

    <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                   Text="What each building asks for at every stage, from your game files, and where to get it: trade goods from systems you know with the right economy, items from your Finds, resources from planets where you've recorded them."/>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox Header="Building" MinWidth="260" ItemsSource="{x:Bind ViewModel.Buildings, Mode=OneWay}"
                      SelectedIndex="{x:Bind ViewModel.BuildingIndex, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:SettlementBuildingOption">
                        <TextBlock Text="{x:Bind Label}" ToolTipService.ToolTip="{x:Bind Tip}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="{x:Bind ViewModel.NextUpgrade, Mode=OneWay}" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="13"
                       Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.Note, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasNote, Mode=OneWay}"
                       FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextDimBrush}"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="8"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:MaterialRowViewModel">
                        <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="4">
                            <Grid ColumnSpacing="14" Padding="12,10,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Stage}" FontSize="13" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Image Grid.Column="1" Source="{x:Bind Icon}" Width="40" Height="40" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="2" Spacing="4">
                                    <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                                    <ItemsControl ItemsSource="{x:Bind Leads}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:MaterialLead">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind Text}" Visibility="{x:Bind IsNote}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                                    <TextBlock Text="{x:Bind Text}" Visibility="{x:Bind IsPlace}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind Code}" Visibility="{x:Bind HasCode}" FontSize="12" FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                                    <controls:CopyCodeButton Code="{x:Bind Code}" Visibility="{x:Bind HasCode}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
