<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.BaseStorageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <!-- Reset button on the title's own row, pinned far right, so it
                 appearing never shifts the page down. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="BASE STORAGE" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Storage Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="STORAGE CONTAINERS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <ComboBox x:Name="ContainerSelector" Margin="18,14,18,16" MinWidth="260"
                              ItemsSource="{x:Bind ViewModel.Containers}" DisplayMemberPath="Name"
                              SelectedItem="{x:Bind ViewModel.SelectedContainer, Mode=TwoWay}"
                              SelectionChanged="ContainerSelector_SelectionChanged"
                              AutomationProperties.Name="Base storage container"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock x:Name="GridHeaderTxt" Text="CONTENTS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="14,12,14,14" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                            <TextBox x:Name="NameEditBox" AutomationProperties.Name="Name" Width="260" Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="NameEditBox_LostFocus"/>
                        </StackPanel>
                        <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="Unlock All Slots" Click="UnlockAllBtn_Click"/>
                            <Button Content="Max All Qty" Click="MaxAllQtyBtn_Click"/>
                            <Button Content="Sort" Click="SortBtn_Click"
                                    ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                        </ctcontrols:WrapPanel>
                        <controls:InventorySlotGrid x:Name="StorageGrid"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
