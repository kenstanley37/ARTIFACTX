<?xml version="1.0" encoding="utf-8"?>
<!-- What the system's space station trade terminal sells (StationMarketViewModel), worked out with the game's own
     rules: one fixed-width card per item, trade goods first. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.StationMarket"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <controls:FoldingCard Title="SOLD AT THE STATION" Summary="{x:Bind Market.Summary, Mode=OneWay}"
                          SettingKey="CurrentSystemMarketCollapsed">
        <Border Style="{StaticResource ThemeCardStyle}" Padding="16,12,16,14">
            <StackPanel Spacing="10">
                <TextBlock Visibility="{x:Bind Market.HasMessage, Mode=OneWay}" Text="{x:Bind Market.Message, Mode=OneWay}"
                           Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{x:Bind Market.Items, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MarketCard">
                            <!-- Fixed width, so the cards line up in columns whatever the name's length -->
                            <Border CornerRadius="6" Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}"
                                    BorderThickness="1" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6,12,6" Width="290">
                                    <Image Source="{x:Bind Icon}" Width="32" Height="32" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center" Width="226">
                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind Details}" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
