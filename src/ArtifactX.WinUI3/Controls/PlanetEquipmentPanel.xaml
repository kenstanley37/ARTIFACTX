<?xml version="1.0" encoding="utf-8"?>
<!-- Located sites from the save and existing recorded Finds. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetEquipmentPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="18">

        <!-- Quick Planetary Navigation & POI Cards: Portal, Crashed Ships, and Cabinet Multi-Tools -->
        <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12">

            <!-- Planetary Portal Card -->
            <Border Width="370" MinHeight="170" Padding="16,14" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                    Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                    Visibility="{x:Bind Equipment.HasPortal, Mode=OneWay}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Badge & Coordinates -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource ThemeAccentBrush}" Padding="6,1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" VerticalAlignment="Center">
                            <TextBlock Text="PORTAL" FontSize="11" FontWeight="Bold" FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="100" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{x:Bind Equipment.PortalCoordinates, Mode=OneWay}" FontSize="15" FontWeight="Bold"
                                   FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeAccentBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" IsTextSelectionEnabled="True"
                                   AutomationProperties.Name="Portal coordinates"/>
                    </Grid>

                    <!-- Subtitle & Status -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="Ancient glyph portal for interplanetary and interstellar travel."
                                   FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind Equipment.PortalStatus, Mode=OneWay}" FontSize="11"
                                   Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Actions -->
                    <Grid Grid.Row="2" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="{x:Bind Equipment.AddPortalMarkerText, Mode=OneWay}"
                                Command="{x:Bind Equipment.AddPortalMarkerCommand}"
                                IsEnabled="{x:Bind Equipment.CanAddPortalMarker, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Add a portal marker to my save"
                                ToolTipService.ToolTip="Adds a marker for this portal to your save. Save your changes afterwards; the game shows it next time you load."/>
                        <Button Grid.Column="1" Content="Undo" Command="{x:Bind Equipment.UndoPortalMarkerCommand}"
                                Visibility="{x:Bind Equipment.CanUndoPortalMarker, Mode=OneWay}"
                                AutomationProperties.Name="Undo the portal marker"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Crashed Ships Card -->
            <Border Width="370" MinHeight="170" Padding="16,14" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                    Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Badge & Title -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource ThemeAccentBrush}" Padding="6,1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" VerticalAlignment="Center">
                            <TextBlock Text="CRASHED SHIPS" FontSize="11" FontWeight="Bold" FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="100" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Wrecks &amp; Salvage" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Subtitle -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="Search predicted crash sites on this planet with interactive 3D model previews, class filters, ship types, and visor coordinates."
                                   FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action -->
                    <Button Grid.Row="2" Content="View Crashed Ships ›" Click="OpenCrashedShips_Click"
                            Style="{StaticResource ThemeAccentButtonStyle}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Open Crashed Ships page for this planet"/>
                </Grid>
            </Border>

            <!-- Cabinet Multi-Tools Card -->
            <Border Width="370" MinHeight="170" Padding="16,14" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                    Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: Badge & Title -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{ThemeResource ThemeDoneBrush}" Padding="6,1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" VerticalAlignment="Center">
                            <TextBlock Text="MULTI-TOOLS" FontSize="11" FontWeight="Bold" FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="100" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Cabinets &amp; Shops" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Subtitle -->
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock Text="Explore weapon cabinets, class rolls, and technology shops across this planet's minor settlements."
                                   FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Action -->
                    <Button Grid.Row="2" Content="View Cabinet Multi-Tools ›" Click="OpenCabinetMultiTools_Click"
                            Style="{StaticResource ThemeAccentButtonStyle}" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Open Cabinet Multi-Tools page for this planet"/>
                </Grid>
            </Border>

        </ctcontrols:WrapPanel>

        <!-- Located sites with their recorded coordinates. -->
        <controls:FoldingCard Title="{x:Bind Equipment.LocatedSitesHeading, Mode=OneWay}" SettingKey="PlanetDetailsLocatedSitesCollapsed">
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel Padding="18,14,18,16" Spacing="14">
                    <TextBlock Text="{x:Bind Equipment.LocatedSitesHint, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>

                    <!-- Active Located Sites from Save / Finds -->
                    <ItemsControl ItemsSource="{x:Bind Equipment.LocatedSites, Mode=OneWay}" Visibility="{x:Bind Equipment.HasLocatedSites, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="explore:PlanetLocatedSite">
                                <Border Width="370" Padding="12,10" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                        Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind BadgeBackground}" Padding="6,1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind CategoryBadge}" FontSize="10" FontWeight="Bold"
                                                           FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="100"
                                                           Foreground="{x:Bind BadgeForeground}"/>
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Coordinates}" FontSize="12" FontWeight="Bold"
                                                       FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeAccentBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                                        </Grid>
                                        <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{x:Bind Details}" FontSize="11"
                                                   Foreground="{ThemeResource ThemeTextDimBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>
        </controls:FoldingCard>

        <!-- Planetary deep-level resource hotspots (Survey Device) -->
        <controls:PlanetHotspotsPanel ViewModel="{x:Bind Equipment.Hotspots, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
