<UserControl
    x:Class="ArtifactX.WinUI3.Controls.VehicleUnlockPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:vm="using:ArtifactX.WinUI3.ViewModels">
    <controls:FoldingCard Title="CUSTOMIZATION UNLOCKS" Summary="Requirements and recorded rewards"
        IsExpanded="False" SettingKey="ExocraftUnlocksExpanded">
        <Border Style="{StaticResource ThemeCardStyle}" Padding="18">
        <StackPanel Spacing="16">
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
            <ItemsControl ItemsSource="{x:Bind ViewModel.Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:VehicleUnlockGroupViewModel">
                        <StackPanel Spacing="10" Margin="0,0,0,18">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="270" MinItemHeight="400" MinRowSpacing="10" MinColumnSpacing="10"
                                        Orientation="Horizontal" ItemsStretch="Fill"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:VehicleUnlockItemViewModel">
                                        <Border Style="{StaticResource ThemeCardStyle}" Padding="14">
                                            <StackPanel Spacing="10">
                                                <Grid ColumnSpacing="10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="40" Height="40" AutomationProperties.AccessibilityView="Raw"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"
                                                        VerticalAlignment="Center" Foreground="{ThemeResource ThemeTextBrush}"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}" Foreground="{x:Bind StatusBrush, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Requirement, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Progress, Mode=OneWay}" Foreground="{x:Bind ProgressBrush, Mode=OneWay}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind Notice, Mode=OneWay}" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
