<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.LanguageWordsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="TitleTxt" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- Labeled "All Language Words", not "this race" - the 4 race pages
                 share one underlying save array (see NmsLanguagePaths), so
                 Reset here really does revert every race's pending edits, not
                 just this page's. Goes through the normal title-bar Save/Reset
                 too, same as CataloguePage - no separate save button needed. -->
            <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset All Language Words" Click="PageResetBtn_Click"
                    Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Grid x:Name="ContentPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Opacity="0.85">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock x:Name="InfoTxt" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search words..." TextChanged="SearchBox_TextChanged"/>
                    <ComboBox Grid.Column="1" x:Name="KnownFilterBox" Width="150" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Words"/>
                        <ComboBoxItem Content="Known Only"/>
                        <ComboBoxItem Content="Unknown Only"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" x:Name="ResultCountTxt" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource NmsTextSecondary}"/>
                    <Button Grid.Column="3" x:Name="MarkUnknownAllBtn" Content="Mark All Unknown" Click="MarkUnknownAllBtn_Click"
                            ToolTipService.ToolTip="Marks every word currently shown below as unknown (respects the search box and filter)"/>
                    <Button Grid.Column="4" x:Name="MarkKnownAllBtn" Content="Mark All Known" Click="MarkKnownAllBtn_Click"
                            ToolTipService.ToolTip="Marks every word currently shown below as known (respects the search box and filter)"/>
                </Grid>

                <!-- Same compact-row-in-a-WrapPanel approach as CataloguePage, just
                     narrower (200px, no icon box) since words are short text only.
                     Not virtualized - up to ~1,170 rows per race, same reasoning as
                     CataloguePage's own ~370: small enough visual tree to be a
                     non-issue. Tapped on the whole row for the same double-toggle-
                     avoidance reason (the CheckBox is a non-hit-testable indicator). -->
                <ScrollViewer Grid.Row="2">
                    <ItemsControl x:Name="ItemsListView">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:LanguageWordRowViewModel">
                                <Border Width="200" Padding="10,8" CornerRadius="6" BorderThickness="1"
                                        Tapped="Tile_Tapped" Tag="{x:Bind}"
                                        BorderBrush="{ThemeResource NmsTextSecondary}" Opacity="0.95"
                                        Background="{x:Bind IsKnown, Mode=OneWay, Converter={StaticResource BoolToActiveBackgroundConverter}}">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsKnown, Mode=OneWay}" IsHitTestVisible="False"
                                                  VerticalAlignment="Center" Padding="0" MinWidth="0"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" FontSize="12" TextWrapping="Wrap"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
