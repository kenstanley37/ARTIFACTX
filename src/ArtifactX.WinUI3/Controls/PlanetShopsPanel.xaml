<?xml version="1.0" encoding="utf-8"?>
<!-- Shops nearest you or the portal (PlanetShopsViewModel), each with a save marker. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetShopsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <controls:FoldingCard Title="{x:Bind Shops.Heading, Mode=OneWay}" SettingKey="PlanetDetailsShopsCollapsed"
                          Visibility="{x:Bind Shops.HasShops, Mode=OneWay}">
        <Border Style="{StaticResource ThemeCardStyle}">
            <StackPanel Padding="18,14,18,16" Spacing="12">
                <TextBlock Text="{x:Bind Shops.Hint, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{x:Bind Shops.Shops, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="explore:ShopSiteRowViewModel">
                            <Border Width="340" Padding="12,10" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <StackPanel Spacing="6">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Coordinates}" FontSize="14" FontWeight="Bold"
                                                   FontFamily="{ThemeResource ThemeDisplayFont}" Foreground="{ThemeResource ThemeAccentBrush}"
                                                   IsTextSelectionEnabled="True"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Distance}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    <StackPanel Spacing="4" Visibility="{x:Bind HasTools}">
                                        <TextBlock Text="{x:Bind ToolsLabel}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                                        <ItemsControl ItemsSource="{x:Bind Tools}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:SystemMultiToolItemViewModel">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2"
                                                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                                                        <Border Background="{x:Bind BadgeBackground, Mode=OneWay}" Padding="6,1" VerticalAlignment="Center"
                                                                CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                                            <TextBlock Text="{x:Bind KindLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                                                       FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="120"
                                                                       Foreground="{x:Bind BadgeForeground, Mode=OneWay}"/>
                                                        </Border>
                                                        <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource ThemeTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="{x:Bind AddMarkerText, Mode=OneWay}" Command="{x:Bind AddMarkerCommand}"
                                                IsEnabled="{x:Bind CanAddMarker, Mode=OneWay}" AutomationProperties.Name="{x:Bind AddMarkerName}"/>
                                        <Button Content="Undo" Command="{x:Bind UndoMarkerCommand}"
                                                Visibility="{x:Bind CanUndoMarker, Mode=OneWay}" AutomationProperties.Name="{x:Bind UndoMarkerName}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
