<UserControl x:Class="ArtifactX.WinUI3.Controls.RecipePlanner"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels" xmlns:controls="using:ArtifactX.WinUI3.Controls"
 Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <!-- Split screen (owner's design, 2026-11-13): the ingredient tree at full height on the left, the recipe and the
      selected step on the right. -->
 <Grid Padding="28,24,24,20" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="{x:Bind ViewModel.PageTitle}" Style="{StaticResource ThemePageTitleStyle}"/>
  <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
   Foreground="{ThemeResource ThemeWarningBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>

  <Grid Grid.Row="2" ColumnSpacing="18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="SideColumn" Width="430"/></Grid.ColumnDefinitions>
   <VisualStateManager.VisualStateGroups><VisualStateGroup>
    <VisualState><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1400"/></VisualState.StateTriggers></VisualState>
    <VisualState><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers>
     <VisualState.Setters><Setter Target="SideColumn.Width" Value="360"/></VisualState.Setters></VisualState>
   </VisualStateGroup></VisualStateManager.VisualStateGroups>

   <!-- The tree -->
   <Border Style="{StaticResource ThemeCardStyle}" Padding="0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Padding="16,12" ColumnSpacing="14" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,0,0,1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="INGREDIENT TREE" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" Visibility="{x:Bind ViewModel.PlannerVisibility, Mode=OneWay}">
       <TextBlock FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"><Run Text="●" Foreground="{ThemeResource ThemeDoneBrush}"/> have enough</TextBlock>
       <TextBlock FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"><Run Text="●" Foreground="{ThemeResource ThemeWarningBrush}"/> some</TextBlock>
       <TextBlock FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"><Run Text="●" Foreground="{ThemeResource ThemeDamagedBrush}"/> none</TextBlock>
      </StackPanel>
     </Grid>
     <!-- Scrolls both ways. The tree is centred inside a wrapper at least the viewport's size (centring it in the
          ScrollViewer itself clips a tree wider than the panel instead of scrolling it). Shift+wheel scrolls sideways. -->
     <ScrollViewer x:Name="TreeScroller" Grid.Row="1" HorizontalScrollBarVisibility="Visible" HorizontalScrollMode="Enabled"
      VerticalScrollBarVisibility="Visible" VerticalScrollMode="Enabled" ZoomMode="Disabled" AutomationProperties.Name="Ingredient tree">
      <Grid HorizontalAlignment="Left" VerticalAlignment="Top"
       MinWidth="{x:Bind TreeScroller.ViewportWidth, Mode=OneWay}" MinHeight="{x:Bind TreeScroller.ViewportHeight, Mode=OneWay}">
       <ItemsControl ItemsSource="{x:Bind ViewModel.Tree}" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top" IsTabStop="False">
        <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipeTreeNode"><controls:RecipeTreeBranch Node="{x:Bind}"/></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </Grid>
     </ScrollViewer>
     <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.EmptyHint}" Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
      Foreground="{ThemeResource ThemeTextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"/>
    </Grid>
   </Border>

   <!-- The recipe and the selected step -->
   <Grid Grid.Column="1" RowSpacing="14">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Style="{StaticResource ThemeCardStyle}" Padding="16">
     <StackPanel Spacing="12">
      <Grid ColumnSpacing="8">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="RECIPE" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="{x:Bind ViewModel.PickerButtonText, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePickerCommand}"
        Visibility="{x:Bind ViewModel.PickerButtonVisibility, Mode=OneWay}"/>
       <ToggleButton Grid.Column="2" IsChecked="{x:Bind ViewModel.IsTargetPinned, Mode=OneWay}" Command="{x:Bind ViewModel.TogglePinTargetCommand}"
        Visibility="{x:Bind ViewModel.PlannerVisibility, Mode=OneWay}" AutomationProperties.Name="Pin this recipe" ToolTipService.ToolTip="Pin this recipe"
        Padding="9,6"><FontIcon Glyph="&#xE718;" FontSize="14"/></ToggleButton>
      </Grid>
      <controls:RecipePlannerBrowser ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.PickerVisibility, Mode=OneWay}"/>
      <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.PlannerVisibility, Mode=OneWay}">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="{x:Bind ViewModel.TargetIcon, Mode=OneWay}" Width="48" Height="48" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
         <TextBlock Text="{x:Bind ViewModel.TargetName, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{x:Bind ViewModel.TargetBuff, Mode=OneWay}" Visibility="{x:Bind ViewModel.IngestorVisibility, Mode=OneWay}"
          Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
        </StackPanel>
       </Grid>
       <TextBlock Text="Its effect applies in the Nutrient Ingestor; eating it directly does something else." Visibility="{x:Bind ViewModel.IngestorVisibility, Mode=OneWay}"
        Foreground="{ThemeResource ThemeTextDimBrush}" FontSize="12" TextWrapping="Wrap"/>
       <TextBlock Text="{x:Bind ViewModel.HaveSummary, Mode=OneWay}" Foreground="{x:Bind ViewModel.HaveSummaryBrush, Mode=OneWay}" FontWeight="SemiBold"
        TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </StackPanel>
    </Border>

    <Border Grid.Row="1" Style="{StaticResource ThemeCardStyle}" Padding="0" Visibility="{x:Bind ViewModel.PlannerVisibility, Mode=OneWay}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <SelectorBar x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" Margin="8,4,8,0">
       <SelectorBarItem x:Name="SelectedTab" Text="Selected step" IsSelected="True"/>
       <SelectorBarItem x:Name="ShoppingTab" Text="Shopping list"/>
      </SelectorBar>
      <ScrollViewer x:Name="TabScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <Border Padding="16">
        <Grid>
         <controls:RecipePlannerDetails Item="{x:Bind ViewModel.SelectedItem, Mode=OneWay}" Source="{x:Bind ViewModel.Source}"
          Visibility="{x:Bind ViewModel.SelectedTabVisibility, Mode=OneWay}"/>
         <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShoppingTabVisibility, Mode=OneWay}">
          <TextBlock Text="Every raw ingredient the recipe needs. Select one to see where to find it." Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Gather}" IsTabStop="False">
           <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerItemViewModel">
            <Button Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind TileName, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,3" Padding="10,8">
             <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Image Source="{x:Bind Icon}" Width="28" Height="28"/>
              <TextBlock Grid.Column="1" Text="{x:Bind Name}" Foreground="{ThemeResource ThemeTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="2" Text="{x:Bind TileStatus, Mode=OneWay}" Foreground="{x:Bind TileStatusBrush, Mode=OneWay}" VerticalAlignment="Center"/>
             </Grid>
            </Button>
           </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
         </StackPanel>
        </Grid>
       </Border>
      </ScrollViewer>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
