<?xml version="1.0" encoding="utf-8"?>
<!-- "Your notes on this system" (SystemNotesViewModel): the system's facts as the game shows
     them, ships seen and free notes. Kept by ArtifactX on this PC, never in the save. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.SystemNotesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Visibility="{x:Bind Notes.HasSystem, Mode=OneWay}">

    <UserControl.Resources>
        <DataTemplate x:Key="PickerTemplate" x:DataType="viewmodels:ChoiceFilter">
            <ComboBox Header="{x:Bind Header}" Width="{x:Bind Width}" ItemsSource="{x:Bind Choices, Mode=OneWay}" SelectedItem="{x:Bind Selected, Mode=TwoWay}"/>
        </DataTemplate>
    </UserControl.Resources>

    <controls:FoldingCard Title="YOUR NOTES ON THIS SYSTEM" Summary="{x:Bind Notes.Summary, Mode=OneWay}"
                          FoldedName="" SettingKey="PlanetsSystemNotesCollapsed"
                          Visibility="{x:Bind Notes.HasSystem, Mode=OneWay}">
        <Border Style="{StaticResource ThemeCardStyle}" Padding="16,12,16,14">
            <StackPanel Spacing="10">
                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                           Text="Facts about the whole system, as the Galaxy Map or the system's info panel shows them - pick the exact word the game uses. A planet's weather, sentinels, life, resources and notes go on its own page. The game doesn't save any of these, so ArtifactX keeps them on this PC (never in your save), and they become filters in the Planet Finder."/>
                <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="10">
                    <TextBox Header="System name" Width="200" Text="{x:Bind Notes.SystemName, Mode=TwoWay}" PlaceholderText="{x:Bind Notes.SystemNamePlaceholder, Mode=OneWay}"
                             LostFocus="Text_LostFocus"
                             ToolTipService.ToolTip="Filled in automatically when you save in space in this system (the save records &quot;In the ... system&quot;). You can also type it."/>
                    <TextBox Header="Star class" Width="110" Text="{x:Bind Notes.StarClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. G7"
                             LostFocus="Text_LostFocus"
                             ToolTipService.ToolTip="As shown on the Galaxy Map after the distance (e.g. 24 LY // G7). Its first letter fills in the star colour."/>
                    <ContentControl Content="{x:Bind Notes.Star}" ContentTemplate="{StaticResource PickerTemplate}"/>
                    <ContentControl Content="{x:Bind Notes.Economy}" ContentTemplate="{StaticResource PickerTemplate}"/>
                    <ContentControl Content="{x:Bind Notes.Wealth}" ContentTemplate="{StaticResource PickerTemplate}"/>
                    <ContentControl Content="{x:Bind Notes.Conflict}" ContentTemplate="{StaticResource PickerTemplate}"/>
                    <ContentControl Content="{x:Bind Notes.Race}" ContentTemplate="{StaticResource PickerTemplate}"/>
                    <CheckBox Content="Water" IsChecked="{x:Bind Notes.Water, Mode=TwoWay}" VerticalAlignment="Bottom"
                              ToolTipService.ToolTip="The Galaxy Map shows &quot;// Water&quot; after the star class - in every system checked so far that meant a water world with Salt to harvest"/>
                    <CheckBox Content="Dissonant" IsChecked="{x:Bind Notes.Dissonant, Mode=TwoWay}" VerticalAlignment="Bottom"
                              ToolTipService.ToolTip="The Galaxy Map shows &quot;// Dissonant&quot; - systems with Autophage and corrupted sentinels"/>
                    <ContentControl Content="{x:Bind Notes.Moons}" ContentTemplate="{StaticResource PickerTemplate}"
                                    ToolTipService.ToolTip="From the Discoveries screen, e.g. &quot;4 PLANETS / 2 MOONS&quot;. Marks which bodies below are moons."/>
                </ctcontrols:WrapPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="SHIPS SEEN HERE" Style="{StaticResource ThemeEyebrowStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind Notes.Ships}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ShipSeen">
                                <ToggleButton Content="{x:Bind Type}" IsChecked="{x:Bind IsOn, Mode=TwoWay}" Padding="12,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,4,0,0">
                    <TextBlock Text="NOTES" Style="{StaticResource ThemeEyebrowStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind Notes.Notes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnSpacing="10" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="•" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" IsTextSelectionEnabled="True" TextWrapping="Wrap"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                                        <Button Content="Move to planet ▾" Click="MoveNote_Click" Tag="{x:Bind}" Padding="8,2"
                                                ToolTipService.ToolTip="This note is about one planet - move it to that planet's details"/>
                                        <Button Content="Remove" Click="RemoveNote_Click" Tag="{x:Bind}" Padding="8,2"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnSpacing="8" MaxWidth="640" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewNoteBox" MinWidth="380" PlaceholderText="About the whole system, e.g. S-class ships at the station"
                                 Text="{x:Bind Notes.NewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewNote_KeyDown"/>
                        <Button Grid.Column="1" Content="Add note" Click="AddNote_Click"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </controls:FoldingCard>
</UserControl>
