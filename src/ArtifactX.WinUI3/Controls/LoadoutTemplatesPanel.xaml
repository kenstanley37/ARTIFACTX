<?xml version="1.0" encoding="utf-8"?>
<!-- The Templates sidebar of Multi-Tool, Starships and Freighter (LoadoutTemplatesViewModel).
     Two separate domains on purpose: a Tech Stack template only ever carries tech; a Full
     Build template is the whole thing (tech, class, stats, look) - never cargo, name or crew.
     The page it sits on (ILoadoutTemplateHost) captures and applies them. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.LoadoutTemplatesPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels">

    <StackPanel>
        <Border Style="{StaticResource ThemeBandStyle}">
            <TextBlock Text="TEMPLATES" Style="{StaticResource ThemeBandTextStyle}"/>
        </Border>
        <StackPanel Padding="18,14,18,18" Spacing="18">
            <!-- Templates other players shared as files (Share... on any template). -->
            <StackPanel Spacing="6">
                <Button Content="Import a template file..." Click="Import_Click" FontSize="12" Padding="10,4,10,4"
                        ToolTipService.ToolTip="Add a template someone shared with you. Your save only changes when you click Apply."/>
                <TextBlock Text="{x:Bind ViewModel.ImportStatus, Mode=OneWay}" Foreground="{x:Bind ViewModel.ImportStatusBrush, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasImportStatus, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="TECH STACK" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                    <Button Content="Save Current..." Click="SaveTechStack_Click" FontSize="11" Padding="8,3,8,3" HorizontalAlignment="Right"
                            AutomationProperties.Name="Save current tech stack"/>
                </Grid>
                <TextBlock Text="{x:Bind TechStackHint, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                <TextBlock Text="No templates saved yet." Visibility="{x:Bind ViewModel.NoTechStacks, Mode=OneWay}"
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.TechStacks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LoadoutTemplateRowViewModel">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Summary}" FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Apply" Click="ApplyTechStack_Click" FontSize="11" Padding="8,3,8,3"
                                            AutomationProperties.Name="{x:Bind ApplyName}"/>
                                    <Button Content="Share..." Click="Share_Click" FontSize="11" Padding="8,3,8,3"
                                            ToolTipService.ToolTip="Save this template as a file - to give to a friend, or to keep as a backup"/>
                                    <Button Content="Delete" Click="Delete_Click" FontSize="11" Padding="8,3,8,3"
                                            AutomationProperties.Name="{x:Bind DeleteName}"/>
                                </StackPanel>
                                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,1,0,0"/>

            <StackPanel Spacing="8">
                <Grid>
                    <TextBlock Text="FULL BUILD" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                    <Button Content="Save Current..." Click="SaveFullBuild_Click" FontSize="11" Padding="8,3,8,3" HorizontalAlignment="Right"
                            AutomationProperties.Name="Save current full build"/>
                </Grid>
                <TextBlock Text="{x:Bind FullBuildHint, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                <TextBlock Text="No full build templates saved yet." Visibility="{x:Bind ViewModel.NoFullBuilds, Mode=OneWay}"
                           FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{x:Bind ViewModel.FullBuilds}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:LoadoutTemplateRowViewModel">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind Summary}" FontSize="10" Opacity="0.6" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{x:Bind FullBuildAction}" Click="UseFullBuild_Click" FontSize="11" Padding="8,3,8,3"
                                            ToolTipService.ToolTip="{x:Bind FullBuildTip}" AutomationProperties.Name="{x:Bind FullBuildActionName}"/>
                                    <Button Content="Share..." Click="Share_Click" FontSize="11" Padding="8,3,8,3"
                                            ToolTipService.ToolTip="Save this template as a file - to give to a friend, or to keep as a backup"/>
                                    <Button Content="Delete" Click="Delete_Click" FontSize="11" Padding="8,3,8,3"
                                            AutomationProperties.Name="{x:Bind DeleteName}"/>
                                </StackPanel>
                                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
