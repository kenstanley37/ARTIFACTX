<?xml version="1.0" encoding="utf-8"?>
<!-- System Multi-Tools Panel (SystemMultiToolsViewModel): shows native multi-tool pools
     for the Space Station and each planet in the current system, with source filtering and 1-click seed copy. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.SystemMultiToolsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Background="{ThemeResource ThemePanelAltBrush}"
            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="16,12,16,14"
            Visibility="{x:Bind MultiTools.HasTools, Mode=OneWay}">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind MultiTools.Heading, Mode=OneWay}" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{x:Bind MultiTools.Subtitle, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Content="{x:Bind MultiTools.ToggleLabel, Mode=OneWay}" Click="Toggle_Click" Padding="10,4"
                        AutomationProperties.Name="Toggle system multi-tools visibility"/>
            </Grid>

            <StackPanel Spacing="12" Visibility="{x:Bind MultiTools.IsOpen, Mode=OneWay}">
                <!-- Filter Pills by Source (Space Station vs Planets) -->
                <ItemsControl ItemsSource="{x:Bind MultiTools.FilterOptions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:MultiToolFilterOption">
                            <Button Click="Filter_Click" Tag="{x:Bind FilterKey}" Padding="10,3"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ThemeLineBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    AutomationProperties.Name="{x:Bind Label}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" VerticalAlignment="Center"/>
                                    <Border CornerRadius="4" Background="{ThemeResource ThemeVoidBrush}" Padding="5,0" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Count}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                           Text="Native multi-tool pools for this system. Saving and reloading on a planet or station activates that pool for all weapon cabinets in the system."/>

                <!-- Multi-Tools List -->
                <ItemsControl ItemsSource="{x:Bind MultiTools.FilteredTools, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:SystemMultiToolItemViewModel">
                            <Border Width="300" Padding="12,10" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{x:Bind BadgeBackground, Mode=OneWay}" Padding="6,1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind KindLabel, Mode=OneWay}" FontSize="10" FontWeight="Bold"
                                                           FontFamily="{ThemeResource ThemeDisplayFont}" CharacterSpacing="120"
                                                           Foreground="{x:Bind BadgeForeground, Mode=OneWay}"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind SourceLabel}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind IndexLabel}"
                                                       FontSize="11" Foreground="{ThemeResource ThemeTextFaintBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind DefaultName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource ThemeTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{x:Bind SeedHex}" FontSize="11" FontFamily="{ThemeResource ThemeDisplayFont}"
                                                   Foreground="{ThemeResource ThemeTextDimBrush}" CharacterSpacing="40" IsTextSelectionEnabled="True"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{x:Bind CopyButtonText, Mode=OneWay}" Click="Copy_Click" Tag="{x:Bind}"
                                            Padding="8,4" VerticalAlignment="Center" FontSize="12"
                                            AutomationProperties.Name="{x:Bind AutomationName}" ToolTipService.ToolTip="{x:Bind TooltipText}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

