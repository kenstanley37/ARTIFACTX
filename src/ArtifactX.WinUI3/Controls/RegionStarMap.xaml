<?xml version="1.0" encoding="utf-8"?>
<!-- A region's stars in 3D (RegionStarMap.xaml.cs): drag to turn, wheel to zoom, click a star to pick it. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.RegionStarMap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
            CornerRadius="{ThemeResource ThemeCardCornerRadius}">
        <Grid>
            <Canvas x:Name="Stage" Background="Transparent" ManipulationMode="None"
                    AutomationProperties.Name="Region map. Drag to turn, right-drag to move, use the mouse wheel to zoom, click a star to centre it and see its details. Arrow keys turn, plus and minus zoom, Home returns to your system."/>
            <TextBlock Text="Drag to turn · right-drag to move · wheel to zoom · click a star to centre it · Home: your system" Style="{StaticResource ThemeDimTextStyle}" FontSize="11"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8" IsHitTestVisible="False"/>
        </Grid>
    </Border>
</UserControl>
