<?xml version="1.0" encoding="utf-8"?>
<!-- "Edit details" on a planet's page (PlanetDetailsEditorViewModel): its name in game,
     what the game's discovery screen shows (weather, sentinels, flora, fauna, water),
     resources and notes. Suggestions use the game's own words. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetDetailsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="12">
        <TextBox Header="Name in game" Text="{x:Bind Editor.Name, Mode=TwoWay}" PlaceholderText="{x:Bind Editor.NamePlaceholder, Mode=OneWay}"/>
        <TextBox Header="Description" Text="{x:Bind Editor.Descriptor, Mode=TwoWay}" PlaceholderText="e.g. Crimson Planet, Paradise Planet, Verdant Moon"/>
        <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
            <ComboBox Header="Sentinels" Width="165" IsEditable="True" ItemsSource="{x:Bind Editor.Vocabulary.Sentinels, Mode=OneWay}" Text="{x:Bind Editor.Sentinels, Mode=TwoWay}"/>
            <ComboBox Header="Flora" Width="165" IsEditable="True" ItemsSource="{x:Bind Editor.Vocabulary.Life, Mode=OneWay}" Text="{x:Bind Editor.Flora, Mode=TwoWay}"/>
            <ComboBox Header="Fauna" Width="165" IsEditable="True" ItemsSource="{x:Bind Editor.Vocabulary.Life, Mode=OneWay}" Text="{x:Bind Editor.Fauna, Mode=TwoWay}"/>
            <ComboBox Header="Water" Width="165" ItemsSource="{x:Bind Editor.WaterChoices, Mode=OneWay}" SelectedIndex="{x:Bind Editor.WaterIndex, Mode=TwoWay}"/>
        </ctcontrols:WrapPanel>
        <AutoSuggestBox Header="Weather" PlaceholderText="e.g. Painfully Hot Rain"
                        Text="{x:Bind Editor.Weather, Mode=TwoWay}" TextChanged="Weather_TextChanged"/>

        <StackPanel Spacing="6">
            <TextBlock Text="RESOURCES" Style="{StaticResource ThemeEyebrowStyle}"/>
            <ItemsControl ItemsSource="{x:Bind Editor.Resources, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Click="RemoveResource_Click" Tag="{x:Bind}" Padding="8,2" FontSize="12"
                                ToolTipService.ToolTip="Remove" AutomationProperties.Name="{x:Bind}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind}"/>
                                <FontIcon Glyph="&#xE711;" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <AutoSuggestBox Header="Add a resource" PlaceholderText="Type its name and press Enter"
                            TextChanged="Resource_TextChanged" QuerySubmitted="Resource_QuerySubmitted"/>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="NOTES" Style="{StaticResource ThemeEyebrowStyle}"/>
            <ItemsControl ItemsSource="{x:Bind Editor.Notes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind}" Style="{StaticResource ThemeBodyTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="RemoveNote_Click" Tag="{x:Bind}" Padding="6,2"
                                    ToolTipService.ToolTip="Remove this note" AutomationProperties.Name="Remove note">
                                <FontIcon Glyph="&#xE711;" FontSize="10"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="Add a note..." Text="{x:Bind Editor.NewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="1" Content="Add" Click="AddNote_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
            <Button Content="Save details" Click="Save_Click" Style="{StaticResource ThemeAccentButtonStyle}"/>
            <TextBlock Text="{x:Bind Editor.Status, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
