<?xml version="1.0" encoding="utf-8"?>
<!-- "Edit details" on a planet's page (PlanetDetailsEditorViewModel): its name in game,
     what the game's discovery screen shows (weather, sentinels, flora, fauna, water),
     resources and notes. Pickers list the game's own words; typos get a "did you mean". -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PlanetDetailsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <StackPanel Spacing="12">
        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                   Text="As the game's discovery screen shows them. Pick the game's word, or type your own. Kept by ArtifactX on this PC, never in your save."/>

        <StackPanel Spacing="4">
            <TextBox Header="Name in game" Text="{x:Bind Editor.Name, Mode=TwoWay}" PlaceholderText="{x:Bind Editor.NamePlaceholder, Mode=OneWay}"/>
            <TextBlock Text="{x:Bind Editor.NameHint, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBox Header="Description" Text="{x:Bind Editor.Descriptor, Mode=TwoWay}" PlaceholderText="e.g. Crimson Planet, Paradise Planet, Verdant Moon"/>

        <StackPanel Spacing="4">
            <AutoSuggestBox Header="Weather" PlaceholderText="Start typing, e.g. Painfully Hot Rain"
                            Text="{x:Bind Editor.Weather, Mode=TwoWay}"
                            TextChanged="Weather_TextChanged" SuggestionChosen="Weather_SuggestionChosen" LostFocus="Weather_LostFocus"/>
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind Editor.HasWeatherFix, Mode=OneWay}">
                <TextBlock Text="{x:Bind Editor.WeatherFixText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource ThemeWarningBrush}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <HyperlinkButton Content="{x:Bind Editor.WeatherFixAction, Mode=OneWay}" Click="UseWeatherFix_Click" Padding="0" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
            <ComboBox x:Name="SentinelsBox" Header="Sentinels" Width="240" IsEditable="True" PlaceholderText="Not recorded"
                      ItemsSource="{x:Bind Editor.SentinelChoices, Mode=OneWay}" Text="{x:Bind Editor.Sentinels, Mode=TwoWay}" Loaded="Choice_Loaded"/>
            <ComboBox x:Name="FloraBox" Header="Flora" Width="240" IsEditable="True" PlaceholderText="Not recorded"
                      ItemsSource="{x:Bind Editor.LifeChoices, Mode=OneWay}" Text="{x:Bind Editor.Flora, Mode=TwoWay}" Loaded="Choice_Loaded"/>
            <ComboBox x:Name="FaunaBox" Header="Fauna" Width="240" IsEditable="True" PlaceholderText="Not recorded"
                      ItemsSource="{x:Bind Editor.LifeChoices, Mode=OneWay}" Text="{x:Bind Editor.Fauna, Mode=TwoWay}" Loaded="Choice_Loaded"/>
            <ComboBox Header="Water" Width="160" ItemsSource="{x:Bind Editor.WaterChoices, Mode=OneWay}" SelectedIndex="{x:Bind Editor.WaterIndex, Mode=TwoWay}"/>
        </ctcontrols:WrapPanel>

        <StackPanel Spacing="6">
            <AutoSuggestBox x:Name="ResourceBox" Header="Resources" PlaceholderText="Type a resource and press Enter, e.g. Paraffinium"
                            Text="{x:Bind Editor.NewResource, Mode=TwoWay}"
                            TextChanged="Resource_TextChanged" SuggestionChosen="Resource_SuggestionChosen"
                            QuerySubmitted="Resource_QuerySubmitted" PreviewKeyDown="Resource_PreviewKeyDown"/>
            <ItemsControl ItemsSource="{x:Bind Editor.Resources, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Click="RemoveResource_Click" Tag="{x:Bind}" Padding="8,2" FontSize="12"
                                ToolTipService.ToolTip="Remove" AutomationProperties.Name="{x:Bind}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{x:Bind}"/>
                                <FontIcon Glyph="&#xE711;" FontSize="10"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{x:Bind Editor.ResourceFixes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="explore:ResourceFix">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                            <TextBlock Text="{x:Bind Text}" FontSize="12" Foreground="{ThemeResource ThemeWarningBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <HyperlinkButton Content="{x:Bind Action}" Click="UseResourceFix_Click" Tag="{x:Bind}" Padding="0" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="NOTES" Style="{StaticResource ThemeEyebrowStyle}"/>
            <ItemsControl ItemsSource="{x:Bind Editor.Notes, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Grid ColumnSpacing="8" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind}" Style="{StaticResource ThemeBodyTextStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Remove" Click="RemoveNote_Click" Tag="{x:Bind}" Padding="8,2"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox PlaceholderText="e.g. crashed freighter, Vile Brood, great base spot"
                         Text="{x:Bind Editor.NewNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="NewNote_KeyDown"/>
                <Button Grid.Column="1" Content="Add note" Click="AddNote_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
            <Button Content="Save details" Click="Save_Click" Style="{StaticResource ThemeAccentButtonStyle}"/>
            <TextBlock Text="{x:Bind Editor.Status, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
