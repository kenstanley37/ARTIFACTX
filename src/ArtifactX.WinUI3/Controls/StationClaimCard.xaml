<?xml version="1.0" encoding="utf-8"?>
<!-- One claim in progress on the Space Stations page (StationClaimViewModel): name and
     system, what's known about it, the three requirements, distance and glyphs. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.StationClaimCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <Border Width="330" Padding="14,12,14,12"
            CornerRadius="{ThemeResource ThemeCardCornerRadius}"
            Background="{ThemeResource ThemePanelBrush}"
            BorderBrush="{x:Bind Claim.Border}" BorderThickness="{x:Bind Claim.BorderThickness}"
            Opacity="{x:Bind Claim.Opacity}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock Text="{x:Bind Claim.Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                                   Foreground="{ThemeResource ThemeTextBrush}"/>
                        <TextBlock Text="{x:Bind Claim.SystemLine}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource ThemeTextDimBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Bind Claim.HideLabel}" Click="Hide_Click"
                            FontSize="11" Padding="8,2,8,2" VerticalAlignment="Top"
                            ToolTipService.ToolTip="{x:Bind Claim.HideTip}"
                            AutomationProperties.Name="{x:Bind Claim.HideAutomationName}"/>
                </Grid>

                <ItemsControl ItemsSource="{x:Bind Claim.Badges}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StationBadgeViewModel">
                            <Border CornerRadius="4" Padding="6,1,6,1" Background="{x:Bind Background}"
                                    BorderBrush="{x:Bind Border}" BorderThickness="{x:Bind BorderThickness}"
                                    ToolTipService.ToolTip="{x:Bind Tip}">
                                <TextBlock Text="{x:Bind Text}" FontSize="10" FontWeight="SemiBold" Foreground="{x:Bind Foreground}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{x:Bind Claim.Requirements}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:StationRequirementViewModel">
                            <StackPanel Spacing="3" AutomationProperties.Name="{x:Bind AutomationName}">
                                <Grid>
                                    <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    <TextBlock Text="{x:Bind ValueText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                               Foreground="{x:Bind ValueBrush}"/>
                                </Grid>
                                <Grid Height="4" Background="{ThemeResource ThemeTrackBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Bind FillWidth}"/>
                                        <ColumnDefinition Width="{x:Bind RestWidth}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{x:Bind BarBrush}"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{x:Bind Claim.DistanceText}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
            </StackPanel>

            <controls:GlyphStrip Grid.Row="1" GlyphSize="20" Code="{x:Bind Claim.PortalCode}" Title="{x:Bind Claim.Name}"
                                 Margin="0,10,0,0" VerticalAlignment="Bottom"/>
        </Grid>
    </Border>
</UserControl>
