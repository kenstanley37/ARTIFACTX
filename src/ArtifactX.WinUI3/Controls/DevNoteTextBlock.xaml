<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.DevNoteTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtifactX.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    HorizontalAlignment="Left">

    <!-- Wraps this app's standard dim confidence/verification-status note
         style (FontSize 10, Opacity 0.55) so it can be gated out of Release
         builds - alpha testers don't care which fields were cross-referenced
         against a screenshot vs. still unconfirmed, but contributors do.
         HorizontalAlignment="Left" is baked in on the root so callers don't
         have to remember it themselves - see
         project_stretch_maxwidth_text_centering_fix: a wrapping TextBlock
         with MaxWidth and the default Stretch alignment centers instead of
         sitting flush-left once the parent has spare width. -->
    <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="10" Opacity="0.55" TextWrapping="Wrap"/>
</UserControl>
