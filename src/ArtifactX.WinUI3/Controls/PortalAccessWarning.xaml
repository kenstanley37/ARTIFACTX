<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.PortalAccessWarning"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">
    <TextBlock Text="Purple star: requires purple-star access."
               Margin="2,4,2,0" MaxWidth="200" FontSize="12" FontWeight="SemiBold"
               Foreground="{ThemeResource ThemeWarningBrush}" TextWrapping="Wrap"
               AutomationProperties.Name="Purple star: requires purple-star access to reach."
               ToolTipService.ToolTip="Without purple-star access, this portal address can send you to a different system."/>
</UserControl>
