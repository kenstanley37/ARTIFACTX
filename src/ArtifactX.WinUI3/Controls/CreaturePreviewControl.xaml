<?xml version="1.0" encoding="utf-8"?>
<!-- 3D preview and anatomy viewer for planetary fauna and creatures. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.CreaturePreviewControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:services="using:ArtifactX.WinUI3.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="14" Width="460">
        <!-- 3D Model Viewport -->
        <Border CornerRadius="8" Background="{ThemeResource ThemeVoidBrush}"
                BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Padding="8">
            <controls:ModelPreviewPanel x:Name="ModelPreview" Subject="creature" Height="340"/>
        </Border>

        <!-- Creature Info and Rig Selection -->
        <StackPanel Spacing="8">
            <TextBlock x:Name="CreatureNameTxt" FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
            <TextBlock x:Name="CreatureTraitsTxt" FontSize="12" Style="{StaticResource ThemeDimTextStyle}"
                       TextWrapping="Wrap"/>

            <StackPanel x:Name="CompanionBadge" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" Margin="0,2,0,0">
                <FontIcon Glyph="&#xE735;" FontSize="13" Foreground="{ThemeResource ThemeAccentBrush}"/>
                <TextBlock x:Name="CompanionBadgeTxt" FontSize="12" Foreground="{ThemeResource ThemeAccentBrush}" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Spacing="4" Margin="0,6,0,0">
                <TextBlock Text="CREATURE 3D RIG" Style="{StaticResource ThemeEyebrowStyle}"/>
                <ComboBox x:Name="RigComboBox" HorizontalAlignment="Stretch"
                          ItemsSource="{x:Bind AvailableRigs}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="RigComboBox_SelectionChanged"
                          AutomationProperties.Name="Select creature 3D rig"/>
            </StackPanel>

            <TextBlock Text="3D creature geometry extracted directly from your game install. Drag to rotate model."
                       Style="{StaticResource ThemeDimTextStyle}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>

