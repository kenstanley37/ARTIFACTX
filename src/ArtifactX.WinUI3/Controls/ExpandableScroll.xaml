<?xml version="1.0" encoding="utf-8"?>
<!-- An inventory grid (or anything) shown at a short preview height, with a chevron to
     show it all; whether it's open is remembered (ExpandableScroll.SettingKey). -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.ExpandableScroll"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <ScrollViewer x:Name="Scroller" Padding="0,28,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
            <ContentPresenter Content="{x:Bind ScrollContent, Mode=OneWay}"/>
        </ScrollViewer>
        <Button x:Name="ToggleBtn" Click="Toggle_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                Padding="6" Background="Transparent" BorderThickness="0">
            <FontIcon x:Name="Chevron" FontSize="12" Foreground="{ThemeResource ThemeAccentBrush}"/>
        </Button>
    </Grid>
</UserControl>
