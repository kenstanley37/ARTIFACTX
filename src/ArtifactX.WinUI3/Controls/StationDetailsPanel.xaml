<?xml version="1.0" encoding="utf-8"?>
<!-- The selected station on the Space Stations page (StationDetailsViewModel): its
     screenshot and glyphs on the left, facts about its system on the right. Sections
     with nothing recorded are hidden. -->
<UserControl
    x:Class="ArtifactX.WinUI3.Controls.StationDetailsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <Style x:Key="FactTitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{ThemeResource ThemeDisplayFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CharacterSpacing" Value="260"/>
            <Setter Property="Foreground" Value="{ThemeResource ThemeAccentBrush}"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource ThemeBandStyle}">
            <Grid>
                <TextBlock Text="{x:Bind Details.Title, Mode=OneWay}" Style="{StaticResource ThemeBandTextStyle}" CharacterSpacing="60" FontSize="15"/>
                <TextBlock Text="Station details" HorizontalAlignment="Right" Style="{StaticResource ThemeDimTextStyle}"/>
            </Grid>
        </Border>
        <!-- The station's system: name and details from the game's generator. -->
        <TextBlock Text="{x:Bind Details.Facts, Mode=OneWay}" Margin="22,16,22,0" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{ThemeResource ThemeAccentBrush}"/>
        <ctcontrols:WrapPanel Padding="22,20,22,24" HorizontalSpacing="30" VerticalSpacing="20">
            <StackPanel Width="440" Spacing="10">
                <Grid Height="248" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                      Background="{ThemeResource ThemePanelAltBrush}">
                    <Image Source="{x:Bind Details.Screenshot, Mode=OneWay}" Stretch="UniformToFill"/>
                    <TextBlock Text="No screenshot cached for this station" Visibility="{x:Bind Details.ShowNoScreenshot, Mode=OneWay}"
                               Style="{StaticResource ThemeDimTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="PORTAL ADDRESS" Style="{StaticResource ThemeEyebrowStyle}"
                           Foreground="{ThemeResource ThemeTextDimBrush}" Margin="0,8,0,0"/>
                <Border Padding="6" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                        Background="{ThemeResource ThemeVoidBrush}">
                    <controls:GlyphStrip Code="{x:Bind Details.PortalCode, Mode=OneWay}" Title="{x:Bind Details.Station.Name, Mode=OneWay}"
                                         GlyphSize="30" HighlightFirst="True" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                           Text="Dial at any portal to reach this system. The highlighted first glyph picks planet 1."/>
            </StackPanel>

            <StackPanel Spacing="20" MinWidth="340" MaxWidth="560">
                <StackPanel Spacing="8">
                    <TextBlock Text="GALAXY" Style="{StaticResource FactTitleStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{x:Bind Details.GalaxyName, Mode=OneWay}" FontFamily="{ThemeResource ThemeDisplayFont}"
                                   FontWeight="Bold" FontSize="24" Foreground="{ThemeResource ThemeTextBrush}"/>
                        <TextBlock Text="{x:Bind Details.GalaxyNumber, Mode=OneWay}" Visibility="{x:Bind Details.HasGalaxyNumber, Mode=OneWay}"
                                   VerticalAlignment="Bottom" Margin="0,0,0,4" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="HISTORY" Style="{StaticResource FactTitleStyle}"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="24"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Discovered" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                            <TextBlock Text="{x:Bind Details.DiscoveredAt, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                            <TextBlock Text="{x:Bind Details.DiscoveredBy, Mode=OneWay}" Visibility="{x:Bind Details.HasDiscoveredBy, Mode=OneWay}"
                                       FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Height="1" VerticalAlignment="Center" Fill="{ThemeResource ThemeAccentBrush}" Opacity="0.6"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Claimed" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                            <TextBlock Text="{x:Bind Details.ClaimedAt, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind Details.HasChips, Mode=OneWay}">
                    <TextBlock Text="YOUR DISCOVERIES HERE" Style="{StaticResource FactTitleStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind Details.Chips, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:StationChipViewModel">
                                <Border Padding="12,5,12,5" Background="{ThemeResource ThemePanelAltBrush}"
                                        BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                        CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Count}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="Bold" FontSize="18"
                                                   Foreground="{ThemeResource ThemeAccentBrush}"/>
                                        <TextBlock Text="{x:Bind Label}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="8" Visibility="{x:Bind Details.HasStandings, Mode=OneWay}">
                    <TextBlock Text="LOCAL STANDING" Style="{StaticResource FactTitleStyle}"/>
                    <ItemsControl ItemsSource="{x:Bind Details.Standings, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="9"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <!-- Label | bar with a tick at the claim requirement | value -->
                            <DataTemplate x:DataType="viewmodels:StationStandingViewModel">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Label}" FontSize="14" VerticalAlignment="Center" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    <Grid Grid.Column="1">
                                        <Grid Height="6" VerticalAlignment="Center" Background="{ThemeResource ThemeTrackBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind FillWidth}"/>
                                                <ColumnDefinition Width="{x:Bind RestWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind BarBrush}"/>
                                        </Grid>
                                        <Grid Height="14" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind TickWidth}"/>
                                                <ColumnDefinition Width="{x:Bind TickRestWidth}"/>
                                            </Grid.ColumnDefinitions>
                                            <Rectangle Grid.Column="1" Width="2" HorizontalAlignment="Left" Fill="{ThemeResource ThemeTextDimBrush}"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Tick marks show the claim requirement." FontSize="12" Foreground="{ThemeResource ThemeTextFaintBrush}"/>
                </StackPanel>

                <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind Details.HasPartsPlaced, Mode=OneWay}">
                        <TextBlock Text="Parts placed" FontSize="14" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                        <TextBlock Text="{x:Bind Details.PartsPlaced, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Other bases here" FontSize="14" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                        <TextBlock Text="{x:Bind Details.OtherBases, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Foreground="{ThemeResource ThemeTextBrush}"/>
                    </StackPanel>
                </ctcontrols:WrapPanel>
            </StackPanel>
        </ctcontrols:WrapPanel>
    </StackPanel>
</UserControl>
