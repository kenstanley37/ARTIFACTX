<UserControl x:Class="ArtifactX.WinUI3.Controls.RecipePlannerDetails"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels"
 xmlns:controls="using:ArtifactX.WinUI3.Controls">
 <!-- The Selected step tab: a raw ingredient's places and closest systems, or a step's equipment and inputs. -->
 <StackPanel Spacing="14">
  <Grid ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Image Source="{x:Bind Item.Icon, Mode=OneWay}" Width="44" Height="44" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
    <TextBlock Text="{x:Bind Item.Name, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
     AutomationProperties.LiveSetting="Polite"/>
    <TextBlock Text="{x:Bind Item.HaveText, Mode=OneWay}" Foreground="{x:Bind Item.TileStatusBrush, Mode=OneWay}" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
  <TextBlock Text="{x:Bind Item.Buff, Mode=OneWay}" Visibility="{x:Bind Item.BuffVisibility, Mode=OneWay}" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>

  <!-- A raw ingredient -->
  <StackPanel Spacing="14" Visibility="{x:Bind Item.RawVisibility, Mode=OneWay}">
   <controls:IngredientSourcePanel ViewModel="{x:Bind Source, Mode=OneWay}"/>
   <StackPanel Spacing="6" Visibility="{x:Bind Item.BaseSourcesVisibility, Mode=OneWay}">
    <TextBlock Text="EXTRACTORS AT YOUR BASES" Style="{StaticResource ThemeEyebrowStyle}"/>
    <TextBlock Text="{x:Bind Item.BaseSources, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Spacing="6" Visibility="{x:Bind Item.SourceVisibility, Mode=OneWay}">
    <TextBlock Text="WHAT THE GAME SAYS" Style="{StaticResource ThemeEyebrowStyle}"/>
    <TextBlock Text="{x:Bind Item.Source, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   </StackPanel>
  </StackPanel>

  <!-- A cooking or refining step -->
  <StackPanel Spacing="10" Visibility="{x:Bind Item.RecipeVisibility, Mode=OneWay}">
   <TextBlock Text="HOW TO MAKE IT" Style="{StaticResource ThemeEyebrowStyle}"/>
   <Border Padding="10" CornerRadius="6" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Image Source="{x:Bind Item.StationIcon, Mode=OneWay}" Width="40" Height="40"/>
     <TextBlock Text="{x:Bind Item.Station, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <TextBlock Text="Put in:" Foreground="{ThemeResource ThemeTextBrush}"/>
   <ItemsControl ItemsSource="{x:Bind Item.Ingredients, Mode=OneWay}" IsTabStop="False">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerItemViewModel">
     <Button Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Amount}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{x:Bind Icon}" Width="26" Height="26"/><TextBlock Text="{x:Bind Amount}" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="{x:Bind Item.UsedFor, Mode=OneWay}" Visibility="{x:Bind Item.UsedForVisibility, Mode=OneWay}" Foreground="{ThemeResource ThemeTextDimBrush}" TextWrapping="Wrap"/>
  </StackPanel>

  <StackPanel Spacing="8" Visibility="{x:Bind Item.InventoryLocationsVisibility, Mode=OneWay}">
   <TextBlock Text="WHERE YOURS ARE" Style="{StaticResource ThemeEyebrowStyle}"/>
   <TextBlock Text="{x:Bind Item.InventoryLocations, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
  </StackPanel>

  <StackPanel Spacing="8" Visibility="{x:Bind Item.AlternativesVisibility, Mode=OneWay}">
   <TextBlock Text="{x:Bind Item.AlternativesHeading, Mode=OneWay}" Style="{StaticResource ThemeEyebrowStyle}"/>
   <ItemsControl ItemsSource="{x:Bind Item.Alternatives, Mode=OneWay}" IsTabStop="False">
    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerAlternative">
     <Border Margin="0,3" Padding="10" CornerRadius="6" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
       <TextBlock Text="{x:Bind Equipment}" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
       <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
       <Button Content="{x:Bind ButtonText}" IsEnabled="{x:Bind CanChoose}" Command="{x:Bind ChooseCommand}" AutomationProperties.Name="{x:Bind ActionName}"/>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </StackPanel>
 </StackPanel>
</UserControl>
