<UserControl x:Class="ArtifactX.WinUI3.Controls.RecipePlannerDetails"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels">
 <UserControl.Resources>
  <Storyboard x:Name="SelectionPulse">
   <DoubleAnimation Storyboard.TargetName="SelectionHighlight" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.9"/>
  </Storyboard>
 </UserControl.Resources>
 <Grid>
 <Border Padding="14" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeAccentBrush}" BorderThickness="2" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
  <StackPanel Spacing="12">
   <TextBlock Text="VIEWING INGREDIENT" Style="{StaticResource ThemeEyebrowStyle}"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Image Source="{x:Bind Item.Icon, Mode=OneWay}" Width="38" Height="38"/><TextBlock x:Name="SelectedName" Text="{x:Bind Item.Name, Mode=OneWay}" Foreground="{ThemeResource ThemeAccentBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="190" AutomationProperties.LiveSetting="Polite"/></StackPanel>
   <StackPanel Visibility="{x:Bind Item.BaseSourcesVisibility, Mode=OneWay}" Spacing="8">
    <TextBlock Text="EXTRACTORS AT YOUR BASES" Style="{StaticResource ThemeEyebrowStyle}"/>
    <TextBlock Text="{x:Bind Item.BaseSources, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
    <TextBlock Text="Visit the base to collect supplies. Uncollected output is not included in your owned total." Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   </StackPanel>
   <StackPanel Visibility="{x:Bind Item.RecipeVisibility, Mode=OneWay}" Spacing="10">
    <StackPanel Orientation="Horizontal" Spacing="10"><Image Source="{x:Bind Item.StationIcon, Mode=OneWay}" Width="56" Height="56"/><TextBlock Text="{x:Bind Item.Station, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" MaxWidth="170"/></StackPanel>
    <TextBlock Text="Put these ingredients into the equipment:" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
    <ItemsControl ItemsSource="{x:Bind Item.Ingredients, Mode=OneWay}">
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerItemViewModel">
      <Button Command="{x:Bind ExploreCommand}" AutomationProperties.Name="{x:Bind SelectionName}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3" Padding="8">
       <StackPanel Orientation="Horizontal" Spacing="7"><Image Source="{x:Bind Icon}" Width="25" Height="25"/><TextBlock Text="{x:Bind Amount}" TextWrapping="Wrap" MaxWidth="200"/></StackPanel>
      </Button>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{x:Bind Item.UsedFor, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
    <Button Content="Explore this branch" Command="{x:Bind Item.ExploreCommand, Mode=OneWay}" HorizontalAlignment="Stretch"/>
   </StackPanel>
   <StackPanel Visibility="{x:Bind Item.AlternativesVisibility, Mode=OneWay}" Spacing="8">
    <TextBlock Text="RECIPES TO MAKE IT" Style="{StaticResource ThemeEyebrowStyle}"/>
    <TextBlock Text="Choose a recipe to use in your plan. Circular conversions may need a starting supply." TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
    <ItemsControl ItemsSource="{x:Bind Item.Alternatives, Mode=OneWay}">
     <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerAlternative">
      <Border Style="{StaticResource ThemeCardStyle}" Padding="10" Margin="0,3">
       <StackPanel Spacing="8">
        <TextBlock Text="{x:Bind Equipment}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeAccentBrush}"/>
        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
        <Button Content="Use this recipe" Command="{x:Bind ChooseCommand}" AutomationProperties.Name="{x:Bind ActionName}"/>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
   <StackPanel Visibility="{x:Bind Item.SourceVisibility, Mode=OneWay}" Spacing="10">
    <TextBlock Text="HOW TO GET IT" Style="{StaticResource ThemeEyebrowStyle}"/>
    <TextBlock Text="{x:Bind Item.Source, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   </StackPanel>
   <TextBlock Text="{x:Bind Item.Inventory, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="{x:Bind Item.InventoryLocations, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   <TextBlock Text="{x:Bind Item.Buff, Mode=OneWay}" Visibility="{x:Bind Item.BuffVisibility, Mode=OneWay}" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
  </StackPanel>
 </Border>
 <Border x:Name="SelectionHighlight" BorderBrush="{ThemeResource ThemeAccentBrush}" BorderThickness="5" Opacity="0" IsHitTestVisible="False" CornerRadius="{ThemeResource ThemeCardCornerRadius}"/>
 </Grid>
</UserControl>
