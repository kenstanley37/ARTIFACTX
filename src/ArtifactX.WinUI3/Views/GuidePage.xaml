<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Guide" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource NmsAccentBrush}" CornerRadius="4" Padding="9,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ActivePlatformTxt" Text="" FontSize="12" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="PendingEditsTxt" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource NmsTextSecondary}"/>
                <Button x:Name="DiscardChangesBtn" Content="Discard Changes" Click="DiscardChangesBtn_Click"
                        Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button x:Name="SaveChangesBtn" Content="Save Changes" Click="SaveChangesBtn_Click"
                        Style="{ThemeResource AccentButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="NoAccountDataTxt" Visibility="Collapsed"
                       Text="No accountdata.hg file was found alongside this save - this platform account may be very new, or this feature isn't supported for it yet."
                       Foreground="{ThemeResource NmsTextSecondary}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center"/>

            <Grid x:Name="ContentPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#332B1400" BorderBrush="#FFB800"
                        BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFB800" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFB800"
                                   Text="This list is account-wide, not tied to any one save slot - toggling a topic here affects every save on this platform account (accountdata.hg), not just the save currently loaded. Save this separately with the button above; it does not go through the normal per-save Save button."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Opacity="0.85">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"
                                   Text="Tracks the in-game Guide screen's per-topic Unlocked/Seen state, found via a real controlled test (confirmed 2026-08-12). Grouped by the game's own real section data (metadata/reality/wiki.mbin), extracted automatically - not a hand-copied list, so a future game update's topic changes get picked up just by re-running the cataloger."/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search topics..." TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Grid.Column="1" x:Name="ResultCountTxt" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource NmsTextSecondary}"/>
                    <Button Grid.Column="2" x:Name="MarkAllUnknownBtn" Content="Mark All Unknown" Click="MarkAllUnknownBtn_Click"
                            ToolTipService.ToolTip="Sets every topic currently shown below to locked/unseen (respects the search box)"/>
                    <Button Grid.Column="3" x:Name="MarkAllKnownBtn" Content="Mark All Known" Click="MarkAllKnownBtn_Click"
                            ToolTipService.ToolTip="Sets every topic currently shown below to unlocked/seen (respects the search box)"/>
                </Grid>

                <!-- Cards (one per category), not a flat full-width list - user
                     feedback 2026-08-12 ("they can be in block (cards) next to
                     each other and responsive to app width"), same wrapping
                     approach as Squadron/Catalogue's own responsive layouts.
                     Built in code-behind (BuildCategoryCards) rather than a
                     grouped ListView/CollectionViewSource - simpler to keep in
                     sync with search filtering, which needs to hide a whole
                     card when none of its topics match. -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CategoriesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="16" VerticalSpacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:GuideCategoryGroupViewModel">
                                <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                                        CornerRadius="8" Padding="14" Width="320" VerticalAlignment="Top" Opacity="0.95">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind HeaderText}" FontWeight="SemiBold" FontSize="14"/>
                                        <ItemsControl ItemsSource="{x:Bind Topics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:GuideTopicRowViewModel">
                                                    <!-- Plain horizontal StackPanel, not a Grid with a
                                                         Width="*" column - a Star column needs a bounded
                                                         parent width to divide up, which this row doesn't
                                                         reliably get while nested inside a WrapPanel-hosted
                                                         ItemsControl (WrapPanel sizes its children to their
                                                         OWN desired size, so a Star column here measured
                                                         against an effectively unbounded width instead of
                                                         the card's real 320px - user feedback 2026-08-12:
                                                         checkboxes bunched left, name text stranded far
                                                         right with a huge gap). A StackPanel just places
                                                         each child at its own natural width immediately
                                                         after the last, regardless of the parent's
                                                         measurement pass. -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="0,3">
                                                        <CheckBox IsChecked="{x:Bind IsUnlocked, Mode=OneWay}"
                                                                  Click="UnlockedCheckBox_Click" Tag="{x:Bind}"
                                                                  ToolTipService.ToolTip="Unlocked"/>
                                                        <CheckBox IsChecked="{x:Bind IsSeen, Mode=OneWay}"
                                                                  Click="SeenCheckBox_Click" Tag="{x:Bind}"
                                                                  ToolTipService.ToolTip="Seen"/>
                                                        <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   MaxWidth="190"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
