<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). -->
<Page
    x:Class="ArtifactX.WinUI3.Views.GuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="GUIDE" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource ThemeAccentBrush}" CornerRadius="4" Padding="9,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ActivePlatformTxt" Text="" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="PendingEditsTxt" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource ThemeTextDimBrush}"/>
                <Button x:Name="DiscardChangesBtn" Content="Discard Changes" Click="DiscardChangesBtn_Click"
                        Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button x:Name="SaveChangesBtn" Content="Save Changes" Click="SaveChangesBtn_Click"
                        Style="{StaticResource ThemeAccentButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="NoAccountDataTxt" Visibility="Collapsed"
                       Text="No accountdata.hg file was found alongside this save - this platform account may be very new, or this feature isn't supported for it yet."
                       Foreground="{ThemeResource ThemeTextDimBrush}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center"/>

            <Grid x:Name="ContentPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}"
                        BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource ThemeWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource ThemeWarningBrush}"
                                   Text="This list is shared by every save on this platform account, not just the save that's loaded. Save it with the Save Changes button above; the normal Save button doesn't cover it."/>
                    </Grid>
                </Border>

                <!-- Per-topic Unlocked/Seen state in accountdata.hg, found via a real
                     controlled test (confirmed 2026-08-12). Grouping comes from the
                     game's own section data (metadata/reality/wiki.mbin), extracted by
                     DataCataloger's add-guide-topics - not a hand-copied list, so a game
                     update's topic changes are picked up by re-running the cataloger. -->
                <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                        Background="{ThemeResource ThemePanelAltBrush}"
                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                                   Text="The topics on the in-game Guide screen, grouped the way the game groups them. Unlock makes a topic available; Seen clears its &quot;new&quot; marker."/>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search topics..." TextChanged="SearchBox_TextChanged"/>
                    <TextBlock Grid.Column="1" x:Name="ResultCountTxt" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource ThemeTextDimBrush}"/>
                    <Button Grid.Column="2" x:Name="MarkAllUnknownBtn" Content="Mark All Unknown" Click="MarkAllUnknownBtn_Click"
                            ToolTipService.ToolTip="Sets every topic currently shown below to locked/unseen (respects the search box)"/>
                    <Button Grid.Column="3" x:Name="MarkAllKnownBtn" Content="Mark All Known" Click="MarkAllKnownBtn_Click"
                            ToolTipService.ToolTip="Sets every topic currently shown below to unlocked/seen (respects the search box)"/>
                </Grid>

                <!-- Cards (one per category), not a flat full-width list - user
                     feedback 2026-08-12 ("they can be in block (cards) next to
                     each other and responsive to app width"), same wrapping
                     approach as Squadron/Catalogue's own responsive layouts.
                     Built in code-behind (BuildCategoryCards) rather than a
                     grouped ListView/CollectionViewSource - simpler to keep in
                     sync with search filtering, which needs to hide a whole
                     card when none of its topics match. -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="CategoriesItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="16" VerticalSpacing="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:GuideCategoryGroupViewModel">
                                <Border Style="{StaticResource ThemeCardStyle}" Width="320" VerticalAlignment="Top">
                                  <StackPanel>
                                    <Border Style="{StaticResource ThemeBandStyle}">
                                        <TextBlock Text="{x:Bind HeaderUpper}" Style="{StaticResource ThemeBandTextStyle}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <StackPanel Spacing="6" Padding="14,10,14,14">

                                        <!-- Persistent column labels, not hover-only tooltips - user
                                             feedback 2026-08-12: "no one is going to know what the
                                             checkbox columns actually do". Widths match the CheckBox
                                             Width below exactly so the labels sit directly above their
                                             own column regardless of window width. -->
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Unlock" Width="30" FontSize="9" TextAlignment="Center"
                                                       Foreground="{ThemeResource ThemeAccentBrush}"/>
                                            <TextBlock Text="Seen" Width="30" FontSize="9" TextAlignment="Center"
                                                       Foreground="{ThemeResource ThemeAccentBrush}"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{x:Bind Topics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:GuideTopicRowViewModel">
                                                    <!-- Plain horizontal StackPanel, not a Grid with a
                                                         Width="*" column - a Star column needs a bounded
                                                         parent width to divide up, which this row doesn't
                                                         reliably get while nested inside a WrapPanel-hosted
                                                         ItemsControl (WrapPanel sizes its children to their
                                                         OWN desired size, so a Star column here measured
                                                         against an effectively unbounded width instead of
                                                         the card's real 320px - user feedback 2026-08-12:
                                                         checkboxes bunched left, name text stranded far
                                                         right with a huge gap). A StackPanel just places
                                                         each child at its own natural width immediately
                                                         after the last, regardless of the parent's
                                                         measurement pass.
                                                         Each CheckBox also gets an explicit small Width/
                                                         Padding="0" - the default WinUI3 CheckBox style
                                                         reserves a generous touch-target/content area even
                                                         with no Content set, which still read as "too far
                                                         apart" with Spacing alone (2nd round of the same
                                                         user feedback). -->
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Padding="0,2">
                                                        <CheckBox Width="30" MinWidth="0" Padding="0" HorizontalContentAlignment="Center"
                                                                  IsChecked="{x:Bind IsUnlocked, Mode=OneWay}"
                                                                  Click="UnlockedCheckBox_Click" Tag="{x:Bind}"/>
                                                        <CheckBox Width="30" MinWidth="0" Padding="0" HorizontalContentAlignment="Center"
                                                                  IsChecked="{x:Bind IsSeen, Mode=OneWay}"
                                                                  Click="SeenCheckBox_Click" Tag="{x:Bind}"/>
                                                        <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" Foreground="{ThemeResource ThemeTextBrush}"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                                   MaxWidth="180"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Invisible "ghost" rows padding this card up to the
                                             tallest visible card's topic count - user feedback
                                             2026-08-12 ("all containers should match the tallest
                                             container"). Uses the EXACT same row template as a real
                                             topic (just hidden) rather than a guessed pixel Height,
                                             so it always matches whatever the real row height
                                             actually renders as. See PaddingCount's own doc comment. -->
                                        <ItemsControl ItemsSource="{x:Bind PaddingIndices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Padding="0,2"
                                                                Opacity="0" IsHitTestVisible="False">
                                                        <CheckBox Width="30" MinWidth="0" Padding="0" IsTabStop="False"/>
                                                        <CheckBox Width="30" MinWidth="0" Padding="0" IsTabStop="False"/>
                                                        <TextBlock Text=" " MaxWidth="180"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                  </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
