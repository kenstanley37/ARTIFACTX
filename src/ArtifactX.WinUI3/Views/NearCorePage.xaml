<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Read-only Tools page: known
     systems ranked by distance to their galaxy's core. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.NearCorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="SYSTEMS NEAR THE CORE" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        ToolTipService.ToolTip="This page follows your game: each time No Man's Sky saves, it updates. It only reads the save.">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}"
                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                           Text="Every star system in your saves' discoveries, closest to its galaxy's core first. Dial a system's portal address to jump straight there and skip the long warp to the centre. Includes systems other players found that the game downloaded for you. Distances are approximate (within about 0.1% of the Galaxy Map)."/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Spacing="12">
        <!-- Where you are now, always visible above the list. -->
        <Border x:Name="HereCard" Visibility="Collapsed" BorderBrush="{ThemeResource ThemeAccentBrush}" BorderThickness="2"
                Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="16,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Background="{ThemeResource ThemeAccentBrush}" CornerRadius="4" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock Text="YOU ARE HERE" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                </Border>
                <TextBlock Grid.Column="1" x:Name="HereTxt" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="Show in list" Click="ShowHere_Click" Padding="10,3"/>
            </Grid>
        </Border>

        <ctcontrols:WrapPanel HorizontalSpacing="18" VerticalSpacing="10">
            <ComboBox x:Name="GalaxyFilterBox" Header="Galaxy" Width="240" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Header="Sort" Width="220" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Closest to the core"/>
                <ComboBoxItem Content="Closest to you"/>
                <ComboBoxItem Content="Most planets known"/>
            </ComboBox>
            <StackPanel Spacing="2" Width="300">
                <TextBlock x:Name="RangeLabelTxt" Text="Within any distance of the core" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13"/>
                <Slider x:Name="RangeSlider" Minimum="0" Maximum="7" StepFrequency="1" TickFrequency="1" TickPlacement="BottomRight"
                        Value="7" ValueChanged="RangeSlider_ValueChanged" IsThumbToolTipEnabled="False"
                        ToolTipService.ToolTip="Only show systems this close to their galaxy's core"/>
            </StackPanel>
            <CheckBox x:Name="MineOnlyBox" Content="Discovered by you" Click="Filter_Click" VerticalAlignment="Bottom"/>
            <CheckBox x:Name="AllSlotsBox" Content="Include my other save slots" IsChecked="True" Click="AllSlotsBox_Click" VerticalAlignment="Bottom"/>
            <Button x:Name="ExportBtn" Content="Export CSV" Click="ExportCsv_Click" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Save the list as shown (with your filters) as a spreadsheet file"/>
            <TextBlock x:Name="CountTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </ctcontrols:WrapPanel>
        </StackPanel>

        <ListView Grid.Row="3" x:Name="SystemsList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:CoreSystemRowViewModel">
                    <Border BorderBrush="{x:Bind RowBorder}" BorderThickness="{x:Bind RowBorderThickness}"
                            Background="{ThemeResource ThemePanelAltBrush}"
                            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Rank}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="Bold" FontSize="16"
                                       Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <Border Visibility="{x:Bind HereVisibility}" Background="{ThemeResource ThemeAccentBrush}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="YOU ARE HERE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{x:Bind NotesLabel}" Visibility="{x:Bind NotesVisibility}" FontSize="12"
                                           Foreground="{ThemeResource ThemeAccentBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="{x:Bind CoreDistance}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold" FontSize="15"
                                           Foreground="{ThemeResource ThemeTextBrush}"/>
                                <TextBlock Text="from the galaxy core" Style="{StaticResource ThemeDimTextStyle}" FontSize="11"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="3">
                                <ItemsControl ItemsSource="{x:Bind Glyphs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ImageSource">
                                            <Border Width="24" Height="24" Background="{ThemeResource ThemeVoidBrush}">
                                                <Image Source="{x:Bind}" Width="20" Height="20"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind PortalCode}" Style="{StaticResource ThemeDimTextStyle}" FontSize="11"
                                           IsTextSelectionEnabled="True" CharacterSpacing="80"/>
                            </StackPanel>
                            <TextBlock Grid.Column="4" Text="{x:Bind FromYou}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="5" Content="Copy" Tag="{x:Bind PortalCode}" Click="CopyCode_Click"
                                    VerticalAlignment="Center" Padding="10,3" ToolTipService.ToolTip="Copy this system's portal address"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
