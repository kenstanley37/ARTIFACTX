<Page x:Class="ArtifactX.WinUI3.Views.RecipeTreePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels" xmlns:controls="using:ArtifactX.WinUI3.Controls">
 <Page.Resources>
  <DataTemplate x:Key="Card" x:DataType="vm:RecipePlanCardViewModel">
   <controls:RecipeRequirementCard ViewModel="{x:Bind}" RecipeChanged="Recipe_Changed"/>
  </DataTemplate>
 </Page.Resources>
 <Grid Padding="28,26,28,24" RowSpacing="14" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TextBlock Text="RECIPE STEPS" Style="{StaticResource ThemePageTitleStyle}"/>
  <TextBlock Grid.Row="1" Text="Gather the starting ingredients, then follow the numbered cards to make your requested recipe. Choose a different recipe on a card to change the steps."
    Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
  <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
   <Button Content="Back to recipes" Click="Back_Click" VerticalAlignment="Bottom"/>
   <NumberBox x:Name="QuantityBox" Header="Quantity to make" Value="1" Minimum="1" Maximum="99999" Width="160"
     SpinButtonPlacementMode="Inline" ValueChanged="Quantity_ValueChanged" AutomationProperties.Name="Quantity to make"/>
   <TextBlock x:Name="TargetTxt" Foreground="{ThemeResource ThemeAccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="450"/>
  </StackPanel>
  <Grid Grid.Row="3" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock x:Name="StatusTxt" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
   <Border Grid.Row="1" Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Padding="12" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
    <StackPanel Spacing="6">
     <TextBlock Text="STARTING INGREDIENTS - SOURCES SHOWN ON THE CARDS BELOW" Foreground="{ThemeResource ThemeAccentBrush}" FontWeight="SemiBold"/>
     <TextBlock x:Name="GatherTxt" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <GridView Grid.Row="2" x:Name="Cards" ItemTemplate="{StaticResource Card}" SelectionMode="None" IsItemClickEnabled="False"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollMode="Disabled">
    <GridView.ItemContainerStyle><Style TargetType="GridViewItem">
     <Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,12,12"/>
    </Style></GridView.ItemContainerStyle>
   </GridView>
  </Grid>
 </Grid>
</Page>
