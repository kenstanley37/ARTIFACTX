<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Tools page: player-recorded
     finds (ships, multi-tools, freighters, item sellers...) with portal addresses,
     stored in user.db (FindsService) - never in the save. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.FindsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="FINDS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        ToolTipService.ToolTip="This page follows your game, so Use my current location and the distances stay up to date. It only reads the save.">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}"
                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                           Text="Keep track of great finds - S-class ships, Multi-Tools, freighters, systems that sell an item you need, where a fish lives, good upgrade spots - with the portal address to get back. Add one while you're there with Use my current location, or paste an address someone shared. Finds are kept by ArtifactX on this PC, not in your save."/>
            </Grid>
        </Border>

        <!-- Where the player is right now (from the save), so a find can be recorded here. -->
        <Border Grid.Row="2" x:Name="HerePanel" Visibility="Collapsed" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE81D;" FontSize="16" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="YOU ARE HERE" Style="{StaticResource ThemeEyebrowStyle}" FontSize="10"/>
                    <TextBlock x:Name="HereSystemTxt" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HerePlaceTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="HereHintTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                               Text="The game only writes a system's name into the save when you save in your ship in space. Save there once, or type the name in the System name box below."/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Add / edit form, collapsed behind a button. -->
        <Border Grid.Row="3" Style="{StaticResource ThemeCardStyle}">
            <StackPanel>
                <Button x:Name="FormToggleBtn" Click="FormToggle_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="18,11">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="FormToggleIcon" Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}"/>
                        <TextBlock x:Name="FormTitleTxt" Text="ADD A FIND" Style="{StaticResource ThemeEyebrowStyle}"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="FormPanel" Visibility="Collapsed" Padding="18,4,18,18" Spacing="12">
                    <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                        <ComboBox x:Name="FormTypeBox" Header="Type" Width="200" SelectionChanged="FormType_Changed"/>
                        <TextBox x:Name="FormTitleBox" Header="Title" Width="340" PlaceholderText="e.g. Red S-class Exotic at the station"/>
                        <ComboBox x:Name="FormClassBox" Header="Class" Width="110"/>
                        <ComboBox x:Name="FormSubtypeBox" Header="Kind" Width="220"/>
                        <TextBox x:Name="FormLocationBox" Header="Where to find it" Width="300"
                                 PlaceholderText="e.g. Space station landing pad, planet 3 crash site"/>
                    </ctcontrols:WrapPanel>

                    <!-- Sells items / Fishing spot: pick items (or fish) from the game's own lists. -->
                    <StackPanel x:Name="FormItemsPanel" Spacing="6" HorizontalAlignment="Left">
                        <AutoSuggestBox x:Name="FormItemSearch" Header="Items sold here" Width="340" QueryIcon="Add"
                                        PlaceholderText="Search an item, e.g. Pugneum"
                                        TextChanged="FormItemSearch_TextChanged" SuggestionChosen="FormItemSearch_SuggestionChosen"/>
                        <ctcontrols:WrapPanel x:Name="FormItemChips" HorizontalSpacing="6" VerticalSpacing="6"/>
                    </StackPanel>

                    <!-- Location: current position from the save, or a pasted address. -->
                    <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Portal address" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="UseHereBtn" Content="Use my current location" Click="UseHere_Click" Style="{StaticResource ThemeAccentButtonStyle}"/>
                                <TextBox x:Name="FormCodeBox" Width="220" PlaceholderText="or paste a code / coordinates" TextChanged="FormCode_TextChanged"/>
                            </StackPanel>
                        </StackPanel>
                        <ComboBox x:Name="FormGalaxyBox" Header="Galaxy" Width="240" SelectionChanged="FormGalaxy_Changed"/>
                        <TextBox x:Name="FormSystemNameBox" Header="System name" Width="220" PlaceholderText="As shown in game"
                                 ToolTipService.ToolTip="The game only writes the system name into the save when you save in space, so type it here if it's missing. It's shared with the Planets page."/>
                        <StackPanel Spacing="4" VerticalAlignment="Bottom">
                            <StackPanel x:Name="FormGlyphsPanel" Orientation="Horizontal" Spacing="2"/>
                            <TextBlock x:Name="FormCodeStatusTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                        </StackPanel>
                    </ctcontrols:WrapPanel>

                    <TextBox x:Name="FormNotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxWidth="760" HorizontalAlignment="Left"
                             PlaceholderText="Anything worth remembering - price, colours, how many slots..."/>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="FormSaveBtn" Content="Save find" Click="FormSave_Click" Style="{StaticResource ThemeAccentButtonStyle}"/>
                        <Button x:Name="FormCancelBtn" Content="Cancel" Click="FormCancel_Click"/>
                        <TextBlock x:Name="FormErrorTxt" Foreground="{ThemeResource ThemeWarningBrush}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <ctcontrols:WrapPanel Grid.Row="4" HorizontalSpacing="14" VerticalSpacing="10">
            <TextBox x:Name="SearchBox" Header="Search" Width="300" PlaceholderText="Title, item sold, fish, notes, system..." TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="TypeFilterBox" Header="Type" Width="220" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="ClassFilterBox" Header="Class" Width="140" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Header="Sort" Width="200" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Newest first"/>
                <ComboBoxItem Content="Nearest to you first"/>
                <ComboBoxItem Content="Title (A to Z)"/>
            </ComboBox>
            <controls:HyperdriveRangeBox VerticalAlignment="Bottom"/>
            <Button x:Name="ExportBtn" Content="Export CSV" Click="ExportCsv_Click" VerticalAlignment="Bottom"
                    ToolTipService.ToolTip="Save the list as shown (with your filters) as a spreadsheet file"/>
            <TextBlock x:Name="CountTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </ctcontrols:WrapPanel>

        <TextBlock Grid.Row="5" x:Name="EmptyTxt" Style="{StaticResource ThemeDimTextStyle}" Visibility="Collapsed" Margin="0,12,0,0"
                   Text="No finds yet. Use Add a find above - next time you spot an S-class ship or a trader with something you need, record it here."/>

        <GridView Grid.Row="5" x:Name="FindsList" SelectionMode="None" IsItemClickEnabled="False">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="340" ItemHeight="250"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,10,10"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:FindCardViewModel">
                    <Border Width="330" Height="240" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                            Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,10">
                        <Grid RowSpacing="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{x:Bind ClassBrush}" CornerRadius="4" Padding="7,1" VerticalAlignment="Center" Visibility="{x:Bind ClassVisibility}">
                                    <TextBlock Text="{x:Bind ClassLetter}" FontWeight="Bold" FontSize="13" Foreground="White"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="0">
                                    <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource ThemeEyebrowStyle}" FontSize="10"/>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Title}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                    <Button Click="Edit_Click" Tag="{x:Bind Id}" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Edit" AutomationProperties.Name="Edit">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{x:Bind Id}" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                <TextBlock Text="{x:Bind Place}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Place}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Spacing="4">
                                <ItemsControl ItemsSource="{x:Bind Items}" Visibility="{x:Bind ItemsVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ctcontrols:WrapPanel HorizontalSpacing="4" VerticalSpacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FindItemChip">
                                            <Border Background="{ThemeResource ThemeVoidBrush}" CornerRadius="4" Padding="4,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Image Source="{x:Bind Icon}" Width="18" Height="18"/>
                                                    <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind Notes}" Visibility="{x:Bind NotesVisibility}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12"
                                           MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Notes}"/>
                            </StackPanel>

                            <Grid Grid.Row="3" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{x:Bind Glyphs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ImageSource">
                                            <Border Width="20" Height="20" Background="{ThemeResource ThemeVoidBrush}">
                                                <Image Source="{x:Bind}" Width="17" Height="17"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Grid.Column="1" Content="Copy" Tag="{x:Bind PortalCode}" Click="CopyCode_Click" Padding="8,2"
                                        ToolTipService.ToolTip="Copy the portal address"/>
                            </Grid>
                            <TextBlock Grid.Row="4" Text="{x:Bind Distance}" Style="{StaticResource ThemeDimTextStyle}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
