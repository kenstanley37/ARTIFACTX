<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.MultiToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <!-- On the page's root element: AdaptiveTriggers attached to a nested
             Grid never fired (2026-10-10 - the narrow layout never applied). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HeaderWide">
                    <VisualState.StateTriggers>
                        <!-- WINDOW width, which includes the ~320px nav pane: two columns
                             need nav + grid card (~720) + sidebar (~340) + gaps/padding.
                             950 left the sidebar clipped beside the grid (2026-10-10). -->
                        <AdaptiveTrigger MinWindowWidth="1440"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                        <Setter Target="ToolInfoBorder.Width" Value="NaN"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="28,26,28,40" Spacing="22" HorizontalAlignment="Stretch">

            <!-- ONE Grid for the whole page body (title row + a single tall
                 content row) rather than Templates living in its own Grid
                 above everything else - a real gap bug (2026-08-01) showed up
                 between the selector and "Technology" once the Templates
                 panel grew a 2nd section (Full Build) and got taller than the
                 title+selector column: with title+selector+Templates in
                 their own Grid, that Grid's own outer height was forced to
                 match whichever column was taller (Templates), pushing
                 everything below it down by the difference even though the
                 selector's own visible content ended much higher up. Fix
                 (same root cause/fix as CompanionsPage's Arena League gap and
                 ShipsPage's identical version of this same bug): put every
                 left-column element (selector, Technology, Class, tech
                 grid+info) in ONE StackPanel and Templates in the other
                 column, both in the SAME Grid row - so the row's height is
                 driven by column 0 (always the taller side), and Templates
                 just renders top-aligned within it with no effect on
                 anything after it, since this is the Grid's last row. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reset button pinned far right of THIS row (not tied to
                     either column below), styled to stand out as a
                     destructive action - its own row so it appearing/
                     disappearing never shifts the selector or Templates. -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MULTI-TOOL" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Multi-Tool Changes" Click="PageResetBtn_Click"
                            Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="22">
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="OWNED MULTI-TOOLS" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <!-- The game doesn't hard-cap how many multi-tools a player can own, so
                                 this strip is bounded and scrolls internally instead of growing the page. -->
                            <ScrollViewer MaxHeight="120" Padding="18,14,18,16" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                <ctcontrols:WrapPanel x:Name="ToolSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- No cargo section (multi-tools don't have one), so the full 10x6
                         grid is shown at once - no scroll cap needed. -->
                    <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock x:Name="TechHeaderTxt" Text="TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="14,12,14,14" Spacing="12">
                                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                                    <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                                    <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                                    <Button Content="Copy Tech Stack..." Click="CopyTechStackBtn_Click"/>
                                </ctcontrols:WrapPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                    <StackPanel x:Name="ClassSelectorPanel" Orientation="Horizontal" Spacing="6"/>
                                </StackPanel>
                                <controls:InventorySlotGrid x:Name="TechGrid"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SidebarPanel is one named unit (Templates + Name/Class/Type/Stats
                     together), matching ShipsPage/FreighterPage's layout exactly - the
                     info panel used to sit in a WrapPanel next to the Tech grid instead,
                     which dropped it BELOW the grid on anything less than a very wide
                     window (WrapPanel wraps well before this page's own HeaderNarrow
                     breakpoint kicks in) and put it in a different place than every other
                     equipment page (2026-08-06 user feedback: "make the other pages look
                     like this for consistency"). The interactive Class selector strip
                     above the grid is untouched - only this read-only-Class-badge info
                     panel moved. -->
                <StackPanel x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                    <Border x:Name="TemplatesBorder" Style="{StaticResource ThemeCardStyle}" Width="320">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="TEMPLATES" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <!-- Tech Stack never touches Stats/Seed/Name; Full Build also carries
                                 Stats + Type (never Name or equip state). -->
                            <StackPanel Padding="18,14,18,18" Spacing="18">
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="TECH STACK" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                        <Button Content="Save Current..." Click="SaveAsTemplateBtn_Click" FontSize="11" Padding="8,3,8,3" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="Apply replaces the selected tool's tech with this template. Never touches Stats or Class unless you opt in."/>
                                    <StackPanel x:Name="TemplatesListPanel" Spacing="8"/>
                                </StackPanel>

                                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,1,0,0"/>

                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="FULL BUILD" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                        <Button Content="Save Current..." Click="SaveAsFullBuildTemplateBtn_Click" FontSize="11" Padding="8,3,8,3" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="Also captures Base Stats and Type - for cloning a whole build onto another tool."/>
                                    <StackPanel x:Name="FullBuildTemplatesListPanel" Spacing="8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Name (NKm), class badge, Type, and Base Stats from OsQ.@bB
                         (WEAPON_DAMAGE/WEAPON_MINING/WEAPON_SCAN). -->
                    <Border x:Name="ToolInfoBorder" Style="{StaticResource ThemeCardStyle}" Width="320">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="MULTI-TOOL DETAILS" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="18,14,18,18" Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBox x:Name="NameEditBox" LostFocus="NameEditBox_LostFocus"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                    <Border x:Name="SelectedToolClassBadge" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,3">
                                        <TextBlock x:Name="SelectedToolClassTxt" Text="—" FontWeight="Bold" FontSize="14"
                                                   FontFamily="{ThemeResource ThemeDisplayFont}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <ComboBox x:Name="TypeComboBox" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="TypeComboBox_SelectionChanged"/>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="BASE STATS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="No known upper limit - extreme values won't corrupt your save, just unbalance it."/>
                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Damage" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="0" Grid.Column="1" x:Name="DamageStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="DamageStatBox_ValueChanged" LostFocus="DamageStatBox_LostFocus"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mining" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="1" Grid.Column="1" x:Name="MiningStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="MiningStatBox_ValueChanged" LostFocus="MiningStatBox_LostFocus"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Scanner" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="2" Grid.Column="1" x:Name="ScannerStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="ScannerStatBox_ValueChanged" LostFocus="ScannerStatBox_LostFocus"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
