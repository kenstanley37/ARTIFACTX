<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.MultiToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Stretch">

            <!-- ONE Grid for the whole page body (title row + a single tall
                 content row) rather than Templates living in its own Grid
                 above everything else - a real gap bug (2026-08-01) showed up
                 between the selector and "Technology" once the Templates
                 panel grew a 2nd section (Full Build) and got taller than the
                 title+selector column: with title+selector+Templates in
                 their own Grid, that Grid's own outer height was forced to
                 match whichever column was taller (Templates), pushing
                 everything below it down by the difference even though the
                 selector's own visible content ended much higher up. Fix
                 (same root cause/fix as CompanionsPage's Arena League gap and
                 ShipsPage's identical version of this same bug): put every
                 left-column element (selector, Technology, Class, tech
                 grid+info) in ONE StackPanel and Templates in the other
                 column, both in the SAME Grid row - so the row's height is
                 driven by column 0 (always the taller side), and Templates
                 just renders top-aligned within it with no effect on
                 anything after it, since this is the Grid's last row. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reset button pinned far right of THIS row (not tied to
                     either column below), styled to stand out as a
                     destructive action - its own row so it appearing/
                     disappearing never shifts the selector or Templates. -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Multi-Tool" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Multi-Tool Changes" Click="PageResetBtn_Click"
                            Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Owned Multi-Tools" FontSize="14" Opacity="0.8"/>
                        <!-- The game doesn't hard-cap how many multi-tools a player can own, so
                             this strip is bounded and scrolls internally (~2 rows) instead of
                             growing the page - a save with a couple dozen tools stays just as
                             usable as one with three. -->
                        <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <ctcontrols:WrapPanel x:Name="ToolSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="TechHeaderTxt" Text="Technology" FontSize="18" FontWeight="SemiBold"/>
                        <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                            <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                            <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                            <Button Content="Copy Tech Stack..." Click="CopyTechStackBtn_Click"/>
                        </ctcontrols:WrapPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Class:" FontSize="14" Opacity="0.8" VerticalAlignment="Center"/>
                        <StackPanel x:Name="ClassSelectorPanel" Orientation="Horizontal" Spacing="6"/>
                    </StackPanel>

                    <!-- No cargo section on this page (multi-tools don't have one) so the
                         full 10x6 grid is shown at once - no scroll cap needed. -->
                    <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="6" Padding="8" HorizontalAlignment="Left" Opacity="0.9">
                        <controls:InventorySlotGrid x:Name="TechGrid"/>
                    </Border>
                </StackPanel>

                <!-- SidebarPanel is one named unit (Templates + Name/Class/Type/Stats
                     together), matching ShipsPage/FreighterPage's layout exactly - the
                     info panel used to sit in a WrapPanel next to the Tech grid instead,
                     which dropped it BELOW the grid on anything less than a very wide
                     window (WrapPanel wraps well before this page's own HeaderNarrow
                     breakpoint kicks in) and put it in a different place than every other
                     equipment page (2026-08-06 user feedback: "make the other pages look
                     like this for consistency"). The interactive Class selector strip
                     above the grid is untouched - only this read-only-Class-badge info
                     panel moved. -->
                <StackPanel x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                    <Border x:Name="TemplatesBorder"
                            BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Opacity="0.9" Width="300">
                        <StackPanel Spacing="18">
                            <!-- Two separate domains on purpose - a Tech Stack template never
                                 touches Stats/Seed/Name, a Full Build template also carries
                                 Stats + Seed (still never Name or equip state). Kept as two
                                 clearly separate lists rather than one merged list with a type
                                 tag, so it's obvious at a glance what a given template will and
                                 won't touch before applying it. -->
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Tech Stack Templates" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="Save Current..." Click="SaveAsTemplateBtn_Click" FontSize="11" Padding="8,3,8,3"/>
                                </StackPanel>
                                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                                           Text="Apply replaces the currently selected tool's tech with this template. Never touches Stats, Seed, or Class unless you opt in."/>
                                <StackPanel x:Name="TemplatesListPanel" Spacing="8"/>
                            </StackPanel>

                            <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="0,1,0,0" Opacity="0.5"/>

                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Full Build Templates" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="Save Current..." Click="SaveAsFullBuildTemplateBtn_Click" FontSize="11" Padding="8,3,8,3"/>
                                </StackPanel>
                                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                                           Text="Also captures Base Stats and Type alongside the tech stack - for cloning a whole build onto another tool. (Multi-Tools don't have an exposed appearance Seed on this page, unlike Ships/Freighter.)"/>
                                <StackPanel x:Name="FullBuildTemplatesListPanel" Spacing="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Name (editable, NKm), class badge, Type, and Base Stats sourced
                         from OsQ.@bB (WEAPON_DAMAGE/WEAPON_MINING/WEAPON_SCAN), matching
                         the Damage Potential / Scanner Range figures the game shows. -->
                    <Border x:Name="ToolInfoBorder" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="8" Padding="16" Opacity="0.9" Width="300">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Name" FontSize="12" Opacity="0.7"/>
                                <TextBox x:Name="NameEditBox" Width="260" LostFocus="NameEditBox_LostFocus"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Class" Opacity="0.7" VerticalAlignment="Center"/>
                                <Border x:Name="SelectedToolClassBadge" CornerRadius="4" Padding="10,3,10,3">
                                    <TextBlock x:Name="SelectedToolClassTxt" Text="—" FontWeight="Bold" FontSize="13"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Type" FontSize="12" Opacity="0.7"/>
                                <ComboBox x:Name="TypeComboBox" Width="260"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="TypeComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Base Stats" FontSize="12" Opacity="0.7"/>
                                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                                           Text="No known upper limit - the game doesn't enforce one. Extreme values won't corrupt your save, just unbalance it."/>
                                <Grid ColumnSpacing="8" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="190"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Damage" VerticalAlignment="Center"/>
                                    <NumberBox Grid.Row="0" Grid.Column="1" x:Name="DamageStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="DamageStatBox_ValueChanged" LostFocus="DamageStatBox_LostFocus"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Mining" VerticalAlignment="Center"/>
                                    <NumberBox Grid.Row="1" Grid.Column="1" x:Name="MiningStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="MiningStatBox_ValueChanged" LostFocus="MiningStatBox_LostFocus"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scanner" VerticalAlignment="Center"/>
                                    <NumberBox Grid.Row="2" Grid.Column="1" x:Name="ScannerStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="ScannerStatBox_ValueChanged" LostFocus="ScannerStatBox_LostFocus"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="HeaderWide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="950"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="HeaderNarrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="SidebarPanel.(Grid.Row)" Value="2"/>
                                <Setter Target="SidebarPanel.(Grid.Column)" Value="0"/>
                                <Setter Target="SidebarPanel.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                                <Setter Target="ToolInfoBorder.Width" Value="NaN"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
