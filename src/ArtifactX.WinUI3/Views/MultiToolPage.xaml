<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.MultiToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <!-- On the page's root element: AdaptiveTriggers attached to a nested
             Grid never fired (2026-10-10 - the narrow layout never applied). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HeaderWide">
                    <VisualState.StateTriggers>
                        <!-- WINDOW width, which includes the ~320px nav pane: two columns
                             need nav + grid card (~720) + sidebar (~340) + gaps/padding.
                             950 left the sidebar clipped beside the grid (2026-10-10). -->
                        <AdaptiveTrigger MinWindowWidth="1440"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="28,26,28,40" Spacing="22" HorizontalAlignment="Stretch">

            <!-- ONE Grid for the whole page body (title row + a single tall
                 content row) rather than Templates living in its own Grid
                 above everything else - a real gap bug (2026-08-01) showed up
                 between the selector and "Technology" once the Templates
                 panel grew a 2nd section (Full Build) and got taller than the
                 title+selector column: with title+selector+Templates in
                 their own Grid, that Grid's own outer height was forced to
                 match whichever column was taller (Templates), pushing
                 everything below it down by the difference even though the
                 selector's own visible content ended much higher up. Fix
                 (same root cause/fix as CompanionsPage's Arena League gap and
                 ShipsPage's identical version of this same bug): put every
                 left-column element (selector, Technology, Class, tech
                 grid+info) in ONE StackPanel and Templates in the other
                 column, both in the SAME Grid row - so the row's height is
                 driven by column 0 (always the taller side), and Templates
                 just renders top-aligned within it with no effect on
                 anything after it, since this is the Grid's last row. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reset button pinned far right of THIS row (not tied to
                     either column below), styled to stand out as a
                     destructive action - its own row so it appearing/
                     disappearing never shifts the selector or Templates. -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="MULTI-TOOL" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Multi-Tool Changes" Click="PageResetBtn_Click"
                            Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="MainColumn" Grid.Row="1" Grid.Column="0" Spacing="22">
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="OWNED MULTI-TOOLS" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <!-- The game doesn't hard-cap how many multi-tools a player can own, so
                                 this strip is bounded and scrolls internally instead of growing the page. -->
                            <ScrollViewer MaxHeight="120" Padding="18,14,18,16" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                <controls:EquipmentStrip x:Name="ToolStrip" ChipClicked="ToolStrip_ChipClicked"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Details above the tech, like Starships (2026-10-15 - they sat at
                         the bottom of the sidebar): Base Stats from OsQ.@bB
                         (WEAPON_DAMAGE/WEAPON_MINING/WEAPON_SCAN) in one wrapping row, then
                         Name (NKm), class badge and Type. -->
                    <Border x:Name="ToolInfoBorder" Style="{StaticResource ThemeCardStyle}">
                        <controls:FoldingCard x:Name="DetailsCard" Title="MULTI-TOOL DETAILS" SettingKey="MultiToolDetailsCollapsed">
                            <StackPanel Padding="18,14,18,18">
                                <!-- Stats, name and type on the left, the 3D preview beside them; it
                                     wraps below on narrow windows - same as Starships (2026-10-16). -->
                                <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                                    <StackPanel MaxWidth="692" Spacing="16">

                                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="16">
                                            <StackPanel Width="280" Spacing="6">
                                                <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <TextBox x:Name="NameEditBox" AutomationProperties.Name="Name" LostFocus="NameEditBox_LostFocus"/>
                                                <HyperlinkButton x:Name="NameUpdateLink" Content="Update game data now" Padding="0" Visibility="Collapsed" Click="NameUpdateLink_Click"/>
                                            </StackPanel>
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <Border x:Name="SelectedToolClassBadge" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,3" HorizontalAlignment="Left">
                                                    <TextBlock x:Name="SelectedToolClassTxt" Text="—" FontWeight="Bold" FontSize="14"
                                                               FontFamily="{ThemeResource ThemeDisplayFont}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Width="240" Spacing="6">
                                                <TextBlock Text="TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <ComboBox x:Name="TypeComboBox" AutomationProperties.Name="Type" HorizontalAlignment="Stretch"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="TypeComboBox_SelectionChanged"/>
                                                <!-- The main model's kind comes from the seed (MultiToolKinds). -->
                                                <TextBlock x:Name="KindTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </ctcontrols:WrapPanel>
                                        <!-- Base stats under who it is (user, 2026-10-22 - they were first). -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="BASE STATS" Style="{StaticResource ThemeEyebrowStyle}"
                                                       ToolTipService.ToolTip="No known upper limit - extreme values won't corrupt your save, just unbalance it."/>
                                            <controls:StatBonusBoxes x:Name="StatsBoxes" Edited="StatsBoxes_Edited"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="ToolPreviewGroup" Width="420" Spacing="6" Visibility="Collapsed">
                                        <TextBlock Text="PREVIEW" Style="{StaticResource ThemeEyebrowStyle}"/>
                                        <controls:ShipPreview x:Name="ToolPreviewView" Height="260"/>
                                        <TextBlock x:Name="ToolPreviewNote" Style="{StaticResource ThemeDimTextStyle}" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ctcontrols:WrapPanel>
                                <!-- Destructive, so out of the way: always the card's bottom right (user, 2026-10-22). -->
                                <Button HorizontalAlignment="Right" Content="Delete this Multi-Tool..." Click="DeleteToolBtn_Click" Foreground="{ThemeResource ThemeWarningBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}" ToolTipService.ToolTip="Remove this Multi-Tool from the save. You can keep it as a template first."/>
                            </StackPanel>
                        </controls:FoldingCard>
                    </Border>

                    <!-- Tech grid with the list of tech this tool can fit beside it, or
                         underneath on a narrow window - same as Starships/Exosuit. -->
                    <controls:InventoryLayout x:Name="TechLayout" ListTitle="MULTI-TOOL TECHNOLOGY">
                        <controls:InventoryLayout.Inventories>
                            <StackPanel Spacing="22">
                                <controls:InventoryCard x:Name="TechCard" Title="TECHNOLOGY" Kind="Technology" Edited="Inventory_Edited">
                                    <controls:InventoryCard.ExtraActions>
                                        <Button Content="Copy Tech Stack..." Click="CopyTechStackBtn_Click"/>
                                    </controls:InventoryCard.ExtraActions>
                                    <controls:InventoryCard.AboveSlots>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                            <controls:ClassPicker x:Name="ClassPicker" ClassChosen="ClassPicker_ClassChosen"/>
                                        </StackPanel>
                                    </controls:InventoryCard.AboveSlots>
                                    <controls:InventorySlotGrid x:Name="TechGrid"/>
                                </controls:InventoryCard>
                            </StackPanel>
                        </controls:InventoryLayout.Inventories>
                        <controls:InventoryLayout.List>
                            <controls:ItemListPanel x:Name="TechListPanel"/>
                        </controls:InventoryLayout.List>
                    </controls:InventoryLayout>
                </StackPanel>

                <!-- SidebarPanel is one named unit (Templates + Name/Class/Type/Stats
                     together), matching ShipsPage/FreighterPage's layout exactly - the
                     info panel used to sit in a WrapPanel next to the Tech grid instead,
                     which dropped it BELOW the grid on anything less than a very wide
                     window (WrapPanel wraps well before this page's own HeaderNarrow
                     breakpoint kicks in) and put it in a different place than every other
                     equipment page (2026-08-06 user feedback: "make the other pages look
                     like this for consistency"). The interactive Class selector strip
                     above the grid is untouched - only this read-only-Class-badge info
                     panel moved. -->
                <StackPanel x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Spacing="20" VerticalAlignment="Top">
                    <Border x:Name="TemplatesBorder" Style="{StaticResource ThemeCardStyle}" Width="320">
                        <controls:LoadoutTemplatesPanel x:Name="TemplatesPanel" SourceKind="MultiTool" NameExample="PvE Rifle Build" FullBuildContents="tech + stats"
                                                      TechStackHint="Apply replaces the selected tool's tech with this template. Never touches Stats or Class unless you opt in."
                                                      FullBuildHint="The whole tool: tech, class, stats, type and look. Add as new puts it in an empty Multi-Tool slot - your other tools aren't changed."/>
                    </Border>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
