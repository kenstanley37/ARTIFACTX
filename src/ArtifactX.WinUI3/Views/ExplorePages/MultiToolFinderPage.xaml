<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Multi-Tool Finder (MultiToolFinderViewModel): what the space station
     cabinets sell in the star systems around you, by kind and class. Read-only - it never changes the save. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.MultiToolFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="MULTI-TOOL FINDER" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Each time No Man's Sky saves somewhere new, the search runs again around you. It only reads the save.">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <controls:FoldingCard Title="SEARCH AND FILTERS" SettingKey="MultiToolFinderSearchCollapsed"
                                          Summary="{x:Bind ViewModel.ResultCount, Mode=OneWay}">
                        <StackPanel Padding="20,16,20,20" Spacing="14">
                            <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                                       Text="The multi-tools the space station cabinets sell in the star systems around you, visited or not. A cabinet's class never changes; the tool it sells depends on where you last loaded the game. Arriving in a system counts as loading in space. For another tool, land on the planet named on the card, save there, reload, then fly up to the station. Stats depend on your own progress: see them on Current System once you're there."/>
                            <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                                <ComboBox Header="Search area" Width="300" SelectedIndex="{x:Bind ViewModel.AreaIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="My region (about 600 systems)"/>
                                    <ComboBoxItem Content="Plus the regions around me (about 10,000 systems)"/>
                                </ComboBox>
                                <ComboBox Header="Sort" Width="200" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Best class first"/>
                                    <ComboBoxItem Content="Nearest to you first"/>
                                </ComboBox>
                                <ComboBox Header="{x:Bind ViewModel.Kind.Header}" Width="{x:Bind ViewModel.Kind.Width}"
                                          ItemsSource="{x:Bind ViewModel.Kind.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Kind.Selected, Mode=TwoWay}"/>
                                <ComboBox Header="Class" Width="180" SelectedIndex="{x:Bind ViewModel.ClassIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Any class"/>
                                    <ComboBoxItem Content="B or better"/>
                                    <ComboBoxItem Content="A or better"/>
                                    <ComboBoxItem Content="S only"/>
                                </ComboBox>
                                <CheckBox Content="Sold on arrival only (no reload needed)" IsChecked="{x:Bind ViewModel.ArrivalOnly, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                            </ctcontrols:WrapPanel>
                        </StackPanel>
                    </controls:FoldingCard>
                    <StackPanel Padding="20,16,20,20" Spacing="14">
                        <Button Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" Click="ClearFilters_Click" Style="{StaticResource ThemeAccentButtonStyle}"
                                Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                                ToolTipService.ToolTip="Clear the kind, class and arrival filters (keeps the area and sort)"/>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                                   Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>

                        <GridView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None" MaxHeight="900"
                                  IsItemClickEnabled="False" AutomationProperties.Name="Multi-tools for sale near you">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,14,14"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="explore:MultiToolFinderRowViewModel">
                                    <Border Width="300" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                            Background="{ThemeResource ThemeVoidBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,12"
                                            AutomationProperties.Name="{x:Bind AutomationName}">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="4" Background="{x:Bind ClassBrush}" VerticalAlignment="Top">
                                                    <TextBlock Text="{x:Bind ClassLetter}" FontSize="16" FontWeight="Bold" FontFamily="{ThemeResource ThemeDisplayFont}"
                                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}"/>
                                                    <TextBlock Text="{x:Bind Kind}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Border Visibility="{x:Bind IsThisGalaxy}" HorizontalAlignment="Left" CornerRadius="4" Padding="8,2"
                                                    Background="{ThemeResource ThemeAccentBrush}">
                                                <TextBlock Text="{x:Bind GalaxyLabel}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                                            </Border>
                                            <Border Visibility="{x:Bind IsOtherGalaxy}" HorizontalAlignment="Left" CornerRadius="4" Padding="8,2"
                                                    BorderThickness="1" BorderBrush="{ThemeResource ThemeWarningBrush}">
                                                <TextBlock Text="{x:Bind GalaxyLabel}" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ThemeWarningBrush}"/>
                                            </Border>
                                            <TextBlock Text="{x:Bind SystemLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SystemLabel}"/>
                                            <TextBlock Text="{x:Bind DistanceLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind CabinetLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12"/>
                                            <TextBlock Text="{x:Bind LoadLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource ThemeTextBrush}"/>
                                            <controls:GlyphStrip Code="{x:Bind PortalCode}" Title="{x:Bind SystemLabel}" GlyphSize="18" Margin="0,4,0,0"/>
                                            <controls:CopyCodeButton Code="{x:Bind PortalCode}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
