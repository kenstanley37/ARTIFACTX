<?xml version="1.0" encoding="utf-8"?>
<!-- One base's own page (BaseDetailsViewModel), opened from the Bases page: where it is,
     its picture faded in behind the header, and its parts by kind and count. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.BaseDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <Style x:Key="InfoCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Background" Value="{ThemeResource ThemePanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource ThemeLineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{ThemeResource ThemeCardCornerRadius}"/>
            <Setter Property="MaxWidth" Value="680"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The base's picture behind the header, faded out at the edges (ShowBackdropAsync) -->
        <Border x:Name="Backdrop" Margin="-12,-8,-12,-6" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Visibility="Collapsed">
            <Border.Background>
                <ImageBrush x:Name="BackdropBrush" Stretch="UniformToFill" Opacity="0.28"/>
            </Border.Background>
        </Border>

        <Grid x:Name="HeaderGrid" ColumnSpacing="24" SizeChanged="HeaderGrid_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <Button Content="‹ All bases" Click="Back_Click" Padding="10,4" Margin="0,0,0,6"/>
                <TextBlock Text="{x:Bind ViewModel.Row.Name}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.Row.Detail}" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.PartsLabel, Mode=OneWay}" Foreground="{x:Bind ViewModel.Row.PartsBrush}" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel.KindsLabel, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasParts}" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                    <Button Content="Delete base…" Click="DeleteBase_Click" Visibility="{x:Bind ViewModel.CanDeleteBase}"
                            ToolTipService.ToolTip="Delete this base and everything built in it from this save"/>
                    <Button Content="Delete from save…" Click="DeleteObject_Click" Visibility="{x:Bind ViewModel.CanDeleteObject}"
                            ToolTipService.ToolTip="Delete this placed object from this save"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" MaxWidth="460">
                <Border Height="200" CornerRadius="6" Visibility="{x:Bind ViewModel.Row.HasPicture}">
                    <Image Source="{x:Bind ViewModel.Row.Picture}" Stretch="UniformToFill"/>
                </Border>
                <TextBlock Text="{x:Bind ViewModel.Row.Facts}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.Row.AreaLabel}" Opacity="{x:Bind ViewModel.Row.AreaOpacity}" FontSize="13"
                           Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                <TextBlock Text="{x:Bind ViewModel.Row.DistanceLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <controls:GlyphStrip Code="{x:Bind ViewModel.Row.PortalCode}" Title="{x:Bind ViewModel.Row.Name}" GlyphSize="24" VerticalAlignment="Center"/>
                    <controls:CopyCodeButton Code="{x:Bind ViewModel.Row.PortalCode}"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Style="{StaticResource InfoCardStyle}" Visibility="{x:Bind ViewModel.IsSettlement}">
                <StackPanel Spacing="8">
                    <TextBlock Text="SETTLEMENT" Style="{StaticResource ThemeEyebrowStyle}"/>
                    <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="These are the parts placed on the settlement's planet - objects placed there and the parts of bases there. Its buildings, citizens and production are on the Settlement page."/>
                    <Button Content="Open the Settlement page ›" Click="OpenSettlement_Click" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource InfoCardStyle}" Visibility="{x:Bind ViewModel.IsPlaced}">
                <StackPanel Spacing="8">
                    <TextBlock Text="PLACED OUTSIDE A BASE" Style="{StaticResource ThemeEyebrowStyle}"/>
                    <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="This was placed on a planet outside any base, so it isn't part of one. It still counts towards the game's limit of 21,000 parts placed in all."/>
                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="To pick it up in game, go to the portal address above and find it at the coordinates shown."/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" ColumnSpacing="14" Visibility="{x:Bind ViewModel.HasParts}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Header="Filter parts" PlaceholderText="Part name..." Width="280"
                         Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Visibility="{x:Bind ViewModel.CanEditParts}">
                    <Button Content="Select all" Click="SelectAll_Click"/>
                    <Button Content="Deselect all" Click="DeselectAll_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
                    <Button Content="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}" Click="DeleteParts_Click"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource ThemeAccentButtonStyle}"
                            ToolTipService.ToolTip="Delete every part of the selected kinds from this base"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.FilterLabel, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}"
                           FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind ViewModel.HasParts}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}" Margin="0,0,12,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="8"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:BasePartViewModel">
                            <Border Width="380" CornerRadius="6" BorderThickness="1"
                                    Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}">
                                <Grid ColumnSpacing="10" Padding="10,6,14,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Visibility="{x:Bind CanSelect}"
                                              MinWidth="0" Padding="0" VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Bind Name}"/>
                                    <Image Grid.Column="1" Source="{x:Bind Icon}" Width="32" Height="32" Visibility="{x:Bind HasIcon}"/>
                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="6" Visibility="{x:Bind ShowGlyph}"
                                            Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource ThemeTextBrush}" ToolTipService.ToolTip="{x:Bind Name}"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind CountLabel}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{ThemeResource ThemeAccentBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
