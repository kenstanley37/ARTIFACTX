<?xml version="1.0" encoding="utf-8"?>
<!-- Dedicated drill-down page for itemized base building parts and colony telemetry.
     Extracted from BasesPage to prevent 21,000+ parts from loading on the overview page. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.BaseDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: Back button & Title -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Content="‹ All bases" Click="BackBtn_Click" Padding="12,6" VerticalAlignment="Center" Margin="0,0,16,0"
                    ToolTipService.ToolTip="Return to categorized bases overview"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="BaseTitleTxt" Style="{StaticResource ThemePageTitleStyle}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="BaseSubTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                <TextBlock x:Name="BasePartsTxt" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="BaseKindsTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- System, Planet, and Glyph overview banner -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="16,12">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="LOCATION &amp; TELEMETRY" Style="{StaticResource ThemeEyebrowStyle}"/>
                    <TextBlock x:Name="BaseFactsTxt" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BaseAreaTxt" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <TextBlock x:Name="BaseDistanceTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <controls:GlyphStrip x:Name="BaseGlyphStrip" VerticalAlignment="Center">
                        <ItemsControl x:Name="BaseGlyphs">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ImageSource">
                                    <Border Width="24" Height="24" Background="{ThemeResource ThemeVoidBrush}">
                                        <Image Source="{x:Bind}" Width="20" Height="20"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </controls:GlyphStrip>
                    <Button x:Name="BaseCopyBtn" Content="Copy" Click="CopyCode_Click" Padding="10,4" VerticalAlignment="Center" ToolTipService.ToolTip="Copy portal glyph code"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: Parts search and grid -->
        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search parts and bulk selection toolbar -->
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PartSearchBox" Header="Filter parts in base" PlaceholderText="Search part names..." Width="280" TextChanged="PartSearchBox_TextChanged"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,2">
                    <Button x:Name="SelectAllPartsBtn" Content="Select All" Click="SelectAllParts_Click"
                            ToolTipService.ToolTip="Select all part types"/>
                    <Button x:Name="DeselectAllPartsBtn" Content="Deselect All" Click="DeselectAllParts_Click"
                            ToolTipService.ToolTip="Deselect all part types"/>
                    <Button x:Name="DeletePartsBtn" Content="Delete Selected" Click="DeleteParts_Click"
                            IsEnabled="False" Style="{StaticResource ThemeAccentButtonStyle}"
                            ToolTipService.ToolTip="Delete selected parts from this base"/>
                </StackPanel>
                <TextBlock x:Name="PartsSummaryCountTxt" Grid.Column="3" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>

            <!-- Parts wrap panel inside ScrollViewer -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ctcontrols:WrapPanel x:Name="PartsPanel" HorizontalSpacing="10" VerticalSpacing="8" Margin="0,0,12,16"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
