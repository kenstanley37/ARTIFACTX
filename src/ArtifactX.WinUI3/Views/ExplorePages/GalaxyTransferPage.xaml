<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.GalaxyTransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="28,24,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <!-- Row 0: Page Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Current Location Banner -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Main Content (Browser on Left, Details & Transfer Action on Right) -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Spacing="6">
                <Grid>
                    <TextBlock Text="GALAXY TRANSFER" Style="{StaticResource ThemePageTitleStyle}"/>
                    <Border HorizontalAlignment="Right" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="4" Padding="8,4" Visibility="{x:Bind ViewModel.IsTransferStaged, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}"/>
                            <TextBlock Text="Save Safe: Staged Edits" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ThemeDoneBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="Warp your starship to any of the 256 galaxies in No Man's Sky. You will spawn safely docked inside an active space station in a Gateway system near the galactic core."
                           Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Current Location Banner -->
            <Border Grid.Row="1" Style="{StaticResource ThemeCardStyle}">
                <Grid Padding="18,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,14,0">
                        <FontIcon Glyph="&#xE909;" FontSize="18" Foreground="{ThemeResource ThemeAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="CURRENT LOCATION" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.CurrentGalaxyTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                            <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{x:Bind ViewModel.CurrentGalaxyClassification, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ThemeAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="256 Galaxies Available" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Main Content Grid (Browser on Left, Details & Transfer Action on Right) -->
            <Grid Grid.Row="2" ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="500"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Search, Filters, and Galaxy List -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <Grid Padding="16,14,16,16" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <TextBox PlaceholderText="Search by name, number, or presence..."
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filter galaxies by name or number"/>

                        <!-- Dual Filter Rows: Presence & Biome Categories -->
                        <StackPanel Grid.Row="1" Spacing="8">
                            <!-- Presence Filters -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="{x:Bind ViewModel.AllFilterLabel, Mode=OneWay}" Click="FilterAll_Click" Padding="8,3" FontSize="11"/>
                                <Button Content="{x:Bind ViewModel.UnvisitedFilterLabel, Mode=OneWay}" Click="FilterUnvisited_Click" Padding="8,3" FontSize="11"/>
                                <Button Content="{x:Bind ViewModel.VisitedFilterLabel, Mode=OneWay}" Click="FilterVisited_Click" Padding="8,3" FontSize="11"/>
                                <Button Content="{x:Bind ViewModel.BasesFilterLabel, Mode=OneWay}" Click="FilterBases_Click" Padding="8,3" FontSize="11"/>
                                <Button Content="{x:Bind ViewModel.StationsFilterLabel, Mode=OneWay}" Click="FilterStations_Click" Padding="8,3" FontSize="11"/>
                            </StackPanel>

                            <!-- Biome Category Filters -->
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="All Types" Click="FilterTypeAll_Click" Padding="6,2" FontSize="10"/>
                                <Button Content="Lush (25)" Click="FilterLush_Click" Padding="6,2" FontSize="10"/>
                                <Button Content="Harsh (26)" Click="FilterHarsh_Click" Padding="6,2" FontSize="10"/>
                                <Button Content="Empty (26)" Click="FilterEmpty_Click" Padding="6,2" FontSize="10"/>
                                <Button Content="Normal (179)" Click="FilterNormal_Click" Padding="6,2" FontSize="10"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Divider Line -->
                        <Border Grid.Row="2" Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,2,0,2"/>

                        <!-- Galaxy ListView Container -->
                        <Border Grid.Row="3" Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}"
                                BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                            <ListView ItemsSource="{x:Bind ViewModel.FilteredGalaxies, Mode=OneWay}"
                                      SelectedItem="{x:Bind ViewModel.SelectedGalaxy, Mode=TwoWay}"
                                      SelectionMode="Single"
                                      AutomationProperties.Name="List of galaxies">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="explore:GalaxyRowViewModel">
                                        <Grid Padding="8,8" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Number}" FontSize="13" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                                <TextBlock Text="{x:Bind ClassificationName}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- HERE Badge -->
                                                <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                        Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                                                    <TextBlock Text="HERE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ThemeDoneBrush}"/>
                                                </Border>
                                                <!-- Bases Badge -->
                                                <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeAccentBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                        Visibility="{x:Bind HasBases, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind PresenceSummary, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind BasesBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                </Border>
                                                <!-- Stations Badge -->
                                                <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="6,2"
                                                        Visibility="{x:Bind HasStations, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind PresenceSummary, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind StationsBadgeText, Mode=OneWay}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ThemeWarningBrush}"/>
                                                </Border>
                                                <!-- Unvisited Badge -->
                                                <Border Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}"
                                                        BorderThickness="1" CornerRadius="4" Padding="5,2"
                                                        Visibility="{x:Bind IsUnvisited, Mode=OneWay}">
                                                    <TextBlock Text="UNVISITED" FontSize="9" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Column: Selected Galaxy Details & Warp Action (Independently Scrollable) -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16" Margin="0,0,12,0">

                    <!-- Selected Galaxy Overview Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="16">
                            <TextBlock Text="SELECTED DESTINATION" Style="{StaticResource ThemeEyebrowStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.FormattedTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.ClassificationName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Internal Index:" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.RealityIndex, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource ThemeLineBrush}"/>

                            <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.Description, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                    </Border>

                    <!-- Player Presence in this Galaxy Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="YOUR PRESENCE IN THIS GALAXY" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.PresenceSummary, Mode=OneWay}"
                                               FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.Presence.StatusBadgeText, Mode=OneWay}"
                                               FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                </Border>
                            </Grid>

                            <!-- Bases List (if any) -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedGalaxy.HasBases, Mode=OneWay}">
                                <Border Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,2"/>
                                <TextBlock Text="REGISTERED BASES" Style="{StaticResource ThemeEyebrowStyle}" FontSize="11"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedGalaxy.Bases, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <TextBlock Text="⌂" Foreground="{ThemeResource ThemeAccentBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind}" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Space Stations List (if any) -->
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.SelectedGalaxy.HasStations, Mode=OneWay}">
                                <Border Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,2"/>
                                <TextBlock Text="TELEPORT NETWORK SPACE STATIONS" Style="{StaticResource ThemeEyebrowStyle}" FontSize="11"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedGalaxy.Stations, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                                <TextBlock Text="✦" Foreground="{ThemeResource ThemeWarningBrush}" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind}" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Gateway Space Station Details Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="14">
                            <TextBlock Text="GATEWAY SPACE STATION &amp; CORE PROXIMITY" Style="{StaticResource ThemeEyebrowStyle}"/>

                            <Grid RowSpacing="10" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Destination Point:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Gateway Space Station (Docking Bay Walkway)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}"/>

                                <TextBlock Grid.Row="1" Text="Distance to Galactic Core:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.DistanceToCoreText}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    <TextBlock Text="(Gateway distance for core jumps)" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Galactic Coordinates:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GatewayCoordinatesText}" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}"/>

                                <TextBlock Grid.Row="3" Text="Portal Glyph Address:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <controls:GlyphStrip Code="{x:Bind ViewModel.GatewayPortalGlyphs}" Title="{x:Bind ViewModel.SelectedGalaxy.Name, Mode=OneWay}" GlyphSize="26" VerticalAlignment="Center"/>
                                    <controls:CopyCodeButton Code="{x:Bind ViewModel.GatewayPortalGlyphs}" Padding="8,3" Content="Copy Glyphs" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,4"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Safe Arrival Guarantee:" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock Text="• Your player character is safely positioned on foot inside the station docking bay walkway." Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                <TextBlock Text="• Your primary starship is docked on the landing pad directly beside you." Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                <TextBlock Text="• The station is automatically registered in your Teleport Network for easy return visits." Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Staging & Actions Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="14">
                            <TextBlock Text="ACTIONS &amp; SAVE STAGING" Style="{StaticResource ThemeEyebrowStyle}"/>

                            <TextBlock Text="{x:Bind ViewModel.StagedStatusMessage, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="{x:Bind ViewModel.TransferActionText, Mode=OneWay}"
                                        Click="Transfer_Click"
                                        IsEnabled="{x:Bind ViewModel.CanTransfer, Mode=OneWay}"
                                        Style="{StaticResource ThemeAccentButtonStyle}"
                                        Padding="18,10"
                                        AutomationProperties.Name="Transfer starship to selected galaxy space station"/>

                                <Button Content="Revert Transfer"
                                        Click="Revert_Click"
                                        IsEnabled="{x:Bind ViewModel.IsTransferStaged, Mode=OneWay}"
                                        Padding="14,10"
                                        AutomationProperties.Name="Revert staged galaxy transfer"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
    </Grid>
</Page>
