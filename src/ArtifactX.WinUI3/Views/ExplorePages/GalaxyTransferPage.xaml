<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.GalaxyTransferPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,26,28,40" Spacing="20">

            <!-- Title & Live status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="GALAXY TRANSFER" Style="{StaticResource ThemePageTitleStyle}"/>
                    <TextBlock Text="Warp your starship to any of the 256 galaxies in No Man's Sky. You will spawn safely docked inside an active space station in a Gateway system near the galactic core."
                               Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Save Safe · Staged Edits" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Current Location Banner -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <Grid Padding="18,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="28" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="CURRENT LOCATION" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.CurrentGalaxyTitle, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                            <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{x:Bind ViewModel.CurrentGalaxyClassification, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource ThemeAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="256 Galaxies Available" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Main Content Grid (Browser on Left, Details & Transfer Action on Right) -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Search, Filter, and Galaxy List -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <Grid Padding="16,14,16,16" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Search Box -->
                        <TextBox PlaceholderText="Search by name or galaxy number (1..256)..."
                                 Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Filter galaxies by name or number"/>

                        <!-- Type Filters -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="All (256)" Click="FilterAll_Click" Padding="8,4"/>
                            <Button Content="Lush (25)" Click="FilterLush_Click" Padding="8,4"/>
                            <Button Content="Harsh (26)" Click="FilterHarsh_Click" Padding="8,4"/>
                            <Button Content="Empty (26)" Click="FilterEmpty_Click" Padding="8,4"/>
                            <Button Content="Normal (179)" Click="FilterNormal_Click" Padding="8,4"/>
                        </StackPanel>

                        <!-- Galaxy ListView -->
                        <ListView Grid.Row="2" Height="480" ItemsSource="{x:Bind ViewModel.FilteredGalaxies, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedGalaxy, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  AutomationProperties.Name="List of galaxies">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="explore:GalaxyRowViewModel">
                                    <Grid Padding="8,6" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Number}" FontSize="13" Foreground="{ThemeResource ThemeTextDimBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                            <TextBlock Text="{x:Bind ClassificationName}" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Visibility="{x:Bind IsCurrent, Mode=OneWay}">
                                            <TextBlock Text="HERE" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource ThemeDoneBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Right Column: Selected Galaxy Details & Warp Action -->
                <StackPanel Grid.Column="1" Spacing="16">

                    <!-- Selected Galaxy Overview Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="16">
                            <TextBlock Text="SELECTED DESTINATION" Style="{StaticResource ThemeEyebrowStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.FormattedTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.ClassificationName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Top">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Internal Index:" FontSize="11" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.RealityIndex, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="{ThemeResource ThemeTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource ThemeLineBrush}"/>

                            <TextBlock Text="{x:Bind ViewModel.SelectedGalaxy.Description, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap" LineHeight="19"/>
                        </StackPanel>
                    </Border>

                    <!-- Gateway Space Station Details Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="14">
                            <TextBlock Text="GATEWAY SPACE STATION &amp; CORE PROXIMITY" Style="{StaticResource ThemeEyebrowStyle}"/>

                            <Grid RowSpacing="10" ColumnSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Destination Point:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="Gateway Space Station (Docking Bay Walkway)" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}"/>

                                <TextBlock Grid.Row="1" Text="Distance to Galactic Core:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.DistanceToCoreText}" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    <TextBlock Text="(Gateway distance for core jumps)" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Text="Galactic Coordinates:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.GatewayCoordinatesText}" FontSize="13" Foreground="{ThemeResource ThemeTextBrush}"/>

                                <TextBlock Grid.Row="3" Text="Portal Glyph Address:" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind ViewModel.GatewayPortalGlyphs}" FontFamily="Consolas" FontWeight="Bold" FontSize="14" Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Copy Glyphs" Click="CopyGlyphs_Click" Padding="8,2" FontSize="11"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,4"/>

                            <StackPanel Spacing="6">
                                <TextBlock Text="Safe Arrival Guarantee:" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock Text="• Your player character is safely positioned on foot inside the station docking bay walkway." Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                <TextBlock Text="• Your primary starship is docked on the landing pad directly beside you." Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                <TextBlock Text="• The station is automatically registered in your Teleport Network for easy return visits." Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Staging & Actions Card -->
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel Padding="22,18,22,20" Spacing="14">
                            <TextBlock Text="ACTIONS &amp; SAVE STAGING" Style="{StaticResource ThemeEyebrowStyle}"/>

                            <TextBlock Text="{x:Bind ViewModel.StagedStatusMessage, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="{x:Bind ViewModel.TransferActionText, Mode=OneWay}"
                                        Click="Transfer_Click"
                                        IsEnabled="{x:Bind ViewModel.CanTransfer, Mode=OneWay}"
                                        Style="{StaticResource ThemeAccentButtonStyle}"
                                        Padding="18,10"
                                        AutomationProperties.Name="Transfer starship to selected galaxy space station"/>

                                <Button Content="Revert Transfer"
                                        Click="Revert_Click"
                                        IsEnabled="{x:Bind ViewModel.IsTransferStaged, Mode=OneWay}"
                                        Padding="14,10"
                                        AutomationProperties.Name="Revert staged galaxy transfer"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>

