<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Trade Finder (TradeFinderViewModel): which space stations around you
     sell an item and for how much, worked out with the game's own rules. Read-only - it never changes the save. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.TradeFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="TRADE FINDER" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Each time No Man's Sky saves somewhere new, the search runs again around you. It only reads the save.">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel Padding="20,16,20,20" Spacing="14">
                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="Where the space stations around you sell an item and what it costs there, visited or not, worked out with the game's own rules and your save's difficulty settings. Prices are before anything you buy or sell yourself moves them."/>
                    <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                        <ComboBox Header="{x:Bind ViewModel.Item.Header}" Width="{x:Bind ViewModel.Item.Width}"
                                  ItemsSource="{x:Bind ViewModel.Item.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Item.Selected, Mode=TwoWay}"
                                  AutomationProperties.Name="Item to buy"/>
                        <ComboBox Header="Search area" Width="300" SelectedIndex="{x:Bind ViewModel.AreaIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="My region (about 600 systems)"/>
                            <ComboBoxItem Content="Plus the regions around me (about 10,000 systems)"/>
                        </ComboBox>
                        <ComboBox Header="Sort" Width="200" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Cheapest first"/>
                            <ComboBoxItem Content="Nearest to you first"/>
                        </ComboBox>
                    </ctcontrols:WrapPanel>
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                               Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap"/>
                    <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" Style="{StaticResource ThemeEyebrowStyle}"/>

                    <GridView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None" MaxHeight="900"
                              IsItemClickEnabled="False" AutomationProperties.Name="Space stations selling the item">
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,14,14"/>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="explore:TradeFinderRowViewModel">
                                <Border Width="300" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                        Background="{ThemeResource ThemeVoidBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,12"
                                        AutomationProperties.Name="{x:Bind AutomationName}">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{x:Bind Icon}" Width="32" Height="32" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{x:Bind PriceLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind KindLabel}" FontSize="12" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind SystemLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind SystemLabel}"/>
                                        <TextBlock Text="{x:Bind EconomyLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                        <TextBlock Text="{x:Bind DistanceLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                        <controls:GlyphStrip Code="{x:Bind PortalCode}" Title="{x:Bind SystemLabel}" GlyphSize="18" Margin="0,4,0,0"/>
                                        <controls:CopyCodeButton Code="{x:Bind PortalCode}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
