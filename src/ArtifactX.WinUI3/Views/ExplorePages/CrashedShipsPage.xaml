<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.CrashedShipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:explore="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,26,28,40" Spacing="20">

            <!-- Title & Live status -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.SystemHeading, Mode=OneWay}" Style="{StaticResource ThemePageTitleStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.SystemLocation, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Filters Bar Card -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel Padding="18,14,18,16" Spacing="14">
                    <TextBlock Text="SEARCH FILTERS" Style="{StaticResource ThemeEyebrowStyle}"/>

                    <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="14">
                        <ComboBox Header="Target Planet" MinWidth="220" ItemsSource="{x:Bind ViewModel.PlanetChoices, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedPlanet, Mode=TwoWay}"
                                  AutomationProperties.Name="Planet to search for crashed ships"/>

                        <RadioButtons Header="Class" MaxColumns="5" ItemsSource="{x:Bind ViewModel.ShipClassChoices}"
                                      SelectedIndex="{x:Bind ViewModel.ShipClassChoice, Mode=TwoWay}"
                                      AutomationProperties.Name="Class of crashed ship"/>

                        <ComboBox Header="Ship Type" MinWidth="180" ItemsSource="{x:Bind ViewModel.ShipTypeOptions, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedShipType, Mode=TwoWay}"
                                  AutomationProperties.Name="Type of crashed ship"/>

                        <ComboBox Header="Show Count" MinWidth="100" ItemsSource="{x:Bind ViewModel.ShipCountChoices}"
                                  SelectedIndex="{x:Bind ViewModel.ShipCountChoice, Mode=TwoWay}"
                                  AutomationProperties.Name="Number of crashed ships to display"/>
                    </ctcontrols:WrapPanel>

                    <Border Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,2"/>

                    <Grid>
                        <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ship Cards Grid -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.CrashedShips, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="explore:CrashedShipRowViewModel">
                        <Border Width="380" Padding="14,12" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                Background="{ThemeResource ThemeVoidBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                            <controls:CrashedShipRow Row="{x:Bind}"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</Page>

