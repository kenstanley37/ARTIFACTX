<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Planet Finder (PlanetFinderViewModel):
     every planet in the save's discoveries, searched and filtered, and the glyph decoder.
     Read-only - it never changes the save. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.PlanetFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PLANET FINDER" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Distances follow your game: each time No Man's Sky saves, they're measured from where you are. It only reads the save.">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ThemeCardStyle}">
                <controls:FoldingCard Title="GLYPH DECODER" SettingKey="PlanetFinderDecoderCollapsed">
                    <controls:GlyphDecoder/>
                </controls:FoldingCard>
            </Border>

            <!-- Search and filters: one row with what most searches need (search, planet type, sort, rings, infested);
                 the rest opens under More filters, whose label counts the ones in use so nothing hides unseen.
                 The results are their own card below. -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <controls:FoldingCard Title="SEARCH AND FILTERS" SettingKey="PlanetFinderSearchCollapsed"
                                      Summary="{x:Bind ViewModel.FilterSummary, Mode=OneWay}">
                    <controls:FoldingCard.HeaderContent>
                        <Button Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" Click="ClearFilters_Click" Padding="12,2" FontSize="12" Margin="0,0,12,0"
                                Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                                ToolTipService.ToolTip="Clear the search and every filter, back to the galaxy you're in (keeps your sort and hyperdrive range)"/>
                    </controls:FoldingCard.HeaderContent>
                    <StackPanel Padding="20,16,20,20" Spacing="14">
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                                   Text="Every planet in your saves' discoveries (including ones other players found that the game downloaded for you), and every planet around you worked out the way the game does. Pick a type to find the nearest one, then dial its portal address at any portal. Distances are approximate, measured from where this save is now."/>
                        <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                            <TextBox Width="320" Header="Search" PlaceholderText="Names, notes, resources, weather..."
                                     Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTipService.ToolTip="Finds planets whose name, system name, your notes, recorded details or creatures contain this text"/>
                            <ComboBox Header="{x:Bind ViewModel.Type.Header}" Width="{x:Bind ViewModel.Type.Width}"
                                      ItemsSource="{x:Bind ViewModel.Type.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Type.Selected, Mode=TwoWay}"/>
                            <ComboBox Header="Sort" Width="220" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Nearest to you first"/>
                                <ComboBoxItem Content="Newest first"/>
                                <ComboBoxItem Content="Furthest from galaxy core"/>
                                <ComboBoxItem Content="Nearest to galaxy core"/>
                            </ComboBox>
                            <CheckBox Content="{x:Bind ViewModel.RingsLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.RingsOnly, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                            <CheckBox Content="{x:Bind ViewModel.InfestedLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.InfestedOnly, Mode=TwoWay}"
                                      Visibility="{x:Bind ViewModel.ShowInfested, Mode=OneWay}" VerticalAlignment="Bottom"
                                      ToolTipService.ToolTip="Planets of the infested kind, where Whispering Eggs and the small ground worms are. Combine it with Planet type for, say, infested Lush planets."/>
                            <ToggleButton Content="{x:Bind ViewModel.MoreFiltersLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.ShowMoreFilters, Mode=TwoWay}"
                                          VerticalAlignment="Bottom"
                                          ToolTipService.ToolTip="Galaxy, region, sentinels, life, resources, star colour, economy and the other filters"/>
                        </ctcontrols:WrapPanel>

                        <StackPanel Spacing="20" Visibility="{x:Bind ViewModel.ShowMoreFilters, Mode=OneWay}">
                            <Border Height="1" Margin="0,6,0,0" Background="{ThemeResource ThemeLineBrush}"/>

                            <StackPanel Spacing="10">
                                <TextBlock Text="WHERE TO LOOK" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                                    <ComboBox Header="{x:Bind ViewModel.Galaxy.Header}" Width="{x:Bind ViewModel.Galaxy.Width}"
                                              ItemsSource="{x:Bind ViewModel.Galaxy.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Galaxy.Selected, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Starts on the galaxy you're in: a portal can't take you to another galaxy"/>
                                    <ComboBox Header="{x:Bind ViewModel.Region.Header}" Width="{x:Bind ViewModel.Region.Width}"
                                              ItemsSource="{x:Bind ViewModel.Region.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Region.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="Undiscovered planets" Width="260" SelectedIndex="{x:Bind ViewModel.NearbyIndex, Mode=TwoWay}"
                                              ToolTipService.ToolTip="Planets not in your saves, worked out the way the game does, so the list isn't limited to what your save still remembers">
                                        <ComboBoxItem Content="Your region and the ones around it"/>
                                        <ComboBoxItem Content="Your region only"/>
                                        <ComboBoxItem Content="None (your saves only)"/>
                                    </ComboBox>
                                    <controls:HyperdriveRangeBox/>
                                    <CheckBox Content="Discovered by you" IsChecked="{x:Bind ViewModel.MineOnly, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                                </ctcontrols:WrapPanel>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="PLANET DETAILS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                                    <ComboBox Header="Planets / moons (your notes)" Width="220" SelectedIndex="{x:Bind ViewModel.BodiesIndex, Mode=TwoWay}"
                                              Visibility="{x:Bind ViewModel.ShowBodies, Mode=OneWay}">
                                        <ComboBoxItem Content="Planets and moons"/>
                                        <ComboBoxItem Content="Planets only"/>
                                        <ComboBoxItem Content="Moons only"/>
                                    </ComboBox>
                                    <ComboBox Header="{x:Bind ViewModel.Sentinels.Header}" Width="{x:Bind ViewModel.Sentinels.Width}" Visibility="{x:Bind ViewModel.Sentinels.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Sentinels.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Sentinels.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Flora.Header}" Width="{x:Bind ViewModel.Flora.Width}" Visibility="{x:Bind ViewModel.Flora.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Flora.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Flora.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Fauna.Header}" Width="{x:Bind ViewModel.Fauna.Width}" Visibility="{x:Bind ViewModel.Fauna.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Fauna.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Fauna.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Resource.Header}" Width="{x:Bind ViewModel.Resource.Width}" Visibility="{x:Bind ViewModel.Resource.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Resource.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Resource.Selected, Mode=TwoWay}"/>
                                </ctcontrols:WrapPanel>
                                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.ShowPlanetNotesHint, Mode=OneWay}"
                                           Text="Record a planet's sentinels, life and resources on its page, or a system's moons on Current System, and filters for them appear here."/>
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Text="STAR SYSTEM" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                                    <ComboBox Header="{x:Bind ViewModel.Star.Header}" Width="{x:Bind ViewModel.Star.Width}" Visibility="{x:Bind ViewModel.Star.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Star.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Star.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Economy.Header}" Width="{x:Bind ViewModel.Economy.Width}" Visibility="{x:Bind ViewModel.Economy.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Economy.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Economy.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Wealth.Header}" Width="{x:Bind ViewModel.Wealth.Width}" Visibility="{x:Bind ViewModel.Wealth.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Wealth.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Wealth.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Conflict.Header}" Width="{x:Bind ViewModel.Conflict.Width}" Visibility="{x:Bind ViewModel.Conflict.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Conflict.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Conflict.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Race.Header}" Width="{x:Bind ViewModel.Race.Width}" Visibility="{x:Bind ViewModel.Race.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Race.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Race.Selected, Mode=TwoWay}"/>
                                    <ComboBox Header="{x:Bind ViewModel.Ship.Header}" Width="{x:Bind ViewModel.Ship.Width}" Visibility="{x:Bind ViewModel.Ship.IsShown, Mode=OneWay}"
                                              ItemsSource="{x:Bind ViewModel.Ship.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Ship.Selected, Mode=TwoWay}"/>
                                </ctcontrols:WrapPanel>
                                <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="4">
                                    <CheckBox Content="{x:Bind ViewModel.WaterLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.WaterOnly, Mode=TwoWay}"
                                              Visibility="{x:Bind ViewModel.ShowWater, Mode=OneWay}"
                                              ToolTipService.ToolTip="Systems known to have water: a Water World among their planets, a fish you caught there, a Galaxy Map card that said Water, or ticked in your notes."/>
                                    <CheckBox Content="{x:Bind ViewModel.DissonantLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DissonantOnly, Mode=TwoWay}"
                                              Visibility="{x:Bind ViewModel.ShowDissonant, Mode=OneWay}"
                                              ToolTipService.ToolTip="Only systems recorded as dissonant - read off the game screen, or ticked in your notes. Systems not recorded yet are left out."/>
                                </ctcontrols:WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </controls:FoldingCard>
            </Border>

            <!-- The results: their own card, with the count and export in its band. -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RESULTS" Style="{StaticResource ThemeBandTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" FontSize="12" Opacity="0.8"
                                       Foreground="{ThemeResource ThemeBandTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="ExportBtn" Grid.Column="2" Content="Export CSV" Click="ExportCsv_Click" Padding="12,2" FontSize="12" Margin="0,-6"
                                    VerticalAlignment="Center" ToolTipService.ToolTip="Save the list as shown (with your filters) as a spreadsheet file"/>
                        </Grid>
                    </Border>
                    <StackPanel Padding="20,16,20,20" Spacing="14">
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                                   Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ViewModel.ShownNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasShownNote, Mode=OneWay}"
                                   Foreground="{ThemeResource ThemeTextBrush}" FontSize="12" TextWrapping="Wrap"/>

                        <!-- Result cards (same width as the Current System planet cards). Bounded height so the GridView
                             virtualizes inside the page's ScrollViewer (an unbounded one would realize every card). -->
                        <GridView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None" MaxHeight="900"
                                  IsItemClickEnabled="True" ItemClick="Results_ItemClick">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,14,14"/>
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PlanetRowViewModel">
                                    <Border Width="372" Height="250" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                            Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,12">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="44" Height="30" VerticalAlignment="Top">
                                                    <Ellipse Width="26" Height="26" Fill="{x:Bind Swatch}"/>
                                                    <Ellipse Width="44" Height="11" StrokeThickness="2" Stroke="{ThemeResource ThemeTextDimBrush}"
                                                             Visibility="{x:Bind HasRings}" RenderTransformOrigin="0.5,0.5">
                                                        <Ellipse.RenderTransform>
                                                            <RotateTransform Angle="-18"/>
                                                        </Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{x:Bind NameLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{x:Bind LocationLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind LocationLabel}"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Spacing="2">
                                                <TextBlock Text="{x:Bind FactsLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource ThemeAccentBrush}" ToolTipService.ToolTip="{x:Bind FactsLabel}"/>
                                                <TextBlock Text="{x:Bind NotesLabel}" Visibility="{x:Bind HasNotes}" FontSize="12" Style="{StaticResource ThemeDimTextStyle}"
                                                           TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind NotesLabel}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Spacing="2">
                                                <TextBlock Text="{x:Bind DistanceLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind DistanceLabel}"/>
                                                <TextBlock Text="{x:Bind DiscoveredLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                                                <controls:GlyphStrip Code="{x:Bind PortalCode}" Title="{x:Bind NameLabel}" GlyphSize="20"/>
                                                <controls:CopyCodeButton Code="{x:Bind PortalCode}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
