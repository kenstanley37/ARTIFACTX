<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Every colour, font and corner
     comes from the active theme's Theme* keys via ThemeStyles.xaml, so the
     same markup renders correctly in both Station Core and Galaxy Map. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.PlanetDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtifactX.WinUI3.Views.ExplorePages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer x:Name="PageScrollViewer" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,22,28,40" Spacing="18">

            <!-- 1. Top Navigation Bar -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Content="‹  Back to Planets" Click="BackButton_Click"
                        Style="{StaticResource ThemeAccentButtonStyle}"/>
                <StackPanel Grid.Column="2" x:Name="SiblingNavPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="PrevPlanetBtn" Content="‹ Previous planet" Click="PrevPlanetBtn_Click"/>
                    <Button x:Name="NextPlanetBtn" Content="Next planet ›" Click="NextPlanetBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Integrated Header Container: Planet Telemetry & Environment -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <Grid x:Name="HeaderAreaGrid">
                    <!-- Faint system picture backdrop -->
                    <Border x:Name="HeaderBackdrop" Margin="-1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Opacity="0.25"/>

                    <StackPanel Padding="20,16,20,18" Spacing="14">
                        <!-- Top Row: Planet Drawing, Titles, Glyphs -->
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" x:Name="PlanetDrawingFrame" Width="152" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="PlanetEyebrowTxt" Text="PLANET TELEMETRY" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock x:Name="PlanetTitleTxt" Style="{StaticResource ThemeHeadingStyle}" FontSize="26"/>
                                <TextBlock x:Name="OriginalNameTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                    <TextBlock x:Name="BiomeTxt" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold" FontSize="13" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    <TextBlock Text="·" Foreground="{ThemeResource ThemeTextFaintBrush}" FontSize="13"/>
                                    <TextBlock x:Name="SystemNameTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                    <TextBlock Text="·" Foreground="{ThemeResource ThemeTextFaintBrush}" FontSize="13"/>
                                    <TextBlock x:Name="GalaxyTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                    <TextBlock Text="·" Foreground="{ThemeResource ThemeTextFaintBrush}" FontSize="13"/>
                                    <TextBlock x:Name="CoordsTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                </StackPanel>
                                <Border x:Name="HereBadge" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,4,0,0"
                                        Background="{ThemeResource ThemeDoneBrush}" Padding="8,3" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                    <TextBlock x:Name="HereBadgeTxt" Text="◆  YOU ARE HERE" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold"
                                               FontSize="11" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                                </Border>
                                <StackPanel x:Name="GlyphContainer" Orientation="Horizontal" Spacing="4" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Environmental Conditions & Resources Bar (Top Container) -->
                        <Border Height="1" Background="{ThemeResource ThemeLineBrush}" Margin="0,2,0,2"/>

                        <StackPanel Spacing="10">
                            <TextBlock Text="ENVIRONMENTAL CONDITIONS &amp; SURVEY TELEMETRY" Style="{StaticResource ThemeEyebrowStyle}" FontSize="10"/>
                            <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="8">
                                <!-- Weather Pill -->
                                <Border Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="⚡ Weather:" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                        <TextBlock x:Name="WeatherValTxt" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sentinels Pill -->
                                <Border Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🛡 Sentinels:" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                        <TextBlock x:Name="SentinelsValTxt" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Flora Pill -->
                                <Border Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🌿 Flora:" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                        <TextBlock x:Name="FloraValTxt" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Fauna Pill -->
                                <Border Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="🐾 Fauna:" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                        <TextBlock x:Name="FaunaValTxt" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>

                                <!-- Water Pill -->
                                <Border Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="10,5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="💧 Water:" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                        <TextBlock x:Name="WaterValTxt" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </controls:WrapPanel>

                            <!-- Detected Resources Chips -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Resources:" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                                <controls:WrapPanel x:Name="TopResourcesWrapPanel" HorizontalSpacing="6" VerticalSpacing="6" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Modular Responsive Cards Grid: wraps automatically across rows as viewport width permits -->
            <controls:WrapPanel HorizontalSpacing="18" VerticalSpacing="18">

                <!-- Your Details & Notes Card (Manual Editor) -->
                <Border x:Name="DetailsCard" Style="{StaticResource ThemeCardStyle}" Width="430" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <Grid>
                                <TextBlock Text="YOUR DETAILS &amp; NOTES" Style="{StaticResource ThemeBandTextStyle}" VerticalAlignment="Center"/>
                                <Button x:Name="EditDetailsToggleBtn" Content="Edit details" HorizontalAlignment="Right" Padding="12,2" FontSize="12" Click="EditDetailsToggleBtn_Click"/>
                            </Grid>
                        </Border>
                        <StackPanel Padding="18,14,18,16" Spacing="12">
                            <!-- Summary View -->
                            <StackPanel x:Name="DetailsSummaryPanel" Spacing="6"/>

                            <!-- Inline Editor View -->
                            <StackPanel x:Name="DetailsEditorPanel" Spacing="12" Visibility="Collapsed">
                                <TextBox x:Name="NameInGameBox" Header="Name in game" HorizontalAlignment="Stretch"/>
                                <controls:WrapPanel HorizontalSpacing="10" VerticalSpacing="10">
                                    <ComboBox x:Name="SentinelsPicker" Header="Sentinels" Width="185" IsEditable="True"/>
                                    <ComboBox x:Name="FloraPicker" Header="Flora" Width="185" IsEditable="True"/>
                                    <ComboBox x:Name="FaunaPicker" Header="Fauna" Width="185" IsEditable="True"/>
                                    <ComboBox x:Name="WaterPicker" Header="Water" Width="185"/>
                                </controls:WrapPanel>
                                <AutoSuggestBox x:Name="WeatherSuggestBox" Header="Weather" HorizontalAlignment="Stretch" PlaceholderText="e.g. Painfully Hot Rain"/>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Resources Recorded" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <controls:WrapPanel x:Name="EditorResourceChips" HorizontalSpacing="6" VerticalSpacing="6"/>
                                    <AutoSuggestBox x:Name="ResourceAddBox" Header="Add Resource" HorizontalAlignment="Stretch" PlaceholderText="Type resource name and press Enter"/>
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Notes" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <StackPanel x:Name="EditorNotesList" Spacing="6"/>
                                    <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewNoteInput" PlaceholderText="Add a note..."/>
                                        <Button Grid.Column="1" Content="Add" Click="AddNote_Click"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
                                    <Button Content="Save details" Click="SaveDetails_Click" Style="{StaticResource ThemeAccentButtonStyle}"/>
                                    <TextBlock x:Name="SaveStatusTxt" Style="{StaticResource ThemeDimTextStyle}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- From Your Save Card -->
                <Border x:Name="SaveFactsCard" Style="{StaticResource ThemeCardStyle}" Width="430" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="FROM YOUR SAVE" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <Grid x:Name="SaveFactsContainer" Padding="18,14,18,16"/>
                    </StackPanel>
                </Border>

                <!-- Registered Bases & Outposts Card -->
                <Border x:Name="BasesCard" Style="{StaticResource ThemeCardStyle}" Width="430" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="REGISTERED BASES &amp; OUTPOSTS" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <StackPanel x:Name="BasesListPanel" Padding="18,14,18,16" Spacing="10"/>
                    </StackPanel>
                </Border>

                <!-- Recorded Finds Card -->
                <Border x:Name="FindsCard" Style="{StaticResource ThemeCardStyle}" Width="430" VerticalAlignment="Top" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="YOUR FINDS HERE" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <StackPanel x:Name="FindsListPanel" Padding="18,14,18,16" Spacing="8"/>
                    </StackPanel>
                </Border>

                <!-- Fishing Card -->
                <Border x:Name="FishCard" Style="{StaticResource ThemeCardStyle}" Width="430" VerticalAlignment="Top">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="FISH" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <StackPanel x:Name="FishContainerPanel" Padding="18,14,18,16" Spacing="10"/>
                    </StackPanel>
                </Border>

            </controls:WrapPanel>

            <!-- 4. Full-Width Bottom Section: Creatures / Fauna Discoveries (Scanned with images) -->
            <Border x:Name="CreaturesCard" Style="{StaticResource ThemeCardStyle}" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="CREATURES (FAUNA DISCOVERIES)" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="18,14,18,16" Spacing="10">
                        <TextBlock Text="Read off the game's Discoveries fauna list with screen recording on — open a creature there to add its picture, gender and size."
                                   Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                        <controls:WrapPanel x:Name="CreaturesWrapPanel" HorizontalSpacing="10" VerticalSpacing="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>