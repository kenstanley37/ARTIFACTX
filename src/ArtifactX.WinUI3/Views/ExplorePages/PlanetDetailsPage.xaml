<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Every colour, font and corner
     comes from the active theme's Theme* keys via ThemeStyles.xaml, so the
     same markup renders correctly in both Station Core and Galaxy Map. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExplorePages.PlanetDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtifactX.WinUI3.Views.ExplorePages"
    xmlns:vm="using:ArtifactX.WinUI3.ViewModels.ExploreViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,26,28,40" Spacing="22">

            <!-- Page Title -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PLANET DETAILS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
            </Grid>

            <!-- ========================================== -->
            <!-- 1. HERO HEADER SECTION                     -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <Grid Padding="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Planet Icon / Hologram Thumbnail Placeholder -->
                    <Border Grid.Column="0" Width="88" Height="88" CornerRadius="44"
                            Background="{ThemeResource ThemeVoidBrush}"
                            BorderBrush="{ThemeResource ThemeAccentBrush}"
                            BorderThickness="2" Margin="0,0,24,0">
                        <FontIcon Glyph="&#xE707;" FontSize="36" Foreground="{ThemeResource ThemeAccentBrush}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Planet Names & Classification -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <TextBlock Text="PLANET TELEMETRY" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PlanetName, Mode=OneWay}"
                                   Style="{StaticResource ThemeHeadingStyle}" FontSize="28"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{x:Bind ViewModel.SystemName, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="14"/>
                            <TextBlock Text="•" Foreground="{ThemeResource ThemeTextFaintBrush}"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.BiomeClassification, Mode=OneWay}"
                                       FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold"
                                       FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Quick Action Buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Export Data" Click="ExportDataButton_Click"
                                Style="{StaticResource ThemeAccentButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- 2. ENVIRONMENT & HAZARD STATS GRID         -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="ENVIRONMENTAL CONDITIONS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <Grid Padding="20,18,20,20">
                        <controls:UniformGrid Columns="4" Rows="1" MinHeight="100">
                            <!-- Weather Card -->
                            <Border Background="{ThemeResource ThemePanelAltBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Padding="16,14" Margin="0,0,12,0"
                                    BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="WEATHER" Style="{StaticResource ThemeEyebrowStyle}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.WeatherType, Mode=OneWay}"
                                               Style="{StaticResource ThemeNumberStyle}" FontSize="15"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind ViewModel.WeatherDescription, Mode=OneWay}"
                                               Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Sentinels Card -->
                            <Border Background="{ThemeResource ThemePanelAltBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Padding="16,14" Margin="0,0,12,0"
                                    BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="SENTINELS" Style="{StaticResource ThemeEyebrowStyle}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.SentinelActivity, Mode=OneWay}"
                                               FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold"
                                               FontSize="15" Foreground="{ThemeResource ThemeDamagedBrush}"/>
                                    <TextBlock Text="Security Level" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Flora Card -->
                            <Border Background="{ThemeResource ThemePanelAltBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Padding="16,14" Margin="0,0,12,0"
                                    BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="FLORA" Style="{StaticResource ThemeEyebrowStyle}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.FloraDensity, Mode=OneWay}"
                                               Style="{StaticResource ThemeNumberStyle}" FontSize="15"/>
                                    <TextBlock Text="Life Spores Recorded" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>

                            <!-- Fauna Card -->
                            <Border Background="{ThemeResource ThemePanelAltBrush}"
                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Padding="16,14"
                                    BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="FAUNA" Style="{StaticResource ThemeEyebrowStyle}" FontSize="11"/>
                                    <TextBlock Text="{x:Bind ViewModel.FaunaAbundance, Mode=OneWay}"
                                               Style="{StaticResource ThemeNumberStyle}" FontSize="15"/>
                                    <TextBlock Text="Species Documented" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                </StackPanel>
                            </Border>
                        </controls:UniformGrid>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 3. RESOURCES & ELEMENTS SECTION            -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="DETECTED ELEMENTS &amp; RESOURCES" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <Grid Padding="20,18,20,20">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PlanetResources, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:WrapPanel Orientation="Horizontal" HorizontalSpacing="12" VerticalSpacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResourceItemViewModel">
                                    <Border Background="{ThemeResource ThemePanelAltBrush}"
                                            CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                            Padding="14,12" Width="360"
                                            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                                    Background="{ThemeResource ThemeVoidBrush}"
                                                    BorderBrush="{ThemeResource ThemeLineBrush}"
                                                    BorderThickness="1" Margin="0,0,12,0">
                                                <FontIcon Glyph="&#xE8EC;" FontSize="18"
                                                          Foreground="{ThemeResource ThemeAccentBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind Name}"
                                                           FontFamily="{ThemeResource ThemeDisplayFont}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{ThemeResource ThemeTextBrush}"/>
                                                <TextBlock Text="{x:Bind AbundanceOrType}"
                                                           Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ========================================== -->
            <!-- 4. DISCOVERED BASES & OUTPOSTS ON PLANET   -->
            <!-- ========================================== -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="REGISTERED BASES &amp; OUTPOSTS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <Grid Padding="20,18,20,20">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.PlanetBases, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BaseRecordViewModel">
                                    <Border Padding="16,12" Margin="0,0,0,10"
                                            Background="{ThemeResource ThemePanelAltBrush}"
                                            BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                            CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36"
                                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                                    Background="{ThemeResource ThemeVoidBrush}"
                                                    BorderBrush="{ThemeResource ThemeLineBrush}"
                                                    BorderThickness="1" Margin="0,0,14,0">
                                                <FontIcon Glyph="&#xEB49;" FontSize="16"
                                                          Foreground="{ThemeResource ThemeAccentBrush}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                <TextBlock Text="{x:Bind BaseName}"
                                                           FontFamily="{ThemeResource ThemeDisplayFont}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{ThemeResource ThemeTextBrush}"/>
                                                <TextBlock Text="{x:Bind CoordinatesString}"
                                                           Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="View Details" VerticalAlignment="Center"
                                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                                    FontFamily="{ThemeResource ThemeBodyFont}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
