<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.MilestonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Milestones" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Milestone Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" MaxWidth="820"
                       Text="From the in-game Catalog &amp; Guide -&gt; Milestones screen - save-wide progress tracking, not tied to any specific ship/tool/companion, and NOT shared with your other save slots (each is a fully independent file). 11 of 12 categories are mapped to real save data so far (the 3 Guilds are partial - their Standing/Missions Completed fields are still ambiguous). Previous Expeditions doesn't store expedition names in the save at all, so it can't be mapped the same way - see its placeholder for details."/>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="MILESTONES" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                        <StackPanel x:Name="MilestonesGroupPanel" Spacing="4"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="LIFEFORMS" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                        <StackPanel x:Name="LifeformsGroupPanel" Spacing="4"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="FACTIONS" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                        <StackPanel x:Name="FactionsGroupPanel" Spacing="4"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1">
                    <!-- Shown for the 1 category with no confirmed stat mapping yet. -->
                    <StackPanel x:Name="PlaceholderPanel" Spacing="10" HorizontalAlignment="Left" MaxWidth="600">
                        <TextBlock x:Name="PlaceholderHeaderTxt" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PlaceholderNoteTxt" TextWrapping="Wrap" Opacity="0.7"/>
                    </StackPanel>

                    <!-- One reusable panel for every mapped category - fields are built
                         dynamically in code from each category's field list (see
                         MappedCategories in the code-behind) rather than one hand-written
                         Border per category, since 6 mapped categories x ~4-5 fields each
                         would otherwise mean a lot of repetitive XAML. -->
                    <Border x:Name="MappedCategoryPanel" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Opacity="0.9" Width="340" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <TextBlock x:Name="MappedCategoryHeaderTxt" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock x:Name="MappedCategoryNoteTxt" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                            <StackPanel x:Name="MappedCategoryFieldsPanel" Spacing="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
