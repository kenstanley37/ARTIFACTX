<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.MilestonesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Stretch">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Milestones" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Milestone Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" MaxWidth="820"
                       Text="From the in-game Catalog &amp; Guide -&gt; Milestones screen - save-wide progress tracking, not tied to any specific ship/tool/companion, and NOT shared with your other save slots (each is a fully independent file). Only Arena League is mapped to real save data so far - the other 11 categories are listed for reference but aren't wired up to anything yet."/>

            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="18">
                    <StackPanel Spacing="6">
                        <TextBlock Text="MILESTONES" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                        <StackPanel x:Name="MilestonesGroupPanel" Spacing="4"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="LIFEFORMS" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                        <StackPanel x:Name="LifeformsGroupPanel" Spacing="4"/>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <TextBlock Text="FACTIONS" FontSize="11" FontWeight="SemiBold" Opacity="0.5"/>
                        <StackPanel x:Name="FactionsGroupPanel" Spacing="4"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1">
                    <!-- Shown for the 11 categories with no confirmed stat mapping yet. -->
                    <StackPanel x:Name="PlaceholderPanel" Spacing="10" HorizontalAlignment="Left" MaxWidth="600">
                        <TextBlock x:Name="PlaceholderHeaderTxt" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="This category hasn't been mapped to real save data yet. A screenshot of this category's Catalog &amp; Guide screen (with the numbers visible) would let us find and confirm the matching stat IDs - the same way Arena League was done."/>
                    </StackPanel>

                    <!-- The one live category, moved here from the Companions page - it's a
                         Factions milestone, not really a per-companion concern. Same 5
                         NumberBoxes/logic as before, just relocated. -->
                    <Border x:Name="ArenaLeaguePanel" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Opacity="0.9" Width="340" HorizontalAlignment="Left" Visibility="Collapsed">
                        <StackPanel Spacing="14">
                            <TextBlock Text="Arena League" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock FontSize="11" Opacity="0.6" TextWrapping="Wrap"
                                       Text="Save-wide, not tied to any specific companion (a different number from the per-companion &quot;Holo-Arena Victories&quot; field on the Companions page). All 5 confirmed exact against real screenshots."/>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Champions Defeated" Opacity="0.7" FontSize="12"/>
                                <NumberBox x:Name="ArenaChampionsBox" HorizontalAlignment="Stretch" Minimum="0"
                                           SpinButtonPlacementMode="Hidden" ValueChanged="ArenaChampionsBox_ValueChanged" LostFocus="ArenaChampionsBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Holo-Arena Victories" Opacity="0.7" FontSize="12"/>
                                <NumberBox x:Name="ArenaVictoriesBox" HorizontalAlignment="Stretch" Minimum="0"
                                           SpinButtonPlacementMode="Hidden" ValueChanged="ArenaVictoriesBox_ValueChanged" LostFocus="ArenaVictoriesBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Apex Companions" Opacity="0.7" FontSize="12"/>
                                <NumberBox x:Name="ArenaCompanionsBox" HorizontalAlignment="Stretch" Minimum="0"
                                           SpinButtonPlacementMode="Hidden" ValueChanged="ArenaCompanionsBox_ValueChanged" LostFocus="ArenaCompanionsBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Hatch Eggs" Opacity="0.7" FontSize="12"/>
                                <NumberBox x:Name="ArenaEggsBox" HorizontalAlignment="Stretch" Minimum="0"
                                           SpinButtonPlacementMode="Hidden" ValueChanged="ArenaEggsBox_ValueChanged" LostFocus="ArenaEggsBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Spacing="6">
                                <TextBlock Text="Iteration: Oceanus" Opacity="0.7" FontSize="12"/>
                                <NumberBox x:Name="ArenaOceanusBox" HorizontalAlignment="Stretch" Minimum="0"
                                           SpinButtonPlacementMode="Hidden" ValueChanged="ArenaOceanusBox_ValueChanged" LostFocus="ArenaOceanusBox_LostFocus"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
