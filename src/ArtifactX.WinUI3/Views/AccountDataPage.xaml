<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.AccountDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Shared across all 3 lists (Catalog/Expedition Rewards/Twitch Rewards)
             below - same row shape everywhere, just a different filtered subset
             of _allItems feeding each ListView. -->
        <DataTemplate x:Key="AccountItemRowTemplate" x:DataType="viewmodels:AccountItemRowViewModel">
            <Grid Padding="4,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsUnlocked, Mode=OneWay}"
                          Click="ItemCheckBox_Click" Tag="{x:Bind}" VerticalAlignment="Center"/>
                <!-- GameId shown under every row, not just when it's ambiguous -
                     many base-building parts (straight/corner/cap connector
                     variants of the same piece) legitimately share one display
                     name across several distinct ids (up to 16 for some pieces),
                     which read as duplicate/buggy rows without this (user feedback
                     2026-08-05). Differing checkbox states on those rows was
                     already proof they're real separate items, just easy to miss. -->
                <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{x:Bind GameId}" FontSize="10" Foreground="{ThemeResource NmsTextSecondary}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="2" Visibility="{x:Bind ExpeditionVisibility}"
                        BorderBrush="{ThemeResource NmsAccentBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ExpeditionLabel}" FontSize="11" Foreground="{ThemeResource NmsAccentBrush}"/>
                </Border>
                <Border Grid.Column="3" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind CategoryLabel}" FontSize="11" Foreground="{ThemeResource NmsTextSecondary}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Catalog" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <!-- This list is account-wide, not tied to any one save slot (see the
                     warning banner below) - accountdata.hg lives once per PLATFORM
                     account, so what matters here is which platform is active
                     (SaveSessionManager.ActivePlatformDisplayName), not which save
                     slot. Without this, there was no on-page indication of which
                     account was actually being edited (user feedback 2026-08-04). -->
                <Border Background="{ThemeResource NmsAccentBrush}" CornerRadius="4" Padding="9,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ActivePlatformTxt" Text="" FontSize="12" FontWeight="Bold" Foreground="White"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="PendingEditsTxt" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource NmsTextSecondary}"/>
                <!-- Its own Save/Discard pair, deliberately separate from AppTitleBar's -
                     this data isn't tied to the currently loaded save slot at all, so
                     conflating it with the per-slot Save button would risk a user
                     thinking a slot save also covers this (or vice versa). Shared
                     across all 3 sections below - they're all just different filtered
                     views of the same accountdata.hg B1h array. -->
                <Button x:Name="DiscardChangesBtn" Content="Discard Changes" Click="DiscardChangesBtn_Click"
                        Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button x:Name="SaveChangesBtn" Content="Save Changes" Click="SaveChangesBtn_Click"
                        Style="{ThemeResource AccentButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="NoAccountDataTxt" Visibility="Collapsed"
                       Text="No accountdata.hg file was found alongside this save - this platform account may be very new, or this feature isn't supported for it yet."
                       Foreground="{ThemeResource NmsTextSecondary}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center"/>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Background="#332B1400" BorderBrush="#FFB800"
                            BorderThickness="1" CornerRadius="6" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFB800" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFB800"
                                       Text="This list is account-wide, not tied to any one save slot - unlocking or locking an item anywhere below affects every save on this platform account (accountdata.hg), not just the save currently loaded. Save this separately with the button above; it does not go through the normal per-save Save button."/>
                        </StackPanel>
                    </Border>

                    <!-- Deliberately hedged wording - see project_account_data_page.md's
                         2026-08-02 follow-up. A reference tool's own "Catalog" tab claims this
                         list drives the in-game Catalog & Guide -> Catalogue screen's black
                         silhouettes, but direct testing (writing a confirmed-persisted id, then
                         checking in-game) didn't show that effect, and the user separately
                         confirmed that screen is actually driven by PER-SLOT save data, not
                         accountdata.hg at all. Don't restate that claim as fact here until
                         ArtifactX's own testing confirms what this list actually does in-game. -->
                    <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Opacity="0.85">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"
                                       Text="This is your account-wide unlock list (accountdata.hg) - the same data a reference tool's own 'Catalog' tab edits. That tool describes it as controlling the black-silhouette items under the game's Catalog &amp; Guide screen, but ArtifactX hasn't independently confirmed that effect yet - that screen may actually be driven by per-save-slot data instead. Treat changes here as experimental until confirmed in-game."/>
                        </StackPanel>
                    </Border>

                    <!-- Catalog - the general ~4,600-item list, everything that isn't an
                         Expedition/Twitch reward (those are split into their own sections
                         below - user feedback 2026-08-12: "we can at least group our
                         checkboxes like NomNom", matching that reference tool keeping its
                         own Expedition/Twitch sections separate from the general Catalog
                         tab rather than folded into one dropdown-filtered list). -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Catalog" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="CatalogSearchBox" PlaceholderText="Search items..." TextChanged="CatalogSearchBox_TextChanged"/>
                            <ComboBox Grid.Column="1" x:Name="UnlockFilterBox" Width="150" SelectionChanged="UnlockFilterBox_SelectionChanged">
                                <ComboBoxItem Content="All Items"/>
                                <ComboBoxItem Content="Unlocked Only"/>
                                <ComboBoxItem Content="Locked Only"/>
                            </ComboBox>
                            <TextBlock Grid.Column="2" x:Name="CatalogResultCountTxt" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource NmsTextSecondary}"/>
                            <Button Grid.Column="3" x:Name="CatalogLockAllBtn" Content="Lock All" Click="CatalogLockAllBtn_Click"
                                    ToolTipService.ToolTip="Locks every item currently shown below (respects the search box, category checkboxes, and Unlocked/Locked filter)"/>
                            <Button Grid.Column="4" x:Name="CatalogUnlockAllBtn" Content="Unlock All" Click="CatalogUnlockAllBtn_Click"
                                    ToolTipService.ToolTip="Unlocks every item currently shown below (respects the search box, category checkboxes, and Unlocked/Locked filter)"/>
                        </Grid>

                        <!-- Multi-select category filter, deliberately checkboxes rather than a
                             single-select dropdown - mirrors a reference tool's own Catalog tab,
                             which shows all 9 of its (finer) groups as checkboxes side by side
                             rather than a one-at-a-time picker. ArtifactX only has the coarser
                             Technology/Product/Substance split (see CatalogService.ElvLabelFor),
                             not that tool's 9-way one - the catalog DB doesn't currently decode
                             the finer per-item grouping. -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="Categories:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"/>
                            <CheckBox x:Name="TechnologyCategoryCheck" Content="Technology" IsChecked="True" Click="CategoryCheck_Click"/>
                            <CheckBox x:Name="ProductCategoryCheck" Content="Product" IsChecked="True" Click="CategoryCheck_Click"/>
                            <CheckBox x:Name="SubstanceCategoryCheck" Content="Substance" IsChecked="True" Click="CategoryCheck_Click"/>
                        </StackPanel>

                        <ListView x:Name="CatalogListView" SelectionMode="None" Height="600"
                                  ItemTemplate="{StaticResource AccountItemRowTemplate}"/>
                    </StackPanel>

                    <!-- Expedition Rewards - Banner/Decal/Title items whose own names spell
                         out which expedition they're from (CatalogService.BuildExpeditionNameLookup).
                         Both id prefixes ("EXPD_"/"TWITCH_") are Hello Games' own naming
                         convention, confirmed present on every expedition/Twitch-drop item
                         found in the account's real B1h list (2026-08-04) - a live pattern
                         match against whatever's in the catalog DB, not a hardcoded item list. -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Collect Expedition Rewards" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="ExpeditionSearchBox" PlaceholderText="Search expedition rewards..." TextChanged="ExpeditionSearchBox_TextChanged"/>
                            <ComboBox Grid.Column="1" x:Name="ExpeditionFilterBox" Width="220" SelectionChanged="ExpeditionFilterBox_SelectionChanged"/>
                            <TextBlock Grid.Column="2" x:Name="ExpeditionResultCountTxt" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource NmsTextSecondary}"/>
                            <Button Grid.Column="3" x:Name="ExpeditionLockAllBtn" Content="Lock All" Click="ExpeditionLockAllBtn_Click"
                                    ToolTipService.ToolTip="Locks every item currently shown below (respects the search box and expedition filter)"/>
                            <Button Grid.Column="4" x:Name="ExpeditionUnlockAllBtn" Content="Unlock All" Click="ExpeditionUnlockAllBtn_Click"
                                    ToolTipService.ToolTip="Unlocks every item currently shown below (respects the search box and expedition filter)"/>
                        </Grid>
                        <ListView x:Name="ExpeditionListView" SelectionMode="None" Height="260"
                                  ItemTemplate="{StaticResource AccountItemRowTemplate}"/>
                    </StackPanel>

                    <!-- Twitch Rewards - same shape as Expedition Rewards above, just no
                         expedition-number filter (TWITCH_ items don't carry one). -->
                    <StackPanel Spacing="10">
                        <TextBlock Text="Collect Twitch Rewards" FontWeight="SemiBold" FontSize="16"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="TwitchSearchBox" PlaceholderText="Search Twitch rewards..." TextChanged="TwitchSearchBox_TextChanged"/>
                            <TextBlock Grid.Column="1" x:Name="TwitchResultCountTxt" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{ThemeResource NmsTextSecondary}"/>
                            <Button Grid.Column="2" x:Name="TwitchLockAllBtn" Content="Lock All" Click="TwitchLockAllBtn_Click"
                                    ToolTipService.ToolTip="Locks every item currently shown below (respects the search box)"/>
                            <Button Grid.Column="3" x:Name="TwitchUnlockAllBtn" Content="Unlock All" Click="TwitchUnlockAllBtn_Click"
                                    ToolTipService.ToolTip="Unlocks every item currently shown below (respects the search box)"/>
                        </Grid>
                        <ListView x:Name="TwitchListView" SelectionMode="None" Height="260"
                                  ItemTemplate="{StaticResource AccountItemRowTemplate}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
