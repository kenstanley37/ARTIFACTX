<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.AccountDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Account Data" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="PendingEditsTxt" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource NmsTextSecondary}"/>
                <!-- Its own Save/Discard pair, deliberately separate from AppTitleBar's -
                     this data isn't tied to the currently loaded save slot at all, so
                     conflating it with the per-slot Save button would risk a user
                     thinking a slot save also covers this (or vice versa). -->
                <Button x:Name="DiscardChangesBtn" Content="Discard Changes" Click="DiscardChangesBtn_Click"
                        Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button x:Name="SaveChangesBtn" Content="Save Changes" Click="SaveChangesBtn_Click"
                        Style="{ThemeResource AccentButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="NoAccountDataTxt" Visibility="Collapsed"
                       Text="No accountdata.hg file was found alongside this save - this platform account may be very new, or this feature isn't supported for it yet."
                       Foreground="{ThemeResource NmsTextSecondary}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center"/>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <Grid x:Name="ContentPanel" Visibility="Collapsed" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#332B1400" BorderBrush="#FFB800"
                        BorderThickness="1" CornerRadius="6" Padding="12,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="#FFB800" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#FFB800"
                                   Text="This list is account-wide, not tied to any one save slot - unlocking or locking an item here affects every save on this platform account (accountdata.hg), not just the save currently loaded. Save this separately with the button above; it does not go through the normal per-save Save button."/>
                    </StackPanel>
                </Border>

                <!-- Sets the same mental model NomNom's own "Catalog" tab gives this exact
                     data, since that's what this list actually is - the game's own Catalog &
                     Guide "seen/unseen" list, not a general inventory or crafting unlock. -->
                <Border Grid.Row="1" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Opacity="0.85">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"
                                   Text="This is your account-wide Catalog - the same list NomNom's own 'Catalog' tab edits, and the black silhouettes shown for items you haven't seen yet under the game's Catalog &amp; Guide screen. Unlocking an item here only reveals it there; it doesn't add it to your inventory or grant its crafting recipe."/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search items..." TextChanged="SearchBox_TextChanged"/>
                    <ComboBox Grid.Column="1" x:Name="UnlockFilterBox" Width="150" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Items"/>
                        <ComboBoxItem Content="Unlocked Only"/>
                        <ComboBoxItem Content="Locked Only"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" x:Name="ResultCountTxt" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource NmsTextSecondary}"/>
                    <Button Grid.Column="3" x:Name="LockAllBtn" Content="Lock All" Click="LockAllBtn_Click"
                            ToolTipService.ToolTip="Locks every item currently shown below (respects the search box, category checkboxes, and Unlocked/Locked filter)"/>
                    <Button Grid.Column="4" x:Name="UnlockAllBtn" Content="Unlock All" Click="UnlockAllBtn_Click"
                            ToolTipService.ToolTip="Unlocks every item currently shown below (respects the search box, category checkboxes, and Unlocked/Locked filter)"/>
                </Grid>

                <!-- Multi-select category filter, deliberately checkboxes rather than a
                     single-select dropdown - mirrors NomNom's own Catalog tab, which shows
                     all 9 of its (finer) groups as checkboxes side by side rather than a
                     one-at-a-time picker. ArtifactX only has the coarser Technology/Product/
                     Substance split (see CatalogService.ElvLabelFor), not NomNom's 9-way one -
                     the catalog DB doesn't currently decode the finer per-item grouping. -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="Categories:" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"/>
                    <CheckBox x:Name="TechnologyCategoryCheck" Content="Technology" IsChecked="True" Click="CategoryCheck_Click"/>
                    <CheckBox x:Name="ProductCategoryCheck" Content="Product" IsChecked="True" Click="CategoryCheck_Click"/>
                    <CheckBox x:Name="SubstanceCategoryCheck" Content="Substance" IsChecked="True" Click="CategoryCheck_Click"/>
                </StackPanel>

                <ListView Grid.Row="4" x:Name="ItemsListView" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AccountItemRowViewModel">
                            <Grid Padding="4,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{x:Bind IsUnlocked, Mode=OneWay}"
                                          Click="ItemCheckBox_Click" Tag="{x:Bind}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                                        CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind CategoryLabel}" FontSize="11" Foreground="{ThemeResource NmsTextSecondary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
