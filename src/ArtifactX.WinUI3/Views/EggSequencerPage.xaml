<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Read-only Reference page:
     what each item does in the Space Anomaly's Egg Sequencer. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.EggSequencerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="EGG SEQUENCER" Style="{StaticResource ThemePageTitleStyle}"/>

        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}"
                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="What each item does in the Space Anomaly's Egg Sequencer. In the Neural Calibrator an item always moves the same personality trait the same way, and in the Growth Hormone it always makes the creature bigger or smaller. More of an item makes a bigger change, up to a full dose."/>
                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="The Gene Splitter and Dye Injector change anatomy and colouring by chance; the count on each card makes the change certain. Each item gives its own colours."/>
                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap" Text="{x:Bind ViewModel.FullDoseText, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Border>

        <ctcontrols:WrapPanel Grid.Row="2" HorizontalSpacing="14" VerticalSpacing="10">
            <TextBox Header="Search" Width="280" PlaceholderText="e.g. Sac Venom"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search items"/>
            <ComboBox Header="Neural Calibrator" Width="240" ItemsSource="{x:Bind ViewModel.PersonalityOptions}"
                      SelectedItem="{x:Bind ViewModel.Personality, Mode=TwoWay}"
                      AutomationProperties.Name="Filter by personality effect"/>
            <ComboBox Header="Growth Hormone" Width="200" ItemsSource="{x:Bind ViewModel.GrowthOptions}"
                      SelectedItem="{x:Bind ViewModel.Growth, Mode=TwoWay}"
                      AutomationProperties.Name="Filter by size effect"/>
            <CheckBox Content="Hide items with no effect" IsChecked="{x:Bind ViewModel.HideNoEffect, Mode=TwoWay}" VerticalAlignment="Bottom"/>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                       VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </ctcontrols:WrapPanel>

        <!-- Uniform cards in a virtualizing grid, same pattern as Item Values. -->
        <GridView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Items}" SelectionMode="None" IsItemClickEnabled="False">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="160"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,10,10"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:EggCatalystRowViewModel">
                    <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Width="260" Height="150"
                            Background="{ThemeResource ThemePanelAltBrush}"
                            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,10"
                            AutomationProperties.Name="{x:Bind AccessibleName}">
                        <Grid RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" Background="{ThemeResource ThemeVoidBrush}" VerticalAlignment="Top">
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="38" Height="38"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"
                                           FontSize="14" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="2" VerticalAlignment="Bottom">
                                <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" Visibility="{x:Bind HasEffect}">
                                    <Run Text="Personality" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    <Run Text="{x:Bind PersonalityText}" Foreground="{ThemeResource ThemeAccentBrush}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" Visibility="{x:Bind HasEffect}">
                                    <Run Text="Size" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    <Run Text="{x:Bind GrowthText}" Foreground="{ThemeResource ThemeAccentBrush}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <TextBlock Text="{x:Bind DoseText}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                <TextBlock Text="{x:Bind ChanceText}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                           TextTrimming="CharacterEllipsis" Visibility="{x:Bind HasEffect}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
