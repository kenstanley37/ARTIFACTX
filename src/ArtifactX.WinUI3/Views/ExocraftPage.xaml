<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExocraftPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="28,26,28,0" Spacing="22">
            <TextBlock Text="EXOCRAFT" Style="{StaticResource ThemePageTitleStyle}"/>

            <!-- Vehicle picker - built in code from ExocraftType, same choice-button
                 style as the ship/tool pickers. All 7 slots always exist in a save,
                 built or not. -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="VEHICLES" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="18,14,18,16" Spacing="10">
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                   Text="All 7 exocraft exist in every save, whether or not you've built them yet. Pick one to edit its Technology, Cargo and paint Seed."/>
                        <ctcontrols:WrapPanel x:Name="TabPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- One ExocraftDetailControl at a time lives here - swapped (not
             all 7 pre-built) so switching tabs doesn't eagerly load every
             vehicle's Tech/Cargo grids up front (project_perf_gc_tuning).
             The outgoing control's Unloaded event fires when it's removed
             from ContentHost.Children, unsubscribing its handlers. -->
        <Grid Grid.Row="1" x:Name="ContentHost"/>
    </Grid>
</Page>
