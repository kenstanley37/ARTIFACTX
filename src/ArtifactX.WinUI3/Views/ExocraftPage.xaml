<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.ExocraftPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="24,24,24,0" Spacing="16">
            <TextBlock Text="Exocraft" FontSize="26" FontWeight="Bold"/>
            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" MaxWidth="820"
                       Text="All 7 exocraft slots always exist in a save, whether or not you've built that vehicle yet - pick one below to edit its Technology, Cargo, and paint Seed."/>

            <!-- Tab strip - built in code from ExocraftType, same pill-button
                 visual language as the Class selectors on Ships/Freighter
                 (Border+TextBlock, bold/accent-highlighted when active). -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Auto">
                <ctcontrols:WrapPanel x:Name="TabPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
            </ScrollViewer>
        </StackPanel>

        <!-- One ExocraftDetailControl at a time lives here - swapped (not
             all 7 pre-built) so switching tabs doesn't eagerly load every
             vehicle's Tech/Cargo grids up front, matching the perf lesson
             from project_perf_gc_tuning (CataloguePage's synchronous-build
             sluggishness). The outgoing control's Unloaded event fires when
             it's removed from ContentHost.Children, cleanly unsubscribing
             its SaveSessionManager handlers before the new one is added. -->
        <Grid Grid.Row="1" x:Name="ContentHost" Padding="0,20,0,0"/>
    </Grid>
</Page>
