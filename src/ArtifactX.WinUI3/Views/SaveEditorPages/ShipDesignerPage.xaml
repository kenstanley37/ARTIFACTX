<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). The Ship Designer: the game's own
     ship fabricator choices (ShipDesignerViewModel) around a preview that never
     scrolls away - parts on the left, the ship in the middle, paint on the right,
     like the game's builder (2026-10-16, the user's layout: the first version listed
     everything in one column and the preview scrolled out of sight). -->
<Page
    x:Class="ArtifactX.WinUI3.Views.SaveEditorPages.ShipDesignerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:ArtifactX.WinUI3.ViewModels.ShipDesignerViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- One colour in a colour group's grid; white outline when picked. -->
        <DataTemplate x:Key="SwatchTemplate" x:DataType="vm:SwatchChoiceViewModel">
            <Border Width="31" Height="28" CornerRadius="3" BorderThickness="2" Background="{x:Bind Fill}"
                    BorderBrush="{x:Bind Outline, Mode=OneWay}" Tapped="{x:Bind Pick}"
                    ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}"/>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <!-- On the page's root element (AdaptiveTriggers on a nested Grid never fire). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <!-- WINDOW width, nav pane included: ~320 nav + 400 + 480 + 380 + gaps. -->
                        <AdaptiveTrigger MinWindowWidth="1700"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1250"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Preview across the top; parts | paint + designs below; the page scrolls
                             (2026-10-17: the old narrow layout laid the preview over the parts and
                             pushed paint off the right edge). -->
                        <Setter Target="BodyScroll.VerticalScrollMode" Value="Enabled"/>
                        <Setter Target="BodyScroll.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="BodyCol0.Width" Value="*"/>
                        <Setter Target="BodyCol1.Width" Value="0"/>
                        <Setter Target="BodyCol1.MinWidth" Value="0"/>
                        <Setter Target="PreviewCard.(Grid.Column)" Value="0"/>
                        <Setter Target="PreviewCard.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="PreviewCard.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="PartsCard.(Grid.Row)" Value="1"/>
                        <Setter Target="PartsCard.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="RightPanel.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="BodyCol2.Width" Value="*"/>
                        <Setter Target="BodyRow1.Height" Value="880"/>
                        <Setter Target="PreviewCard.Height" Value="440"/>
                        <Setter Target="RightPanel.(Grid.Row)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- One column: preview, parts, then paint + designs. -->
                        <Setter Target="BodyScroll.VerticalScrollMode" Value="Enabled"/>
                        <Setter Target="BodyScroll.VerticalScrollBarVisibility" Value="Auto"/>
                        <Setter Target="BodyCol0.Width" Value="*"/>
                        <Setter Target="BodyCol1.Width" Value="0"/>
                        <Setter Target="BodyCol1.MinWidth" Value="0"/>
                        <Setter Target="PreviewCard.(Grid.Column)" Value="0"/>
                        <Setter Target="PreviewCard.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="PreviewCard.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="PartsCard.(Grid.Row)" Value="1"/>
                        <Setter Target="PartsCard.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="RightPanel.(Grid.RowSpan)" Value="1"/>
                        <Setter Target="BodyCol2.Width" Value="0"/>
                        <Setter Target="BodyRow1.Height" Value="640"/>
                        <Setter Target="BodyRow2.Height" Value="880"/>
                        <Setter Target="PreviewCard.Height" Value="400"/>
                        <Setter Target="PartsCard.(Grid.ColumnSpan)" Value="3"/>
                        <Setter Target="RightPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="RightPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="RightPanel.(Grid.ColumnSpan)" Value="3"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Free starship slots as a badge by the title (2026-10-17: as small text by the
             buttons it was easy to miss). Amber when every slot is in use. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="18">
            <TextBlock Text="SHIP DESIGNER" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
            <Border VerticalAlignment="Center" CornerRadius="12" Padding="12,4,12,4" BorderThickness="1"
                    BorderBrush="{x:Bind ViewModel.SlotsBrush, Mode=OneWay}" Visibility="{x:Bind ViewModel.SlotsBadgeVisible, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.SlotsToolTip, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE709;" FontSize="13" Foreground="{x:Bind ViewModel.SlotsBrush, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.SlotsText, Mode=OneWay}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{x:Bind ViewModel.SlotsBrush, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Shown instead of the designer when the game data has no builder yet. -->
        <StackPanel Grid.Row="1" Spacing="8" Visibility="{x:Bind ViewModel.HasNoData, Mode=OneWay}">
            <TextBlock Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap"
                       Text="The Ship Designer reads the game's own ship fabricator from your game files. Update your game data to use it."/>
            <HyperlinkButton Content="Update game data now" Padding="0" Command="{x:Bind ViewModel.UpdateGameDataCommand}"/>
        </StackPanel>

        <!-- Wide: no page scrolling, so each card's own list scrolls inside the window.
             The narrower layouts give the cards fixed heights and scroll the page instead. -->
        <ScrollViewer x:Name="BodyScroll" Grid.Row="1" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid ColumnSpacing="20" RowSpacing="18" Visibility="{x:Bind ViewModel.HasData, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BodyCol0" Width="400"/>
                <ColumnDefinition x:Name="BodyCol1" Width="*" MinWidth="360"/>
                <ColumnDefinition x:Name="BodyCol2" Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="BodyRow0" Height="Auto"/>
                <RowDefinition x:Name="BodyRow1" Height="*"/>
                <RowDefinition x:Name="BodyRow2" Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left: type and parts, one slot at a time; only the slot's parts scroll. -->
            <Border x:Name="PartsCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource ThemeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="SHIP AND PARTS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <!-- Paint mode: the ship keeps its own parts, so the choices hide. -->
                    <StackPanel Grid.Row="1" Padding="16,14,16,16" Spacing="8" Visibility="{x:Bind ViewModel.IsPaintMode, Mode=OneWay}">
                        <TextBlock Text="PARTS" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.PaintPartsText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource ThemeDimTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Padding="16,14,16,4" Spacing="6" Visibility="{x:Bind ViewModel.IsDesignMode, Mode=OneWay}">
                        <TextBlock Text="SHIP TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Types}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShipTypeChoiceViewModel">
                                    <controls:ChoiceButton Content="{x:Bind Title}" Padding="12,5,12,5" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                                           Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind AccessibleName}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Padding="16,12,16,0" Spacing="6" Visibility="{x:Bind ViewModel.IsDesignMode, Mode=OneWay}">
                        <TextBlock Text="PARTS" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <!-- One row per slot with the part picked for it - the game builder's slots, so the
                             whole design reads at a glance. Click one to list its parts. -->
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Slots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShipSlotChoiceViewModel">
                                    <controls:ChoiceButton Padding="8,5,10,5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                           IsSelected="{x:Bind IsSelected, Mode=OneWay}" Command="{x:Bind SelectCommand}"
                                                           AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="34" Height="34"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Label}" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <TextBlock Text="{x:Bind PartName, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </controls:ChoiceButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <!-- Some slots offer 40+ parts: filter by name (the list itself is A-Z). -->
                    <TextBox Grid.Row="3" Margin="16,12,16,0" PlaceholderText="Find a part" AutomationProperties.Name="Find a part"
                             Text="{x:Bind ViewModel.PartSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{x:Bind ViewModel.IsDesignMode, Mode=OneWay}"/>
                    <ScrollViewer Grid.Row="4" Margin="0,10,0,0" Visibility="{x:Bind ViewModel.IsDesignMode, Mode=OneWay}">
                        <StackPanel Margin="16,0,16,16" Spacing="6">
                            <TextBlock Text="{x:Bind ViewModel.PartsEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.PartsEmptyVisible, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Parts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ShipPartChoiceViewModel">
                                        <controls:ChoiceButton Padding="4" VerticalAlignment="Stretch" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                                               Command="{x:Bind SelectCommand}" ToolTipService.ToolTip="{x:Bind Name}"
                                                               AutomationProperties.Name="{x:Bind Name}">
                                            <StackPanel Width="76" Spacing="2">
                                                <Image Source="{x:Bind Icon}" Visibility="{x:Bind IconVisibility}" Width="46" Height="46" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind Name}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" MaxLines="3"/>
                                            </StackPanel>
                                        </controls:ChoiceButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Middle: the ship. -->
            <Border x:Name="PreviewCard" Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource ThemeCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="PREVIEW" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <Grid Grid.Row="1" Padding="18,14,18,0" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ShipName, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <!-- New or editing a saved design, always said (2026-10-17: a loaded design
                                 stayed highlighted after the player moved on to a new ship). -->
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.DesignStateText, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}"
                                           FontSize="12" VerticalAlignment="Center"/>
                                <HyperlinkButton Content="New design" FontSize="12" Padding="0" Visibility="{x:Bind ViewModel.NewDesignVisible, Mode=OneWay}"
                                                 Command="{x:Bind ViewModel.NewDesignCommand}"
                                                 ToolTipService.ToolTip="Start a new design. The saved one stays as it was saved."/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Content="New name" Command="{x:Bind ViewModel.NewNameCommand}"
                                Visibility="{x:Bind ViewModel.NewNameVisible, Mode=OneWay}"
                                ToolTipService.ToolTip="The game names a built ship from a random number - pick another to get another name."/>
                    </Grid>
                    <controls:ShipPreview x:Name="PreviewView" Grid.Row="2" Margin="18,10,18,0" MinHeight="200" FitToSize="True"/>
                    <StackPanel Grid.Row="3" Padding="18,10,18,16" Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.PreviewNote, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                        <!-- Left: into the save. Right: keep it in My designs. -->
                        <ctcontrols:WrapPanel Margin="0,6,0,0" HorizontalSpacing="24" VerticalSpacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.IsPaintMode, Mode=OneWay}">
                                <Button Content="Repaint" Command="{x:Bind ViewModel.RepaintCommand}" IsEnabled="{x:Bind ViewModel.WriteEnabled, Mode=OneWay}"
                                        Style="{StaticResource ThemeAccentButtonStyle}"/>
                                <Button Content="Remove paint..." Command="{x:Bind ViewModel.RemovePaintCommand}" IsEnabled="{x:Bind ViewModel.WriteEnabled, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.RemovePaintVisible, Mode=OneWay}"
                                        ToolTipService.ToolTip="Back to the colours the ship had when you found or bought it."/>
                                <HyperlinkButton Content="Design a new ship instead" Command="{x:Bind ViewModel.ExitPaintCommand}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.IsDesignMode, Mode=OneWay}">
                                <Button Content="Add as new ship" Command="{x:Bind ViewModel.AddNewCommand}" IsEnabled="{x:Bind ViewModel.AddNewEnabled, Mode=OneWay}"
                                        Style="{StaticResource ThemeAccentButtonStyle}"/>
                                <Button Content="Apply to a ship..." Command="{x:Bind ViewModel.ApplyCommand}" IsEnabled="{x:Bind ViewModel.WriteEnabled, Mode=OneWay}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.IsDesignMode, Mode=OneWay}">
                                <Button Content="{x:Bind ViewModel.SaveDesignText, Mode=OneWay}" Command="{x:Bind ViewModel.SaveDesignCommand}"
                                        IsEnabled="{x:Bind ViewModel.SaveDesignEnabled, Mode=OneWay}"
                                        ToolTipService.ToolTip="Keep this design in My designs to add or apply to a ship later. Your game save isn't changed."/>
                                <Button Content="Save as new..." Command="{x:Bind ViewModel.SaveAsNewCommand}" Visibility="{x:Bind ViewModel.SaveAsNewVisible, Mode=OneWay}"
                                        ToolTipService.ToolTip="Keep this as another design, with its own name. The one you loaded stays as it was."/>
                            </StackPanel>
                        </ctcontrols:WrapPanel>
                        <TextBlock Text="{x:Bind ViewModel.WriteBlockedText, Mode=OneWay}" Visibility="{x:Bind ViewModel.WriteBlockedVisible, Mode=OneWay}"
                                   Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: paint, then the player's saved designs (2026-10-17, the user's idea:
                 the space under Paint was empty). Paint takes what it needs, the list the rest. -->
            <Grid x:Name="RightPanel" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Both cards fold (2026-11-11, the user: My designs was a small area to scroll) - hide
                     Paint and the designs take the whole column. Remembered across visits. -->
                <controls:FoldingCard Title="PAINT" FoldedName="{x:Bind ViewModel.PaintStyleName, Mode=OneWay}"
                                      SettingKey="ShipDesignerPaintCollapsed">
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <ScrollViewer>
                            <StackPanel Padding="16,14,16,16" Spacing="16">
                                <!-- The style, then each colour the style offers. -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PAINT STYLE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PaintStyles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ctcontrols:WrapPanel HorizontalSpacing="6" VerticalSpacing="6"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PaintStyleChoiceViewModel">
                                                <controls:ChoiceButton Content="{x:Bind Name}" Padding="12,5,12,5" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                                                       Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Some styles are unlocked in game by expedition rewards; said as the game would. -->
                                    <TextBlock Text="{x:Bind ViewModel.StyleUnlockNote, Mode=OneWay}" Visibility="{x:Bind ViewModel.StyleUnlockVisible, Mode=OneWay}"
                                               Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.ColourGroups}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="16"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ColourGroupViewModel">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{x:Bind PickedName, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- The game's own grid: two rows, half the swatches in each. -->
                                                <StackPanel Spacing="3" HorizontalAlignment="Left">
                                                    <ItemsControl ItemsSource="{x:Bind TopRow}" ItemTemplate="{StaticResource SwatchTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <ItemsControl ItemsSource="{x:Bind BottomRow}" ItemTemplate="{StaticResource SwatchTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </controls:FoldingCard>
                <controls:FoldingCard Grid.Row="1" Title="MY DESIGNS" Summary="{x:Bind ViewModel.DesignsSummary, Mode=OneWay}"
                                      SettingKey="ShipDesignerDesignsCollapsed">
                    <Border MinHeight="220" Style="{StaticResource ThemeCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox Margin="16,12,16,0" PlaceholderText="Find a design" AutomationProperties.Name="Find a design"
                                 Text="{x:Bind ViewModel.DesignSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <ScrollViewer Grid.Row="1" Margin="0,10,0,0">
                            <StackPanel Margin="16,0,16,16">
                                <TextBlock Text="{x:Bind ViewModel.DesignsEmptyText, Mode=OneWay}" Visibility="{x:Bind ViewModel.DesignsEmptyVisible, Mode=OneWay}"
                                           Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Designs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <!-- A card: the picture, name and type/style. Click to load; the corner button
                                             deletes (beside the card, not inside its button). -->
                                        <DataTemplate x:DataType="vm:SavedDesignCardViewModel">
                                            <Grid>
                                                <controls:ChoiceButton Padding="6" VerticalAlignment="Stretch" IsSelected="{x:Bind IsSelected, Mode=OneWay}"
                                                                       Command="{x:Bind LoadCommand}" ToolTipService.ToolTip="{x:Bind LoadToolTip}"
                                                                       AutomationProperties.Name="{x:Bind LoadName}">
                                                    <StackPanel Width="144" Spacing="2">
                                                        <Grid Width="144" Height="90" CornerRadius="4" Background="{ThemeResource ThemePanelAltBrush}">
                                                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform"/>
                                                            <TextBlock Text="Load it to take a picture" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                                                                       Style="{StaticResource ThemeDimTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Margin="8" Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}"/>
                                                        </Grid>
                                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" TextTrimming="CharacterEllipsis" Style="{StaticResource ThemeDimTextStyle}"/>
                                                    </StackPanel>
                                                </controls:ChoiceButton>
                                                <Button Padding="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"
                                                        Command="{x:Bind DeleteCommand}" ToolTipService.ToolTip="Delete this design"
                                                        AutomationProperties.Name="{x:Bind DeleteName}">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    </Border>
                </controls:FoldingCard>
            </Grid>

        </Grid>
        </ScrollViewer>
    </Grid>
</Page>
