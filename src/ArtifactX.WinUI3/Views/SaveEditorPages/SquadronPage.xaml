<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Squadron (SquadronViewModel): the four pilot slots and the
     selected pilot's race, rank, ship and seeds, with 3D previews of the pilot and its ship. Every edit is staged as
     it's made; Reset undoes this pilot's. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.SaveEditorPages.SquadronPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <!-- The previews beside the form only when there's room for both (window width includes the nav pane). -->
            <VisualStateGroup>
                <VisualState x:Name="DetailsSideBySide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1700"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- The previews go under the form, still side by side. -->
                <VisualState x:Name="DetailsStacked">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1150"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PreviewGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="PreviewGroup.(Grid.Row)" Value="1"/>
                        <Setter Target="PreviewGroup.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>
                <!-- Narrow window: the ship goes under the pilot too. -->
                <VisualState x:Name="DetailsNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PreviewGroup.(Grid.Column)" Value="0"/>
                        <Setter Target="PreviewGroup.(Grid.Row)" Value="1"/>
                        <Setter Target="PreviewGroup.HorizontalAlignment" Value="Left"/>
                        <Setter Target="ShipColumn.(Grid.Column)" Value="0"/>
                        <Setter Target="ShipColumn.(Grid.Row)" Value="1"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="SQUADRON" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Reset Squadron Changes" Click="Reset_Click" Visibility="{x:Bind ViewModel.HasEdits, Mode=OneWay}"
                        Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" MaxWidth="820" HorizontalAlignment="Left" TextWrapping="Wrap"
                       Text="Your four squadron pilots. The game works out each pilot's name, stat ratings, confirmed kills and notes from the seeds below - they aren't kept in your save, so they're changed by rerolling the seeds."/>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="PILOT SLOTS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Slots}" Margin="18,14,18,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SquadronSlotViewModel">
                                <Button Click="Slot_Click" Padding="12,6" Background="{x:Bind Fill, Mode=OneWay}"
                                        BorderBrush="{x:Bind Border, Mode=OneWay}" BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" FontWeight="{x:Bind Weight, Mode=OneWay}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ThemeCardStyle}" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="PILOT DETAILS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <Grid ColumnSpacing="32" RowSpacing="24" Padding="20,16,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="22" MaxWidth="760" HorizontalAlignment="Left">
                            <CheckBox Content="Slot unlocked" IsChecked="{x:Bind ViewModel.IsUnlocked, Mode=TwoWay}"
                                      ToolTipService.ToolTip="A locked slot has no pilot yet; unlock it to edit the pilot."/>

                            <!-- A locked slot has no real pilot yet, so its fields are leftover data, not editable
                                 (2026-08-10). IsEnabled lives on Control, so a ContentControl cascades it. -->
                            <ContentControl IsEnabled="{x:Bind ViewModel.IsUnlocked, Mode=OneWay}" HorizontalContentAlignment="Stretch" IsTabStop="False">
                                <StackPanel Spacing="22">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="PILOT RACE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <ComboBox ItemsSource="{x:Bind ViewModel.Races}" SelectedItem="{x:Bind ViewModel.Race, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Pilot race"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="PILOT RANK" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <NumberBox Value="{x:Bind ViewModel.Rank.Value, Mode=TwoWay}" Minimum="0" SpinButtonPlacementMode="Compact"
                                                           AutomationProperties.Name="Pilot rank"
                                                           ToolTipService.ToolTip="0 to 3 show in game as the C, B, A or S badge next to the pilot's name."/>
                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.RankLetter, Mode=OneWay}" FontFamily="{ThemeResource ThemeDisplayFont}"
                                                           FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="6">
                                            <TextBlock Text="SHIP TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <ComboBox ItemsSource="{x:Bind ViewModel.ShipTypes}" SelectedItem="{x:Bind ViewModel.ShipType, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch" AutomationProperties.Name="Ship type" ToolTipService.ToolTip="The pilot's ship model."/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="PILOT APPEARANCE SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                                      ToolTipService.ToolTip="Drives the pilot's look (the preview on the right). Paste a seed you've found elsewhere, or Generate a new one."/>
                                        </StackPanel>
                                        <controls:SeedBox x:Name="NpcSeedBox" Label="Pilot seed" Changed="Seed_Changed"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="PILOT AND SHIP NAME SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                                      ToolTipService.ToolTip="Drives the ship's look and rerolls the pilot's name and the ship's name together."/>
                                        </StackPanel>
                                        <controls:SeedBox x:Name="ShipSeedBox" Label="Ship seed" Changed="Seed_Changed"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="PILOT TRAITS SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                                      ToolTipService.ToolTip="Drives the pilot's four stat categories and their ratings (the categories themselves vary per pilot), confirmed kills and the notes line."/>
                                        </StackPanel>
                                        <controls:SeedBox x:Name="TraitsSeedBox" Label="Traits seed" Changed="Seed_Changed"/>
                                    </StackPanel>
                                </StackPanel>
                            </ContentControl>

                            <!-- The game's stat card for this pilot, worked out from the traits seed and rank as the game does
                                 (Core SquadronPilotFacts, catalog format 110). Read-only: reroll the traits seed or change the
                                 rank to change it. -->
                            <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasFacts, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="IN GAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                              ToolTipService.ToolTip="What the game's Squadron Pilots screen shows for this pilot. It follows the traits seed and the rank, so it updates as you change them."/>
                                </StackPanel>
                                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Background="{ThemeResource ThemePanelAltBrush}"
                                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="16,12,16,14" HorizontalAlignment="Left" MinWidth="360">
                                    <StackPanel Spacing="10">
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.Facts, Mode=OneWay}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="10"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:PilotFactRow">
                                                    <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleName}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{x:Bind Skill}" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                                            <TextBlock Text="{x:Bind Grade}" Foreground="{x:Bind GradeBrush}" FontSize="15" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Confirmed Kills" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                                <TextBlock Text="{x:Bind ViewModel.Kills, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="15" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Notes" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"/>
                                                <TextBlock Text="{x:Bind ViewModel.Notes, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="15" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- The pilot (its race's NPC scene; the appearance seed's first child seed picks the parts, as for a
                             freighter captain - a shape scan, colours unknown) beside its ship, the same height so they line up;
                             the ship's name sits under its preview. -->
                        <Grid x:Name="PreviewGroup" Grid.Column="1" ColumnSpacing="18" RowSpacing="18" VerticalAlignment="Top"
                              Visibility="{x:Bind ViewModel.ShowPreviews, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360"/>
                                <ColumnDefinition Width="360"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <controls:ModelPreviewPanel x:Name="PilotPreview" Subject="pilot" Heading="PILOT"
                                                        PreviewHeight="300" StartYawOffset="2.65" StartPitchOffset="0.45"/>
                            <StackPanel x:Name="ShipColumn" Grid.Column="1" Spacing="8">
                                <controls:ModelPreviewPanel x:Name="ShipPreview" Subject="ship" Heading="SHIP" PreviewHeight="300"/>
                                <TextBlock Text="{x:Bind ViewModel.ShipName, Mode=OneWay}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold"
                                           FontSize="15" Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
