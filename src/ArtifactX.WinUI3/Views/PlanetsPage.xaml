<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Read-only page: shows what
     the save knows about planets (see NmsPlanets) and never stages an edit. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.PlanetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <TextBlock Text="PLANETS" Style="{StaticResource ThemePageTitleStyle}"/>

            <!-- Current system: animated orbit view + one tile per known planet. -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="CURRENT SYSTEM" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="20,16,20,20" Spacing="18">
                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                            <!-- Orbit spacing, planet sizes and the star's colour are
                                 decorative: the save stores none of them. -->
                            <Border Width="360" Height="360" CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                    Background="{ThemeResource ThemeVoidBrush}">
                                <Canvas x:Name="SystemCanvas" Width="360" Height="360"/>
                            </Border>

                            <StackPanel Spacing="12" MaxWidth="520" VerticalAlignment="Top">
                                <TextBlock Text="LOCATION" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock x:Name="SystemHeadingTxt" Style="{StaticResource ThemeHeadingStyle}" FontSize="24"/>
                                <TextBlock x:Name="SystemSubTxt" Style="{StaticResource ThemeDimTextStyle}"/>
                                <StackPanel Spacing="6" Margin="0,6,0,0">
                                    <TextBlock Text="SYSTEM PORTAL ADDRESS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <StackPanel x:Name="SystemGlyphsPanel" Orientation="Horizontal" Spacing="3"/>
                                    <StackPanel Orientation="Horizontal" Spacing="10"
                                                ToolTipService.ToolTip="The same address as text: each character is one glyph, in order. The first is the planet number (0 for the system itself).">
                                        <TextBlock Text="Text code (for sharing):" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SystemCodeTxt" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" CharacterSpacing="80"
                                                   IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
                                        <Button x:Name="CopySystemCodeBtn" Content="Copy" Click="CopyCode_Click" Padding="10,3"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                           Text="Planet types, rings and your discoveries come from your save. Star colour, economy, conflict, weather and resources aren't saved (the game generates them each visit), so they can't be shown here."/>
                            </StackPanel>
                        </ctcontrols:WrapPanel>

                        <TextBlock x:Name="NoSystemPlanetsTxt" Style="{StaticResource ThemeDimTextStyle}" Visibility="Collapsed"
                                   Text="No planets in this system are in your discoveries yet. Scan or land on one in-game, then save."/>
                        <ctcontrols:WrapPanel x:Name="CurrentPlanetsPanel" HorizontalSpacing="14" VerticalSpacing="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Glyph decoder: paste a code someone shared, see the glyphs to dial. -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="GLYPH DECODER" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="20,16,20,20" Spacing="12">
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                                   Text="Paste a portal code someone shared (like 21BAE0F7D734) or galactic coordinates from a signal booster (like 0F2F:0065:077F:0013) to see the glyphs to dial."/>
                        <TextBox x:Name="DecoderInputBox" MaxWidth="420" HorizontalAlignment="Left"
                                 PlaceholderText="Portal code or galactic coordinates" TextChanged="DecoderInputBox_TextChanged"/>
                        <TextBlock x:Name="DecoderErrorTxt" Foreground="{ThemeResource ThemeWarningBrush}" FontSize="13" Visibility="Collapsed"/>
                        <StackPanel x:Name="DecoderResultPanel" Spacing="8" Visibility="Collapsed">
                            <StackPanel x:Name="DecoderGlyphsPanel" Orientation="Horizontal" Spacing="4"/>
                            <TextBlock x:Name="DecoderDetailTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" IsTextSelectionEnabled="True"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Planet finder: every planet in the save's discovery list. -->
            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="PLANET FINDER" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="20,16,20,20" Spacing="14">
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                                   Text="Every planet in your saves' discoveries, including ones other players found that the game downloaded for you. Pick a type to find the nearest one, then dial its portal address at any portal. Distances are approximate, measured from where this save is now."/>
                        <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                            <ComboBox x:Name="TypeFilterBox" Width="220" SelectionChanged="Filter_Changed" Header="Planet type"/>
                            <ComboBox x:Name="GalaxyFilterBox" Width="220" SelectionChanged="Filter_Changed" Header="Galaxy"/>
                            <ComboBox x:Name="SortBox" Width="180" SelectionChanged="Filter_Changed" Header="Sort">
                                <ComboBoxItem Content="Nearest first"/>
                                <ComboBoxItem Content="Newest first"/>
                            </ComboBox>
                            <CheckBox x:Name="RingsOnlyBox" Content="Rings only" Click="Filter_Click" VerticalAlignment="Bottom"/>
                            <CheckBox x:Name="MineOnlyBox" Content="Discovered by you" Click="Filter_Click" VerticalAlignment="Bottom"/>
                            <CheckBox x:Name="AllSlotsBox" Content="Include my other save slots" IsChecked="True" Click="AllSlotsBox_Click" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="ResultCountTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        </ctcontrols:WrapPanel>

                        <TextBlock x:Name="FinderStatusTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" Visibility="Collapsed"/>
                        <!-- Bounded height so the ListView virtualizes inside the page's
                             ScrollViewer (an unbounded one would realize every row). -->
                        <ListView x:Name="ResultsList" SelectionMode="None" MaxHeight="640">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PlanetRowViewModel">
                                    <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                            Background="{ThemeResource ThemePanelAltBrush}"
                                            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <Grid Width="44" Height="30" VerticalAlignment="Center">
                                                <Ellipse Width="26" Height="26" Fill="{x:Bind Swatch}"/>
                                                <Ellipse Width="44" Height="11" StrokeThickness="2" Stroke="{ThemeResource ThemeTextDimBrush}"
                                                         Visibility="{x:Bind RingVisibility}" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform Angle="-18"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind TypeLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind LocationLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <ItemsControl ItemsSource="{x:Bind Glyphs}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="2"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="ImageSource">
                                                            <Border Width="24" Height="24" Background="{ThemeResource ThemeVoidBrush}">
                                                                <Image Source="{x:Bind}" Width="20" Height="20"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{x:Bind PortalCode}" Style="{StaticResource ThemeDimTextStyle}" FontSize="11"
                                                           IsTextSelectionEnabled="True" CharacterSpacing="80"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind DistanceLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{x:Bind DiscoveredLabel}" Style="{StaticResource ThemeDimTextStyle}"
                                                           FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            </StackPanel>

                                            <Button Grid.Column="4" Content="Copy" Tag="{x:Bind PortalCode}" Click="CopyCode_Click"
                                                    VerticalAlignment="Center" Padding="10,3"
                                                    ToolTipService.ToolTip="Copy this planet's portal address"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
