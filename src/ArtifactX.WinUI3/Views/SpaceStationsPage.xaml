<?xml version="1.0" encoding="utf-8"?>
<!-- Space station directorship (SpaceStationsViewModel). Pilot page for the theme
     system: every colour, font and corner comes from the active theme's Theme* keys
     (Themes/*.xaml) via ThemeStyles.xaml, so the same markup renders as Station Core
     or Galaxy Map. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.SpaceStationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ThemeVoidBrush}">

    <Grid Background="{ThemeResource ThemePageBackdropBrush}">
        <ScrollViewer>
            <StackPanel Padding="28,26,28,40" Spacing="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SPACE STATIONS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Reset Station Changes" Click="PageResetBtn_Click"
                            Visibility="{x:Bind ViewModel.HasEdits, Mode=OneWay}" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Current station: its own screenshot as the backdrop, name on the left,
                     requirement meters on the right. -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <StackPanel>
                        <!-- The screenshot is painted as this grid's Background (an ImageBrush),
                             not an Image element - an Image measures at its own 16:9 size for the
                             full card width and made the card ~860px tall (user report). -->
                        <Grid MinHeight="240">
                            <Grid.Background>
                                <ImageBrush ImageSource="{x:Bind ViewModel.Hero, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.55"/>
                            </Grid.Background>
                            <Rectangle Fill="{ThemeResource ThemeHeroOverlayBrush}"/>
                            <ctcontrols:WrapPanel Padding="26,24" HorizontalSpacing="40" VerticalSpacing="20">
                                <StackPanel Spacing="6" MinWidth="320" MaxWidth="520">
                                    <TextBlock Text="CURRENT STATION" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentName, Mode=OneWay}" Style="{StaticResource ThemeHeadingStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentLocation, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}"/>
                                    <Border Visibility="{x:Bind ViewModel.IsDirector, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Background="{ThemeResource ThemeDoneBrush}" Padding="14,7" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                                        <TextBlock Text="◆  YOU ARE THE DIRECTOR" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold"
                                                   FontSize="12" CharacterSpacing="160" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind ViewModel.CurrentStatus, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                                               Style="{StaticResource ThemeDimTextStyle}" Margin="0,6,0,0"/>
                                    <Button Content="CLAIM STATION" Style="{StaticResource ThemeAccentButtonStyle}"
                                            Visibility="{x:Bind ViewModel.ShowClaim, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanClaim, Mode=OneWay}"
                                            Click="ClaimStationBtn_Click" Margin="0,8,0,0"
                                            ToolTipService.ToolTip="Makes you director of this station: meets the requirements and adds the station to your bases, without charging the Units donation."/>
                                </StackPanel>

                                <StackPanel Visibility="{x:Bind ViewModel.ShowRequirements, Mode=OneWay}" Spacing="14" MinWidth="320" MaxWidth="460">
                                    <TextBlock Text="DIRECTORSHIP REQUIREMENTS" Style="{StaticResource ThemeEyebrowStyle}"
                                               Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    <Grid ColumnSpacing="12" RowSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <!-- Race: shield -->
                                        <Path Grid.RowSpan="2" Width="24" Height="24" Stretch="Uniform" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2"
                                              Data="M16,3 L27,9 L27,17 C27,23 22,27 16,29 C10,27 5,23 5,17 L5,9 Z"/>
                                        <TextBlock Grid.Column="1" Text="Local race standing" Style="{StaticResource ThemeBodyTextStyle}"/>
                                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.Race.ValueText, Mode=OneWay}" Style="{StaticResource ThemeNumberStyle}"/>
                                        <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="6" Margin="0,0,0,10" Background="{ThemeResource ThemeTrackBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind ViewModel.Race.FillWidth, Mode=OneWay}"/>
                                                <ColumnDefinition Width="{x:Bind ViewModel.Race.RestWidth, Mode=OneWay}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind ViewModel.Race.BarBrush, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Guild: banner -->
                                        <Path Grid.Row="2" Grid.RowSpan="2" Width="24" Height="24" Stretch="Uniform" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2"
                                              Data="M5,6 L27,6 L24,23 L16,29 L8,23 Z M11,12 L21,12 M11,17 L21,17"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Local guild standing" Style="{StaticResource ThemeBodyTextStyle}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{x:Bind ViewModel.Guild.ValueText, Mode=OneWay}" Style="{StaticResource ThemeNumberStyle}"/>
                                        <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="6" Margin="0,0,0,10" Background="{ThemeResource ThemeTrackBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind ViewModel.Guild.FillWidth, Mode=OneWay}"/>
                                                <ColumnDefinition Width="{x:Bind ViewModel.Guild.RestWidth, Mode=OneWay}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind ViewModel.Guild.BarBrush, Mode=OneWay}"/>
                                        </Grid>

                                        <!-- Contracts: ringed planet -->
                                        <Path Grid.Row="4" Grid.RowSpan="2" Width="24" Height="24" Stretch="Uniform" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2"
                                              Data="M23,16 A7,7 0 1 1 9,16 A7,7 0 1 1 23,16 Z M2,20 C6,26 26,14 30,12"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Salvage contracts" Style="{StaticResource ThemeBodyTextStyle}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{x:Bind ViewModel.Contracts.ValueText, Mode=OneWay}" Style="{StaticResource ThemeNumberStyle}"/>
                                        <Grid Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Height="6" Background="{ThemeResource ThemeTrackBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind ViewModel.Contracts.FillWidth, Mode=OneWay}"/>
                                                <ColumnDefinition Width="{x:Bind ViewModel.Contracts.RestWidth, Mode=OneWay}"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="{x:Bind ViewModel.Contracts.BarBrush, Mode=OneWay}"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="Each station asks for one race and one guild, which the save doesn't record. Claim Station meets all of them."/>
                                </StackPanel>
                            </ctcontrols:WrapPanel>
                        </Grid>

                        <!-- Other systems where standing has been earned - only when any. -->
                        <StackPanel Visibility="{x:Bind ViewModel.HasClaims, Mode=OneWay}" Spacing="12" Padding="26,16,26,20"
                                    Background="{ThemeResource ThemePanelAltBrush}">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.ClaimsHeader, Mode=OneWay}" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
                                    <ComboBox Width="240" VerticalAlignment="Center" AutomationProperties.Name="Sort claims"
                                              ItemsSource="{x:Bind viewmodels:SpaceStationsViewModel.ClaimSortOptions}"
                                              SelectedIndex="{x:Bind ViewModel.ClaimSortIndex, Mode=TwoWay}"/>
                                    <CheckBox Content="{x:Bind ViewModel.ShowHiddenLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.ShowHidden, Mode=TwoWay}"
                                              IsEnabled="{x:Bind ViewModel.ShowHiddenEnabled, Mode=OneWay}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.ClaimHint, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasClaimHint, Mode=OneWay}"
                                       Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Claims}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:StationClaimViewModel">
                                        <controls:StationClaimCard Claim="{x:Bind}" HideToggled="ClaimCard_HideToggled"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- How to claim: collapsed by default, a real 5-step sequence. -->
                <Border Style="{StaticResource ThemeCardStyle}">
                    <StackPanel>
                        <Button Click="HowToToggle_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Background="Transparent" BorderThickness="0" Padding="18,12"
                                AutomationProperties.Name="How to claim a station">
                            <Grid>
                                <TextBlock Text="HOW TO CLAIM A STATION" Style="{StaticResource ThemeBandTextStyle}"
                                           Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                <TextBlock Text="{x:Bind HowToGlyph(ViewModel.HowToOpen), Mode=OneWay}" HorizontalAlignment="Right" FontSize="18"
                                           Foreground="{ThemeResource ThemeAccentBrush}"/>
                            </Grid>
                        </Button>
                        <ItemsControl ItemsSource="{x:Bind viewmodels:SpaceStationsViewModel.HowToSteps}"
                                      Visibility="{x:Bind ViewModel.HowToOpen, Mode=OneWay}" Padding="18,4,18,18">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:StationHowToStep">
                                    <StackPanel Spacing="4" Width="190" Padding="12" Background="{ThemeResource ThemePanelAltBrush}">
                                        <Border Height="2" Background="{ThemeResource ThemeAccentBrush}" Margin="-12,-12,-12,6"/>
                                        <TextBlock Text="{x:Bind Number}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="Bold" FontSize="22"
                                                   Foreground="{ThemeResource ThemeAccentBrush}"/>
                                        <TextBlock Text="{x:Bind Text}" FontSize="13" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ThemeCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <Grid>
                                <TextBlock Text="STATIONS YOU DIRECT" Style="{StaticResource ThemeBandTextStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.OwnedHeader, Mode=OneWay}" HorizontalAlignment="Right" Style="{StaticResource ThemeDimTextStyle}"/>
                            </Grid>
                        </Border>
                        <!-- Capped at two rows of tiles (126px + 12px gap) and scrolls inside,
                             so a long station list doesn't push the details card far down the
                             page (user report 2026-10-11). -->
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Padding="18,16,18,18">
                                <TextBlock Text="None yet. Claim the station you're docked at above." Visibility="{x:Bind ViewModel.NoOwned, Mode=OneWay}"
                                           Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                <ItemsControl ItemsSource="{x:Bind ViewModel.OwnedStations}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <!-- Screenshot tile: image, bottom fade, name, and a "CURRENT" badge
                                             in the player's system; the selected one is outlined. -->
                                        <DataTemplate x:DataType="viewmodels:StationTileViewModel">
                                            <Button Click="StationTile_Click" Padding="0" Background="{ThemeResource ThemePanelAltBrush}"
                                                    BorderBrush="{x:Bind Border, Mode=OneWay}" BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
                                                    CornerRadius="{ThemeResource ThemeCardCornerRadius}"
                                                    ToolTipService.ToolTip="{x:Bind Name}" AutomationProperties.Name="{x:Bind Name}">
                                                <Grid Width="224" Height="126" Background="{ThemeResource ThemePanelAltBrush}">
                                                    <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill"/>
                                                    <Rectangle Fill="{ThemeResource ThemeTileFadeBrush}"/>
                                                    <TextBlock Text="{x:Bind Name}" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold" FontSize="14"
                                                               TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"
                                                               VerticalAlignment="Bottom" Margin="10,0,10,8"/>
                                                    <Border Visibility="{x:Bind IsCurrent}" Background="{ThemeResource ThemeDoneBrush}" Padding="7,3,7,3"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                        <TextBlock Text="CURRENT" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="Bold" FontSize="10"
                                                                   CharacterSpacing="200" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Details for the selected tile. -->
                <Border x:Name="StationDetailsCard" Visibility="{x:Bind HasDetails(ViewModel.Details), Mode=OneWay}"
                        Style="{StaticResource ThemeCardStyle}" SizeChanged="StationDetailsCard_SizeChanged">
                    <controls:StationDetailsPanel Details="{x:Bind ViewModel.Details, Mode=OneWay}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
