<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.SaveFolderSelectPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArtifactX.WinUI3.Views"
    xmlns:models="using:ArtifactX.WinUI3.Models"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="40" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="Select Your No Man's Sky Save Folder" FontSize="22" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}"
                       Text="We looked for Steam, GOG, and Microsoft Store installs automatically. Expand a platform below to pick a save, or browse for your own."/>
        </StackPanel>

        <!-- One AnimatedExpander per detected/added platform - accordion-style
             (opening one closes any other, see SaveFolderSelectViewModel's
             OnCandidatePropertyChanged), since only one platform is realistically
             "the one you're working in" at a time. IsExpanded round-trips through
             SaveFolderSettingsService so the layout the user left it in survives
             a relaunch. -->
        <Grid Grid.Row="1">
            <ScrollViewer>
                <ItemsControl ItemsSource="{x:Bind ViewModel.Candidates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="12"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SaveFolderCandidate">
                            <!-- IsActive highlights whichever platform SaveSessionManager is
                                 currently working within - see IsActivePlatform's doc comment. -->
                            <controls:AnimatedExpander HorizontalAlignment="Stretch"
                                                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                        IsActive="{x:Bind IsActivePlatform, Mode=OneWay}">
                                <controls:AnimatedExpander.HeaderContent>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <SymbolIcon Grid.Column="0" Symbol="Folder"
                                                    Foreground="{ThemeResource NmsAccentBrush}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="14"/>
                                                <Border Background="{ThemeResource NmsAccentBrush}" CornerRadius="4" Padding="7,2"
                                                        Visibility="{x:Bind IsActivePlatform, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind SubText}" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                                                    Visibility="{x:Bind CanRemove, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Click="RenameFolderBtn_Click" Tag="{x:Bind}"
                                                    Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Give this folder a name">
                                                <SymbolIcon Symbol="Rename"/>
                                            </Button>
                                            <Button Click="RemoveFolderBtn_Click" Tag="{x:Bind}"
                                                    Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Remove this folder from the list">
                                                <SymbolIcon Symbol="Delete"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </controls:AnimatedExpander.HeaderContent>

                                <controls:AnimatedExpander.BodyContent>
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Visibility="{x:Bind IsLoadingSlots, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ProgressRing IsActive="{x:Bind IsLoadingSlots, Mode=OneWay}" Width="20" Height="20"/>
                                            <TextBlock Text="Indexing save files..." Foreground="{ThemeResource NmsTextSecondary}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="No readable save files were found in this folder."
                                                   Foreground="{ThemeResource NmsTextSecondary}" FontSize="13"
                                                   Visibility="{x:Bind IsEmptyResult, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Compact grid (not a tall single column) so a full
                                             6-slot folder fits without scrolling. -->
                                        <ItemsControl ItemsSource="{x:Bind SlotGroups}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SaveSlotGroup">
                                                    <Border Tapped="SaveSlot_Tapped" Tag="{x:Bind}"
                                                            Width="270" Padding="14" CornerRadius="10" BorderThickness="1"
                                                            BorderBrush="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                                            Background="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BoolToActiveBackgroundConverter}}">
                                                        <StackPanel Spacing="6">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{x:Bind SlotLabel}" FontWeight="Bold" FontSize="15"/>
                                                                <Border Grid.Column="1" Background="{ThemeResource NmsAccentBrush}" CornerRadius="4" Padding="7,2"
                                                                        Visibility="{x:Bind IsActive, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                                                </Border>
                                                            </Grid>

                                                            <TextBlock Text="{x:Bind PrimaryFile.SaveName}" FontWeight="SemiBold" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <Border Background="Transparent" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                                                                    CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                                                    Visibility="{x:Bind PrimaryFile.HasKnownGameMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind PrimaryFile.GameMode}" FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{ThemeResource NmsTextSecondary}"/>
                                                            </Border>

                                                            <TextBlock Text="{x:Bind PrimaryFile.SummaryDisplay}" FontSize="11"
                                                                       Foreground="{ThemeResource NmsTextSecondary}" TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Text="+ backup copy" FontSize="10" Opacity="0.5"
                                                                       Foreground="{ThemeResource NmsTextSecondary}"
                                                                       Visibility="{x:Bind HasBackupCopy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </controls:AnimatedExpander.BodyContent>
                            </controls:AnimatedExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="40" Height="40" HorizontalAlignment="Center"/>
                <TextBlock Text="Indexing your save folders — this only happens once per launch."
                           FontSize="13" Foreground="{ThemeResource NmsTextSecondary}"/>
            </StackPanel>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       TextWrapping="Wrap" Foreground="OrangeRed"
                       Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"/>
            <Button Content="Browse for folder..." Click="BrowseFolderBtn_Click" HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Page>
