<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml), same card pattern as the
     other equipment pages. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExosuitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel x:Name="MainColumn" Padding="28,26,28,40" Spacing="22" SizeChanged="MainColumn_SizeChanged">
            <!-- Reset button on the title's own row, pinned far right, so it
                 appearing never shifts the page down. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="EXOSUIT" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Exosuit Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Tech and cargo stacked, with the list of tech the exosuit can fit
                 beside them (or underneath on a narrow window) - same as Starships. -->
            <Grid x:Name="TechLayoutGrid" ColumnSpacing="22" RowSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel x:Name="TechCargoStack" Spacing="22" VerticalAlignment="Top" SizeChanged="TechCargoStack_SizeChanged">
                    <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="14,12,14,14" Spacing="10">
                                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                                    <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                                    <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                                    <Button Content="Arrange for Adjacency" Click="ArrangeTech_Click"
                                            ToolTipService.ToolTip="Groups same-type tech side by side so it gets the game's adjacency boost. Tech in supercharged slots stays where it is."/>
                                </ctcontrols:WrapPanel>
                                <controls:ExpandableScroll CollapsedHeight="232" SettingKey="ExosuitTechExpanded">
                                    <controls:InventorySlotGrid x:Name="TechGrid"/>
                                </controls:ExpandableScroll>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="CARGO" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="14,12,14,14" Spacing="10">
                                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="Unlock All Slots" Click="UnlockAllCargo_Click"/>
                                    <Button Content="Max All Qty" Click="MaxAllQtyCargo_Click"/>
                                    <Button Content="Sort" Click="SortCargo_Click"
                                            ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                                </ctcontrols:WrapPanel>
                                <controls:ExpandableScroll CollapsedHeight="368" SettingKey="ExosuitCargoExpanded">
                                    <controls:InventorySlotGrid x:Name="CargoGrid"/>
                                </controls:ExpandableScroll>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border x:Name="TechListCard" Grid.Column="1" Style="{StaticResource ThemeCardStyle}" Width="340" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="EXOSUIT TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <Border Padding="14,12,14,14">
                            <controls:ItemListPanel x:Name="TechListPanel"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
