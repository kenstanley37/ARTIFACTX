<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.SquadronPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Squadron" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Squadron Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Your 4 Squadron Pilot slots. Each pilot's displayed Name, ship flavor name, stat ratings (Intelligence/Mechanical Aptitude/etc.), Confirmed Kills, and Notes are generated by the game itself from the fields below and aren't stored or reproducible here - only the underlying pilot race, ship, seeds, and rank are directly editable."/>
            <controls:DevNoteTextBlock MaxWidth="820"
                       Text="FIRST PASS, 2026-08-09 - field map confirmed structurally against a real save (vLc/6f=/S5O, a real fixed-4 array matching libMBIN's GcSquadronPilotData exactly). Race and Rank cross-checked against GcPlayerSquadronConfig's own data (RandomPilotNPCResources, PilotRankAttackDefinitions). Ship Type independently discovered from real .SCENE.MBIN files under models/common/spacecraft/ - 7 standard archetypes plus 6 reward-ship entries; 3 of those 6 (Starborn Runner, Boundary Herald, The Wraith) are directly confirmed from a real save's owned-ship data, the other 3 (Golden Vector, Horizon Vector NX, Starborn Phoenix) are inferred from matching part files/naming patterns. Hauler, Utopia Speeder, and Iron Vulture genuinely couldn't be traced to any file despite real effort and are deliberately left out (see ArtifactX.Almanac.Starship.StarshipTypes' own doc comment). READING is high-confidence; WRITING a new value back and reloading in-game has not been tested yet."/>

            <StackPanel Spacing="20" HorizontalAlignment="Stretch">
                <TextBlock Text="Pilot Slots" FontSize="14" Opacity="0.8"/>
                <ctcontrols:WrapPanel x:Name="PilotSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>

                <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="8" Padding="20" Opacity="0.9" HorizontalAlignment="Stretch">
                    <StackPanel Spacing="18">
                        <CheckBox x:Name="UnlockedCheckBox" Content="Slot Unlocked" Click="UnlockedCheckBox_Click"/>

                        <StackPanel Orientation="Horizontal" Spacing="32">
                            <StackPanel Spacing="6" Width="160">
                                <TextBlock Text="Pilot Race" FontSize="12" Opacity="0.7"/>
                                <ComboBox x:Name="RaceBox" Width="150" HorizontalAlignment="Left" SelectionChanged="RaceBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="160">
                                <TextBlock Text="Pilot Rank" FontSize="12" Opacity="0.7"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="RankBox" Width="110" HorizontalAlignment="Left" Minimum="0" SpinButtonPlacementMode="Compact"
                                               ValueChanged="RankBox_ValueChanged"
                                               ToolTipService.ToolTip="Raw value - 0/1/2/3 are confirmed to show as the C/B/A/S class badge next to the pilot's name in-game (0=C, 3=S). Values above 3 are untested."/>
                                    <TextBlock x:Name="RankLetterTxt" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- WrapPanel, not a plain vertical StackPanel - these
                             4 blocks used to stack in a single tall column
                             regardless of window width, forcing a scroll even
                             on a wide window (2026-08-09 user report). Each
                             child keeps its own fixed Width so wrapping is
                             predictable, same pattern as Frigate's Stats/
                             Expedition Record WrapPanels. -->
                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                            <StackPanel Spacing="6" Width="300">
                                <TextBlock Text="Pilot Appearance Seed" FontSize="12" Opacity="0.7"/>
                                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" HorizontalAlignment="Left"
                                           Text="Drives this pilot's procedural look. Paste a seed you've found elsewhere, or click Generate for a new random look - you won't see it until you load into the game."/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="NpcSeedEditBox" Width="180" HorizontalAlignment="Left" LostFocus="NpcSeedEditBox_LostFocus"/>
                                    <Button Grid.Column="1" Content="Generate" Click="GenerateNpcSeedBtn_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6" Width="240">
                                <TextBlock Text="Ship Type" FontSize="12" Opacity="0.7"/>
                                <ComboBox x:Name="ShipTypeBox" Width="230" HorizontalAlignment="Left" SelectionChanged="ShipTypeBox_SelectionChanged"
                                          ToolTipService.ToolTip="7 standard archetypes plus 6 reward-ship entries are offered - Hauler, Utopia Speeder, and Iron Vulture couldn't be confirmed safely. See NmsSquadronPaths for why."/>
                                <TextBlock x:Name="ShipFilenameTxt" FontSize="10" Opacity="0.55" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                            </StackPanel>

                            <StackPanel Spacing="6" Width="300">
                                <TextBlock Text="Ship Appearance Seed" FontSize="12" Opacity="0.7"/>
                                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" HorizontalAlignment="Left"
                                           Text="Drives this ship's procedural paint/look. Paste a seed you've found elsewhere, or click Generate for a new random look - you won't see it until you load into the game."/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="ShipSeedEditBox" Width="180" HorizontalAlignment="Left" LostFocus="ShipSeedEditBox_LostFocus"/>
                                    <Button Grid.Column="1" Content="Generate" Click="GenerateShipSeedBtn_Click"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="6" Width="300">
                                <TextBlock Text="Traits Seed" FontSize="12" Opacity="0.7"/>
                                <controls:DevNoteTextBlock
                                           Text="Believed to drive the pilot's generated stat ratings, Confirmed Kills, and Notes line - not verified in-game, and the word/number thresholds it maps to weren't found in any decoded game data table. Regenerating this will change how the pilot is described in-game, but ArtifactX can't preview what it changes to."/>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TraitsSeedEditBox" Width="180" HorizontalAlignment="Left" LostFocus="TraitsSeedEditBox_LostFocus"/>
                                    <Button Grid.Column="1" Content="Generate" Click="GenerateTraitsSeedBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </ctcontrols:WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
