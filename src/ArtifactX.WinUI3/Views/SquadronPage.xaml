<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.SquadronPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SQUADRON" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Squadron Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" MaxWidth="820" HorizontalAlignment="Left"
                       Text="Your 4 Squadron Pilot slots. Each pilot's displayed Name, ship flavor name, stat ratings (Intelligence/Mechanical Aptitude/etc.), Confirmed Kills, and Notes are generated by the game itself from the fields below and aren't stored or reproducible here - only the underlying pilot race, ship, seeds, and rank are directly editable."/>

            <StackPanel Spacing="22" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource ThemeCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="PILOT SLOTS" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <ctcontrols:WrapPanel x:Name="PilotSelectorPanel" Padding="18,14,18,16" HorizontalSpacing="8" VerticalSpacing="8"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ThemeCardStyle}">
                  <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="PILOT DETAILS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Spacing="18" Padding="20,16,20,20">
                        <CheckBox x:Name="UnlockedCheckBox" Content="Slot Unlocked" Click="UnlockedCheckBox_Click"/>

                        <!-- One IsEnabled toggle for the whole editable region
                             (cascades to every descendant control) rather than
                             disabling each field individually - a locked slot
                             has no real pilot yet, so its Race/Rank/Ship/Seed
                             values are meaningless leftover/default data, not
                             something a user should be able to edit (real bug
                             found 2026-08-10: a locked slot's fields were
                             fully editable). -->
                        <!-- ContentControl, not StackPanel - IsEnabled lives on
                             Control, not Panel, and cascading it to every
                             descendant control is the whole point here. -->
                        <ContentControl x:Name="EditableFieldsPanel" HorizontalContentAlignment="Stretch"
                                        IsTabStop="False">
                        <StackPanel Spacing="18">

                        <!-- WrapPanel, not a plain horizontal StackPanel - a
                             fixed-orientation StackPanel doesn't reflow, so
                             Ship Type was getting squeezed/truncated instead
                             of dropping to its own row on a narrow window
                             (2026-08-10 user report). -->
                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                            <StackPanel Spacing="6" Width="160">
                                <TextBlock Text="PILOT RACE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ComboBox x:Name="RaceBox" AutomationProperties.Name="Pilot race" Width="150" HorizontalAlignment="Left" SelectionChanged="RaceBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="210">
                                <TextBlock Text="PILOT RANK" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox x:Name="RankBox" AutomationProperties.Name="Pilot rank" Width="110" HorizontalAlignment="Left" Minimum="0" SpinButtonPlacementMode="Compact"
                                               ValueChanged="RankBox_ValueChanged"
                                               ToolTipService.ToolTip="0 to 3 show in-game as the C, B, A or S badge next to the pilot's name."/>
                                    <TextBlock x:Name="RankLetterTxt" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="240">
                                <TextBlock Text="SHIP TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ComboBox x:Name="ShipTypeBox" AutomationProperties.Name="Ship type" Width="230" HorizontalAlignment="Left" SelectionChanged="ShipTypeBox_SelectionChanged"
                                          ToolTipService.ToolTip="The pilot's ship model."/>
                            </StackPanel>
                        </ctcontrols:WrapPanel>

                        <!-- Each card's label+help-text sits in its own
                             MinHeight block so the TextBox+Generate row below
                             lines up across all 3 cards regardless of how
                             many lines each one's help text wraps to (2026-
                             08-10 user report - the "Generate" buttons were
                             landing at different heights depending on text
                             length). Not a Grid with shared row definitions
                             (would align perfectly but can't reflow to fewer
                             columns on a narrow window the way WrapPanel
                             does) - MinHeight is the tradeoff that keeps
                             both responsiveness and alignment. -->
                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                            <StackPanel Spacing="6" Width="300">
                                <StackPanel Spacing="4" MinHeight="96">
                                    <TextBlock Text="PILOT APPEARANCE SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" HorizontalAlignment="Left"
                                               Text="Drives this pilot's procedural look. Paste a seed you've found elsewhere, or click Generate for a new random look - you won't see it until you load into the game."/>
                                </StackPanel>
                                <controls:SeedBox x:Name="NpcSeedBox" Label="Pilot seed" Changed="Seed_Changed" BoxWidth="180"/>
                            </StackPanel>

                            <StackPanel Spacing="6" Width="300">
                                <StackPanel Spacing="4" MinHeight="96">
                                    <TextBlock Text="PILOT &amp; SHIP NAME SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" HorizontalAlignment="Left"
                                               Text="Rerolls the pilot's Name AND the ship's flavor name together."/>
                                </StackPanel>
                                <controls:SeedBox x:Name="ShipSeedBox" Label="Ship seed" Changed="Seed_Changed" BoxWidth="180"/>
                            </StackPanel>

                            <StackPanel Spacing="6" Width="300">
                                <StackPanel Spacing="4" MinHeight="96">
                                    <TextBlock Text="PILOT TRAITS SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" HorizontalAlignment="Left"
                                               Text="Drives the pilot's 4 stat categories AND their ratings (the category set itself varies per pilot, not just the values), Confirmed Kills, and the Notes line."/>
                                </StackPanel>
                                <controls:SeedBox x:Name="TraitsSeedBox" Label="Traits seed" Changed="Seed_Changed" BoxWidth="180"/>
                            </StackPanel>
                        </ctcontrols:WrapPanel>

                        </StackPanel>
                        </ContentControl>
                    </StackPanel>
                  </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
