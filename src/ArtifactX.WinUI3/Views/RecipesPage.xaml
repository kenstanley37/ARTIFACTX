<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Read-only Tools page:
     every refiner and cooking recipe from the game's own recipe table. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.RecipesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="RecipeItemTemplate" x:DataType="viewmodels:RecipeItemViewModel">
            <Button Click="Item_Click" Tag="{x:Bind ItemId}" Padding="6,3" Background="{ThemeResource ThemeVoidBrush}"
                    BorderBrush="{ThemeResource ThemeLineBrush}" ToolTipService.ToolTip="Show recipes for this item">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{x:Bind Icon}" Width="26" Height="26"/>
                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="RECIPES" Style="{StaticResource ThemePageTitleStyle}"/>

        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}"
                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13"
                           Text="Every refiner and Nutrient Processor recipe from the game's own recipe table. Search for an item to see how to make it, or what it's used in. Click any item in a recipe to jump to its recipes. Refiners: a Portable Refiner takes 1 input, a Medium Refiner 2, a Large Refiner 3."/>
            </Grid>
        </Border>

        <ctcontrols:WrapPanel Grid.Row="2" HorizontalSpacing="14" VerticalSpacing="10">
            <AutoSuggestBox x:Name="SearchBox" Header="Item" Width="320" PlaceholderText="e.g. Chromatic Metal, Sodium Nitrate"
                            TextChanged="SearchBox_TextChanged" SuggestionChosen="SearchBox_SuggestionChosen" QueryIcon="Find"/>
            <ComboBox x:Name="ModeBox" Header="Show" Width="230" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="How to make it"/>
                <ComboBoxItem Content="What it's used in"/>
            </ComboBox>
            <ComboBox x:Name="KindBox" Header="Recipe type" Width="200" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Refiner and cooking"/>
                <ComboBoxItem Content="Refiner only"/>
                <ComboBoxItem Content="Cooking only"/>
            </ComboBox>
            <ComboBox x:Name="InputsBox" Header="Inputs" Width="240" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Any number"/>
                <ComboBoxItem Content="1 (Portable Refiner)"/>
                <ComboBoxItem Content="Up to 2 (Medium Refiner)"/>
            </ComboBox>
            <TextBlock x:Name="CountTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </ctcontrols:WrapPanel>

        <ListView Grid.Row="3" x:Name="RecipesList" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:RecipeRowViewModel">
                    <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                            Background="{ThemeResource ThemePanelAltBrush}"
                            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock Text="{x:Bind Station}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="6">
                                <ItemsControl ItemsSource="{x:Bind Ingredients}" ItemTemplate="{StaticResource RecipeItemTemplate}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <TextBlock Text="→" FontSize="20" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Center" Margin="4,0"/>
                                <ContentPresenter Content="{x:Bind Result}" ContentTemplate="{StaticResource RecipeItemTemplate}"/>
                            </ctcontrols:WrapPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
