<Page x:Class="ArtifactX.WinUI3.Views.RecipesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="using:ArtifactX.WinUI3.ViewModels" xmlns:controls="using:ArtifactX.WinUI3.Controls" xmlns:ct="using:CommunityToolkit.WinUI.Controls"
 NavigationCacheMode="Required" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
 <Page.Resources><DataTemplate x:Key="RecipeCard" x:DataType="vm:RecipePlannerItemViewModel"><controls:RecipePlannerCard ViewModel="{x:Bind}"/></DataTemplate></Page.Resources>
  <Grid Padding="28,26,28,24" RowSpacing="12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <TextBlock Text="RECIPE PLANNER" Style="{StaticResource ThemePageTitleStyle}"/>
   <controls:RecipePlannerBrowser Grid.Row="1" ViewModel="{x:Bind ViewModel}"/>
   <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.Status, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   <StackPanel Grid.Row="3" Visibility="{x:Bind ViewModel.PlannerVisibility, Mode=OneWay}" Spacing="12">
    <Border Style="{StaticResource ThemeCardStyle}" Padding="16">
     <ct:WrapPanel HorizontalSpacing="18" VerticalSpacing="14">
      <StackPanel Spacing="6" Width="320"><TextBlock Text="YOU'RE MAKING" Style="{StaticResource ThemeEyebrowStyle}"/><TextBlock Text="{x:Bind ViewModel.TargetName, Mode=OneWay}" FontSize="21" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind ViewModel.PlanSummary, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/></StackPanel>
      <NumberBox Width="160" Header="Quantity to make" Value="{x:Bind ViewModel.Quantity, Mode=TwoWay}" Minimum="1" Maximum="99999" SpinButtonPlacementMode="Inline" AutomationProperties.Name="Quantity of the main recipe to make"/>
      <StackPanel Width="340" Spacing="6" Visibility="{x:Bind ViewModel.IngestorVisibility, Mode=OneWay}"><TextBlock Text="NUTRIENT INGESTOR EFFECT" Style="{StaticResource ThemeEyebrowStyle}"/><TextBlock Text="{x:Bind ViewModel.TargetBuff, Mode=OneWay}" Foreground="{ThemeResource ThemeAccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Place this food in the Nutrient Ingestor. Eating it directly has a different effect." Foreground="{ThemeResource ThemeTextBrush}" FontSize="12" TextWrapping="Wrap"/></StackPanel>
     </ct:WrapPanel>
    </Border>
    <StackPanel Spacing="8">
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="← Back" Command="{x:Bind ViewModel.BackCommand}" IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"/><Button Content="Main recipe" Command="{x:Bind ViewModel.MainRecipeCommand}"/></StackPanel>
     <ItemsControl ItemsSource="{x:Bind ViewModel.Breadcrumbs}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><ct:WrapPanel HorizontalSpacing="8" VerticalSpacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerCrumb"><Button Content="{x:Bind Name}" Command="{x:Bind NavigateCommand}"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </StackPanel>
    <Grid x:Name="Workspace" Grid.Row="4" Visibility="{x:Bind ViewModel.PlannerVisibility, Mode=OneWay}" ColumnSpacing="18" RowSpacing="12">
     <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <VisualStateManager.VisualStateGroups><VisualStateGroup x:Name="WorkspaceStates">
      <VisualState x:Name="WidePlanner"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1250"/></VisualState.StateTriggers></VisualState>
      <VisualState x:Name="CompactPlanner"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
       <Setter Target="Details.(Grid.Row)" Value="1"/><Setter Target="Details.(Grid.Column)" Value="0"/><Setter Target="Details.(Grid.ColumnSpan)" Value="3"/>
       <Setter Target="Details.MaxHeight" Value="240"/>
       <Setter Target="MapPanel.(Grid.ColumnSpan)" Value="2"/>
      </VisualState.Setters></VisualState>
     </VisualStateGroup></VisualStateManager.VisualStateGroups>
     <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <Border VerticalAlignment="Top" Style="{StaticResource ThemeCardStyle}" Padding="12">
      <StackPanel Spacing="10"><TextBlock Text="GATHER INGREDIENTS" Style="{StaticResource ThemeEyebrowStyle}"/><TextBlock Text="Totals for your main recipe" Foreground="{ThemeResource ThemeTextBrush}" TextWrapping="Wrap"/>
       <ItemsControl ItemsSource="{x:Bind ViewModel.Gather}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RecipePlannerItemViewModel">
        <Button Command="{x:Bind SelectCommand}" AutomationProperties.Name="{x:Bind SelectionName}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,3" Padding="9">
         <StackPanel Spacing="5"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Inventory, Mode=OneWay}" TextWrapping="Wrap" FontSize="12"/></StackPanel>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Border>
     </ScrollViewer>
     <Grid x:Name="MapPanel" Grid.Column="1" RowSpacing="12">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{x:Bind ViewModel.MapHeading, Mode=OneWay}" Foreground="{ThemeResource ThemeTextBrush}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="Map" Command="{x:Bind ViewModel.ShowMapCommand}"/><Button Content="Step order" Command="{x:Bind ViewModel.ShowOrderCommand}"/></StackPanel>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Recipe requirements map and steps">
       <Grid>
      <controls:RecipePlannerMap ViewModel="{x:Bind ViewModel}" Visibility="{x:Bind ViewModel.MapVisibility, Mode=OneWay}"/>
      <ItemsControl ItemsSource="{x:Bind ViewModel.Cards}" Visibility="{x:Bind ViewModel.OrderVisibility, Mode=OneWay}" ItemTemplate="{StaticResource RecipeCard}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><ct:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
       </Grid>
      </ScrollViewer>
     </Grid>
     <ScrollViewer x:Name="Details" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Selected ingredient details">
      <controls:RecipePlannerDetails VerticalAlignment="Top" Item="{x:Bind ViewModel.SelectedItem, Mode=OneWay}" RecipeChanged="RecipeChanged"/>
     </ScrollViewer>
    </Grid>
  </Grid>
</Page>
