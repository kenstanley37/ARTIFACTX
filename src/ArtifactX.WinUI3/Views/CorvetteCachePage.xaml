<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.CorvetteCachePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20">
            <!-- Reset button on the title's own row, pinned far right via the
                 "*" spacer column, styled to stand out as a destructive
                 action - not its own row below, which shifted the whole page
                 down whenever it appeared. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Corvette Workshop Cache" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Cache Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Spacing="20" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Contents" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Max All Qty" Click="MaxAllQtyBtn_Click"/>
            </StackPanel>
            <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                    CornerRadius="6" HorizontalAlignment="Left" Opacity="0.9">
                <Grid>
                    <ScrollViewer x:Name="CacheScrollViewer" Padding="8,32,8,8" MaxHeight="708" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                        <controls:InventorySlotGrid x:Name="CacheGrid"/>
                    </ScrollViewer>
                    <Button x:Name="CacheExpandBtn" Click="CacheExpandBtn_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                            Padding="6" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Expand">
                        <FontIcon x:Name="CacheExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
