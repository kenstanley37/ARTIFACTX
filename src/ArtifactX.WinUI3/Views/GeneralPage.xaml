<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Left">
            <TextBlock Text="General" FontSize="26" FontWeight="Bold"/>
            <Button x:Name="PageResetBtn" Content="Reset General Changes" Click="PageResetBtn_Click" Visibility="Collapsed"/>

            <StackPanel Spacing="8">
                <TextBlock Text="Currency" FontSize="18" FontWeight="SemiBold"/>
                <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Opacity="0.9" Width="320" HorizontalAlignment="Left">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Units" FontSize="12" Opacity="0.7"/>
                            <NumberBox x:Name="UnitsBox" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       ValueChanged="UnitsBox_ValueChanged" LostFocus="UnitsBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Nanites" FontSize="12" Opacity="0.7"/>
                            <NumberBox x:Name="NanitesBox" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       ValueChanged="NanitesBox_ValueChanged" LostFocus="NanitesBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Quicksilver" FontSize="12" Opacity="0.7"/>
                            <NumberBox x:Name="QuicksilverBox" Minimum="0" SpinButtonPlacementMode="Hidden"
                                       ValueChanged="QuicksilverBox_ValueChanged" LostFocus="QuicksilverBox_LostFocus"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
