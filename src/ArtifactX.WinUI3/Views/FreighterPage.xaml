<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml), same card structure as
     ShipsPage. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.FreighterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <!-- On the page's root element: AdaptiveTriggers attached to a nested
             Grid never fired (2026-10-10 - the narrow layout never applied). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HeaderWide">
                    <VisualState.StateTriggers>
                        <!-- WINDOW width, which includes the ~320px nav pane: two columns
                             need nav + grid card (~720) + sidebar (~340) + gaps/padding.
                             950 left the sidebar clipped beside the grid (2026-10-10). -->
                        <AdaptiveTrigger MinWindowWidth="1440"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="28,26,28,40" Spacing="22" HorizontalAlignment="Stretch">

            <!-- Shown instead of HeaderGrid when the player doesn't actually
                 own a freighter yet (bIR.93M hull scene path empty) - without
                 this the Tech/Cargo grids rendered anyway, reading a
                 structurally-always-present-but-unowned container (real bug
                 found 2026-08-10 on a save that hadn't left the starting planet). -->
            <StackPanel x:Name="NoFreighterPanel" Spacing="18" MaxWidth="760" HorizontalAlignment="Left" Visibility="Collapsed">
                <TextBlock Text="FREIGHTER" Style="{StaticResource ThemePageTitleStyle}"/>
                <TextBlock Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap">
                    <Run Text="You don't own a freighter yet. Start fresh with a basic one, or add one from a Full Build template - it arrives with that freighter's look, tech and furnished interior. Either way it's parked in the system you're in."/>
                    <LineBreak/><LineBreak/>
                    <Run Text="Or get one in game: warp until you arrive in a space battle with a freighter under pirate attack, destroy the pirates, then land and talk to the captain on the bridge (sometimes free, sometimes for Units). You can also buy one from any freighter captain."/>
                </TextBlock>

                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                        Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                    <StackPanel Padding="16,14,16,16" Spacing="12">
                        <TextBlock Text="START FRESH" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                                   Text="A brand-new freighter, just like the game gives you: C class, a hyperdrive and scanner, the starter interior and a random look. Build it up yourself - change its look, class and tech once it's yours."/>
                        <StackPanel x:Name="StarterListPanel" Spacing="10"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                        Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                    <StackPanel Padding="16,14,16,16" Spacing="12">
                        <TextBlock Text="ADD A FREIGHTER" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                                   Text="Freighter Full Build templates - yours, or one a friend shared. Save one from a save that has the freighter you want (Freighter page, Full Build, Save Current...)."/>
                        <Button Content="Import a template file..." Click="AddFreighterImport_Click" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="AddFreighterStatusTxt" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <StackPanel x:Name="AddFreighterListPanel" Spacing="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ONE Grid for the whole page body (title row + a single tall
                 content row), matching ShipsPage's structure - column 0
                 (Technology+Cargo) and column 1 (Templates+Freighter details)
                 both live in the SAME Grid row. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FREIGHTER" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Freighter Changes" Click="PageResetBtn_Click"
                            Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="MainColumn" Grid.Row="1" Grid.Column="0" Spacing="22" SizeChanged="MainColumn_SizeChanged">
                    <!-- Details above the tech, like Starships/Multi-Tool (2026-10-15 - they
                         sat at the bottom of the sidebar). Type and Crew Race are model
                         scene-path swaps (bIR.93M / Sjw.93M); Model Seed and Crew Seed are
                         the matching @EL seeds. -->
                    <Border x:Name="FreighterInfoBorder" Style="{StaticResource ThemeCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <Grid>
                                    <TextBlock x:Name="DetailsHeaderTxt" Text="FREIGHTER DETAILS" Style="{StaticResource ThemeBandTextStyle}" VerticalAlignment="Center"/>
                                    <Button x:Name="DetailsToggle" Click="DetailsToggle_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="6,2" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Hide the details">
                                        <FontIcon x:Name="DetailsToggleIcon" Glyph="&#xE70E;" FontSize="12" Foreground="{ThemeResource ThemeBandTextBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="DetailsBody" Padding="18,14,18,18" Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="BASE STATS" Style="{StaticResource ThemeEyebrowStyle}"
                                               ToolTipService.ToolTip="No known upper limit - extreme values won't corrupt your save, just unbalance it."/>
                                    <ctcontrols:WrapPanel HorizontalSpacing="16" VerticalSpacing="10">
                                        <StackPanel Width="150" Spacing="4">
                                            <TextBlock Text="Hyperdrive" Style="{StaticResource ThemeBodyTextStyle}"/>
                                            <NumberBox x:Name="HyperdriveStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="HyperdriveStatBox_ValueChanged" LostFocus="HyperdriveStatBox_LostFocus"/>
                                        </StackPanel>
                                        <StackPanel Width="150" Spacing="4">
                                            <TextBlock Text="Fleet Coordination" Style="{StaticResource ThemeBodyTextStyle}"/>
                                            <NumberBox x:Name="FleetStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="FleetStatBox_ValueChanged" LostFocus="FleetStatBox_LostFocus"/>
                                        </StackPanel>
                                    </ctcontrols:WrapPanel>
                                </StackPanel>

                                <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                                    <StackPanel Width="280" Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <TextBox x:Name="NameEditBox" LostFocus="NameEditBox_LostFocus"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <controls:ClassPicker x:Name="ClassPicker" ClassChosen="ClassPicker_ClassChosen"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <ComboBox x:Name="TypeComboBox" HorizontalAlignment="Stretch"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="TypeComboBox_SelectionChanged"/>
                                        </StackPanel>
                                        <Button Content="Delete this freighter..." Click="DeleteFreighterBtn_Click" Margin="0,4,0,0"
                                                    Foreground="{ThemeResource ThemeWarningBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}"
                                                    ToolTipService.ToolTip="Remove your freighter from the save. You can keep it as a template first."/>
                                    </StackPanel>
                                    <StackPanel Width="300" Spacing="12">
                                        <!-- Home Seed: also the freighter's registered home-system address,
                                             but 2 isolated in-game tests showed it drives the hull's paint/
                                             texture too (shape stays, colours reroll). Model Seed matches a
                                             reference tool's field; 2 tests regenerating it showed no visible
                                             change - what it controls is still unconfirmed. -->
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="HOME SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                                          ToolTipService.ToolTip="Sets the hull's paint and colour pattern (the shape stays the same). Paste a value you've found elsewhere, or Generate a new one."/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="HomeSeedEditBox" LostFocus="HomeSeedEditBox_LostFocus"/>
                                                <Button Grid.Column="1" Content="Generate" Click="GenerateHomeSeedBtn_Click"/>
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="MODEL SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                                          ToolTipService.ToolTip="A second appearance seed for the hull. Its visible effect hasn't been pinned down yet - the paint scheme comes from Home Seed."/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="ModelSeedEditBox" LostFocus="ModelSeedEditBox_LostFocus"/>
                                                <Button Grid.Column="1" Content="Generate" Click="GenerateModelSeedBtn_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Width="300" Spacing="12">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="CREW RACE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <ComboBox x:Name="CrewRaceComboBox" HorizontalAlignment="Stretch"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectionChanged="CrewRaceComboBox_SelectionChanged"/>
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="CREW SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                <FontIcon Glyph="&#xE946;" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"
                                                          ToolTipService.ToolTip="Drives the captain's look, alongside their Race. Paste a seed you've found elsewhere, or Generate a new one."/>
                                            </StackPanel>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="CrewSeedEditBox" LostFocus="CrewSeedEditBox_LostFocus"/>
                                                <Button Grid.Column="1" Content="Generate" Click="GenerateCrewSeedBtn_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ctcontrols:WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Tech and cargo stacked, with the list of tech the freighter can fit
                         beside them, or underneath on a narrow window - same as Starships. -->
                    <Grid x:Name="TechLayoutGrid" ColumnSpacing="22" RowSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="TechCargoStack" Spacing="22" VerticalAlignment="Top" SizeChanged="TechCargoStack_SizeChanged">
                            <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Border Style="{StaticResource ThemeBandStyle}">
                                        <TextBlock Text="TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                                    </Border>
                                    <StackPanel Padding="14,12,14,14" Spacing="10">
                                        <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                                            <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                                            <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                                            <Button Content="Arrange for Adjacency" Click="ArrangeTech_Click"
                                                    ToolTipService.ToolTip="Groups same-type tech side by side so it gets the game's adjacency boost. Tech in supercharged slots stays where it is."/>
                                        </ctcontrols:WrapPanel>
                                        <controls:ExpandableScroll CollapsedHeight="232" SettingKey="FreighterTechExpanded">
                                            <controls:InventorySlotGrid x:Name="TechGrid"/>
                                        </controls:ExpandableScroll>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Border Style="{StaticResource ThemeBandStyle}">
                                        <TextBlock Text="CARGO" Style="{StaticResource ThemeBandTextStyle}"/>
                                    </Border>
                                    <StackPanel Padding="14,12,14,14" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Unlock All Slots" Click="UnlockAllCargo_Click"/>
                                            <Button Content="Max All Qty" Click="MaxAllQtyCargo_Click"/>
                                            <Button Content="Sort" Click="SortCargo_Click"
                                                    ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                                        </StackPanel>
                                        <controls:ExpandableScroll CollapsedHeight="368" SettingKey="FreighterCargoExpanded">
                                            <controls:InventorySlotGrid x:Name="CargoGrid"/>
                                        </controls:ExpandableScroll>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border x:Name="TechListCard" Grid.Column="1" Style="{StaticResource ThemeCardStyle}" Width="340" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <StackPanel>
                                <Border Style="{StaticResource ThemeBandStyle}">
                                    <TextBlock Text="FREIGHTER TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                                </Border>
                                <Border Padding="14,12,14,14">
                                    <controls:ItemListPanel x:Name="TechListPanel"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- SidebarPanel is one named unit (Templates + Freighter details) so
                     the narrow-mode VisualState can move it to its own row at once.
                     A save only ever has ONE freighter, so there's no same-save
                     "Copy Tech Stack..." here, only the cross-save Templates. -->
                <StackPanel x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Spacing="22" VerticalAlignment="Top">
                    <Border x:Name="TemplatesBorder" Style="{StaticResource ThemeCardStyle}" Width="340">
                        <controls:LoadoutTemplatesPanel x:Name="TemplatesPanel" SourceKind="Freighter" NameExample="Combat Hauler" FullBuildContents="tech + stats + appearance"
                                                      TechStackHint="Apply replaces your freighter's tech with this template. Never touches Stats, Seed, Cargo, or Class unless you opt in."
                                                      FullBuildHint="The whole freighter: tech, class, stats, model, look, cargo slots and its furnished interior. Apply replaces your freighter's with it. Never touches cargo, name or crew."/>
                    </Border>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
