<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.FreighterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Left">
            <TextBlock Text="Freighter" FontSize="26" FontWeight="Bold"/>
            <Button x:Name="PageResetBtn" Content="Reset Freighter Changes" Click="PageResetBtn_Click" Visibility="Collapsed"/>

            <!-- Technology and Cargo stack in their own column so they always
                 sit directly under each other regardless of how tall the info
                 panel is; the info panel is a separate column that just sits
                 at the top rather than pairing with the Tech grid alone (a
                 WrapPanel pairing would let a tall info panel stretch/gap the
                 shorter Tech grid's row, pushing Cargo down with it). -->
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Technology" FontSize="18" FontWeight="SemiBold"/>
                        <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                            <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                            <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                            <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                        </ctcontrols:WrapPanel>
                    </StackPanel>
                    <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="6" HorizontalAlignment="Left" Opacity="0.9">
                        <Grid>
                            <ScrollViewer x:Name="TechScrollViewer" Padding="8,32,8,8" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                                <controls:InventorySlotGrid x:Name="TechGrid"/>
                            </ScrollViewer>
                            <Button x:Name="TechExpandBtn" Click="TechExpandBtn_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                    Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Expand">
                                <FontIcon x:Name="TechExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Cargo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Content="Unlock All Slots" Click="UnlockAllCargo_Click"/>
                    </StackPanel>
                    <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                            CornerRadius="6" HorizontalAlignment="Left" Opacity="0.9">
                        <Grid>
                            <ScrollViewer x:Name="CargoScrollViewer" Padding="8,32,8,8" MaxHeight="368" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                                <controls:InventorySlotGrid x:Name="CargoGrid"/>
                            </ScrollViewer>
                            <Button x:Name="CargoExpandBtn" Click="CargoExpandBtn_Click"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                    Padding="6" Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="Expand">
                                <FontIcon x:Name="CargoExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Name/Class/Type/Crew/Base Stats - Type and Crew Race are both
                     model scene-path swaps (bIR.93M and Sjw.93M respectively),
                     Model Seed and Crew Seed are the matching @EL seeds NomNom
                     shows alongside them. -->
                <Border Grid.Column="1" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Opacity="0.9" Width="300" VerticalAlignment="Top">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Name" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="NameEditBox" Width="260" LostFocus="NameEditBox_LostFocus"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Class" Opacity="0.7" VerticalAlignment="Center"/>
                            <StackPanel x:Name="ClassSelectorPanel" Orientation="Horizontal" Spacing="6"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Type" FontSize="12" Opacity="0.7"/>
                            <ComboBox x:Name="TypeComboBox" Width="260"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="TypeComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Model Seed" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="ModelSeedEditBox" Width="260" LostFocus="ModelSeedEditBox_LostFocus"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Crew Race" FontSize="12" Opacity="0.7"/>
                            <ComboBox x:Name="CrewRaceComboBox" Width="260"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="CrewRaceComboBox_SelectionChanged"/>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="Crew Seed" FontSize="12" Opacity="0.7"/>
                            <TextBox x:Name="CrewSeedEditBox" Width="260" LostFocus="CrewSeedEditBox_LostFocus"/>
                        </StackPanel>

                        

                        <StackPanel Spacing="6">
                            <TextBlock Text="Base Stats" FontSize="12" Opacity="0.7"/>
                            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                                       Text="No known upper limit - the game doesn't enforce one. Extreme values won't corrupt your save, just unbalance it."/>
                            <Grid ColumnSpacing="8" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Hyperdrive" VerticalAlignment="Center"/>
                                <NumberBox Grid.Row="0" Grid.Column="1" x:Name="HyperdriveStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="HyperdriveStatBox_ValueChanged" LostFocus="HyperdriveStatBox_LostFocus"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Fleet Coordination" VerticalAlignment="Center"/>
                                <NumberBox Grid.Row="1" Grid.Column="1" x:Name="FleetStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="FleetStatBox_ValueChanged" LostFocus="FleetStatBox_LostFocus"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
