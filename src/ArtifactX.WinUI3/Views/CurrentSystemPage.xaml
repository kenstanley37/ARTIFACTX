<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Current System (CurrentSystemViewModel):
     the system you're in and its planets, following your game. Read-only for the save -
     your notes are kept by ArtifactX, never written to it. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.CurrentSystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
      <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CURRENT SYSTEM" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="This page follows your game: each time No Man's Sky saves, it shows your new location and discoveries. It only reads the save; it never changes it.">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Center"/>
                    <HyperlinkButton Content="How it works" Click="ShowHelp_Click" Padding="4,0" FontSize="12" Visibility="{x:Bind ViewModel.HelpHidden, Mode=OneWay}"/>
                </StackPanel>
            </Grid>

            <!-- How live follow works - dismissible; reopened from the status link. -->
            <Border Visibility="{x:Bind ViewModel.IsHelpVisible, Mode=OneWay}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                    Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="16,12,16,14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="PLAY WITH THIS PAGE OPEN" Style="{StaticResource ThemeEyebrowStyle}"/>
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                                   Text="Keep ArtifactX open on this page while you play (a second monitor or Alt+Tab works well). It updates every time No Man's Sky saves - it only reads your save, never changes it."/>
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap">
                            <Run Text="•  The game saves when you get out of your ship, use a save point, or on autosave. Warping alone doesn't save, so after a jump, hop out of your ship (or save) to see the new system."/>
                            <LineBreak/>
                            <Run Text="•  Saving in your ship in space records the system's name; saving on a planet records that planet's name. Saves on your freighter or a station don't include the system name - type it in the System name box instead."/>
                            <LineBreak/>
                            <Run Text="•  Scan planets and creatures, then save, to see your discovery counts go up."/>
                            <LineBreak/>
                            <Run Text="•  Fill in the notes (star class, economy, moons...) while the game's system info is on screen. Notes save as you type and work while the game is running."/>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Content="Got it" Click="HideHelp_Click" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <Grid>
                            <TextBlock Text="CURRENT SYSTEM" Style="{StaticResource ThemeBandTextStyle}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="CaptureSystemBtn" Click="CaptureSystem_Click" Padding="8,3" VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.CanCapture, Mode=OneWay}" AutomationProperties.Name="Capture this system now"
                                        ToolTipService.ToolTip="Take the game's picture of this system now (open its Discoveries page in game first)">
                                    <FlyoutBase.AttachedFlyout>
                                        <Flyout x:Name="CaptureFlyout">
                                            <StackPanel MaxWidth="320" Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon x:Name="CaptureFlyoutIcon" Glyph="&#xE73E;" FontSize="16"/>
                                                    <TextBlock x:Name="CaptureFlyoutTitle" FontWeight="SemiBold" FontSize="13"/>
                                                </StackPanel>
                                                <TextBlock x:Name="CaptureFlyoutDetails" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                            </StackPanel>
                                        </Flyout>
                                    </FlyoutBase.AttachedFlyout>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE722;" FontSize="12" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.CaptureLabel, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <!-- Smaller card, so the planets show without scrolling (2026-10-18). -->
                                <Button Content="{x:Bind ViewModel.CompactLabel, Mode=OneWay}" Click="Compact_Click" Padding="10,2" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid>
                        <StackPanel x:Name="SystemBody" Padding="{x:Bind ViewModel.BodyPadding, Mode=OneWay}" Spacing="18">
                            <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                                <Border Width="{x:Bind ViewModel.FrameWidth, Mode=OneWay}" Height="{x:Bind ViewModel.FrameHeight, Mode=OneWay}"
                                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Background="{ThemeResource ThemeVoidBrush}">
                                    <Grid>
                                        <controls:SystemOrbitView Bodies="{x:Bind ViewModel.Bodies, Mode=OneWay}" CurrentPlanet="{x:Bind ViewModel.CurrentPlanet, Mode=OneWay}"
                                                                  Visibility="{x:Bind ViewModel.ShowOrbits, Mode=OneWay}"/>
                                        <!-- Every planet and moon where the save puts it (2026-10-27); wins over the picture and the drawing. -->
                                        <controls:SystemMap Bodies="{x:Bind ViewModel.MapBodies, Mode=OneWay}" Station="{x:Bind ViewModel.MapStation, Mode=OneWay}"
                                                            Player="{x:Bind ViewModel.MapPlayer, Mode=OneWay}"
                                                            Visibility="{x:Bind ViewModel.HasMap, Mode=OneWay}"
                                                            BodyClicked="Map_BodyClicked"/>
                                        <!-- The game's own view of this system's planets, when screen recording caught its Discoveries page (2026-10-17). -->
                                        <Image Source="{x:Bind ViewModel.SystemPicture, Mode=OneWay}" Stretch="UniformToFill" Visibility="{x:Bind ViewModel.HasPicture, Mode=OneWay}"
                                               ToolTipService.ToolTip="How the game's Discoveries page shows this system's planets."/>
                                        <Button Click="CaptureSystem_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,4" CornerRadius="4"
                                                IsEnabled="{x:Bind ViewModel.CanCapture, Mode=OneWay}" AutomationProperties.Name="Capture this system now"
                                                Background="{ThemeResource ThemePanelBrush}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                                ToolTipService.ToolTip="Take the game's picture of this system now (open its Discoveries page in game first)">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <FontIcon Glyph="&#xE722;" FontSize="11" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                <TextBlock Text="Capture" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel Spacing="12" MaxWidth="520" VerticalAlignment="Top">
                                    <TextBlock Text="LOCATION" Style="{StaticResource ThemeEyebrowStyle}" Visibility="{x:Bind ViewModel.ShowFullDetails, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Heading, Mode=OneWay}" Style="{StaticResource ThemeHeadingStyle}" FontSize="24"/>
                                    <TextBlock Text="{x:Bind ViewModel.Sub, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap"/>
                                    <!-- From the game's region generator (ArtifactX.Core.Universe.RegionStarGeneration). -->
                                    <TextBlock Text="{x:Bind ViewModel.RegionSystems, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap"
                                               Visibility="{x:Bind ViewModel.HasRegionSystems, Mode=OneWay}"/>
                                    <!-- From the game's generator (ArtifactX.Core.Universe): star, race, economy, wealth, conflict. -->
                                    <TextBlock Text="{x:Bind ViewModel.Facts, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Station, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStation, Mode=OneWay}"
                                               Style="{StaticResource ThemeBodyTextStyle}" FontSize="13"/>
                                    <TextBlock Visibility="{x:Bind ViewModel.ShowFullDetails, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                                               Text="Planet types, rings and your discoveries come from your save. Names, star colour, race, economy, wealth and conflict - and each planet's weather, sentinels and resources - come from the game's own generator, the same formula the game uses, right about 99% of the time. Your notes below win if you record something different."/>
                                    <StackPanel Spacing="6" Margin="0,6,0,0">
                                        <TextBlock Text="SYSTEM PORTAL ADDRESS" Style="{StaticResource ThemeEyebrowStyle}" Visibility="{x:Bind ViewModel.ShowFullDetails, Mode=OneWay}"/>
                                        <controls:GlyphStrip Code="{x:Bind ViewModel.SystemCode, Mode=OneWay}" Title="{x:Bind ViewModel.Heading, Mode=OneWay}" GlyphSize="28"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10" Visibility="{x:Bind ViewModel.ShowFullDetails, Mode=OneWay}"
                                                    ToolTipService.ToolTip="The same address as text: each character is one glyph, in order. The first is the planet number (0 for the system itself).">
                                            <TextBlock Text="Text code (for sharing):" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind ViewModel.SystemCode, Mode=OneWay}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" CharacterSpacing="80"
                                                       IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
                                            <controls:CopyCodeButton Code="{x:Bind ViewModel.SystemCode, Mode=OneWay}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- The system at a glance, laid out like the game's Discoveries pop-up (2026-10-17). -->
                                <Border MinWidth="320" VerticalAlignment="Top" Padding="18,14,18,16" Visibility="{x:Bind ViewModel.ShowFullDetails, Mode=OneWay}"
                                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Background="{ThemeResource ThemeVoidBrush}"
                                        BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="SYSTEM DATA" Style="{StaticResource ThemeEyebrowStyle}"/>
                                        <ItemsControl ItemsSource="{x:Bind ViewModel.SystemData, Mode=OneWay}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodels:SystemDataRow">
                                                    <TextBlock TextWrapping="Wrap" FontSize="15" Margin="0,0,0,6">
                                                        <Run Text="{x:Bind Label}" Foreground="{ThemeResource ThemeTextBrush}"/><Run Text=": " Foreground="{ThemeResource ThemeTextBrush}"/><Run Text="{x:Bind Value}" Foreground="{x:Bind ValueBrush}"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="11" TextWrapping="Wrap" MaxWidth="320"
                                                   Text="Gold: as the game showed it. Grey: worked out by ArtifactX - open the system in the game's Discoveries or Galaxy Map with screen recording on, or type it in your notes below."/>
                                    </StackPanel>
                                </Border>
                            </ctcontrols:WrapPanel>

                            <!-- Planet discovery and detail cards come before station stock. -->
                            <controls:FoldingCard Title="PLANETS AND MOONS" FoldedName="{x:Bind ViewModel.PlanetSectionSummary, Mode=OneWay}"
                                                  SettingKey="CurrentSystemPlanetsCollapsed">
                                <StackPanel Spacing="18" Margin="0,16,0,0">
                                    <!-- Planets read off the game screen under a name ArtifactX doesn't know (renamed by another player). -->
                                    <Border Visibility="{x:Bind ViewModel.HasUnmatched, Mode=OneWay}" BorderBrush="{ThemeResource ThemeWarningBrush}" BorderThickness="1"
                                            Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="16,12,16,14">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="READ FROM THE GAME - WHICH PLANET IS THIS?" Style="{StaticResource ThemeEyebrowStyle}"/>
                                            <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                                                       Text="These names were read off the game screen but aren't the names ArtifactX knows - usually a planet someone renamed. Most renamed planets are learned from your save by themselves; for these, landing on the planet also teaches ArtifactX its name. Or pick it here if you know which one it is."/>
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Unmatched, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="viewmodels:UnmatchedBodyViewModel">
                                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                                                            <TextBlock Text="{x:Bind Name}" FontSize="14" FontWeight="SemiBold" Width="240" VerticalAlignment="Center"
                                                                       Foreground="{ThemeResource ThemeWarningBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <ComboBox PlaceholderText="Which planet?" MinWidth="280" ItemsSource="{x:Bind Bodies}" SelectedItem="{x:Bind Selected, Mode=TwoWay}"/>
                                                            <Button Content="Save" Click="AssignUnmatched_Click" Tag="{x:Bind}" IsEnabled="{x:Bind CanSave, Mode=OneWay}"/>
                                                            <HyperlinkButton Content="Not in this system" Click="DismissUnmatched_Click" Tag="{x:Bind}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Visibility="{x:Bind ViewModel.NoPlanets, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap"
                                               Text="No planets in this system are in your discoveries yet. Scan or land on one in-game, then save."/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Tiles, Mode=OneWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="14"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewmodels:PlanetTileViewModel">
                                                <controls:PlanetTile Tile="{x:Bind}" OpenRequested="Tile_OpenRequested"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </controls:FoldingCard>

                            <controls:StationMultiToolsPanel ViewModel="{x:Bind ViewModel.StationTools}"/>
                            <controls:StationMarket Market="{x:Bind ViewModel.Market}"/>
                            <controls:SystemNotesPanel Notes="{x:Bind ViewModel.Notes}"/>
                            <controls:SystemStarshipsPanel Starships="{x:Bind ViewModel.Starships}"/>

                        </StackPanel>

                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Background="#AA777B84">
          <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="42" Height="42"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.Name="Loading current system"/>
      </Grid>
      <!-- Viewport-level notification stays centered even when the page is scrolled. -->
      <Border x:Name="SystemChangeOverlay" Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Center" Padding="34,18"
              Background="{ThemeResource ThemeAccentBrush}" BorderBrush="{ThemeResource ThemeTextBrush}" BorderThickness="2"
              CornerRadius="{ThemeResource ThemeCardCornerRadius}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="SYSTEM CHANGE DETECTED" FontFamily="{ThemeResource ThemeDisplayFont}" FontWeight="Bold" FontSize="22"
                         CharacterSpacing="160" Foreground="{ThemeResource ThemeOnAccentBrush}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="SystemChangeDetailTxt" FontSize="14" Foreground="{ThemeResource ThemeOnAccentBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
      </Border>
    </Grid>
</Page>
