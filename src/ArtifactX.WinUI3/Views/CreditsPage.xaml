<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Credits for every project and
     person ArtifactX builds on, with licences and links. The list lives in
     CreditsPage.xaml.cs; keep it in step with THIRD-PARTY-NOTICES.md. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.CreditsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,32" Spacing="18" MaxWidth="1400" HorizontalAlignment="Left">
            <TextBlock Text="CREDITS" Style="{StaticResource ThemePageTitleStyle}"/>

            <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                    Background="{ThemeResource ThemePanelAltBrush}"
                    CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEB51;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="ArtifactX is built on the work of many people who shared their code and research freely. Thank you to everyone below. Links open in your browser; the full licence texts are in THIRD-PARTY-NOTICES.md in the ArtifactX repository."/>
                </Grid>
            </Border>

            <!-- Sections and cards are built from the list in code. -->
            <StackPanel x:Name="SectionsPanel" Spacing="22"/>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton Content="ArtifactX on GitHub" NavigateUri="https://github.com/kenstanley37/ARTIFACTX"/>
                <HyperlinkButton Content="Full licence texts (THIRD-PARTY-NOTICES.md)" NavigateUri="https://github.com/kenstanley37/ARTIFACTX/blob/development/THIRD-PARTY-NOTICES.md"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
