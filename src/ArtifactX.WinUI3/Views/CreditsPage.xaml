<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Credits for every project and
     person ArtifactX builds on, with licences and links. The list lives in
     CreditsPage.xaml.cs (cards are the templates below); keep it in step with THIRD-PARTY-NOTICES.md. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.CreditsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,32" Spacing="18" MaxWidth="1400" HorizontalAlignment="Left">
            <TextBlock Text="CREDITS" Style="{StaticResource ThemePageTitleStyle}"/>

            <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                    Background="{ThemeResource ThemePanelAltBrush}"
                    CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xEB51;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="ArtifactX is built on the work of many people who shared their code and research freely. Thank you to everyone below. Links open in your browser; the full licence texts are in THIRD-PARTY-NOTICES.md in the ArtifactX repository."/>
                </Grid>
            </Border>

            <ItemsControl ItemsSource="{x:Bind CreditSections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="22"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:CreditSection">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Title}" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <TextBlock Text="{x:Bind Blurb}" Visibility="{x:Bind HasBlurb}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                            <ItemsControl ItemsSource="{x:Bind Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ctcontrols:WrapPanel HorizontalSpacing="12" VerticalSpacing="12"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:Credit">
                                        <Border Width="330" Padding="14,12" CornerRadius="{ThemeResource ThemeCardCornerRadius}" BorderThickness="1"
                                                BorderBrush="{ThemeResource ThemeLineBrush}" Background="{ThemeResource ThemePanelAltBrush}">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
                                                    <Border Grid.Column="1" Visibility="{x:Bind HasLicence}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                                                            CornerRadius="4" Padding="6,1" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind LicenceTip}">
                                                        <TextBlock Text="{x:Bind Licence}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Who}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                <TextBlock Text="{x:Bind What}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                                <HyperlinkButton Content="{x:Bind LinkText}" NavigateUri="{x:Bind Link}" Padding="0,2,0,0" FontSize="12"
                                                                 ToolTipService.ToolTip="{x:Bind Url}" AutomationProperties.Name="{x:Bind LinkName}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <HyperlinkButton Content="ArtifactX on GitHub" NavigateUri="https://github.com/kenstanley37/ARTIFACTX"/>
                <HyperlinkButton Content="Full licence texts (THIRD-PARTY-NOTICES.md)" NavigateUri="https://github.com/kenstanley37/ARTIFACTX/blob/development/THIRD-PARTY-NOTICES.md"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
