<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Every base in the save in folding
     sections (BasesViewModel / BaseSection / BaseCard): the freighter, planet bases,
     claimed stations, settlements and objects placed outside a base. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.BasesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="BASES" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        ToolTipService.ToolTip="This page follows your game: each time No Man's Sky saves, it updates.">
                <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}"
                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                           Text="Every base in this save - your freighter, planet bases, claimed space stations, settlements, and objects placed outside a base - with where they are and their portal addresses."/>
            </Grid>
        </Border>

        <!-- Shown straight away, so opening the page never waits on reading the save -->
        <ProgressRing Grid.Row="2" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0"/>

        <Grid x:Name="ListArea" Grid.Row="2" RowSpacing="14" Visibility="{x:Bind IsListVisible(ViewModel.IsLoading), Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                <TextBox Header="Search" Width="280" PlaceholderText="Names, regions, resources, notes..."
                         Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <ComboBox Header="Sort" Width="200" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="Nearest to you first"/>
                    <ComboBoxItem Content="Name (A-Z)"/>
                    <ComboBoxItem Content="Galaxy"/>
                </ComboBox>
                <controls:HyperdriveRangeBox VerticalAlignment="Bottom"/>
                <Button x:Name="ExportBtn" Content="Export CSV" Click="ExportCsv_Click" VerticalAlignment="Bottom"
                        ToolTipService.ToolTip="Save the list as shown (with your search) as a spreadsheet file"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                    <Button Content="Deselect all" Click="DeselectAll_Click" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
                    <Button Content="{x:Bind ViewModel.DeleteLabel, Mode=OneWay}" Click="DeleteSelected_Click"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" Style="{StaticResource ThemeAccentButtonStyle}"
                            ToolTipService.ToolTip="Delete the selected planet bases and placed objects from this save"/>
                </StackPanel>
                <TextBlock Text="{x:Bind ViewModel.CountLabel, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                           VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,6" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.PartsTotalLabel, Mode=OneWay}" Foreground="{x:Bind ViewModel.PartsTotalBrush, Mode=OneWay}"
                               Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.PartsBreakdown, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                               TextWrapping="Wrap" MaxWidth="900"/>
                </StackPanel>
            </ctcontrols:WrapPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sections}" Margin="0,0,12,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:BaseSectionViewModel">
                            <controls:BaseSection Section="{x:Bind}" OpenRequested="Section_OpenRequested"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
