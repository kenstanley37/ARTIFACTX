<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.CataloguePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Catalogue" FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
            <!-- No separate Save/Discard here, unlike AccountDataPage - this field is
                 a normal per-slot save value, so it goes through the same title-bar
                 Save/Reset button every other page in the app already uses. -->
            <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Catalogue Changes" Click="PageResetBtn_Click"
                    Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Opacity="0.85">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource NmsTextSecondary}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource NmsTextSecondary}"
                               Text="This save's known-technology list - confirmed 2026-08-02 by direct testing: marking an item Known here made it appear named/available in the ship's technology-install picker after a real save/reload, where it was previously absent. Scoped to Technology-table items only (~370 total)."/>
                </StackPanel>
            </Border>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search technology..." TextChanged="SearchBox_TextChanged"/>
                    <ComboBox Grid.Column="1" x:Name="KnownFilterBox" Width="150" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Items"/>
                        <ComboBoxItem Content="Known Only"/>
                        <ComboBoxItem Content="Unknown Only"/>
                    </ComboBox>
                    <TextBlock Grid.Column="2" x:Name="ResultCountTxt" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource NmsTextSecondary}"/>
                    <Button Grid.Column="3" x:Name="MarkUnknownAllBtn" Content="Mark All Unknown" Click="MarkUnknownAllBtn_Click"
                            ToolTipService.ToolTip="Marks every item currently shown below as unknown (respects the search box and filter)"/>
                    <Button Grid.Column="4" x:Name="MarkKnownAllBtn" Content="Mark All Known" Click="MarkKnownAllBtn_Click"
                            ToolTipService.ToolTip="Marks every item currently shown below as known (respects the search box and filter)"/>
                </Grid>

                <!-- Icon-tile grid, not a text list - mirrors how NMS's own inventory/
                     catalog screens actually look, and fills the window's width far
                     better than a single skinny column of rows did. Not virtualized
                     (plain WrapPanel, not a virtualizing ItemsPanel), but ~370 tiles is
                     a small enough visual tree for WinUI that this is a non-issue -
                     the same reasoning that made icons themselves affordable here but
                     not on AccountDataPage's ~4,700-row list (see CatalogueRowViewModel).
                     Each tile is a single Tapped handler, not a separate CheckBox click -
                     the CheckBox drawn on it is purely a visual indicator
                     (IsHitTestVisible="False") to avoid the same tap bubbling and
                     double-toggling both handlers at once. -->
                <ScrollViewer Grid.Row="2">
                    <ItemsControl x:Name="ItemsListView">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ctcontrols:WrapPanel HorizontalSpacing="10" VerticalSpacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:CatalogueRowViewModel">
                                <Border Width="112" Height="132" CornerRadius="8" BorderThickness="2"
                                        Tapped="Tile_Tapped" Tag="{x:Bind}"
                                        BorderBrush="{x:Bind IsKnown, Mode=OneWay, Converter={StaticResource BoolToAccentBrushConverter}}"
                                        Background="{x:Bind IsKnown, Mode=OneWay, Converter={StaticResource BoolToActiveBackgroundConverter}}">
                                    <Grid Padding="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{x:Bind Icon, Mode=OneWay}" Width="56" Height="56"
                                               Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <CheckBox Grid.Row="0" IsChecked="{x:Bind IsKnown, Mode=OneWay}" IsHitTestVisible="False"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-6"/>
                                        <TextBlock Grid.Row="1" Text="{x:Bind DisplayName}" FontSize="11" TextWrapping="Wrap"
                                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
        </Grid>
    </Grid>
</Page>
