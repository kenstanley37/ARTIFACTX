<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.FrigatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="FRIGATES" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Frigate Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <!-- Shown instead of ContentPanel when the player doesn't own a
                 freighter yet - confirmed 2026-08-11 via a real before/after
                 save diff (user placed one storage container and got their
                 first freighter): the ";Du" (FleetFrigates) array already had
                 one fully-rolled-looking entry on a save with zero real
                 progress, but every field on it stayed byte-for-byte frozen
                 across the diff EXCEPT Crew Race, which only changed once the
                 freighter's own hull scene path (bIR.93M) went from empty to
                 real - frigates are commanded from your freighter, so you
                 can't have a real one without owning one either. -->
            <TextBlock x:Name="NoFreighterTxt" Style="{StaticResource ThemeDimTextStyle}"
                       MaxWidth="600" HorizontalAlignment="Left" Visibility="Collapsed"
                       Text="You don't own a freighter yet, so you don't have a Frigate Fleet to manage. Buy or claim a freighter in-game, then come back here."/>

            <StackPanel x:Name="ContentPanel" Spacing="22" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource ThemeCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="OWNED FRIGATES" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <ScrollViewer MaxHeight="120" Padding="18,14,18,16" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <ctcontrols:WrapPanel x:Name="FrigateSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ThemeCardStyle}">
                  <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="FRIGATE DETAILS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Spacing="20" Padding="20,16,20,20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" MaxWidth="700" HorizontalAlignment="Left"
                                       Text="Leave empty for an auto-generated name (e.g. &quot;SS-2 Akeosc's Gamble&quot;) - that flavor text isn't stored in the save at all, it's generated from the frigate's class/race/seeds each time, so ArtifactX can't show or reproduce it here. Set a value to override it, same as Settlement Name."/>
                            <TextBox x:Name="NameEditBox" AutomationProperties.Name="Name" Width="300" HorizontalAlignment="Left" LostFocus="NameEditBox_LostFocus"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="32">
                            <StackPanel Spacing="6" Width="180">
                                <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ComboBox x:Name="FrigateClassBox" AutomationProperties.Name="Class" Width="170" HorizontalAlignment="Left" SelectionChanged="FrigateClassBox_SelectionChanged"
                                          ToolTipService.ToolTip="The frigate's role, shown as the pill next to it in-game (Combat, Exploration, Industrial, Trade, Support and so on)."/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="150">
                                <TextBlock Text="CREW RACE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ComboBox x:Name="RaceBox" AutomationProperties.Name="Crew race" Width="140" HorizontalAlignment="Left" SelectionChanged="RaceBox_SelectionChanged"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="150">
                                <TextBlock Text="CLASS RATING" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ComboBox x:Name="InventoryClassBox" AutomationProperties.Name="Class rating" Width="140" HorizontalAlignment="Left" SelectionChanged="InventoryClassBox_SelectionChanged"
                                          ToolTipService.ToolTip="The S/A/B/C badge shown next to each frigate in-game."/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="32">
                            <!-- Grid, not a plain horizontal StackPanel - the old
                                 version let the TextBox+Button pair size to its
                                 natural content width (180 + spacing + the
                                 button's own text-driven width) inside a
                                 narrower fixed-width parent, so the button
                                 silently overflowed/clipped instead of shrinking
                                 to fit. An Auto column reserves exactly the
                                 button's real width first, and both seed rows
                                 use the identical column layout regardless of
                                 seed length, so they line up pixel-for-pixel
                                 with each other too (2026-08-07 user report). -->
                            <StackPanel Spacing="6" Width="300">
                                <TextBlock Text="MODEL SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                           Text="Drives the hull's procedural look, alongside Class/Type. Paste a seed you've found elsewhere, or click Generate for a new random look - you won't see it until you load into the game."/>
                                <controls:SeedBox x:Name="ModelSeedBox" Label="Model seed" Changed="Seed_Changed" BoxWidth="180"/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="300">
                                <TextBlock Text="HOME SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                           Text="Drives which home system/name this frigate generates for itself. Paste a seed you've found elsewhere, or click Generate for a new random one."/>
                                <controls:SeedBox x:Name="HomeSeedBox" Label="Home seed" Changed="Seed_Changed" BoxWidth="180"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="STATS" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="12">
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Combat" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat0Box" AutomationProperties.Name="Combat" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat0Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Exploration" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat1Box" AutomationProperties.Name="Exploration" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat1Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Mining" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat2Box" AutomationProperties.Name="Mining" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat2Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Diplomatic" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat3Box" AutomationProperties.Name="Diplomatic" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat3Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Fuel Burn Rate" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat4Box" AutomationProperties.Name="Fuel Burn Rate" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat4Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Fuel Capacity" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat5Box" AutomationProperties.Name="Fuel Capacity" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat5Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Speed" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat6Box" AutomationProperties.Name="Speed" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat6Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Extra Loot" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat7Box" AutomationProperties.Name="Extra Loot" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat7Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Repair" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat8Box" AutomationProperties.Name="Repair" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat8Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Invulnerable" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat9Box" AutomationProperties.Name="Invulnerable" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat9Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Stealth" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat10Box" AutomationProperties.Name="Stealth" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat10Box_ValueChanged"/>
                                </StackPanel>
                            </ctcontrols:WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="EXPEDITION RECORD" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="12">
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Expeditions" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="ExpeditionsBox" AutomationProperties.Name="Expeditions" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="ExpeditionsBox_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Successes" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="SuccessesBox" AutomationProperties.Name="Successes" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="SuccessesBox_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Failures" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="FailuresBox" AutomationProperties.Name="Failures" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="FailuresBox_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Times Damaged" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="TimesDamagedBox" AutomationProperties.Name="Times Damaged" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="TimesDamagedBox_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Repairs Made" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="RepairsMadeBox" AutomationProperties.Name="Repairs Made" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="RepairsMadeBox_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Damage Taken" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="DamageTakenBox" AutomationProperties.Name="Damage Taken" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="DamageTakenBox_ValueChanged"/>
                                </StackPanel>
                            </ctcontrols:WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="TRAITS" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <ctcontrols:WrapPanel x:Name="TraitsPanel" HorizontalSpacing="16" VerticalSpacing="16"/>
                        </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
