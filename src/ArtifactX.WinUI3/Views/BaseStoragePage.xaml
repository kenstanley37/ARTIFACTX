<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.BaseStoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Left">
            <TextBlock Text="Base Storage" FontSize="26" FontWeight="Bold"/>
            <Button x:Name="PageResetBtn" Content="Reset Storage Changes" Click="PageResetBtn_Click" Visibility="Collapsed"/>

            <TextBlock Text="Owned Storage Containers" FontSize="14" Opacity="0.8"/>
            <!-- A player can place as many of these as their base part budget
                 allows - same bounded/scrollable pattern as Ships/Multi-Tool's
                 selector so a base with dozens of containers stays usable. -->
            <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <ctcontrols:WrapPanel x:Name="ContainerSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Name" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBox x:Name="NameEditBox" Width="240" LostFocus="NameEditBox_LostFocus"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock x:Name="GridHeaderTxt" Text="Contents" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Unlock All Slots" Click="UnlockAllBtn_Click"/>
                <Button Content="Max All Qty" Click="MaxAllQtyBtn_Click"/>
            </StackPanel>
            <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                    CornerRadius="6" Padding="8" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.9">
                <controls:InventorySlotGrid x:Name="StorageGrid"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
