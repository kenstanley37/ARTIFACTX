<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Alliance (AllianceViewModel): laid out like
     the game's Galactic Alliance Details screen (user, 2026-10-21) - gold emblem and title, the
     player's banner, and the five graded stats as rings around the alliance emblem (Systems and
     Stations left; Plants, Minerals, Creatures right) - with the player's own counts where the
     game shows each class. Below: what makes up each number and how to raise it. Read-only. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.AlliancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,26,28,24" Spacing="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ALLIANCE" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Updates each time the game saves.">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="No save loaded." Visibility="{x:Bind ViewModel.NoSave, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}"/>

            <!-- The game's screen: header band, then the stats around the emblem. -->
            <Border Visibility="{x:Bind ViewModel.HasStats, Mode=OneWay}" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                    Background="{ThemeResource ThemeVoidBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}">
                <StackPanel>
                    <Grid Background="{ThemeResource ThemePanelAltBrush}" Padding="22,16" ColumnSpacing="18" CornerRadius="7,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- Gold hexagon with the alliance knot, as on the game's title. -->
                        <Grid Width="64" Height="64">
                            <Polygon Points="32,0 60,16 60,48 32,64 4,48 4,16" Fill="{ThemeResource ThemeDoneBrush}"/>
                            <Ellipse Width="22" Height="22" Stroke="{ThemeResource ThemeVoidBrush}" StrokeThickness="2" Margin="0,-12,0,0"/>
                            <Ellipse Width="22" Height="22" Stroke="{ThemeResource ThemeVoidBrush}" StrokeThickness="2" Margin="-12,10,0,0"/>
                            <Ellipse Width="22" Height="22" Stroke="{ThemeResource ThemeVoidBrush}" StrokeThickness="2" Margin="12,10,0,0"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="ALLIANCES" FontFamily="{ThemeResource ThemeDisplayFont}" FontSize="30" CharacterSpacing="180" Foreground="{ThemeResource ThemeTextBrush}"/>
                            <TextBlock Text="Your contribution" FontSize="16" Foreground="{ThemeResource ThemeTextBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind ViewModel.PlayerName, Mode=OneWay}" FontFamily="{ThemeResource ThemeDisplayFont}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="{ThemeResource ThemeTextBrush}" HorizontalAlignment="Right"/>
                            <Border Background="{ThemeResource ThemeDoneBrush}" CornerRadius="10" Padding="10,2" HorizontalAlignment="Right">
                                <TextBlock Text="★ Your lifetime totals" FontSize="13" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Padding="24,28" ColumnSpacing="30" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="44" HorizontalAlignment="Right">
                            <controls:AllianceStatRing Stat="{x:Bind ViewModel.Systems, Mode=OneWay}" TextOnLeft="True" HorizontalAlignment="Right"/>
                            <controls:AllianceStatRing Stat="{x:Bind ViewModel.Stations, Mode=OneWay}" TextOnLeft="True" HorizontalAlignment="Right"/>
                        </StackPanel>

                        <!-- The alliance emblem: three interlocking rings. -->
                        <Grid Grid.Column="1" Width="150" Height="150" Opacity="0.55" VerticalAlignment="Center">
                            <Ellipse Width="70" Height="70" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2" Margin="0,-40,0,0"/>
                            <Ellipse Width="70" Height="70" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2" Margin="-40,30,0,0"/>
                            <Ellipse Width="70" Height="70" Stroke="{ThemeResource ThemeAccentBrush}" StrokeThickness="2" Margin="40,30,0,0"/>
                            <Ellipse Width="140" Height="140" Stroke="{ThemeResource ThemeLineBrush}" StrokeThickness="1"/>
                        </Grid>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="14">
                            <controls:AllianceStatRing Stat="{x:Bind ViewModel.Plants, Mode=OneWay}"/>
                            <controls:AllianceStatRing Stat="{x:Bind ViewModel.Minerals, Mode=OneWay}" Margin="44,0,0,0"/>
                            <controls:AllianceStatRing Stat="{x:Bind ViewModel.Creatures, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap" Margin="22,0,22,18"
                               Text="Your own totals, from the game's counters in your save. Your alliance's name, member count, score, rank and each stat's class are kept on Hello Games' servers, not in your save - see them at the station core of a station you direct (View Galactic Alliances)."/>
                </StackPanel>
            </Border>

            <!-- What makes up each number and how to raise it. -->
            <ItemsControl ItemsSource="{x:Bind ViewModel.Stats, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="14"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AllianceStatViewModel">
                        <Border Width="340" Style="{StaticResource ThemeCardStyle}" Padding="16,12">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="18" Height="18" VerticalAlignment="Center">
                                        <PathIcon Data="{x:Bind Icon}" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    </Viewbox>
                                    <TextBlock Text="{x:Bind Label}" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{x:Bind Value}" FontWeight="SemiBold" Foreground="{ThemeResource ThemeTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind Breakdown}" Visibility="{x:Bind HasBreakdown}" Style="{StaticResource ThemeDimTextStyle}"
                                           FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind HowTo}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The author's own alliance, which advertises the app (#29). -->
            <Border Style="{StaticResource ThemeCardStyle}" MaxWidth="720" HorizontalAlignment="Left" Padding="16,12">
                <StackPanel Spacing="6">
                    <TextBlock Text="JOIN THE ARTIFACTX ALLIANCE" Style="{StaticResource ThemeEyebrowStyle}"/>
                    <TextBlock Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextWrapping="Wrap"
                               Text="Playing with ArtifactX? Join the ARTIFACTX alliance and add your discoveries to its score. At the station core of a station you direct, choose View Galactic Alliances and search for ARTIFACTX."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
