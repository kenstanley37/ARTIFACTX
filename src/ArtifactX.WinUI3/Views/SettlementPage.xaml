<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). -->
<Page
    x:Class="ArtifactX.WinUI3.Views.SettlementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SETTLEMENTS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Settlement Changes" Click="PageResetBtn_Click"
                        Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
            </Grid>

            <StackPanel Spacing="22" HorizontalAlignment="Stretch">
                <Border Style="{StaticResource ThemeCardStyle}">
                    <StackPanel>
                        <Border Style="{StaticResource ThemeBandStyle}">
                            <TextBlock Text="OWNED SETTLEMENTS" Style="{StaticResource ThemeBandTextStyle}"/>
                        </Border>
                        <ScrollViewer MaxHeight="120" Padding="18,14,18,16" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                            <ctcontrols:WrapPanel x:Name="SettlementSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Full width (page's own padding above is the only margin) rather than
                     the old fixed Width="860" - the Buffs section below can't be given a sane
                     fixed width now that its real length is confirmed unbounded (tested to 19
                     entries with no cap found), so the whole card stretches to use whatever
                     room the window actually has. -->
                <Border Style="{StaticResource ThemeCardStyle}">
                  <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="SETTLEMENT DETAILS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Spacing="20" Padding="20,16,20,20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <TextBox x:Name="NameEditBox" Width="300" HorizontalAlignment="Left" LostFocus="NameEditBox_LostFocus"/>
                        </StackPanel>

                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="12">
                            <StackPanel Spacing="6" Width="160">
                                <TextBlock Text="OWNER" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <TextBlock x:Name="OwnerTxt" Style="{StaticResource ThemeBodyTextStyle}"/>
                            </StackPanel>
                            <!-- Culture (pA_) confirmed 2026-07-30: drives the in-game "X Planetary
                                 Settlement" subtitle, translated to a species name - Traders->Gek,
                                 Warriors->Vy'keen, Explorers->Korvax (each tested); the other 6
                                 options are untested. Does NOT affect the separate cosmetic-only
                                 "Dominant Lifeform" stat on the deeper settlement stats screen. -->
                            <StackPanel Spacing="6" Width="160">
                                <TextBlock Text="CULTURE (RACE)" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <ComboBox x:Name="RaceBox" Width="150" HorizontalAlignment="Left" SelectionChanged="RaceBox_SelectionChanged"
                                          ToolTipService.ToolTip="The settlement's culture, shown in-game as the &quot;Gek/Vy'keen/Korvax Planetary Settlement&quot; subtitle."/>
                            </StackPanel>
                            <StackPanel Spacing="6" Width="160">
                                <TextBlock Text="POPULATION" Style="{StaticResource ThemeEyebrowStyle}"/>
                                <NumberBox x:Name="PopulationBox" Width="140" HorizontalAlignment="Left"
                                           Minimum="0" SpinButtonPlacementMode="Hidden"
                                           ValueChanged="PopulationBox_ValueChanged" LostFocus="PopulationBox_LostFocus"/>
                            </StackPanel>
                        </ctcontrols:WrapPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="STATS" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="12">
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Max Population" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat0Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat0Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Happiness" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat1Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat1Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Production" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat2Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat2Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Upkeep" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat3Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat3Box_ValueChanged"/>
                                </StackPanel>
                            </ctcontrols:WrapPanel>
                            <ctcontrols:WrapPanel HorizontalSpacing="24" VerticalSpacing="12">
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Sentinels" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat4Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat4Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Debt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat5Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat5Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Alert" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat6Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat6Box_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="6" Width="120">
                                    <TextBlock Text="Bug Attack" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                                    <NumberBox x:Name="Stat7Box" Width="110" HorizontalAlignment="Left" SpinButtonPlacementMode="Hidden" ValueChanged="Stat7Box_ValueChanged"/>
                                </StackPanel>
                            </ctcontrols:WrapPanel>
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="SETTLEMENT FEATURES" Style="{StaticResource ThemeEyebrowStyle}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="AddPerkSlotBtn" Content="Add Feature Slot" Click="AddFeatureSlotBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                        <ctcontrols:WrapPanel x:Name="PerksPanel" HorizontalSpacing="16" VerticalSpacing="16"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- What each building needs and where to get it (SettlementPage.Materials.cs). -->
                <Border Style="{StaticResource ThemeCardStyle}">
                  <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="BUILDING MATERIALS" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Spacing="12" Padding="20,16,20,20">
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap" MaxWidth="900" HorizontalAlignment="Left"
                                   Text="What each building asks for at every stage, from your game files, and where to get it: trade goods from systems you know with the right economy, items from your Finds, resources from planets where you've recorded them."/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox x:Name="MaterialsBuildingBox" Header="Building" MinWidth="260" SelectionChanged="MaterialsBuilding_Changed"/>
                            <TextBlock x:Name="MaterialsNextTxt" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="13"
                                       Foreground="{ThemeResource ThemeAccentBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel x:Name="MaterialsPanel" Spacing="8"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
