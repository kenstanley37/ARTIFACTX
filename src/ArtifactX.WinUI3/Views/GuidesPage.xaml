<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Tools page: the player's own
     list of creator videos (YouTube, Twitch, TikTok), tagged to the items they're
     about, stored in user.db (GuidesService). Videos open in the browser. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.GuidesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="28,26,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GUIDES" Style="{StaticResource ThemePageTitleStyle}"/>

        <Border Grid.Row="1" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                Background="{ThemeResource ThemePanelAltBrush}"
                CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                <TextBlock Grid.Column="1" Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                           Text="Keep the YouTube, Twitch and TikTok videos that helped you, tagged to the items they're about - they also show up on the Crafting page for those items. Videos open in your browser. Your list is kept by ArtifactX on this PC."/>
            </Grid>
        </Border>

        <!-- Add / edit form, collapsed behind a button. -->
        <Border Grid.Row="2" Style="{StaticResource ThemeCardStyle}">
            <StackPanel>
                <Button Click="FormToggle_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Padding="18,11">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="FormToggleIcon" Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource ThemeAccentBrush}"/>
                        <TextBlock x:Name="FormTitleTxt" Text="ADD A VIDEO" Style="{StaticResource ThemeEyebrowStyle}"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="FormPanel" Visibility="Collapsed" Padding="18,4,18,18" Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBox x:Name="FormLinkBox" Header="Video link" Width="520" HorizontalAlignment="Left"
                                 PlaceholderText="Paste a YouTube, Twitch or TikTok video link" TextChanged="FormLink_TextChanged"/>
                        <TextBlock x:Name="FormLinkStatusTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                        <TextBox x:Name="FormTitleBox" Header="Title" Width="420" PlaceholderText="Filled in from the video when it can be"/>
                        <TextBox x:Name="FormCreatorBox" Header="Creator" Width="220"/>
                        <ComboBox x:Name="FormTopicBox" Header="Topic" Width="220"/>
                    </ctcontrols:WrapPanel>
                    <StackPanel Spacing="6" HorizontalAlignment="Left">
                        <AutoSuggestBox x:Name="FormItemSearch" Header="It's about these items (optional)" Width="420" QueryIcon="Add"
                                        PlaceholderText="Search an item, e.g. Stasis Device"
                                        TextChanged="FormItemSearch_TextChanged" SuggestionChosen="FormItemSearch_SuggestionChosen"/>
                        <ctcontrols:WrapPanel x:Name="FormItemChips" HorizontalSpacing="6" VerticalSpacing="6"/>
                    </StackPanel>
                    <TextBox x:Name="FormNotesBox" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxWidth="760" HorizontalAlignment="Left"
                             PlaceholderText="What it's good for, the time stamp that matters..."/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="FormSaveBtn" Content="Save video" Click="FormSave_Click" Style="{StaticResource ThemeAccentButtonStyle}"/>
                        <Button Content="Cancel" Click="FormCancel_Click"/>
                        <TextBlock x:Name="FormErrorTxt" Foreground="{ThemeResource ThemeWarningBrush}" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <ctcontrols:WrapPanel Grid.Row="3" HorizontalSpacing="14" VerticalSpacing="10">
            <TextBox x:Name="SearchBox" Header="Search" Width="300" PlaceholderText="Title, creator, item, notes..." TextChanged="Search_TextChanged"/>
            <ComboBox x:Name="TopicFilterBox" Header="Topic" Width="230" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="PlatformFilterBox" Header="Platform" Width="160" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Header="Sort" Width="180" SelectionChanged="Filter_Changed"/>
            <TextBlock x:Name="CountTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,8"/>
        </ctcontrols:WrapPanel>

        <TextBlock Grid.Row="4" x:Name="EmptyTxt" Style="{StaticResource ThemeDimTextStyle}" Visibility="Collapsed" Margin="0,12,0,0" TextWrapping="Wrap"
                   Text="No videos yet. Use Add a video above and paste a link - the title, creator and thumbnail fill in for YouTube and TikTok."/>

        <GridView Grid.Row="4" x:Name="GuidesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="GuidesList_ItemClick">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" ItemWidth="380" ItemHeight="190"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,10,10"/>
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:GuideCardViewModel">
                    <Border Width="370" Height="180" BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1"
                            Background="{ThemeResource ThemePanelAltBrush}" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,10"
                            ToolTipService.ToolTip="Click to watch in your browser">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="128" Height="72" Background="{ThemeResource ThemeVoidBrush}" CornerRadius="4">
                                    <Grid>
                                        <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource ThemeTextDimBrush}"/>
                                        <Image Source="{x:Bind Thumbnail}" Visibility="{x:Bind ThumbnailVisibility}" Stretch="UniformToFill"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <Border Background="{x:Bind PlatformBrush}" CornerRadius="4" Padding="6,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind Platform}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold" FontSize="13"
                                               MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Creator}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" VerticalAlignment="Top">
                                    <Button Click="Edit_Click" Tag="{x:Bind Id}" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Edit" AutomationProperties.Name="Edit">
                                        <FontIcon Glyph="&#xE70F;" FontSize="13"/>
                                    </Button>
                                    <Button Click="Delete_Click" Tag="{x:Bind Id}" Padding="6,4" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Delete" AutomationProperties.Name="Delete">
                                        <FontIcon Glyph="&#xE74D;" FontSize="13"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="1" Spacing="5">
                                <TextBlock Text="{x:Bind Topic}" Visibility="{x:Bind TopicVisibility}" Style="{StaticResource ThemeEyebrowStyle}" FontSize="10"/>
                                <ItemsControl ItemsSource="{x:Bind Items}" Visibility="{x:Bind ItemsVisibility}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <ctcontrols:WrapPanel HorizontalSpacing="4" VerticalSpacing="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:FindItemChip">
                                            <Border Background="{ThemeResource ThemeVoidBrush}" CornerRadius="4" Padding="4,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Image Source="{x:Bind Icon}" Width="18" Height="18"/>
                                                    <TextBlock Text="{x:Bind Label}" FontSize="12" Foreground="{ThemeResource ThemeTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{x:Bind Notes}" Visibility="{x:Bind NotesVisibility}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="12"
                                           MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Notes}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
