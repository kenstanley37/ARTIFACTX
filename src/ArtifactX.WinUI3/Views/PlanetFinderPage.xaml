<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). Planet Finder (PlanetFinderViewModel):
     every planet in the save's discoveries, searched and filtered, and the glyph decoder.
     Read-only - it never changes the save. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.PlanetFinderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="28,26,28,40" Spacing="22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="PLANET FINDER" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            ToolTipService.ToolTip="Distances follow your game: each time No Man's Sky saves, they're measured from where you are. It only reads the save.">
                    <Ellipse Width="8" Height="8" Fill="{ThemeResource ThemeDoneBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LiveStatusTxt" Text="Following your game" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="GLYPH DECODER" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <controls:GlyphDecoder/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ThemeCardStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ThemeBandStyle}">
                        <TextBlock Text="PLANET FINDER" Style="{StaticResource ThemeBandTextStyle}"/>
                    </Border>
                    <StackPanel Padding="20,16,20,20" Spacing="14">
                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="13" TextWrapping="Wrap"
                                   Text="Every planet in your saves' discoveries, including ones other players found that the game downloaded for you. Pick a type to find the nearest one, then dial its portal address at any portal. Distances are approximate, measured from where this save is now."/>
                        <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                            <TextBox Width="260" Header="Search" PlaceholderText="Names, notes, resources, weather..."
                                     Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTipService.ToolTip="Finds planets whose name, system name, your notes, recorded details or creatures contain this text"/>
                            <ComboBox Header="{x:Bind ViewModel.Type.Header}" Width="{x:Bind ViewModel.Type.Width}"
                                      ItemsSource="{x:Bind ViewModel.Type.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Type.Selected, Mode=TwoWay}"/>
                            <ComboBox Header="{x:Bind ViewModel.Galaxy.Header}" Width="{x:Bind ViewModel.Galaxy.Width}"
                                      ItemsSource="{x:Bind ViewModel.Galaxy.Choices, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.Galaxy.Selected, Mode=TwoWay}"/>
                            <ComboBox Header="Sort" Width="200" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="Nearest to you first"/>
                                <ComboBoxItem Content="Newest first"/>
                                <ComboBoxItem Content="Furthest from galaxy core"/>
                                <ComboBoxItem Content="Nearest to galaxy core"/>
                            </ComboBox>
                            <CheckBox Content="Rings only" IsChecked="{x:Bind ViewModel.RingsOnly, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                            <CheckBox Content="Discovered by you" IsChecked="{x:Bind ViewModel.MineOnly, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                            <CheckBox Content="Include my other save slots" IsChecked="{x:Bind ViewModel.IncludeOtherSlots, Mode=TwoWay}" VerticalAlignment="Bottom"/>
                            <controls:HyperdriveRangeBox VerticalAlignment="Bottom"/>
                            <Button Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" Click="ClearFilters_Click" Style="{StaticResource ThemeAccentButtonStyle}"
                                    VerticalAlignment="Bottom" Visibility="{x:Bind ViewModel.HasActiveFilters, Mode=OneWay}"
                                    ToolTipService.ToolTip="Clear the search and every filter (keeps your sort, save slots and hyperdrive range)"/>
                            <Button x:Name="ExportBtn" Content="Export CSV" Click="ExportCsv_Click" VerticalAlignment="Bottom"
                                    ToolTipService.ToolTip="Save the list as shown (with your filters) as a spreadsheet file"/>
                            <TextBlock Text="{x:Bind ViewModel.ResultCount, Mode=OneWay}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                       VerticalAlignment="Bottom" Margin="0,0,0,8"/>
                        </ctcontrols:WrapPanel>

                        <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"
                                   Visibility="{x:Bind IsCollapsedWhen(ViewModel.HasNoteFilters), Mode=OneWay}"
                                   Text="Record a system's star colour, economy and so on in your notes on Current System, or a planet's sentinels, life and resources on its page, and filters for them appear here."/>
                        <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.HasNoteFilters, Mode=OneWay}">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.ChoiceFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewmodels:ChoiceFilter">
                                        <ComboBox Header="{x:Bind Header}" Width="{x:Bind Width}" Visibility="{x:Bind IsShown, Mode=OneWay}"
                                                  ItemsSource="{x:Bind Choices, Mode=OneWay}" SelectedItem="{x:Bind Selected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ctcontrols:WrapPanel HorizontalSpacing="14" VerticalSpacing="10">
                                <CheckBox Content="{x:Bind ViewModel.WaterLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.WaterOnly, Mode=TwoWay}"
                                          Visibility="{x:Bind ViewModel.ShowWater, Mode=OneWay}" VerticalAlignment="Bottom"
                                          ToolTipService.ToolTip="Systems known to have water: a Water World among their planets, a fish you caught there, a Galaxy Map card that said Water, or ticked in your notes."/>
                                <CheckBox Content="{x:Bind ViewModel.DissonantLabel, Mode=OneWay}" IsChecked="{x:Bind ViewModel.DissonantOnly, Mode=TwoWay}"
                                          Visibility="{x:Bind ViewModel.ShowDissonant, Mode=OneWay}" VerticalAlignment="Bottom"
                                          ToolTipService.ToolTip="Only systems recorded as dissonant - read off the game screen, or ticked in your notes. Systems not recorded yet are left out."/>
                                <ComboBox Header="Planets / moons (your notes)" Width="220" SelectedIndex="{x:Bind ViewModel.BodiesIndex, Mode=TwoWay}"
                                          Visibility="{x:Bind ViewModel.ShowBodies, Mode=OneWay}">
                                    <ComboBoxItem Content="Planets and moons"/>
                                    <ComboBoxItem Content="Planets only"/>
                                    <ComboBoxItem Content="Moons only"/>
                                </ComboBox>
                            </ctcontrols:WrapPanel>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasStatus, Mode=OneWay}"
                                   Style="{StaticResource ThemeDimTextStyle}" FontSize="12"/>

                        <!-- Bounded height so the ListView virtualizes inside the page's
                             ScrollViewer (an unbounded one would realize every row). -->
                        <ListView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}" SelectionMode="None" MaxHeight="640"
                                  IsItemClickEnabled="True" ItemClick="Results_ItemClick">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PlanetRowViewModel">
                                    <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="1" Background="{ThemeResource ThemePanelAltBrush}"
                                            CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="44" Height="30" VerticalAlignment="Center">
                                                <Ellipse Width="26" Height="26" Fill="{x:Bind Swatch}"/>
                                                <Ellipse Width="44" Height="11" StrokeThickness="2" Stroke="{ThemeResource ThemeTextDimBrush}"
                                                         Visibility="{x:Bind HasRings}" RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <RotateTransform Angle="-18"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind NameLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind LocationLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Text="{x:Bind FactsLabel}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                                <TextBlock Text="{x:Bind NotesLabel}" Visibility="{x:Bind HasNotes}" FontSize="12" Style="{StaticResource ThemeDimTextStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <controls:GlyphStrip Code="{x:Bind PortalCode}" Title="{x:Bind NameLabel}" GlyphSize="24"/>
                                                <TextBlock Text="{x:Bind PortalCode}" Style="{StaticResource ThemeDimTextStyle}" FontSize="11" IsTextSelectionEnabled="True" CharacterSpacing="80"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{x:Bind DistanceLabel}" Style="{StaticResource ThemeBodyTextStyle}" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{x:Bind DiscoveredLabel}" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <controls:CopyCodeButton Grid.Column="4" Code="{x:Bind PortalCode}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
