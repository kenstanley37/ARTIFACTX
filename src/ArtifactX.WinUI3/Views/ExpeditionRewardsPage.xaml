<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml). -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ExpeditionRewardsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:viewmodels="using:ArtifactX.WinUI3.ViewModels"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>

        <ItemsPanelTemplate x:Key="CategoryCardWrapPanelTemplate">
            <ctcontrols:WrapPanel HorizontalSpacing="16" VerticalSpacing="16"/>
        </ItemsPanelTemplate>
        <DataTemplate x:Key="CategoryCardTemplate" x:DataType="viewmodels:UnlockSectionViewModel">
            <controls:UnlockSectionCard Section="{x:Bind}"/>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="28,26,28,24" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="EXPEDITION REWARDS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                <Border Background="{ThemeResource ThemeAccentBrush}" CornerRadius="4" Padding="9,3" VerticalAlignment="Center">
                    <TextBlock x:Name="ActivePlatformTxt" Text="" FontSize="12" FontWeight="Bold" Foreground="{ThemeResource ThemeOnAccentBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="PendingEditsTxt" VerticalAlignment="Center" FontSize="12"
                           Foreground="{ThemeResource ThemeTextDimBrush}"/>
                <!-- Shares the same accountdata.hg unlock array as Catalog/Twitch
                     Rewards (see AccountSessionManager) - saving/discarding here also
                     saves/discards any pending edits made on those other 2 pages this
                     session, which is correct: they're not independently trackable
                     sub-arrays, just different filtered views of the one array. -->
                <Button x:Name="DiscardChangesBtn" Content="Discard Changes" Click="DiscardChangesBtn_Click"
                        Style="{StaticResource DangerButtonStyle}" IsEnabled="False"/>
                <Button x:Name="SaveChangesBtn" Content="Save Changes" Click="SaveChangesBtn_Click"
                        Style="{StaticResource ThemeAccentButtonStyle}" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock x:Name="NoAccountDataTxt" Visibility="Collapsed"
                       Text="No accountdata.hg file was found alongside this save - this platform account may be very new, or this feature isn't supported for it yet."
                       Foreground="{ThemeResource ThemeTextDimBrush}" FontSize="14" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" TextAlignment="Center"/>

            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="40" Height="40"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <ScrollViewer x:Name="ContentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16">
                    <Border Background="{ThemeResource ThemePanelAltBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}"
                            BorderThickness="1" CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="14,10">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource ThemeWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource ThemeWarningBrush}"
                                       Text="This list is shared by every save on this platform account, not just the save that's loaded. Save it with the Save Changes button above; the normal Save button doesn't cover it."/>
                        </Grid>
                    </Border>

                    <!-- Banner/Decal/Title items whose own names spell out which
                         expedition they're from (CatalogService.BuildExpeditionNameLookup).
                         The "EXPD_" id prefix is Hello Games' own naming convention,
                         confirmed present on every expedition-reward item found in the
                         account's real B1h list (2026-08-04) - a live pattern match
                         against whatever's in the catalog DB, not a hardcoded item list.
                         Split out of AccountDataPage into its own page 2026-08-13 - user
                         feedback: "too much on Catalog... a little laggy." -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search expedition rewards..." TextChanged="SearchBox_TextChanged"/>
                        <ComboBox Grid.Column="1" x:Name="ExpeditionFilterBox" AutomationProperties.Name="Expedition" Width="220" SelectionChanged="ExpeditionFilterBox_SelectionChanged"/>
                        <TextBlock Grid.Column="2" x:Name="ResultCountTxt" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource ThemeTextDimBrush}"/>
                    </Grid>

                    <!-- Grouped into one card per expedition number (e.g. "#19: CORVETTE"),
                         the same real data already shown as a badge on each row, plus a
                         catch-all "Other Expedition Items" card for items with no
                         expedition-number signal (backpacks/capes/ships/etc. - see
                         CatalogService.GetExpeditionInfo's own doc comment on why only
                         Banner/Decal/Title items resolve one at all). -->
                    <ItemsControl x:Name="CategoriesItemsControl"
                                  ItemsPanel="{StaticResource CategoryCardWrapPanelTemplate}"
                                  ItemTemplate="{StaticResource CategoryCardTemplate}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
