<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.CargoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="CARGO" Margin="28,26,28,12" Style="{StaticResource ThemePageTitleStyle}"/>
        <NavigationView x:Name="StorageTabs" Grid.Row="1" PaneDisplayMode="Top"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" SelectionChanged="StorageTabs_SelectionChanged"
                        AutomationProperties.Name="Cargo storage types">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Base Storage" Tag="BaseStorage"/>
                <NavigationViewItem Content="Ingredient Storage" Tag="IngredientStorage"/>
                <NavigationViewItem Content="Cold Storage" Tag="ColdStorage"/>
                <NavigationViewItem Content="Corvette Cache" Tag="CorvetteCache"/>
                <NavigationViewItem Content="Dismantled Base Components" Tag="BaseItemCache"/>
            </NavigationView.MenuItems>
            <!-- Keep visited controls attached: changing tabs must not unload
                 their grids, filters, scroll viewers or event subscriptions. -->
            <Grid>
                <ContentControl x:Name="BaseStorageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.BaseStorageVisibility, Mode=OneWay}"/>
                <ContentControl x:Name="IngredientStorageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.IngredientStorageVisibility, Mode=OneWay}"/>
                <ContentControl x:Name="ColdStorageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.ColdStorageVisibility, Mode=OneWay}"/>
                <ContentControl x:Name="CorvetteCacheHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.CorvetteCacheVisibility, Mode=OneWay}"/>
                <ContentControl x:Name="BaseItemCacheHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.BaseItemCacheVisibility, Mode=OneWay}"/>
            </Grid>
        </NavigationView>
    </Grid>
</Page>
