<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArtifactX.WinUI3.Views.ShipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="20" HorizontalAlignment="Stretch">

            <!-- Same Grid+VisualStateManager pattern as MultiToolPage: Templates
                 pinned to the top-right while there's room, dropping to a
                 full-width row under the selector once the window gets narrow. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="20">
                    <TextBlock Text="Starships" FontSize="26" FontWeight="Bold"/>
                    <Button x:Name="PageResetBtn" Content="Reset Starship Changes" Click="PageResetBtn_Click" Visibility="Collapsed"/>

                    <TextBlock Text="Owned Starships" FontSize="14" Opacity="0.8"/>
                    <!-- Same bounded/scrollable pattern as Multi-Tool's selector - a save
                         with many ships stays just as usable as one with a couple. -->
                    <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                        <ctcontrols:WrapPanel x:Name="ShipSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                    </ScrollViewer>
                </StackPanel>

                <Border x:Name="TemplatesBorder" Grid.Row="0" Grid.Column="1"
                        BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                        CornerRadius="8" Padding="16" Opacity="0.9" Width="300" VerticalAlignment="Top">
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Templates" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="Save Current..." Click="SaveAsTemplateBtn_Click" FontSize="11" Padding="8,3,8,3"/>
                        </StackPanel>
                        <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                                   Text="Apply replaces the currently selected ship's tech with this template."/>
                        <StackPanel x:Name="TemplatesListPanel" Spacing="8"/>
                    </StackPanel>
                </Border>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="HeaderWide">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="950"/>
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="HeaderNarrow">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0"/>
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="TemplatesBorder.(Grid.Row)" Value="1"/>
                                <Setter Target="TemplatesBorder.(Grid.Column)" Value="0"/>
                                <Setter Target="TemplatesBorder.(Grid.ColumnSpan)" Value="2"/>
                                <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                                <Setter Target="TemplatesBorder.HorizontalAlignment" Value="Stretch"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Name" FontSize="12" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBox x:Name="NameEditBox" Width="240" LostFocus="NameEditBox_LostFocus"/>
                <TextBlock Text="Class" Opacity="0.7" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel x:Name="ClassSelectorPanel" Orientation="Horizontal" Spacing="6"/>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Base Stats" FontSize="14" FontWeight="SemiBold"/>
                <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap"
                           Text="These are the ship's own rolled bonus stats - changing Class above does not change them by itself. No known upper limit; extreme values won't corrupt your save, just unbalance it."/>
                <Grid ColumnSpacing="8" RowSpacing="6" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Damage" VerticalAlignment="Center"/>
                    <NumberBox Grid.Row="0" Grid.Column="1" x:Name="DamageStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="DamageStatBox_ValueChanged" LostFocus="DamageStatBox_LostFocus"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Shield" VerticalAlignment="Center"/>
                    <NumberBox Grid.Row="1" Grid.Column="1" x:Name="ShieldStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="ShieldStatBox_ValueChanged" LostFocus="ShieldStatBox_LostFocus"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Hyperdrive" VerticalAlignment="Center"/>
                    <NumberBox Grid.Row="2" Grid.Column="1" x:Name="HyperdriveStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="HyperdriveStatBox_ValueChanged" LostFocus="HyperdriveStatBox_LostFocus"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Maneuverability" VerticalAlignment="Center"/>
                    <NumberBox Grid.Row="3" Grid.Column="1" x:Name="AgileStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="AgileStatBox_ValueChanged" LostFocus="AgileStatBox_LostFocus"/>
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock x:Name="TechHeaderTxt" Text="Technology" FontSize="18" FontWeight="SemiBold"/>
                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                    <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                    <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                    <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                    <Button Content="Copy Tech Stack..." Click="CopyTechStackBtn_Click"/>
                </ctcontrols:WrapPanel>
            </StackPanel>
            <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                    CornerRadius="6" HorizontalAlignment="Left" Opacity="0.9">
                <Grid>
                    <ScrollViewer x:Name="TechScrollViewer" Padding="8,32,8,8" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                        <controls:InventorySlotGrid x:Name="TechGrid"/>
                    </ScrollViewer>
                    <Button x:Name="TechExpandBtn" Click="TechExpandBtn_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                            Padding="6" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Expand">
                        <FontIcon x:Name="TechExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Cargo" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="Unlock All Slots" Click="UnlockAllCargo_Click"/>
            </StackPanel>
            <Border BorderBrush="{ThemeResource NmsTextSecondary}" BorderThickness="1"
                    CornerRadius="6" HorizontalAlignment="Left" Opacity="0.9">
                <Grid>
                    <ScrollViewer x:Name="CargoScrollViewer" Padding="8,32,8,8" MaxHeight="368" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                        <controls:InventorySlotGrid x:Name="CargoGrid"/>
                    </ScrollViewer>
                    <Button x:Name="CargoExpandBtn" Click="CargoExpandBtn_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                            Padding="6" Background="Transparent" BorderThickness="0"
                            ToolTipService.ToolTip="Expand">
                        <FontIcon x:Name="CargoExpandIcon" Glyph="&#xE70D;" FontSize="12"/>
                    </Button>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
