<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml): every card, band, label and
     colour comes from the active theme's Theme* keys. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ShipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <!-- On the page's root element: AdaptiveTriggers attached to a nested
             Grid never fired (2026-10-10 - the narrow layout never applied). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HeaderWide">
                    <VisualState.StateTriggers>
                        <!-- WINDOW width, which includes the ~320px nav pane: two columns
                             need nav + grid card (~720) + sidebar (~340) + gaps/padding.
                             950 left the sidebar clipped beside the grid (2026-10-10). -->
                        <AdaptiveTrigger MinWindowWidth="1440"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="28,26,28,40" Spacing="22" HorizontalAlignment="Stretch">

            <!-- ONE Grid for the whole page body (title row + a single tall
                 content row) rather than two stacked Grids - a real gap bug
                 (2026-08-01) showed up between the selector and "Technology"
                 once the Templates panel grew a 2nd section (Full Build) and
                 got taller than the title+selector column. Every left-column
                 element (selector, Technology, Cargo) lives in ONE StackPanel and
                 every right-column element (Templates, Ship Details) in another,
                 both in the SAME Grid row - so the row's height is driven by
                 column 0, and column 1 renders top-aligned within it. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reset button pinned far right of THIS row, in its own row so it
                     appearing/disappearing never shifts the cards below. -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="STARSHIPS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Starship Changes" Click="PageResetBtn_Click"
                            Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel x:Name="MainColumn" Grid.Row="1" Grid.Column="0" Spacing="22" SizeChanged="MainColumn_SizeChanged">
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <Grid>
                                    <TextBlock Text="OWNED STARSHIPS" Style="{StaticResource ThemeBandTextStyle}"/>
                                    <!-- "7 OF 12 SLOTS USED" (2026-10-17, the user's idea). -->
                                    <TextBlock x:Name="ShipSlotsTxt" Style="{StaticResource ThemeBandTextStyle}" Opacity="0.75"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                            <!-- Bounded/scrollable so a save with many ships stays usable. -->
                            <ScrollViewer MaxHeight="120" Padding="18,14,18,16" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                <controls:EquipmentStrip x:Name="ShipStrip" ChipClicked="ShipStrip_ChipClicked"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- The selected ship's own details, full width above its tech
                         (user 2026-10-15: a ship page shouldn't hide them bottom right).
                         Wide and short - three groups that wrap on narrow windows - and
                         collapsible (FoldingCard, remembered). -->
                    <Border x:Name="ShipInfoBorder" Style="{StaticResource ThemeCardStyle}">
                        <controls:FoldingCard x:Name="DetailsCard" Title="SHIP DETAILS" SettingKey="StarshipsDetailsCollapsed">
                            <StackPanel Padding="18,14,18,18" Spacing="16">
                                <!-- Shown for corvettes: their build lives apart from the ship (ShipBaseService). -->
                                <Border x:Name="CorvetteNote" Visibility="Collapsed" BorderBrush="{ThemeResource ThemeAccentBrush}" BorderThickness="1"
                                        CornerRadius="{ThemeResource ThemeCardCornerRadius}" Padding="12,8">
                                    <TextBlock x:Name="CorvetteNoteTxt" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource ThemeTextBrush}"/>
                                </Border>

                                <!-- Stats over who/seed on the left, the preview beside the whole block
                                     (no gap above it, 2026-10-15); it wraps below on narrow windows. -->
                                <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                                    <StackPanel MaxWidth="692" Spacing="16">
                                        <!-- Its rolled stats: one wrapping row at the top, so the card stays short (2026-10-15). -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="BASE STATS" Style="{StaticResource ThemeEyebrowStyle}"
                                                       ToolTipService.ToolTip="The ship's own rolled bonus stats - changing Class doesn't change them by itself. No known upper limit; extreme values won't corrupt your save, just unbalance it."/>
                                            <controls:StatBonusBoxes x:Name="StatsBoxes" Edited="StatsBoxes_Edited"/>
                                        </StackPanel>

                                        <ctcontrols:WrapPanel HorizontalSpacing="32" VerticalSpacing="18">
                                            <!-- Who it is -->
                                            <StackPanel Width="280" Spacing="12">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                    <TextBox x:Name="NameEditBox" LostFocus="NameEditBox_LostFocus" GotFocus="NameEditBox_GotFocus"
                                                             TextChanged="NameEditBox_TextChanged" KeyDown="NameEditBox_KeyDown"/>
                                                    <HyperlinkButton x:Name="NameUpdateLink" Content="Update game data now" Padding="0" Visibility="Collapsed" Click="NameUpdateLink_Click"/>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                    <controls:ClassPicker x:Name="ClassPicker" ClassChosen="ClassPicker_ClassChosen"/>
                                                </StackPanel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                                    <ComboBox x:Name="TypeComboBox" HorizontalAlignment="Stretch"
                                                              DisplayMemberPath="DisplayName"
                                                              SelectionChanged="TypeComboBox_SelectionChanged"
                                                              ToolTipService.ToolTip="The ship's model. Changing it swaps the hull you fly in-game."/>
                                                </StackPanel>
                                                <Button Content="Delete this ship..." Click="DeleteShipBtn_Click" Margin="0,4,0,0"
                                                        Foreground="{ThemeResource ThemeWarningBrush}" BorderBrush="{ThemeResource ThemeWarningBrush}"
                                                        ToolTipService.ToolTip="Remove this ship from the save. You can keep it as a template first."/>
                                            </StackPanel>

                                            <!-- How it looks -->
                                            <StackPanel Width="380" Spacing="6">
                                                <TextBlock Text="SEED" Style="{StaticResource ThemeEyebrowStyle}"
                                                           ToolTipService.ToolTip="Drives this ship's procedural look, alongside its Class and model. Paste a seed you've found elsewhere, or Generate a new random look - you'll see it next time you load the game."/>
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="SeedEditBox" LostFocus="SeedEditBox_LostFocus"/>
                                                    <Button Grid.Column="1" Content="Generate" Click="GenerateSeedBtn_Click"/>
                                                </Grid>
                                                <!-- The parts this seed gives (ShipsPage.Parts.cs, experiment). -->
                                                <StackPanel x:Name="ShipPartsPanel" Spacing="6" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </ctcontrols:WrapPanel>
                                    </StackPanel>

                                    <!-- What the seed looks like (ShipsPage.Parts.cs, experiment) -->
                                    <StackPanel x:Name="ShipPreviewGroup" Width="420" Spacing="6" Visibility="Collapsed">
                                        <TextBlock Text="PREVIEW" Style="{StaticResource ThemeEyebrowStyle}"/>
                                        <controls:ShipPreview x:Name="ShipPreviewView" Height="260"/>
                                        <TextBlock x:Name="ShipPreviewNote" Style="{StaticResource ThemeDimTextStyle}" FontSize="11" TextWrapping="Wrap"
                                                   Text="Shape from your game files. Colours are still being checked against the game."/>
                                        <!-- Under the ship it paints, in the amber "offer" style (the plain button
                                             in the stats column was easy to miss, 2026-10-17). -->
                                        <Button x:Name="PaintShipBtn" Click="PaintShipBtn_Click" Margin="0,4,0,0" Visibility="Collapsed"
                                                Style="{StaticResource ThemeAttentionButtonStyle}"
                                                ToolTipService.ToolTip="Choose a paint style and colours for this ship in the Ship Designer. Its parts and name stay as they are.">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE790;" FontSize="14"/>
                                                <TextBlock Text="Paint this ship"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                </ctcontrols:WrapPanel>
                            </StackPanel>
                        </controls:FoldingCard>
                    </Border>

                    <!-- Tech and cargo stacked, with the list of tech this ship can fit
                         beside them (its height follows theirs), or underneath them when
                         the window is too narrow - see MainColumn_SizeChanged. -->
                    <Grid x:Name="TechLayoutGrid" ColumnSpacing="22" RowSpacing="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="TechCargoStack" Spacing="22" VerticalAlignment="Top" SizeChanged="TechCargoStack_SizeChanged">
                            <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Style="{StaticResource ThemeBandStyle}">
                                        <TextBlock x:Name="TechHeaderTxt" Text="TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                                    </Border>
                                    <StackPanel Padding="14,12,14,14" Spacing="10">
                                        <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                            <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                                            <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                                            <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                                            <Button Content="Arrange for Adjacency" Click="ArrangeTech_Click"
                                                    ToolTipService.ToolTip="Groups same-type tech side by side so it gets the game's adjacency boost. Tech in supercharged slots stays where it is."/>
                                            <Button Content="Copy Tech Stack..." Click="CopyTechStackBtn_Click"/>
                                        </ctcontrols:WrapPanel>
                                        <controls:ExpandableScroll CollapsedHeight="232" SettingKey="ShipsTechExpanded">
                                            <controls:InventorySlotGrid x:Name="TechGrid"/>
                                        </controls:ExpandableScroll>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                                <StackPanel>
                                    <Border Style="{StaticResource ThemeBandStyle}">
                                        <TextBlock Text="CARGO" Style="{StaticResource ThemeBandTextStyle}"/>
                                    </Border>
                                    <StackPanel Padding="14,12,14,14" Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Unlock All Slots" Click="UnlockAllCargo_Click"/>
                                            <Button Content="Max All Qty" Click="MaxAllQtyCargo_Click"/>
                                            <Button Content="Sort" Click="SortCargo_Click"
                                                    ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                                        </StackPanel>
                                        <controls:ExpandableScroll CollapsedHeight="368" SettingKey="ShipsCargoExpanded">
                                            <controls:InventorySlotGrid x:Name="CargoGrid"/>
                                        </controls:ExpandableScroll>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <Border x:Name="TechListCard" Grid.Column="1" Style="{StaticResource ThemeCardStyle}" Width="340" VerticalAlignment="Top" HorizontalAlignment="Left">
                            <StackPanel>
                                <Border Style="{StaticResource ThemeBandStyle}">
                                    <TextBlock x:Name="TechListHeaderTxt" Text="TECHNOLOGY FOR THIS SHIP" Style="{StaticResource ThemeBandTextStyle}"/>
                                </Border>
                                <Border Padding="14,12,14,14">
                                    <controls:ItemListPanel x:Name="TechListPanel"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- SidebarPanel (Templates) is one named unit so the
                     narrow-mode VisualState below can move it to its own row at once. -->
                <StackPanel x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Spacing="22" VerticalAlignment="Top">
                    <Border x:Name="TemplatesBorder" Style="{StaticResource ThemeCardStyle}" Width="320">
                        <controls:LoadoutTemplatesPanel x:Name="TemplatesPanel" SourceKind="Ship" NameExample="Combat Hauler" FullBuildContents="tech + stats + appearance"
                                                      TechStackHint="Apply replaces the selected ship's tech with this template. Never touches Stats, Seed, Cargo, or Class unless you opt in."
                                                      FullBuildHint="The whole ship: tech, class, stats, model, look and cargo slots (never the cargo itself). Add as new puts it in an empty Starship slot - your other ships aren't changed."/>
                    </Border>

                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
