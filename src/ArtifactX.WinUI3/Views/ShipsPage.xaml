<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (see Themes/*.xaml + ThemeStyles.xaml): every card, band, label and
     colour comes from the active theme's Theme* keys. -->
<Page
    x:Class="ArtifactX.WinUI3.Views.ShipsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArtifactX.WinUI3.Controls"
    xmlns:ctcontrols="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <!-- On the page's root element: AdaptiveTriggers attached to a nested
             Grid never fired (2026-10-10 - the narrow layout never applied). -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="HeaderWide">
                    <VisualState.StateTriggers>
                        <!-- WINDOW width, which includes the ~320px nav pane: two columns
                             need nav + grid card (~720) + sidebar (~340) + gaps/padding.
                             950 left the sidebar clipped beside the grid (2026-10-10). -->
                        <AdaptiveTrigger MinWindowWidth="1440"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="HeaderNarrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SidebarPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="SidebarPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="SidebarPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TemplatesBorder.Width" Value="NaN"/>
                        <Setter Target="ShipInfoBorder.Width" Value="NaN"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel Padding="28,26,28,40" Spacing="22" HorizontalAlignment="Stretch">

            <!-- ONE Grid for the whole page body (title row + a single tall
                 content row) rather than two stacked Grids - a real gap bug
                 (2026-08-01) showed up between the selector and "Technology"
                 once the Templates panel grew a 2nd section (Full Build) and
                 got taller than the title+selector column. Every left-column
                 element (selector, Technology, Cargo) lives in ONE StackPanel and
                 every right-column element (Templates, Ship Details) in another,
                 both in the SAME Grid row - so the row's height is driven by
                 column 0, and column 1 renders top-aligned within it. -->
            <Grid x:Name="HeaderGrid" ColumnSpacing="24" RowSpacing="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Reset button pinned far right of THIS row, in its own row so it
                     appearing/disappearing never shifts the cards below. -->
                <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="STARSHIPS" Style="{StaticResource ThemePageTitleStyle}" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" x:Name="PageResetBtn" Content="Reset Starship Changes" Click="PageResetBtn_Click"
                            Visibility="Collapsed" Style="{StaticResource DangerButtonStyle}" VerticalAlignment="Center"/>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="22">
                    <Border Style="{StaticResource ThemeCardStyle}">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="OWNED STARSHIPS" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <!-- Bounded/scrollable so a save with many ships stays usable. -->
                            <ScrollViewer MaxHeight="120" Padding="18,14,18,16" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                                <ctcontrols:WrapPanel x:Name="ShipSelectorPanel" HorizontalSpacing="8" VerticalSpacing="8"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock x:Name="TechHeaderTxt" Text="TECHNOLOGY" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="14,12,14,14" Spacing="10">
                                <ctcontrols:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button Content="Unlock All Slots" Click="UnlockAllTech_Click"/>
                                    <Button Content="Supercharge All Slots" Click="SuperchargeAllTech_Click"/>
                                    <Button Content="Repair All Slots" Click="RepairAllTech_Click"/>
                                    <Button Content="Copy Tech Stack..." Click="CopyTechStackBtn_Click"/>
                                </ctcontrols:WrapPanel>
                                <Grid>
                                    <ScrollViewer x:Name="TechScrollViewer" Padding="0,28,0,0" MaxHeight="232" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                                        <controls:InventorySlotGrid x:Name="TechGrid"/>
                                    </ScrollViewer>
                                    <Button x:Name="TechExpandBtn" Click="TechExpandBtn_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="6" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Expand">
                                        <FontIcon x:Name="TechExpandIcon" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ThemeCardStyle}" HorizontalAlignment="Left">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="CARGO" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="14,12,14,14" Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Unlock All Slots" Click="UnlockAllCargo_Click"/>
                                    <Button Content="Max All Qty" Click="MaxAllQtyCargo_Click"/>
                                    <Button Content="Sort" Click="SortCargo_Click"
                                            ToolTipService.ToolTip="Groups items by kind and name, packed from the top-left, so identical items sit together."/>
                                </StackPanel>
                                <Grid>
                                    <ScrollViewer x:Name="CargoScrollViewer" Padding="0,28,0,0" MaxHeight="368" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Left">
                                        <controls:InventorySlotGrid x:Name="CargoGrid"/>
                                    </ScrollViewer>
                                    <Button x:Name="CargoExpandBtn" Click="CargoExpandBtn_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="6" Background="Transparent" BorderThickness="0"
                                            ToolTipService.ToolTip="Expand">
                                        <FontIcon x:Name="CargoExpandIcon" Glyph="&#xE70D;" FontSize="12" Foreground="{ThemeResource ThemeAccentBrush}"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- SidebarPanel is one named unit (Templates + Ship Details) so the
                     narrow-mode VisualState below can move it to its own row at once. -->
                <StackPanel x:Name="SidebarPanel" Grid.Row="1" Grid.Column="1" Spacing="22" VerticalAlignment="Top">
                    <Border x:Name="TemplatesBorder" Style="{StaticResource ThemeCardStyle}" Width="320">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="TEMPLATES" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <!-- Two separate domains on purpose - a Tech Stack template never
                                 touches Stats/Seed/Cargo/Name, a Full Build template also
                                 carries Stats + Seed (still never Cargo/Name/equip state). -->
                            <StackPanel Padding="18,14,18,18" Spacing="18">
                                <!-- Templates other players shared as files (Share... on any template). -->
                                <StackPanel Spacing="6">
                                    <Button Content="Import a template file..." Click="ImportTemplateBtn_Click" FontSize="12" Padding="10,4,10,4"
                                            ToolTipService.ToolTip="Add a template someone shared with you. Your save only changes when you click Apply."/>
                                    <TextBlock x:Name="ImportTemplateStatusTxt" Style="{StaticResource ThemeDimTextStyle}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="TECH STACK" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                        <Button Content="Save Current..." Click="SaveAsTemplateBtn_Click" FontSize="11" Padding="8,3,8,3" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="Apply replaces the selected ship's tech with this template. Never touches Stats, Seed, Cargo, or Class unless you opt in."/>
                                    <StackPanel x:Name="TemplatesListPanel" Spacing="8"/>
                                </StackPanel>

                                <Border BorderBrush="{ThemeResource ThemeLineBrush}" BorderThickness="0,1,0,0"/>

                                <StackPanel Spacing="8">
                                    <Grid>
                                        <TextBlock Text="FULL BUILD" Style="{StaticResource ThemeEyebrowStyle}" VerticalAlignment="Center"/>
                                        <Button Content="Save Current..." Click="SaveAsFullBuildTemplateBtn_Click" FontSize="11" Padding="8,3,8,3" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="The whole ship: tech, class, stats, model, look and cargo slots (never the cargo itself). Add as new puts it in an empty Starship slot - your other ships aren't changed."/>
                                    <StackPanel x:Name="FullBuildTemplatesListPanel" Spacing="8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ShipInfoBorder" Style="{StaticResource ThemeCardStyle}" Width="320">
                        <StackPanel>
                            <Border Style="{StaticResource ThemeBandStyle}">
                                <TextBlock Text="SHIP DETAILS" Style="{StaticResource ThemeBandTextStyle}"/>
                            </Border>
                            <StackPanel Padding="18,14,18,18" Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="NAME" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBox x:Name="NameEditBox" LostFocus="NameEditBox_LostFocus"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="CLASS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <StackPanel x:Name="ClassSelectorPanel" Orientation="Horizontal" Spacing="6"/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="TYPE" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <ComboBox x:Name="TypeComboBox" HorizontalAlignment="Stretch"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="TypeComboBox_SelectionChanged"
                                              ToolTipService.ToolTip="The ship's model. Changing it swaps the hull you fly in-game."/>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="SEED" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="Drives this ship's procedural look, alongside its Class and model. Paste a seed you've found elsewhere, or Generate a new random look - you'll see it next time you load the game."/>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SeedEditBox" LostFocus="SeedEditBox_LostFocus"/>
                                        <Button Grid.Column="1" Content="Generate" Click="GenerateSeedBtn_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="BASE STATS" Style="{StaticResource ThemeEyebrowStyle}"/>
                                    <TextBlock Style="{StaticResource ThemeDimTextStyle}" FontSize="12"
                                               Text="The ship's own rolled bonus stats - changing Class doesn't change them by itself. No known upper limit; extreme values won't corrupt your save, just unbalance it."/>
                                    <Grid ColumnSpacing="10" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Damage" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="0" Grid.Column="1" x:Name="DamageStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="DamageStatBox_ValueChanged" LostFocus="DamageStatBox_LostFocus"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Shield" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="1" Grid.Column="1" x:Name="ShieldStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="ShieldStatBox_ValueChanged" LostFocus="ShieldStatBox_LostFocus"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Hyperdrive" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="2" Grid.Column="1" x:Name="HyperdriveStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="HyperdriveStatBox_ValueChanged" LostFocus="HyperdriveStatBox_LostFocus"/>
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Maneuverability" Style="{StaticResource ThemeBodyTextStyle}" VerticalAlignment="Center"/>
                                        <NumberBox Grid.Row="3" Grid.Column="1" x:Name="AgileStatBox" Minimum="0" SpinButtonPlacementMode="Hidden" ValueChanged="AgileStatBox_ValueChanged" LostFocus="AgileStatBox_LostFocus"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
